@page
@model OPCBS.Web.Pages.Appointment.SuccessModel
@{
    ViewData["Title"] = "Đặt lịch thành công";
}

<div class="booking-success-container">
    <div class="booking-success-card">
        <!-- Success Icon -->
        <div class="success-icon-wrapper">
            <div class="success-icon-circle">
                <i class="bi bi-check-lg"></i>
            </div>
            <div class="success-confetti"></div>
        </div>

        <h1 class="success-title">Đặt lịch thành công!</h1>
        <p class="success-subtitle">Lịch hẹn của bạn đã được ghi nhận và đang chờ bác sĩ xác nhận.</p>

        <!-- Booking Details -->
        @if (!string.IsNullOrEmpty(Model.BookingCode) || !string.IsNullOrEmpty(Model.DoctorName))
        {
            <div class="success-details">
                @if (!string.IsNullOrEmpty(Model.BookingCode))
                {
                    <div class="detail-item highlight">
                        <div class="detail-icon"><i class="bi bi-upc-scan"></i></div>
                        <div>
                            <span class="detail-label">Mã đặt lịch</span>
                            <span class="detail-value booking-code">@Model.BookingCode</span>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.DoctorName))
                {
                    <div class="detail-item">
                        <div class="detail-icon"><i class="bi bi-person-heart"></i></div>
                        <div>
                            <span class="detail-label">Chuyên gia</span>
                            <span class="detail-value">@Model.DoctorName</span>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.AppointmentDate))
                {
                    <div class="detail-item">
                        <div class="detail-icon"><i class="bi bi-calendar-event"></i></div>
                        <div>
                            <span class="detail-label">Ngày hẹn</span>
                            <span class="detail-value">@Model.AppointmentDate</span>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.StartTime))
                {
                    <div class="detail-item">
                        <div class="detail-icon"><i class="bi bi-clock"></i></div>
                        <div>
                            <span class="detail-label">Thời gian</span>
                            <span class="detail-value">@Model.StartTime @(!string.IsNullOrEmpty(Model.EndTime) ? $"— {Model.EndTime}" : "")</span>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- Status Info -->
        <div class="success-status-info">
            <i class="bi bi-info-circle me-2"></i>
            Trạng thái: <strong>Đang chờ xác nhận</strong> — Bác sĩ sẽ xác nhận lịch hẹn trong thời gian sớm nhất.
        </div>

        @if (Model.IsGuest && !string.IsNullOrEmpty(Model.BookingCode))
        {
            <div class="success-guest-note">
                <i class="bi bi-envelope-heart me-2"></i>
                Vui lòng lưu lại <strong>mã đặt lịch</strong> để theo dõi trạng thái lịch hẹn.
            </div>
        }

        <!-- Actions -->
        <div class="success-actions">
            @if (Model.IsGuest)
            {
                <a asp-page="/Appointment/Track" class="btn btn-primary btn-lg success-btn">
                    <i class="bi bi-search me-2"></i>Theo dõi lịch hẹn
                </a>
                <a asp-page="/Doctors/Index" class="btn btn-outline-primary btn-lg success-btn">
                    <i class="bi bi-search-heart me-2"></i>Tìm chuyên gia khác
                </a>
            }
            else
            {
                <a asp-page="/Patient/Appointments/Index" class="btn btn-primary btn-lg success-btn">
                    <i class="bi bi-calendar-check me-2"></i>Xem lịch hẹn của tôi
                </a>
                <a asp-page="/Doctors/Index" class="btn btn-outline-primary btn-lg success-btn">
                    <i class="bi bi-search-heart me-2"></i>Đặt lịch mới
                </a>
            }
            <a asp-page="/Index" class="btn btn-link text-muted mt-2">
                <i class="bi bi-house me-1"></i>Về trang chủ
            </a>
        </div>
    </div>
</div>
