@page
@model OPCBS.Web.Pages.Appointment.GuestCancelModel
@{
    ViewData["Title"] = "Cancel Appointment";
}

<section class="py-5">
    <div class="container" style="max-width: 580px;">
        <div class="card border shadow-sm" style="border-radius: 8px; border-color: #e2e8f0;">
            <div class="card-body p-4 p-md-5">
                <div class="d-inline-flex align-items-center justify-content-center mb-3" style="width:52px; height:52px; border-radius:8px; background:#fee2e2; color:#dc2626;">
                    <i class="bi bi-x-circle fs-3"></i>
                </div>
                <h1 class="h4 fw-bold mb-2 text-dark">Cancel Your Appointment</h1>
                <p class="text-muted small mb-4">This action will release your scheduled time slot and notify your doctor. This cancellation cannot be undone.</p>

                @if (Model.SuccessMessage != null)
                {
                    <div class="alert alert-success d-flex align-items-start gap-2 mb-3" style="border-radius:8px; font-size:0.88rem;">
                        <i class="bi bi-check-circle-fill text-success fs-5 flex-shrink-0"></i>
                        <div>@Model.SuccessMessage</div>
                    </div>
                    <a asp-page="/Appointment/Track" class="btn btn-primary w-100" style="background:#0f766e; border-color:#0f766e; border-radius:8px; font-weight:600; min-height:42px; display:flex; align-items:center; justify-content:center;">
                        <i class="bi bi-search me-1.5"></i>Go to Track Appointment
                    </a>
                }
                else
                {
                    @if (Model.ErrorMessage != null)
                    {
                        <div class="alert alert-danger d-flex align-items-start gap-2 mb-3" style="border-radius:8px; font-size:0.88rem;">
                            <i class="bi bi-exclamation-triangle-fill text-danger fs-5 flex-shrink-0"></i>
                            <div>@Model.ErrorMessage</div>
                        </div>
                    }
                    <form method="post">
                        <input asp-for="Token" type="hidden" />
                        <div class="mb-3">
                            <label asp-for="Reason" class="form-label small fw-semibold text-secondary">Reason for Cancellation (optional)</label>
                            <textarea asp-for="Reason" class="form-control mb-3" rows="3" maxlength="1000" placeholder="Please let us know why you need to cancel this session..." style="border-radius:8px; font-size:0.88rem;"></textarea>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-outline-danger flex-fill" style="border-radius:8px; font-weight:600; min-height:42px;">
                                <i class="bi bi-x-circle me-1"></i>Confirm Cancellation
                            </button>
                            <a asp-page="/Appointment/Track" class="btn btn-light flex-fill border" style="border-radius:8px; font-weight:600; min-height:42px; display:flex; align-items:center; justify-content:center;">
                                Keep Appointment
                            </a>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</section>
