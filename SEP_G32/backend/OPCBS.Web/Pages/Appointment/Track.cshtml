@page
@model OPCBS.Web.Pages.Appointment.TrackModel
@{
    ViewData["Title"] = "Track Appointment";
}

<section class="mb-section">
    <div style="max-width:680px;margin:0 auto;">
        <!-- Header -->
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center mb-3" style="width:64px;height:64px;border-radius:50%;background:var(--mb-primary-light);">
                <i class="bi bi-search" style="font-size:1.5rem;color:var(--mb-primary);"></i>
            </div>
            <h2>Track Appointment</h2>
            <p class="text-muted">Enter your email and booking code to check your appointment status.</p>
        </div>

        <!-- Track Form -->
        <div class="card border-0 shadow-sm" style="border-radius:16px;">
            <div class="card-body p-4">
                @if (ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="alert alert-danger" style="border-radius:10px;">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <span>@err.ErrorMessage</span>
                        }
                    </div>
                }

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success" style="border-radius:10px;">
                        <i class="bi bi-check-circle me-1"></i>@TempData["SuccessMessage"]
                    </div>
                }

                <form method="post">
                    <div class="mb-3">
                        <label class="form-label fw-medium"><i class="bi bi-envelope me-1" style="color:var(--mb-primary);"></i>Email</label>
                        <input asp-for="Input.Email" class="form-control form-control-lg" placeholder="Enter the email you used when booking" style="border-radius:10px;" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-medium"><i class="bi bi-upc-scan me-1" style="color:var(--mb-primary);"></i>Booking Code <span class="text-muted fw-normal">(optional)</span></label>
                        <input asp-for="Input.BookingCode" class="form-control form-control-lg" placeholder="VD: APT-XXXXX" style="border-radius:10px;" />
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg w-100" style="border-radius:10px;">
                        <i class="bi bi-search me-2"></i>Find appointment
                    </button>
                </form>
            </div>
        </div>

        <!-- Results -->
        @if (Model.Results != null)
        {
            @if (Model.Results.Any())
            {
                <div class="mt-4">
                    <h5 class="mb-3"><i class="bi bi-calendar-check me-2" style="color:var(--mb-primary);"></i>Search Results (@Model.Results.Count appointments)</h5>
                    <div class="d-flex flex-column gap-3">
                        @foreach (var apt in Model.Results)
                        {
                            var borderClass = apt.Status == 0 ? "border-start-warning" :
                                              apt.Status == 1 ? "border-start-primary" :
                                              apt.Status == 4 ? "border-start-success" : "border-start-danger";

                            <div class="card border-0 shadow-sm @borderClass" style="border-radius:12px;border-left:4px solid !important;">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                        <div>
                                            <h6 class="mb-1">@(apt.DoctorName ?? "Therapist")</h6>
                                            <div class="d-flex flex-wrap gap-3" style="font-size:0.8125rem;color:var(--mb-text-secondary);">
                                                <span><i class="bi bi-calendar3 me-1"></i>@(apt.AppointmentDate ?? "—")</span>
                                                <span><i class="bi bi-clock me-1"></i>@(apt.StartTime ?? "—")</span>
                                                @if (!string.IsNullOrEmpty(apt.BookingCode))
                                                {
                                                    <span><i class="bi bi-upc me-1"></i><code>@apt.BookingCode</code></span>
                                                }
                                            </div>
                                        </div>
                                        <partial name="_StatusBadge" view-data='@(new ViewDataDictionary(ViewData) { { "Status", apt.Status } })' />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-5 mt-4">
                    <i class="bi bi-calendar-x d-block mb-3" style="font-size:2.5rem;color:var(--mb-text-muted);"></i>
                    <h5>Not found appointment</h5>
                    <p class="text-muted">Please double-check your email or booking code.</p>
                </div>
            }
        }

        <!-- Guest CTA -->
        <div class="text-center mt-4 pt-3" style="border-top:1px solid var(--mb-border-light);">
            <p class="text-muted mb-2" style="font-size:0.875rem;">Don't have an account? Register to manage appointments more easily.</p>
            <a asp-page="/Account/Register" class="btn btn-outline-primary btn-sm me-2">
                <i class="bi bi-person-plus me-1"></i>Register
            </a>
            <a asp-page="/Doctors/Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-search-heart me-1"></i>Find a Specialist
            </a>
        </div>
    </div>
</section>
