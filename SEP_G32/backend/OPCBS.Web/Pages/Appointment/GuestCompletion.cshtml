@page
@model OPCBS.Web.Pages.Appointment.GuestCompletionModel
@{
    ViewData["Title"] = "Confirm Consultation Completion";
    var isDispute = string.Equals(Model.Action, "dispute", StringComparison.OrdinalIgnoreCase);
}

<section class="py-5">
    <div class="container" style="max-width: 580px;">
        <div class="card border shadow-sm" style="border-radius: 8px; border-color: #e2e8f0;">
            <div class="card-body p-4 p-md-5">
                <div class="d-inline-flex align-items-center justify-content-center mb-3" style="width:52px; height:52px; border-radius:8px; background:@(isDispute ? "#fee2e2" : "#ccfbf1"); color:@(isDispute ? "#dc2626" : "#0f766e");">
                    <i class="bi @(isDispute ? "bi-shield-exclamation" : "bi-patch-check") fs-3"></i>
                </div>
                <h1 class="h4 fw-bold mb-2 text-dark">@(isDispute ? "Request Support Review" : "Confirm Consultation Completion")</h1>
                <p class="text-muted small mb-4">@(isDispute ? "Please tell us what occurred during or after your consultation session so Customer Support can investigate." : "Please confirm that your consultation session has concluded successfully.")</p>

                @if (Model.SuccessMessage != null)
                {
                    <div class="alert alert-success d-flex align-items-start gap-2 mb-3" style="border-radius:8px; font-size:0.88rem;">
                        <i class="bi bi-check-circle-fill text-success fs-5 flex-shrink-0"></i>
                        <div>@Model.SuccessMessage</div>
                    </div>
                    <a asp-page="/Appointment/Track" class="btn btn-primary w-100" style="background:#0f766e; border-color:#0f766e; border-radius:8px; font-weight:600; min-height:42px; display:flex; align-items:center; justify-content:center;">
                        <i class="bi bi-search me-1.5"></i>Go to Track Appointment
                    </a>
                }
                else
                {
                    @if (Model.ErrorMessage != null)
                    {
                        <div class="alert alert-danger d-flex align-items-start gap-2 mb-3" style="border-radius:8px; font-size:0.88rem;">
                            <i class="bi bi-exclamation-triangle-fill text-danger fs-5 flex-shrink-0"></i>
                            <div>@Model.ErrorMessage</div>
                        </div>
                    }
                    <form method="post">
                        <input asp-for="Token" type="hidden" />
                        <input asp-for="Action" type="hidden" />
                        @if (isDispute)
                        {
                            <div class="mb-3">
                                <label asp-for="Reason" class="form-label small fw-semibold text-secondary">Reason for Dispute / Review</label>
                                <textarea asp-for="Reason" class="form-control mb-3" rows="4" maxlength="2000" required placeholder="Please describe what happened in detail..." style="border-radius:8px; font-size:0.88rem;"></textarea>
                            </div>
                        }
                        <button type="submit" class="btn @(isDispute ? "btn-outline-danger" : "btn-primary") w-100" style="@(isDispute ? "" : "background:#0f766e; border-color:#0f766e;") border-radius:8px; font-weight:600; min-height:42px; display:flex; align-items:center; justify-content:center;">
                            <i class="bi @(isDispute ? "bi-send" : "bi-check-circle") me-1.5"></i>@(isDispute ? "Submit Dispute for Support Review" : "Confirm Completion")
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</section>
