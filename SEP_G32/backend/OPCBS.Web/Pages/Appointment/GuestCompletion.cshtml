@page
@model OPCBS.Web.Pages.Appointment.GuestCompletionModel
@{
    ViewData["Title"] = "Confirm Consultation Completion";
    var isDispute = string.Equals(Model.Action, "dispute", StringComparison.OrdinalIgnoreCase);
}

<section class="py-5">
    <div class="container" style="max-width: 620px;">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">
                <h1 class="h3 fw-bold mb-2">@(isDispute ? "Request support review" : "Confirm consultation completion")</h1>
                <p class="text-muted mb-4">@(isDispute ? "Tell us why the completion record needs review." : "Confirm only after reviewing your consultation record.")</p>
                @if (Model.SuccessMessage != null)
                {
                    <div class="alert alert-success">@Model.SuccessMessage</div>
                }
                else
                {
                    @if (Model.ErrorMessage != null)
                    {
                        <div class="alert alert-danger">@Model.ErrorMessage</div>
                    }
                    <form method="post">
                        <input asp-for="Token" type="hidden" />
                        <input asp-for="Action" type="hidden" />
                        @if (isDispute)
                        {
                            <label asp-for="Reason" class="form-label fw-semibold">Reason for review</label>
                            <textarea asp-for="Reason" class="form-control mb-4" rows="4" maxlength="2000" required placeholder="Describe the issue clearly."></textarea>
                        }
                        <button type="submit" class="btn @(isDispute ? "btn-outline-danger" : "btn-success")">@(isDispute ? "Submit dispute" : "Confirm completion")</button>
                    </form>
                }
            </div>
        </div>
    </div>
</section>
