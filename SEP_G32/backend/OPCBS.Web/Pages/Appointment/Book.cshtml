@page "{doctorId:guid?}"
@model OPCBS.Web.Pages.Appointment.BookModel
@{
    ViewData["Title"] = "Book Appointment";
    var today = DateTime.Today;
    var dayNames = new[] { "CN", "T2", "T3", "T4", "T5", "T6", "T7" };
    var dayNamesEn = new[] { "SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT" };
    var prevWeek = Model.WeekStart.AddDays(-7).ToString("yyyy-MM-dd");
    var nextWeek = Model.WeekStart.AddDays(7).ToString("yyyy-MM-dd");
    var weekNumber = System.Globalization.CultureInfo.InvariantCulture.Calendar.GetWeekOfYear(Model.WeekStart, System.Globalization.CalendarWeekRule.FirstFourDayWeek, DayOfWeek.Monday);

    // Month calendar data
    var calMonth = Model.WeekStart;
    var firstOfMonth = new DateTime(calMonth.Year, calMonth.Month, 1);
    var daysInMonth = DateTime.DaysInMonth(calMonth.Year, calMonth.Month);
    var startDay = (int)firstOfMonth.DayOfWeek; // 0=Sun
}

<style>
    .mini-calendar {
        border-radius: 14px;
        padding: 1.15rem;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        box-shadow: 0 2px 10px rgba(15, 23, 42, 0.03);
    }
    .booking-doctor-card {
        border-radius: 14px;
        padding: 1.25rem;
        background: linear-gradient(135deg, #ffffff 0%, #f0fdfa 100%);
        border: 1px solid #ccfbf1;
        box-shadow: 0 4px 16px rgba(15, 118, 110, 0.04);
        position: relative;
    }
    .booking-doctor-card .doctor-avatar {
        width: 54px;
        height: 54px;
        border-radius: 12px;
        object-fit: cover;
        border: 2px solid #99f6e4;
        box-shadow: 0 2px 6px rgba(15, 118, 110, 0.1);
    }
    .booking-doctor-card .online-dot {
        width: 12px;
        height: 12px;
        background: #10b981;
        border: 2px solid #ffffff;
        border-radius: 50%;
        position: absolute;
        bottom: 0;
        right: 0;
        box-shadow: 0 0 6px rgba(16, 185, 129, 0.6);
    }
    .week-calendar {
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        overflow: hidden;
        background: #ffffff;
        box-shadow: 0 2px 12px rgba(15, 23, 42, 0.03);
    }
    .wc-nav {
        background: #fafbfc;
        border-bottom: 1px solid #e2e8f0;
        padding: 0.85rem 1.25rem;
    }
    .wc-slot.available {
        background: linear-gradient(135deg, #ecfdf5 0%, #f0fdfa 100%);
        border: 1px solid #a7f3d0;
        color: #065f46;
        box-shadow: 0 1px 3px rgba(13, 148, 136, 0.06);
        transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .wc-slot.available:hover {
        background: #d1fae5;
        border-color: #34d399;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);
    }
    .wc-slot.selected {
        background: linear-gradient(135deg, #0f766e 0%, #0d9488 100%) !important;
        color: #ffffff !important;
        border-color: #0f766e !important;
        box-shadow: 0 4px 14px rgba(15, 118, 110, 0.35) !important;
    }
    .wc-slot.selected .slot-label,
    .wc-slot.selected .slot-time,
    .wc-slot.selected .slot-mode-text {
        color: #ffffff !important;
    }
</style>

<div style="max-width:1200px;margin:0 auto;" class="py-3">
    @if (Model.Error != null)
    {
        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-1"></i>@Model.Error</div>
    }

    @if (Model.EndedTreatmentPackage != null)
    {
        var endedPkg = Model.EndedTreatmentPackage;
        <div class="alert border-0 shadow-sm mb-3" style="border-radius:14px; background:linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%); border-left:4px solid #f59e0b !important;">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:44px; height:44px; background:#f59e0b; color:white;">
                    <i class="bi bi-hourglass-split" style="font-size:1.2rem;"></i>
                </div>
                <div class="flex-grow-1">
                    <div style="font-weight:800; font-size:0.95rem; color:#92400e;">Your treatment package has ended</div>
                    <div style="font-size:0.82rem; color:#b45309;">
                        <strong>@endedPkg.Title</strong> has no remaining package sessions. This booking will be created as a regular appointment.
                    </div>
                    <div style="font-size:0.78rem; color:#d97706; margin-top:4px;">Ask your doctor to assign a new treatment package if you want to continue package-based sessions.</div>
                </div>
                <a asp-page="/Patient/TreatmentPackages/Details" asp-route-id="@endedPkg.Id" class="btn btn-outline-warning btn-sm" style="border-radius:10px;">
                    <i class="bi bi-eye me-1"></i>View Package
                </a>
            </div>
        </div>
    }

    @if (Model.TreatmentPackage != null)
    {
        var tPkg = Model.TreatmentPackage;

        @if (!Model.HasPackageButNotBookingVia)
        {
            @* Booking via package — show informational banner *@
            <div class="alert border-0 shadow-sm mb-3" style="border-radius:14px; background:linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border-left:4px solid var(--mb-primary) !important;">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:40px; height:40px; background:var(--mb-primary); color:white;">
                        <i class="bi bi-box-seam" style="font-size:1.1rem;"></i>
                    </div>
                    <div class="flex-grow-1">
                        <div style="font-weight:700; font-size:0.9rem; color:#166534;">Booking from treatment package: @tPkg.Title</div>
                        <div style="font-size:0.78rem; color:#4ade80;">Remaining: @tPkg.RemainingSessions / @tPkg.TotalSessions sessions &bull; Exp: @tPkg.ExpirationDate.ToString("MM/dd/yyyy")</div>
                    </div>
                    <a asp-page="/Patient/TreatmentPackages/Details" asp-route-id="@tPkg.Id" class="btn btn-sm btn-outline-success" style="border-radius:8px; font-size:0.75rem;">View Package</a>
                </div>
            </div>
        }
        else
        {
            @* Has active package but NOT booking via package — block booking *@
            <div class="alert border-0 shadow-sm mb-3" style="border-radius:14px; background:linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%); border-left:4px solid #f59e0b !important;">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:48px; height:48px; background:#f59e0b; color:white;">
                        <i class="bi bi-exclamation-triangle-fill" style="font-size:1.3rem;"></i>
                    </div>
                    <div class="flex-grow-1">
                        <div style="font-weight:700; font-size:0.95rem; color:#92400e;">You have an active treatment package with this doctor</div>
                        <div style="font-size:0.82rem; color:#b45309;">Package: <strong>@tPkg.Title</strong> — Remaining: <strong>@tPkg.RemainingSessions / @tPkg.TotalSessions</strong> sessions</div>
                        <div style="font-size:0.78rem; color:#d97706; margin-top:4px;">Please book your next appointment through your treatment package instead of booking separately.</div>
                    </div>
                </div>
                <div class="d-flex gap-2 mt-3">
                    <a asp-page="/Appointment/Book" asp-route-doctorId="@Model.DoctorId" asp-route-treatmentPackageId="@tPkg.Id" class="btn btn-warning btn-sm fw-semibold" style="border-radius:10px;">
                        <i class="bi bi-box-seam me-1"></i>Book via Package
                    </a>
                    <a asp-page="/Patient/TreatmentPackages/Details" asp-route-id="@tPkg.Id" class="btn btn-outline-warning btn-sm" style="border-radius:10px;">
                        <i class="bi bi-eye me-1"></i>View Package Details
                    </a>
                </div>
            </div>
        }
    }

    @if (!Model.DoctorId.HasValue)
    {
        <!-- No doctor selected -->
        <div class="text-center py-5">
            <i class="bi bi-search-heart d-block mb-3" style="font-size:3rem;color:var(--mb-primary);"></i>
            <h3>Select Therapist</h3>
            <p class="text-muted">Please select a doctor before booking</p>
            <a asp-page="/Doctors/Index" class="btn btn-primary btn-lg"><i class="bi bi-search me-1"></i>Find a Specialist</a>
        </div>
    }
    else if (Model.HasPackageButNotBookingVia)
    {
        @* Calendar is intentionally hidden — patient must book via package *@
    }
    else
    {
        <div class="d-flex flex-column flex-lg-row gap-4">
            <!-- SIDEBAR -->
            <aside style="width:320px;min-width:300px;" class="d-flex flex-column gap-3">
                <!-- Mini Month Calendar -->
                <div class="mini-calendar">
                    <div class="mc-header">
                        @{
                            var prevMonthWeek = Model.WeekStart.AddDays(-28).ToString("yyyy-MM-dd");
                            var nextMonthWeek = Model.WeekStart.AddDays(28).ToString("yyyy-MM-dd");
                        }
                        <a asp-page="Book" asp-route-doctorId="@Model.DoctorId" asp-route-week="@prevMonthWeek" asp-route-treatmentPackageId="@Model.TreatmentPackageId" asp-route-returning="@Model.Returning" class="btn btn-sm btn-link p-0 text-muted"><i class="bi bi-chevron-left"></i></a>
                        <span class="mc-title">@firstOfMonth.ToString("MMMM yyyy").ToUpper()</span>
                        <a asp-page="Book" asp-route-doctorId="@Model.DoctorId" asp-route-week="@nextMonthWeek" asp-route-treatmentPackageId="@Model.TreatmentPackageId" asp-route-returning="@Model.Returning" class="btn btn-sm btn-link p-0 text-muted"><i class="bi bi-chevron-right"></i></a>
                    </div>
                    <div class="mc-grid">
                        <div class="mc-day-header">S</div><div class="mc-day-header">M</div><div class="mc-day-header">T</div>
                        <div class="mc-day-header">W</div><div class="mc-day-header">T</div><div class="mc-day-header">F</div><div class="mc-day-header">S</div>

                        @* Fill empty cells before month start *@
                        @for (int i = 0; i < startDay; i++)
                        {
                            var prevDay = firstOfMonth.AddDays(-(startDay - i));
                            <div class="mc-day other-month">@prevDay.Day</div>
                        }
                        @for (int d = 1; d <= daysInMonth; d++)
                        {
                            var thisDay = new DateTime(calMonth.Year, calMonth.Month, d);
                            var isToday = thisDay.Date == today;
                            var isSelected = thisDay.Date >= Model.WeekStart && thisDay.Date <= Model.WeekEnd;
                            var dayWeekStr = thisDay.ToString("yyyy-MM-dd");
                            <a asp-page="Book" asp-route-doctorId="@Model.DoctorId" asp-route-week="@dayWeekStr" asp-route-treatmentPackageId="@Model.TreatmentPackageId" asp-route-returning="@Model.Returning" class="mc-day @(isToday ? "today" : "") @(isSelected ? "selected" : "")" style="text-decoration:none;color:inherit;">@d</a>
                        }
                    </div>
                </div>

                <!-- Doctor Profile Card -->
                @if (Model.Doctor != null)
                {
                    <div class="booking-doctor-card">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="position-relative">
                                @if (!string.IsNullOrEmpty(Model.Doctor.AvatarUrl))
                                {
                                    <img src="@Model.Doctor.AvatarUrl" class="doctor-avatar" alt="@Model.Doctor.FullName" />
                                }
                                else
                                {
                                    var initial = !string.IsNullOrEmpty(Model.Doctor.FullName) ? Model.Doctor.FullName.Substring(0, 1).ToUpper() : "D";
                                    <div class="doctor-avatar d-flex align-items-center justify-content-center" style="background:var(--mb-primary-light);color:var(--mb-primary);font-weight:700;font-size:1.2rem;">
                                        @initial
                                    </div>
                                }
                                <div class="online-dot" title="Active Specialist"></div>
                            </div>
                            <div class="flex-grow-1 overflow-hidden">
                                <div class="d-flex align-items-center gap-1">
                                    <h6 class="mb-0 text-truncate" style="font-weight:750; color:#0f172a;">@Model.Doctor.FullName</h6>
                                    <i class="bi bi-patch-check-fill text-primary" style="font-size:0.9rem;" title="Verified Specialist"></i>
                                </div>
                                <small class="text-muted d-block text-truncate">@(Model.Doctor.Specialization ?? "Clinical Specialist")</small>
                                @if (Model.Doctor.Rating > 0)
                                {
                                    <div class="d-flex align-items-center gap-1 mt-1">
                                        <i class="bi bi-star-fill text-warning" style="font-size:0.75rem;"></i>
                                        <span class="small fw-bold text-dark" style="font-size:0.8rem;">@Model.Doctor.Rating.ToString("F1")</span>
                                        <span class="text-muted" style="font-size:0.75rem;">(@Model.Doctor.ReviewCount reviews)</span>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Doctor Contact Information -->
                        <div class="border-top pt-2.5 mt-2" style="border-color: rgba(226, 232, 240, 0.8) !important;">
                            <div class="text-uppercase text-muted fw-bold mb-2" style="font-size:0.68rem; letter-spacing:0.05em;">Contact Information</div>
                            
                            @if (!string.IsNullOrWhiteSpace(Model.Doctor.PhoneNumber))
                            {
                                <div class="d-flex align-items-center gap-2 mb-1.5" style="font-size:0.825rem;">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:24px; height:24px; background:rgba(13, 148, 136, 0.1); color:#0d9488;">
                                        <i class="bi bi-telephone-fill" style="font-size:0.75rem;"></i>
                                    </div>
                                    <a href="tel:@Model.Doctor.PhoneNumber" class="text-decoration-none fw-medium text-dark text-truncate" title="Call Specialist">
                                        @Model.Doctor.PhoneNumber
                                    </a>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(Model.Doctor.Email))
                            {
                                <div class="d-flex align-items-center gap-2 mb-1.5" style="font-size:0.825rem;">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:24px; height:24px; background:rgba(13, 148, 136, 0.1); color:#0d9488;">
                                        <i class="bi bi-envelope-fill" style="font-size:0.75rem;"></i>
                                    </div>
                                    <a href="mailto:@Model.Doctor.Email" class="text-decoration-none fw-medium text-dark text-truncate" title="Email Specialist">
                                        @Model.Doctor.Email
                                    </a>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(Model.Doctor.Address))
                            {
                                <div class="d-flex align-items-start gap-2 mb-1.5" style="font-size:0.825rem;">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 mt-0.5" style="width:24px; height:24px; background:rgba(13, 148, 136, 0.1); color:#0d9488;">
                                        <i class="bi bi-geo-alt-fill" style="font-size:0.75rem;"></i>
                                    </div>
                                    <span class="text-muted" style="line-height:1.35;" title="Clinic Address">
                                        @Model.Doctor.Address
                                    </span>
                                </div>
                            }

                            @if (Model.Doctor.ConsultationFee > 0)
                            {
                                <div class="d-flex align-items-center justify-content-between pt-2 mt-2 border-top" style="border-color: rgba(226, 232, 240, 0.6) !important; font-size:0.825rem;">
                                    <span class="text-muted">Consultation Fee</span>
                                    <span class="fw-bold" style="color:#0d9488;">@Model.Doctor.ConsultationFee.ToString("N0") VND</span>
                                </div>
                            }
                        </div>

                        <!-- Selected slot info (updated by JS) -->
                        <div id="selectedSlotInfo" class="border-top pt-3 mt-2" style="display:none; border-color: rgba(226, 232, 240, 0.8) !important;">
                            <div class="d-flex align-items-center gap-2 mb-2 text-muted">
                                <i class="bi bi-calendar-event" style="color:var(--mb-primary);"></i>
                                <span id="selectedDate" class="small fw-medium">—</span>
                            </div>
                            <div class="d-flex align-items-center gap-2 mb-2 text-muted">
                                <i class="bi bi-clock" style="color:var(--mb-primary);"></i>
                                <span id="selectedTime" class="small fw-medium">—</span>
                            </div>
                            <span class="badge bg-success"><i class="bi bi-check2 me-1"></i>Slot Selected</span>
                        </div>

                        <div class="mt-3 pt-2 text-center border-top" style="border-color: rgba(226, 232, 240, 0.6) !important;">
                            <a asp-page="/Doctors/Details" asp-route-id="@Model.Doctor.Id" target="_blank" class="small text-decoration-none fw-semibold" style="color:#0d9488; font-size:0.8rem;">
                                View Full Profile <i class="bi bi-box-arrow-up-right ms-1" style="font-size:0.75rem;"></i>
                            </a>
                        </div>
                    </div>
                }

                <!-- Legend -->
                <div class="px-2">
                    <div class="wc-legend flex-column">
                        <div class="wc-legend-item"><div class="legend-dot" style="background:var(--mb-primary-light);border:1px solid rgba(78,139,112,0.25);"></div>Available</div>
                        <div class="wc-legend-item"><div class="legend-dot" style="background:#f0f0f0;border:1px solid #ddd;"></div>Booked</div>
                        <div class="wc-legend-item"><i class="bi bi-camera-video" style="color:var(--mb-primary);"></i>Online</div>
                        <div class="wc-legend-item"><i class="bi bi-geo-alt" style="color:#2563eb;"></i>In-person</div>
                    </div>
                </div>
            </aside>

            <!-- MAIN CALENDAR -->
            <section class="flex-grow-1">
                <div class="week-calendar shadow-sm">
                    <!-- Week nav -->
                    <div class="wc-nav">
                        <div class="d-flex align-items-center gap-2">
                            <div class="btn-group btn-group-sm">
                                <a asp-page="Book" asp-route-doctorId="@Model.DoctorId" asp-route-week="@prevWeek" asp-route-treatmentPackageId="@Model.TreatmentPackageId" asp-route-returning="@Model.Returning" class="btn btn-outline-secondary"><i class="bi bi-chevron-left"></i></a>
                                <a asp-page="Book" asp-route-doctorId="@Model.DoctorId" asp-route-week="@nextWeek" asp-route-treatmentPackageId="@Model.TreatmentPackageId" asp-route-returning="@Model.Returning" class="btn btn-outline-secondary"><i class="bi bi-chevron-right"></i></a>
                            </div>
                        </div>
                        <span class="wc-title">@Model.WeekStart.ToString("MMM dd") — @Model.WeekEnd.ToString("MMM dd, yyyy")</span>
                        <span class="wc-badge">Week @weekNumber</span>
                        <div class="ms-auto wc-view-toggle">
                            <button class="btn active">Week</button>
                        </div>
                    </div>

                    <!-- Day headers -->
                    <div class="week-calendar-header">
                        <div class="wc-time-col"></div>
                        @foreach (var day in Model.WeekDays)
                        {
                            var isToday = day.Date == today;
                            <div class="wc-day-col @(isToday ? "today" : "")">
                                <div class="wc-day-name">@dayNamesEn[(int)day.DayOfWeek]</div>
                                <div class="wc-day-num">@day.Day</div>
                            </div>
                        }
                    </div>

                    <!-- Time grid -->
                    <div class="week-calendar-body">
                        @for (int hour = Model.CalStartHour; hour <= Model.CalEndHour; hour++)
                        {
                            <div class="wc-time-row">
                                <div class="wc-time-label">@hour.ToString("00"):00</div>
                                @foreach (var day in Model.WeekDays)
                                {
                                    var isToday = day.Date == today;
                                    var dayKey = day.ToString("yyyy-MM-dd");
                                    var slots = Model.SlotGrid.GetValueOrDefault(dayKey)?.GetValueOrDefault(hour);

                                    <div class="wc-time-cell @(isToday ? "today-col" : "")">
                                        @if (slots != null)
                                        {
                                            foreach (var slot in slots)
                                            {
                                                var isAvailable = slot.Status == 0; // 0 = Available
                                                var isBooked = slot.Status == 1;    // 1 = Booked
                                                var cssClass = isAvailable ? "available" : "full";
                                                var dateDisplay = day.ToString("MM/dd/yyyy");
                                                <div class="wc-slot @cssClass"
                                                     style="top:2px;height:56px;@(isBooked ? "opacity:0.6;cursor:not-allowed;" : "")"
                                                     @Html.Raw(isAvailable ? "data-bs-toggle=\"modal\" data-bs-target=\"#bookingModal\"" : "")
                                                     data-slot-id="@slot.Id"
                                                     data-slot-date="@dateDisplay"
                                                     data-slot-time="@slot.StartTime - @slot.EndTime"
                                                     data-slot-mode="@((int)slot.ConsultationMode)"
                                                     data-slot-mode-text="@(slot.ConsultationMode == OPCBS.Domain.Enums.ConsultationMode.Online ? "Online Consultation" : slot.ConsultationMode == OPCBS.Domain.Enums.ConsultationMode.Offline ? "In-Person (Offline)" : "Both Online & In-Person")"
                                                     data-slot-note-req="@(slot.IsPreAppointmentNoteRequired ? "true" : "false")"
                                                     data-slot-note-title="@(slot.PreAppointmentNoteTitle ?? "")"
                                                     @Html.Raw(isAvailable ? "onclick=\"fillSlotData(this)\"" : "")
                                                     title="@(isAvailable ? $"Available - {slot.StartTime} - {slot.EndTime} ({(slot.ConsultationMode == OPCBS.Domain.Enums.ConsultationMode.Online ? "Online" : slot.ConsultationMode == OPCBS.Domain.Enums.ConsultationMode.Offline ? "In-Person" : "Online/In-Person")})" : $"Booked - {slot.StartTime} - {slot.EndTime}")">
                                                    @if (isBooked)
                                                    {
                                                        <span class="slot-label"><i class="bi bi-lock-fill me-1"></i>BOOKED</span>
                                                    }
                                                    else
                                                    {
                                                        var modeShortText = slot.ConsultationMode == OPCBS.Domain.Enums.ConsultationMode.Online
                                                            ? "Online"
                                                            : slot.ConsultationMode == OPCBS.Domain.Enums.ConsultationMode.Offline
                                                                ? "In-person"
                                                                : "Online / In-person";
                                                        <span class="slot-label">
                                                            @if (slot.ConsultationMode == OPCBS.Domain.Enums.ConsultationMode.Online)
                                                            {
                                                                <i class="bi bi-camera-video me-1" title="Online consultation"></i><span>ONLINE</span>
                                                            }
                                                            else if (slot.ConsultationMode == OPCBS.Domain.Enums.ConsultationMode.Offline)
                                                            {
                                                                <i class="bi bi-geo-alt me-1" title="In-person consultation"></i><span>IN-PERSON</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="slot-label-both">Online / In-person</span>
                                                            }
                                                        </span>
                                                        @if (slot.ConsultationMode != OPCBS.Domain.Enums.ConsultationMode.Both)
                                                        {
                                                            <span class="slot-mode-text">@modeShortText</span>
                                                        }
                                                    }
                                                    <span class="slot-time">@slot.StartTime - @slot.EndTime</span>
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        }

                        @if (!Model.SlotGrid.Any())
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-calendar-x d-block mb-2" style="font-size:2rem;"></i>
                                <p>No available slots this week</p>
                            </div>
                        }
                    </div>
                </div>
            </section>
        </div>
    }
</div>

<!-- Booking Modal -->
<div class="modal fade" id="bookingModal" tabindex="-1" aria-labelledby="bookingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border-radius:20px;border:none;overflow:hidden;">
            <div class="modal-header border-0 pb-0" style="background:linear-gradient(135deg, #f0f7f3 0%, #e8f5ee 100%);padding:24px 28px 16px;">
                <div>
                    <h4 class="modal-title fw-bold" id="bookingModalLabel" style="color:var(--mb-primary);">
                        <i class="bi bi-calendar-check me-2"></i>Confirm Booking
                    </h4>
                    <p class="text-muted mb-0 mt-1" style="font-size:0.875rem;">Review the information and fill in the form below</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="padding:24px 28px;">
                <!-- Appointment Summary -->
                <div class="p-3 rounded-3 mb-4" style="background:#f0f7f3;border:1px solid #d0e5d8;">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="text-uppercase small text-muted fw-semibold" style="letter-spacing:0.05em;font-size:0.7rem;">DOCTOR</div>
                            <div class="fw-bold mt-1" style="color:var(--mb-primary);">@(Model.Doctor?.FullName ?? "—")</div>
                        </div>
                        <div class="col-md-4">
                            <div class="text-uppercase small text-muted fw-semibold" style="letter-spacing:0.05em;font-size:0.7rem;">DATE</div>
                            <div class="fw-semibold mt-1" id="modalDate">—</div>
                        </div>
                        <div class="col-md-4">
                            <div class="text-uppercase small text-muted fw-semibold" style="letter-spacing:0.05em;font-size:0.7rem;">TIME</div>
                            <div class="fw-semibold mt-1" id="modalTime">—</div>
                        </div>
                    </div>
                </div>

                <!-- Patient Form -->
                <h6 class="fw-bold mb-3"><i class="bi bi-person-lines-fill me-2" style="color:var(--mb-primary);"></i>Patient Information</h6>
                <form method="post" id="bookingForm">
                    <input type="hidden" asp-for="Input.DoctorId" />
                    <input type="hidden" asp-for="Input.AppointmentSlotId" id="slotIdInput" />
                    <input type="hidden" asp-for="Input.TreatmentPackageId" />
                    <input type="hidden" asp-for="SelectedDate" id="selectedDateInput" />
                    <input type="hidden" asp-for="SelectedTime" id="selectedTimeInput" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase fw-semibold text-muted" style="letter-spacing:0.03em;">FULL NAME <span class="text-danger">*</span></label>
                            <input asp-for="Input.GuestName" class="form-control @(Model.IsReturningPatient ? "bg-light" : "")" placeholder="e.g. John Doe" style="border-radius:12px;padding:10px 14px;" required readonly="@(Model.IsReturningPatient ? "readonly" : null)" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase fw-semibold text-muted" style="letter-spacing:0.03em;">EMAIL <span class="text-danger">*</span></label>
                            <input asp-for="Input.GuestEmail" type="email" class="form-control @(Model.IsReturningPatient ? "bg-light" : "")" placeholder="email@example.com" style="border-radius:12px;padding:10px 14px;" required readonly="@(Model.IsReturningPatient ? "readonly" : null)" />
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase fw-semibold text-muted" style="letter-spacing:0.03em;">PHONE NUMBER</label>
                            <input asp-for="Input.GuestPhoneNumber" id="guestPhoneInput" type="tel" class="form-control @(Model.IsReturningPatient ? "bg-light" : "")" placeholder="+84 xxx xxx xxx" style="border-radius:12px;padding:10px 14px;" readonly="@(Model.IsReturningPatient ? "readonly" : null)" />
                            @if (Model.IsReturningPatient)
                            {
                                <div class="form-text text-muted small mt-1"><i class="bi bi-lock-fill text-secondary me-1"></i>Contact information is locked for follow-up visits with this doctor.</div>
                            }
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase fw-semibold text-muted" style="letter-spacing:0.03em;">ZALO NUMBER</label>
                            <input asp-for="Input.GuestZaloNumber" id="guestZaloInput" type="tel" class="form-control @(Model.IsReturningPatient ? "bg-light" : "")" placeholder="+84 xxx xxx xxx" style="border-radius:12px;padding:10px 14px;" readonly="@(Model.IsReturningPatient ? "readonly" : null)" />
                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" id="sameAsPhoneCheck" @(Model.IsReturningPatient ? "checked disabled" : "") />
                                <label class="form-check-label small text-muted" for="sameAsPhoneCheck">Same as phone number</label>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Consultation Mode <span class="text-danger">*</span></label>
                            <select asp-for="Input.ConsultationMode" id="bookingConsultationMode" class="form-select" style="border-radius:12px;padding:10px 14px;" required>
                                <option value="Online">Online Consultation</option>
                                <option value="Offline">In-Person (Offline)</option>
                            </select>
                            <div id="consultationModeNotice" class="form-text small mt-1 text-muted"></div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Patient Address</label>
                            <input asp-for="Input.PatientAddress" class="form-control" placeholder="e.g. 123 Nguyen Hue, District 1, Ho Chi Minh City" style="border-radius:12px;padding:10px 14px;" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small text-uppercase fw-semibold text-muted" style="letter-spacing:0.03em;">REASON FOR VISIT</label>
                        <textarea asp-for="Input.Notes" class="form-control" rows="3" placeholder="Brief description of your condition or reason for consultation..." style="border-radius:12px;padding:10px 14px;resize:vertical;"></textarea>
                    </div>

                    <!-- Pre-Evaluation Form -->
                    @if (Model.IsReturningPatient)
                    {
                        <hr style="border-color:#e2e8f0; margin:1rem 0;" />
                        <div class="d-flex align-items-start gap-3 p-3 rounded-3 mb-3" style="background:linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); border:1px solid rgba(59,130,246,0.15);">
                            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:40px; height:40px; background:#3b82f6; color:white;">
                                <i class="bi bi-arrow-repeat" style="font-size:1.1rem;"></i>
                            </div>
                            <div>
                                <div style="font-weight:700; font-size:0.88rem; color:#1e40af;">Welcome back!</div>
                                <div style="font-size:0.78rem; color:#3b82f6;">You've visited this doctor before. Pre-appointment evaluation is not required for follow-up visits.</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <hr style="border-color:#e2e8f0; margin:1rem 0;" />
                        <h6 class="fw-bold mb-3"><i class="bi bi-clipboard2-pulse me-2" style="color:var(--mb-primary);"></i>Pre-Appointment Evaluation</h6>
                        <p class="text-muted mb-3" style="font-size:0.8rem;">Please fill in to help the doctor prepare for your consultation.</p>

                        <div class="mb-3">
                            <label class="form-label small text-uppercase fw-semibold text-muted" style="letter-spacing:0.03em;">CURRENT SYMPTOMS</label>
                            <textarea asp-for="Input.Symptoms" class="form-control" rows="3" placeholder="Describe your current symptoms, their duration, and severity..." style="border-radius:12px;padding:10px 14px;resize:vertical;"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small text-uppercase fw-semibold text-muted" style="letter-spacing:0.03em;">MEDICAL HISTORY</label>
                            <textarea asp-for="Input.MedicalHistory" class="form-control" rows="2" placeholder="Past treatments, medications, diagnosed conditions..." style="border-radius:12px;padding:10px 14px;resize:vertical;"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small text-uppercase fw-semibold text-muted" style="letter-spacing:0.03em;">EXPECTATIONS FOR THIS SESSION</label>
                            <textarea asp-for="Input.Expectations" class="form-control" rows="2" placeholder="What do you hope to achieve from this consultation?" style="border-radius:12px;padding:10px 14px;resize:vertical;"></textarea>
                        </div>
                    }

                    <!-- Slot Custom Question / Doctor's Required Evaluation -->
                    <div id="slotCustomNoteSection" class="mb-3" style="display:none;">
                        <div class="p-3 rounded-3 border" style="background:#f0fdfa; border-color:#ccfbf1 !important;">
                            <label id="slotCustomNoteLabel" class="form-label small text-uppercase fw-bold text-dark d-flex align-items-center gap-1.5" style="letter-spacing:0.03em; font-size:0.8rem; color:#0f766e !important;"></label>
                            <input type="hidden" id="slotCustomNoteTitleInput" disabled />
                            <input type="hidden" id="slotCustomNoteSectionKeyInput" value="PreAppointmentEvaluation" disabled />
                            <textarea id="slotCustomNoteContent" class="form-control" rows="2" placeholder="Your response to the doctor's inquiry..." style="border-radius:10px; resize:vertical; font-size:0.875rem;" disabled></textarea>
                        </div>
                    </div>

                    <!-- Privacy note -->
                    <div class="d-flex align-items-start gap-2 p-3 rounded-3 mb-3" style="background:#f8faf8;">
                        <i class="bi bi-shield-check" style="color:var(--mb-primary);font-size:1.2rem;margin-top:2px;"></i>
                        <small class="text-muted">Your information is confidential and shared only with the consulting doctor.</small>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal" style="border-radius:12px;">Cancel</button>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold d-flex align-items-center gap-2" id="confirmBtn" style="border-radius:12px;">
                            <i class="bi bi-check-circle"></i>Confirm Booking
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function setSlotCustomFieldEnabled(enabled) {
            const titleInput = document.getElementById('slotCustomNoteTitleInput');
            const sectionInput = document.getElementById('slotCustomNoteSectionKeyInput');
            const contentInput = document.getElementById('slotCustomNoteContent');

            if (titleInput && sectionInput && contentInput) {
                [titleInput, sectionInput, contentInput].forEach(input => input.disabled = !enabled);

                if (enabled) {
                    titleInput.name = 'Input.CustomFields[0].Title';
                    sectionInput.name = 'Input.CustomFields[0].SectionKey';
                    contentInput.name = 'Input.CustomFields[0].Content';
                } else {
                    titleInput.removeAttribute('name');
                    sectionInput.removeAttribute('name');
                    contentInput.removeAttribute('name');
                }
            }
        }

        function syncZaloWithPhone() {
            const sameAsPhone = document.getElementById('sameAsPhoneCheck');
            const phoneInput = document.getElementById('guestPhoneInput');
            const zaloInput = document.getElementById('guestZaloInput');
            if (!sameAsPhone || !phoneInput || !zaloInput) return;

            if (sameAsPhone.checked) {
                zaloInput.value = phoneInput.value;
                if (!zaloInput.hasAttribute('readonly')) {
                    zaloInput.readOnly = true;
                    zaloInput.classList.add('bg-light');
                }
            } else if (!sameAsPhone.disabled) {
                zaloInput.readOnly = false;
                zaloInput.classList.remove('bg-light');
            }
        }

        function fillSlotData(el) {
            var slotId = el.getAttribute('data-slot-id');
            var dateText = el.getAttribute('data-slot-date');
            var timeText = el.getAttribute('data-slot-time');
            var mode = el.getAttribute('data-slot-mode');
            var noteReq = el.getAttribute('data-slot-note-req') === 'true';
            var noteTitle = el.getAttribute('data-slot-note-title');

            // Update hidden inputs
            document.getElementById('slotIdInput').value = slotId;
            document.getElementById('selectedDateInput').value = dateText;
            document.getElementById('selectedTimeInput').value = timeText;
            
            // Show info in sidebar
            var slotInfo = document.getElementById('selectedSlotInfo');
            if(slotInfo) slotInfo.style.display = '';
            var selectedDateEl = document.getElementById('selectedDate');
            if(selectedDateEl) selectedDateEl.textContent = dateText;
            var selectedTimeEl = document.getElementById('selectedTime');
            if(selectedTimeEl) selectedTimeEl.textContent = timeText;
            
            // Update modal summary
            var modalDateEl = document.getElementById('modalDate');
            if(modalDateEl) modalDateEl.textContent = dateText;
            var modalTimeEl = document.getElementById('modalTime');
            if(modalTimeEl) modalTimeEl.textContent = timeText;

            // Configure consultation mode options
            var modeSelect = document.getElementById('bookingConsultationMode');
            var modeNotice = document.getElementById('consultationModeNotice');
            if (modeSelect) {
                modeSelect.innerHTML = '';
                if (mode === '0' || mode === 'Online') {
                    modeSelect.innerHTML = '<option value="Online" selected>Online Consultation</option>';
                    if (modeNotice) modeNotice.textContent = 'This slot is available for Online consultation only.';
                } else if (mode === '1' || mode === 'Offline') {
                    modeSelect.innerHTML = '<option value="Offline" selected>In-Person (Offline) Consultation</option>';
                    if (modeNotice) modeNotice.textContent = 'This slot is available for In-Person (Offline) consultation only.';
                } else {
                    modeSelect.innerHTML = '<option value="Online" selected>Online Consultation</option><option value="Offline">In-Person (Offline) Consultation</option>';
                    if (modeNotice) modeNotice.textContent = 'Doctor allows both Online and In-Person consultations for this slot.';
                }
            }

            // Configure slot custom pre-appointment note / doctor question
            var slotNoteSec = document.getElementById('slotCustomNoteSection');
            var slotNoteLabel = document.getElementById('slotCustomNoteLabel');
            var slotNoteTitleInput = document.getElementById('slotCustomNoteTitleInput');
            var slotNoteSectionKeyInput = document.getElementById('slotCustomNoteSectionKeyInput');
            var slotNoteContent = document.getElementById('slotCustomNoteContent');

            if (slotNoteSec && slotNoteLabel && slotNoteTitleInput && slotNoteSectionKeyInput && slotNoteContent) {
                if (noteTitle && noteTitle.trim() !== '') {
                    slotNoteSec.style.display = 'block';
                    slotNoteTitleInput.value = noteTitle.trim();
                    slotNoteSectionKeyInput.value = 'PreAppointmentEvaluation';
                    slotNoteLabel.innerHTML = '<i class="bi bi-patch-question me-1" style="color:#0f766e;"></i>' + noteTitle.trim() + (noteReq ? ' <span class="text-danger">*</span>' : ' <span class="text-muted fw-normal small">(Optional)</span>');
                    slotNoteContent.required = noteReq;
                    setSlotCustomFieldEnabled(true);
                } else if (noteReq) {
                    slotNoteSec.style.display = 'block';
                    slotNoteTitleInput.value = 'Pre-Appointment Evaluation Note';
                    slotNoteSectionKeyInput.value = 'PreAppointmentEvaluation';
                    slotNoteLabel.innerHTML = '<i class="bi bi-patch-question me-1" style="color:#0f766e;"></i>Doctor\'s Required Evaluation Note <span class="text-danger">*</span>';
                    slotNoteContent.required = true;
                    setSlotCustomFieldEnabled(true);
                } else {
                    slotNoteSec.style.display = 'none';
                    slotNoteTitleInput.value = '';
                    slotNoteSectionKeyInput.value = 'PreAppointmentEvaluation';
                    slotNoteContent.value = '';
                    slotNoteContent.required = false;
                    setSlotCustomFieldEnabled(false);
                }
            }
            
            // Highlight selected slot
            document.querySelectorAll('.wc-slot').forEach(s => s.classList.remove('selected'));
            el.classList.add('selected');
        }

        document.addEventListener('DOMContentLoaded', function () {
            const sameAsPhone = document.getElementById('sameAsPhoneCheck');
            const phoneInput = document.getElementById('guestPhoneInput');

            if (sameAsPhone) {
                sameAsPhone.addEventListener('change', syncZaloWithPhone);
            }

            if (phoneInput) {
                phoneInput.addEventListener('input', function () {
                    const sameAsPhone = document.getElementById('sameAsPhoneCheck');
                    if (sameAsPhone?.checked) syncZaloWithPhone();
                });
            }

            syncZaloWithPhone();
        });
    </script>
}
