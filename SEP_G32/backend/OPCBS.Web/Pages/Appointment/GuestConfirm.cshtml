@page
@model OPCBS.Web.Pages.Appointment.GuestConfirmModel
@{
    ViewData["Title"] = "Confirm Appointment";
}

<section class="py-5">
    <div class="container" style="max-width: 620px;">
        <div class="card border-0 shadow-sm" style="border-radius: 12px;">
            <div class="card-body p-4 p-md-5 text-center">
                <div class="d-inline-flex align-items-center justify-content-center mb-3" style="width:56px;height:56px;border-radius:50%;background:#e8f5f1;color:#278b79;">
                    <i class="bi bi-envelope-check fs-3"></i>
                </div>
                <h1 class="h3 fw-bold mb-2">Confirm your appointment</h1>
                <p class="text-muted mb-4">Confirm your email booking before the doctor reviews the appointment request.</p>

                @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
                {
                    <div class="alert alert-success text-start" role="alert">@Model.SuccessMessage</div>
                    <a asp-page="/Appointment/Track" class="btn btn-outline-success">Track appointment</a>
                }
                else if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="alert alert-danger text-start" role="alert">@Model.ErrorMessage</div>
                    <a asp-page="/Appointment/Track" class="btn btn-outline-secondary">Track appointment</a>
                }
                else
                {
                    <form method="post">
                        <input asp-for="Token" type="hidden" />
                        <button type="submit" class="btn btn-success px-4">
                            <i class="bi bi-check-circle me-2"></i>Confirm appointment
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</section>
