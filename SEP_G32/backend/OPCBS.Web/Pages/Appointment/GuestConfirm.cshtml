@page
@model OPCBS.Web.Pages.Appointment.GuestConfirmModel
@{
    ViewData["Title"] = "Confirm Appointment";
}

<section class="py-5">
    <div class="container" style="max-width: 580px;">
        <div class="card border shadow-sm" style="border-radius: 8px; border-color: #e2e8f0;">
            <div class="card-body p-4 p-md-5 text-center">
                <div class="d-inline-flex align-items-center justify-content-center mb-3" style="width:52px; height:52px; border-radius:8px; background:#ccfbf1; color:#0f766e;">
                    <i class="bi bi-envelope-check fs-3"></i>
                </div>
                <h1 class="h4 fw-bold mb-2 text-dark">Confirm Your Appointment</h1>
                <p class="text-muted small mb-4">Confirm your booking request so your doctor can review and schedule your consultation session.</p>

                @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
                {
                    <div class="alert alert-success text-start d-flex align-items-start gap-2 mb-3" style="border-radius:8px; font-size:0.88rem;" role="alert">
                        <i class="bi bi-check-circle-fill text-success fs-5 flex-shrink-0"></i>
                        <div>@Model.SuccessMessage</div>
                    </div>
                    <a asp-page="/Appointment/Track" class="btn btn-primary w-100" style="background:#0f766e; border-color:#0f766e; border-radius:8px; font-weight:600; min-height:42px; display:flex; align-items:center; justify-content:center;">
                        <i class="bi bi-search me-1.5"></i>Track Your Appointment
                    </a>
                }
                else if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <div class="alert alert-danger text-start d-flex align-items-start gap-2 mb-3" style="border-radius:8px; font-size:0.88rem;" role="alert">
                        <i class="bi bi-exclamation-triangle-fill text-danger fs-5 flex-shrink-0"></i>
                        <div>@Model.ErrorMessage</div>
                    </div>
                    <a asp-page="/Appointment/Track" class="btn btn-outline-secondary w-100" style="border-radius:8px; font-weight:600; min-height:40px; display:flex; align-items:center; justify-content:center;">
                        <i class="bi bi-search me-1.5"></i>Go to Track Appointment
                    </a>
                }
                else
                {
                    <form method="post">
                        <input asp-for="Token" type="hidden" />
                        <button type="submit" class="btn btn-primary w-100" style="background:#0f766e; border-color:#0f766e; border-radius:8px; font-weight:600; min-height:42px; display:flex; align-items:center; justify-content:center;">
                            <i class="bi bi-check-circle me-2"></i>Confirm Appointment
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</section>
