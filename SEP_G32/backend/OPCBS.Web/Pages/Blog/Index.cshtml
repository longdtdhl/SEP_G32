@page
@model OPCBS.Web.Pages.Blog.IndexModel
@{
    ViewData["Title"] = "Mental Health Resources";
    ViewData["UseDashboardLayout"] = false;

    var currentCat = Model.Filter.Category ?? "";
    var hasSearchOrCat = !string.IsNullOrWhiteSpace(Model.Filter.Search) || !string.IsNullOrWhiteSpace(Model.Filter.Category);
    
    var isFirstPage = Model.Pagination == null || Model.Pagination.Page <= 1;
    var hasBlogs = Model.Blogs != null && Model.Blogs.Any();
    var featuredBlog = (hasBlogs && isFirstPage && !hasSearchOrCat) ? Model.Blogs.FirstOrDefault() : null;
    var gridBlogs = featuredBlog != null ? Model.Blogs.Skip(1).ToList() : (Model.Blogs ?? new List<OPCBS.Web.DTOs.BlogListItemDto>());

    var categories = new[] {
        ("", "All Topics", "bi-grid-fill"),
        ("Mental Health", "Mental Health", "bi-heart-pulse"),
        ("Depression", "Depression", "bi-cloud-rain"),
        ("Anxiety", "Anxiety", "bi-emoji-neutral"),
        ("Stress", "Stress & Burnout", "bi-lightning-charge"),
        ("Relationships", "Relationships", "bi-people"),
        ("Children & Adolescents", "Children & Youth", "bi-person-badge"),
        ("Self-care", "Self-Care", "bi-flower1")
    };
}

<style>
    .blog-hub-wrapper {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0.5rem 0.5rem 4rem;
    }

    /* ─── Compact Editorial Header ─── */
    .blog-hero-header {
        background: rgba(255, 255, 255, 0.76);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        border: 1px solid rgba(255, 255, 255, 0.85);
        border-radius: 18px;
        padding: 2.25rem 2rem;
        margin-bottom: 1.75rem;
        box-shadow: 0 8px 32px rgba(15, 118, 110, 0.05), 0 1px 3px rgba(0, 0, 0, 0.02);
        text-align: center;
        position: relative;
    }

    .blog-hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(13, 148, 136, 0.08);
        border: 1px solid rgba(13, 148, 136, 0.2);
        color: #0f766e;
        font-size: 0.76rem;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        padding: 4px 14px;
        border-radius: 20px;
        margin-bottom: 0.85rem;
    }

    .blog-hero-title {
        font-size: 2.1rem;
        font-weight: 850;
        letter-spacing: -0.025em;
        margin-bottom: 0.45rem;
        line-height: 1.25;
        background: linear-gradient(135deg, #0f172a 20%, #0d9488 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .blog-hero-sub {
        font-size: 0.95rem;
        color: #64748b;
        max-width: 640px;
        margin: 0 auto 1.6rem;
        line-height: 1.6;
    }

    /* Search Bar Inside Header */
    .blog-search-wrap {
        max-width: 540px;
        margin: 0 auto;
        position: relative;
    }
    .blog-search-input {
        height: 48px;
        padding-left: 44px;
        padding-right: 105px;
        border-radius: 12px;
        border: 1px solid rgba(203, 213, 225, 0.8);
        font-size: 0.9rem;
        background: rgba(255, 255, 255, 0.85);
        color: #0f172a;
        transition: all 0.18s ease;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
    }
    .blog-search-input:focus {
        background: #ffffff;
        border-color: var(--mb-primary);
        box-shadow: 0 0 0 3px rgba(13, 148, 136, 0.14);
        outline: none;
    }
    .blog-search-icon {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        font-size: 1rem;
        pointer-events: none;
    }
    .blog-search-btn {
        position: absolute;
        right: 5px;
        top: 5px;
        bottom: 5px;
        padding: 0 1.25rem;
        border-radius: 9px;
        background: var(--mb-primary);
        color: #ffffff;
        border: none;
        font-weight: 650;
        font-size: 0.86rem;
        transition: all 0.18s cubic-bezier(0.2, 0.8, 0.2, 1);
        box-shadow: 0 2px 6px rgba(13, 148, 136, 0.25);
    }
    .blog-search-btn:hover {
        background: var(--mb-primary-hover);
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(13, 148, 136, 0.35);
    }
    .blog-search-btn:active {
        transform: scale(0.98);
    }

    /* ─── Category Segmented Filter Bar ─── */
    .blog-cat-nav {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-bottom: 1.75rem;
    }
    .blog-cat-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 15px;
        border-radius: 20px;
        font-size: 0.83rem;
        font-weight: 600;
        color: #475569;
        background: rgba(255, 255, 255, 0.76);
        border: 1px solid rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        text-decoration: none;
        transition: all 0.18s cubic-bezier(0.2, 0.8, 0.2, 1);
        white-space: nowrap;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
    }
    .blog-cat-chip:hover {
        background: rgba(255, 255, 255, 0.95);
        color: var(--mb-primary);
        border-color: #99f6e4;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(13, 148, 136, 0.1);
    }
    .blog-cat-chip.active {
        background: var(--mb-primary);
        color: #ffffff;
        border-color: var(--mb-primary);
        box-shadow: 0 2px 8px rgba(13, 148, 136, 0.25);
    }

    /* ─── Active Filter Status Bar ─── */
    .blog-filter-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.75rem 1.25rem;
        background: rgba(255, 255, 255, 0.76);
        backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.85);
        border-radius: 12px;
        margin-bottom: 1.75rem;
        font-size: 0.86rem;
        color: #475569;
    }

    /* ─── Featured Article Hero Card ─── */
    .blog-featured-card {
        background: rgba(255, 255, 255, 0.76);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        border: 1px solid rgba(255, 255, 255, 0.85);
        border-radius: 18px;
        overflow: hidden;
        margin-bottom: 2.25rem;
        box-shadow: 0 8px 32px rgba(15, 118, 110, 0.05), 0 1px 3px rgba(0, 0, 0, 0.02);
        display: grid;
        grid-template-columns: 1.15fr 1fr;
        text-decoration: none;
        color: inherit;
        transition: transform 0.22s cubic-bezier(0.2, 0.8, 0.2, 1),
                    box-shadow 0.22s cubic-bezier(0.2, 0.8, 0.2, 1),
                    border-color 0.22s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .blog-featured-card:hover {
        background: rgba(255, 255, 255, 0.95);
        transform: translateY(-3px);
        box-shadow: 0 14px 32px -4px rgba(13, 148, 136, 0.14);
        border-color: rgba(62, 142, 126, 0.4);
        color: inherit;
    }

    .blog-featured-thumb-box {
        position: relative;
        aspect-ratio: 16 / 10;
        background: #f1f5f9;
        overflow: hidden;
    }
    .blog-featured-thumb-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }
    .blog-featured-card:hover .blog-featured-thumb-img {
        transform: scale(1.03);
    }
    .blog-featured-badge {
        position: absolute;
        top: 1rem;
        left: 1rem;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(8px);
        color: var(--mb-primary);
        border: 1px solid rgba(13, 148, 136, 0.2);
        font-size: 0.72rem;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 4px 10px;
        border-radius: 6px;
    }

    .blog-featured-content {
        padding: 2rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }
    .blog-featured-tag {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--mb-primary);
        letter-spacing: 0.05em;
        margin-bottom: 0.4rem;
    }
    .blog-featured-title {
        font-size: 1.45rem;
        font-weight: 800;
        color: #0f172a;
        line-height: 1.35;
        margin-bottom: 0.75rem;
        letter-spacing: -0.015em;
    }
    .blog-featured-excerpt {
        font-size: 0.9rem;
        color: #475569;
        line-height: 1.65;
        margin-bottom: 1.25rem;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .blog-featured-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 1rem;
        border-top: 1px solid #f1f5f9;
        font-size: 0.82rem;
        color: #64748b;
    }

    /* ─── Grid Article Cards ─── */
    .blog-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
        margin-bottom: 2.5rem;
    }
    @@media (max-width: 991.98px) {
        .blog-grid { grid-template-columns: repeat(2, 1fr); }
        .blog-featured-card { grid-template-columns: 1fr; }
    }
    @@media (max-width: 575.98px) {
        .blog-grid { grid-template-columns: 1fr; }
        .blog-featured-content { padding: 1.25rem; }
        .blog-hero-title { font-size: 1.6rem; }
    }

    .blog-card {
        background: rgba(255, 255, 255, 0.76);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        border: 1px solid rgba(255, 255, 255, 0.85);
        border-radius: 16px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        height: 100%;
        text-decoration: none;
        color: inherit;
        box-shadow: 0 4px 18px rgba(15, 118, 110, 0.04), 0 1px 3px rgba(0, 0, 0, 0.02);
        transition: transform 0.22s cubic-bezier(0.2, 0.8, 0.2, 1),
                    box-shadow 0.22s cubic-bezier(0.2, 0.8, 0.2, 1),
                    border-color 0.22s cubic-bezier(0.2, 0.8, 0.2, 1),
                    background-color 0.22s ease;
    }
    .blog-card:hover {
        background: rgba(255, 255, 255, 0.96);
        transform: translateY(-4px);
        box-shadow: 0 14px 30px -4px rgba(13, 148, 136, 0.13);
        border-color: rgba(62, 142, 126, 0.38);
        color: inherit;
    }

    .blog-card-thumb-wrap {
        aspect-ratio: 16 / 9;
        width: 100%;
        background: #f1f5f9;
        position: relative;
        overflow: hidden;
    }
    .blog-card-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }
    .blog-card:hover .blog-card-img {
        transform: scale(1.04);
    }
    .blog-placeholder-thumb {
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #e6f4f1 0%, #d1fae5 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--mb-primary);
        font-size: 2.25rem;
    }

    .blog-card-cat-badge {
        position: absolute;
        top: 0.75rem;
        left: 0.75rem;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(8px);
        color: #0f766e;
        border: 1px solid rgba(13, 148, 136, 0.2);
        padding: 3px 8px;
        border-radius: 6px;
        font-size: 0.68rem;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .blog-card-body {
        padding: 1.25rem;
        display: flex;
        flex-direction: column;
        flex: 1;
    }
    .blog-card-title {
        font-size: 1.02rem;
        font-weight: 750;
        color: #0f172a;
        line-height: 1.4;
        margin-bottom: 0.45rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        letter-spacing: -0.01em;
    }
    .blog-card:hover .blog-card-title {
        color: var(--mb-primary);
    }
    .blog-card-excerpt {
        font-size: 0.84rem;
        color: #64748b;
        line-height: 1.55;
        margin-bottom: 1rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        flex: 1;
    }

    .blog-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 0.75rem;
        border-top: 1px solid #f1f5f9;
        font-size: 0.78rem;
        color: #64748b;
        margin-top: auto;
    }
    .blog-author-avatar {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        object-fit: cover;
        background: #e2e8f0;
        border: 1px solid #ffffff;
    }
    .blog-author-initials {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: var(--mb-primary-light);
        color: var(--mb-primary);
        font-size: 0.7rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* ─── Empty State ─── */
    .blog-empty-card {
        text-align: center;
        padding: 4rem 2rem;
        background: rgba(255, 255, 255, 0.82);
        backdrop-filter: blur(16px);
        border: 1px dashed #cbd5e1;
        border-radius: 16px;
        margin-bottom: 3rem;
    }
    .blog-empty-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: #f0fdf9;
        color: var(--mb-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        margin: 0 auto 1.25rem;
        border: 1px solid #ccfbf1;
    }
</style>

<div class="blog-hub-wrapper">
    <!-- ── 1. Compact Editorial Header ── -->
    <div class="blog-hero-header mb-fade-up">
        <div class="blog-hero-badge">
            <i class="bi bi-journal-medical"></i> Clinical Knowledge Library
        </div>
        <h1 class="blog-hero-title">Mental Health Resources</h1>
        <p class="blog-hero-sub">
            Evidence-based articles, self-care guidance, and clinical insights from OPCBS specialists.
        </p>

        <!-- Search Bar -->
        <form method="get" class="blog-search-wrap">
            <i class="bi bi-search blog-search-icon"></i>
            <input type="text" name="search" class="form-control blog-search-input" value="@Model.Filter.Search"
                   placeholder="Search articles, topics, or symptoms..." aria-label="Search articles by title or keyword" />
            @if (!string.IsNullOrEmpty(Model.Filter.Category))
            {
                <input type="hidden" name="category" value="@Model.Filter.Category" />
            }
            <button type="submit" class="blog-search-btn">Search</button>
        </form>
    </div>

    <!-- ── 2. Segmented Category Chips ── -->
    <nav class="blog-cat-nav" aria-label="Category navigation">
        @foreach (var (val, label, icon) in categories)
        {
            <a asp-page="Index"
               asp-route-category="@(string.IsNullOrEmpty(val) ? null : val)"
               asp-route-search="@Model.Filter.Search"
               class="blog-cat-chip @(currentCat == val ? "active" : "")">
                <i class="bi @icon"></i>@label
            </a>
        }
    </nav>

    <!-- ── 3. Active Search / Category Filter Bar ── -->
    @if (hasSearchOrCat)
    {
        <div class="blog-filter-bar mb-fade-up">
            <div>
                Found <strong>@Model.Blogs.Count</strong> article(s)
                @if (!string.IsNullOrEmpty(Model.Filter.Search))
                {
                    <span> matching "<strong>@Model.Filter.Search</strong>"</span>
                }
                @if (!string.IsNullOrEmpty(Model.Filter.Category))
                {
                    <span> in category "<strong>@Model.Filter.Category</strong>"</span>
                }
            </div>
            <a asp-page="Index" class="btn btn-sm btn-outline-secondary" style="border-radius: 8px; font-weight:600; font-size: 0.8rem;">
                <i class="bi bi-x-lg me-1"></i>Reset Filters
            </a>
        </div>
    }

    <!-- ── 4. Featured Article Card (Page 1) ── -->
    @if (featuredBlog != null)
    {
        <a asp-page="Details" asp-route-id="@featuredBlog.Id" class="blog-featured-card mb-fade-up">
            <div class="blog-featured-thumb-box">
                @if (!string.IsNullOrEmpty(featuredBlog.Category))
                {
                    <span class="blog-featured-badge">@featuredBlog.Category</span>
                }
                @if (!string.IsNullOrEmpty(featuredBlog.DisplayImage))
                {
                    <img src="@featuredBlog.DisplayImage" alt="@featuredBlog.Title" class="blog-featured-thumb-img" loading="eager" />
                }
                else
                {
                    <div class="blog-placeholder-thumb">
                        <i class="bi bi-journal-text"></i>
                    </div>
                }
            </div>
            <div class="blog-featured-content">
                <div class="blog-featured-tag">Featured Insight</div>
                <h2 class="blog-featured-title">@featuredBlog.Title</h2>
                <p class="blog-featured-excerpt">@(featuredBlog.DisplaySummary ?? "Explore clinical perspectives and therapeutic guidance written by certified specialists.")</p>
                <div class="blog-featured-meta">
                    <div class="d-flex align-items-center gap-2">
                        @if (!string.IsNullOrEmpty(featuredBlog.AuthorAvatarUrl))
                        {
                            <img src="@featuredBlog.AuthorAvatarUrl" alt="" class="blog-author-avatar" />
                        }
                        else
                        {
                            <div class="blog-author-initials">@(string.IsNullOrEmpty(featuredBlog.AuthorName) ? "D" : featuredBlog.AuthorName[..1].ToUpper())</div>
                        }
                        <span class="fw-bold text-dark">@(featuredBlog.AuthorName ?? "Specialist")</span>
                    </div>
                    <div>
                        <i class="bi bi-calendar3 me-1"></i>@(featuredBlog.PublishedAt?.ToString("MMM dd, yyyy") ?? featuredBlog.CreatedAt.ToString("MMM dd, yyyy"))
                    </div>
                </div>
            </div>
        </a>
    }

    <!-- ── 5. Main Article Grid ── -->
    @if (gridBlogs.Any())
    {
        <div class="blog-grid mb-stagger">
            @foreach (var blog in gridBlogs)
            {
                <a asp-page="Details" asp-route-id="@blog.Id" class="blog-card">
                    <div class="blog-card-thumb-wrap">
                        @if (!string.IsNullOrEmpty(blog.Category))
                        {
                            <span class="blog-card-cat-badge">@blog.Category</span>
                        }
                        @if (!string.IsNullOrEmpty(blog.DisplayImage))
                        {
                            <img src="@blog.DisplayImage" alt="@blog.Title" class="blog-card-img" loading="lazy" />
                        }
                        else
                        {
                            <div class="blog-placeholder-thumb">
                                <i class="bi bi-card-text"></i>
                            </div>
                        }
                    </div>
                    <div class="blog-card-body">
                        <h2 class="blog-card-title">@blog.Title</h2>
                        <p class="blog-card-excerpt">@(blog.DisplaySummary ?? "Comprehensive therapeutic advice and mental wellbeing guide.")</p>
                        <div class="blog-card-footer">
                            <div class="d-flex align-items-center gap-1.5">
                                @if (!string.IsNullOrEmpty(blog.AuthorAvatarUrl))
                                {
                                    <img src="@blog.AuthorAvatarUrl" alt="" class="blog-author-avatar" />
                                }
                                else
                                {
                                    <div class="blog-author-initials">@(string.IsNullOrEmpty(blog.AuthorName) ? "D" : blog.AuthorName[..1].ToUpper())</div>
                                }
                                <span class="fw-semibold text-dark">@(blog.AuthorName ?? "Specialist")</span>
                            </div>
                            <div>
                                <i class="bi bi-calendar3 me-1"></i>@(blog.PublishedAt?.ToString("MMM dd, yyyy") ?? blog.CreatedAt.ToString("MMM dd, yyyy"))
                            </div>
                        </div>
                    </div>
                </a>
            }
        </div>

        @if (Model.Pagination != null && Model.Pagination.TotalPages > 1)
        {
            <partial name="_Pagination" view-data='@(new ViewDataDictionary(ViewData) { { "Pagination", Model.Pagination }, { "PageUrl", "/Blog" } })' />
        }
    }
    else if (featuredBlog == null)
    {
        <!-- ── 6. Clean Empty State ── -->
        <div class="blog-empty-card mb-fade-up">
            <div class="blog-empty-icon">
                <i class="bi bi-journal-x"></i>
            </div>
            <h3 class="fw-bold text-dark h5 mb-2">No Articles Found</h3>
            <p class="text-muted small mb-3">We couldn't find any articles matching your search query or filter selection.</p>
            <a asp-page="Index" class="btn btn-sm btn-outline-primary px-3" style="border-radius: 8px; font-weight:600;">
                <i class="bi bi-arrow-counterclockwise me-1"></i>Reset Filters
            </a>
        </div>
    }
</div>
