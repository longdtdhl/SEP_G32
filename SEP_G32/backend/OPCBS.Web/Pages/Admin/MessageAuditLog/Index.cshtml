@page
@model OPCBS.Web.Pages.Admin.MessageAuditLog.IndexModel
@{ ViewData["Title"] = "Message Audit Log"; }

<div class="container py-4">
    <div class="mb-4">
        <h2 class="fw-bold mb-1"><i class="bi bi-shield-lock me-2"></i>Message Audit Log</h2>
        <p class="text-muted mb-0">Conversation-level audit trail between doctors and patients (message content is not exposed here)</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>@Model.ErrorMessage</div>
    }

    @if (!Model.Audits.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-shield-lock display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">No Conversations Yet</h4>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Patient</th>
                        <th>Doctor</th>
                        <th>Status</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Audits)
                    {
                        <tr>
                            <td>@a.PatientName</td>
                            <td>@a.DoctorName</td>
                            <td><span class="badge bg-secondary">@a.Status</span></td>
                            <td>@a.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
