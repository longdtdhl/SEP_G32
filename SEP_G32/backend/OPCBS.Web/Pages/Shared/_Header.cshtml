@inject OPCBS.Web.Helpers.JwtCookieService JwtService

@{
    var isLoggedIn = JwtService.IsLoggedIn;
    var role = JwtService.GetRole();
    var fullName = JwtService.GetFullName() ?? "User";
    var currentPath = Context.Request.Path.Value?.ToLower() ?? "";

    var isDoctor = string.Equals(role, "Doctor", StringComparison.OrdinalIgnoreCase);
    var isPatient = string.Equals(role, "Patient", StringComparison.OrdinalIgnoreCase);
    var isCS = string.Equals(role, "CustomerSupport", StringComparison.OrdinalIgnoreCase);
    var isBM = string.Equals(role, "BusinessManager", StringComparison.OrdinalIgnoreCase);
    var isAdmin = string.Equals(role, "SystemAdmin", StringComparison.OrdinalIgnoreCase);

    var initials = fullName.Length > 0 ? fullName[0].ToString().ToUpper() : "U";
    var roleBadge = isDoctor ? "Doctor" : isPatient ? "Patient" : isCS ? "CS" : isBM ? "BM" : isAdmin ? "Admin" : "";
}

<nav class="navbar navbar-expand-lg mb-navbar">
    <div class="container">
        <!-- Brand -->
        <a class="navbar-brand d-flex align-items-center" asp-page="/Index">
            <img src="~/images/logo-cropped.png" alt="OPCBS Logo" style="max-height: 48px; width: auto;" />
        </a>

        <!-- Mobile Toggle -->
        <div class="d-flex align-items-center gap-2 d-lg-none">
            @if (isLoggedIn)
            {
                <button class="btn btn-sm" type="button" id="mb-sidebar-toggle" aria-label="Toggle sidebar">
                    <i class="bi bi-list fs-4"></i>
                </button>
            }
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
        </div>

        <!-- Nav Links -->
        <div class="collapse navbar-collapse" id="navbarMain">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link @(currentPath == "/" ? "active" : "")" asp-page="/Index">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentPath.StartsWith("/doctors") ? "active" : "")" asp-page="/Doctors/Index">Find a Therapist</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentPath.StartsWith("/blog") ? "active" : "")" asp-page="/Blog/Index">Resources</a>
                </li>
                @if (!isLoggedIn || isPatient)
                {
                    <li class="nav-item">
                        <a class="nav-link @(currentPath.StartsWith("/appointment/track") ? "active" : "")" asp-page="/Appointment/Track">Track Appointment</a>
                    </li>
                }
            </ul>

            <ul class="navbar-nav align-items-lg-center gap-2">
                @if (isLoggedIn)
                {
                    <!-- Notification Bell -->
                    <li class="nav-item dropdown" id="notification-bell-container">
                        <a class="nav-link position-relative" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" id="notificationBellBtn">
                            <i class="bi bi-bell fs-5"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" id="notifBadge" style="font-size:0.6rem;">
                                0
                            </span>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end shadow-lg p-0" style="min-width:340px;max-height:420px;border-radius:14px;border:1px solid #e5e7eb;" id="notifDropdown">
                            <div class="d-flex justify-content-between align-items-center px-3 py-2" style="border-bottom:1px solid #f0f0f0;">
                                <h6 class="mb-0 fw-bold" style="color:var(--mb-primary);">
                                    <i class="bi bi-bell me-1"></i>Thông báo
                                </h6>
                                <button class="btn btn-sm btn-link text-decoration-none p-0" id="markAllReadBtn" style="font-size:0.8rem;color:var(--mb-primary);">
                                    Đọc tất cả
                                </button>
                            </div>
                            <div id="notifList" style="max-height:300px;overflow-y:auto;">
                                <div class="text-center py-4 text-muted" id="notifEmpty">
                                    <i class="bi bi-bell-slash fs-3 d-block mb-2"></i>
                                    Không có thông báo mới
                                </div>
                            </div>
                            <div class="text-center py-2" style="border-top:1px solid #f0f0f0;">
                                <a href="/Notifications" class="text-decoration-none fw-semibold" style="font-size:0.85rem;color:var(--mb-primary);">
                                    Xem tất cả thông báo →
                                </a>
                            </div>
                        </div>
                    </li>

                    <!-- Logged-in user dropdown with role context -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:34px;height:34px;background:var(--mb-primary);color:#fff;font-weight:600;font-size:0.8rem;">
                                @initials
                            </div>
                            <span class="d-none d-lg-inline" style="max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@fullName</span>
                            @if (!string.IsNullOrEmpty(roleBadge))
                            {
                                <span class="badge bg-light text-dark" style="font-size:0.65rem;">@roleBadge</span>
                            }
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="min-width:220px;border-radius:12px;border:1px solid #e5e7eb;">
                            <!-- Role-specific portal links -->
                            @if (isPatient)
                            {
                                <li><h6 class="dropdown-header" style="color:var(--mb-primary);"><i class="bi bi-person-heart me-1"></i>Cổng Bệnh nhân</h6></li>
                                <li><a class="dropdown-item" asp-page="/Patient/Dashboard"><i class="bi bi-speedometer2 me-2"></i>Bảng điều khiển</a></li>
                                <li><a class="dropdown-item" asp-page="/Patient/Appointments/Index"><i class="bi bi-calendar-check me-2"></i>Lịch hẹn của tôi</a></li>
                                <li><a class="dropdown-item" asp-page="/Patient/ConsultationRecords/Index"><i class="bi bi-file-medical me-2"></i>Hồ sơ tư vấn</a></li>
                            }
                            else if (isDoctor)
                            {
                                <li><h6 class="dropdown-header" style="color:var(--mb-primary);"><i class="bi bi-heart-pulse me-1"></i>Doctor Portal</h6></li>
                                <li><a class="dropdown-item" asp-page="/Doctor/Dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                                <li><a class="dropdown-item" asp-page="/Doctor/Appointments/Index"><i class="bi bi-calendar-check me-2"></i>Appointments</a></li>
                                <li><a class="dropdown-item" asp-page="/Doctor/Verification"><i class="bi bi-patch-check me-2"></i>Verification</a></li>
                            }
                            else if (isCS)
                            {
                                <li><h6 class="dropdown-header" style="color:var(--mb-primary);"><i class="bi bi-headset me-1"></i>CS Portal</h6></li>
                                <li><a class="dropdown-item" asp-page="/CustomerSupport/Dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                                <li><a class="dropdown-item" asp-page="/CustomerSupport/DoctorApplications/Index"><i class="bi bi-person-check me-2"></i>Doctor Apps</a></li>
                            }
                            else if (isBM)
                            {
                                <li><h6 class="dropdown-header" style="color:var(--mb-primary);"><i class="bi bi-briefcase me-1"></i>Business Portal</h6></li>
                                <li><a class="dropdown-item" asp-page="/BusinessManager/Dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                                <li><a class="dropdown-item" asp-page="/BusinessManager/ServicePackages/Index"><i class="bi bi-gem me-2"></i>Packages</a></li>
                            }
                            else if (isAdmin)
                            {
                                <li><h6 class="dropdown-header" style="color:var(--mb-primary);"><i class="bi bi-shield-lock me-1"></i>Admin Portal</h6></li>
                                <li><a class="dropdown-item" asp-page="/Admin/Dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                                <li><a class="dropdown-item" asp-page="/Admin/Users/Index"><i class="bi bi-people me-2"></i>Users</a></li>
                            }

                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" asp-page="/Account/Profile"><i class="bi bi-person me-2"></i>Profile</a></li>
                            <li><a class="dropdown-item" asp-page="/Account/ChangePassword"><i class="bi bi-key me-2"></i>Change Password</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form method="post" asp-page="/Account/Logout">
                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                                </form>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Account/Login">Log in</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-get-started" asp-page="/Account/Register">Get Started</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>
