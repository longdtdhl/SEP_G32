@inject OPCBS.Web.Helpers.JwtCookieService JwtService

@{
    var isLoggedIn = JwtService.IsLoggedIn;
    var role = JwtService.GetRole();
    var currentPath = Context.Request.Path.Value?.ToLower() ?? "";

    var isPatient = string.Equals(role, "Patient", StringComparison.OrdinalIgnoreCase);

    // Dashboard URL per role
    var dashboardUrl = role switch
    {
        "Doctor" => "/Doctor/Dashboard",
        "Patient" => "/Patient/Appointments/Index",
        "CustomerSupport" => "/CustomerSupport/Dashboard",
        "BusinessManager" => "/BusinessManager/Dashboard",
        "SystemAdmin" => "/Admin/Dashboard",
        _ => "/"
    };
}

<nav class="navbar navbar-expand-lg mb-navbar">
    <div class="container">
        <!-- Brand -->
        <a class="navbar-brand" asp-page="/Index">
            <img src="~/images/logo-cropped.png" alt="MindBridge Logo" style="max-height: 38px; width: auto;" />
        </a>

        <!-- Mobile Toggle -->
        <div class="d-flex align-items-center gap-2 d-lg-none">
            @if (isLoggedIn)
            {
                <partial name="_NotificationBell" />
            }
            <button class="navbar-toggler border-0 shadow-none p-1" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                    aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
        </div>

        <!-- Nav Links -->
        <div class="collapse navbar-collapse" id="navbarMain">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-lg-center">
                <li class="nav-item">
                    <a class="nav-link @(currentPath == "/" ? "active" : "")" asp-page="/Index">
                        Home
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentPath.StartsWith("/doctors") ? "active" : "")"
                       asp-page="/Doctors/Index">
                        Find a Therapist
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentPath.StartsWith("/blog") ? "active" : "")"
                       asp-page="/Blog/Index">
                        Resources
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentPath.StartsWith("/appointment/track") ? "active" : "")"
                       asp-page="/Appointment/Track">
                        Track Appointment
                    </a>
                </li>
            </ul>

            <div class="d-flex align-items-center gap-3 mb-navbar-actions">
                @if (isLoggedIn)
                {
                    <!-- Notification Bell (desktop) -->
                    <div class="d-none d-lg-flex align-items-center">
                        <ul class="navbar-nav">
                            <partial name="_NotificationBell" />
                        </ul>
                    </div>

                    @if (!isPatient)
                    {
                        <!-- Dashboard Button (Doctor / CS / Manager / Admin) -->
                        <a class="btn mb-btn-action" href="@dashboardUrl">
                            Dashboard
                        </a>
                    }
                    else
                    {
                        <!-- Patient Portal Quick Access -->
                        <a class="btn mb-btn-action" href="/Patient/Appointments/Index">
                            My Appointments
                        </a>
                    }

                    <!-- User Dropdown -->
                    <ul class="navbar-nav">
                        <partial name="_UserDropdown" />
                    </ul>
                }
                else
                {
                    <a class="mb-nav-login" asp-page="/Account/Login">
                        Log in
                    </a>
                    <a class="btn mb-btn-action" asp-page="/Account/Register">
                        Get Started
                    </a>
                }
            </div>
        </div>
    </div>
</nav>
