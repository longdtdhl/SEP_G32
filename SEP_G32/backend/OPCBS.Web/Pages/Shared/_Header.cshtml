@inject OPCBS.Web.Helpers.JwtCookieService JwtService

@{
    var isLoggedIn = JwtService.IsLoggedIn;
    var role = JwtService.GetRole();
    var currentPath = Context.Request.Path.Value?.ToLower() ?? "";

    var isPatient = string.Equals(role, "Patient", StringComparison.OrdinalIgnoreCase);

    // Dashboard URL per role
    var dashboardUrl = role switch
    {
        "Doctor" => "/Doctor/Dashboard",
        "Patient" => "/Patient/Dashboard",
        "CustomerSupport" => "/CustomerSupport/Dashboard",
        "BusinessManager" => "/BusinessManager/Dashboard",
        "SystemAdmin" => "/Admin/Dashboard",
        _ => "/"
    };
}

<nav class="navbar navbar-expand-lg mb-navbar">
    <div class="container">
        <!-- Brand -->
        <a class="navbar-brand d-flex align-items-center" asp-page="/Index">
            <img src="~/images/logo-cropped.png" alt="MindBridge Logo" style="max-height: 48px; width: auto;" />
        </a>

        <!-- Mobile Toggle -->
        <div class="d-flex align-items-center gap-2 d-lg-none">
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
        </div>

        <!-- Nav Links -->
        <div class="collapse navbar-collapse" id="navbarMain">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link @(currentPath == "/" ? "active" : "")" asp-page="/Index">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentPath.StartsWith("/doctors") ? "active" : "")" asp-page="/Doctors/Index">Find a Therapist</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentPath.StartsWith("/blog") ? "active" : "")" asp-page="/Blog/Index">Resources</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentPath.StartsWith("/appointment/track") ? "active" : "")" asp-page="/Appointment/Track">Track Appointment</a>
                </li>
            </ul>

            <ul class="navbar-nav align-items-lg-center gap-2">
                @if (isLoggedIn)
                {
                    <!-- Notification Bell -->
                    <partial name="_NotificationBell" />

                    <!-- Go to Dashboard + simple dropdown -->
                    <li class="nav-item">
                        <a class="btn btn-get-started btn-sm" href="@dashboardUrl">
                            <i class="bi bi-grid-1x2 me-1"></i>Dashboard
                        </a>
                    </li>

                    <!-- User Dropdown (simplified) -->
                    <partial name="_UserDropdown" />
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-page="/Account/Login">Log in</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-get-started" asp-page="/Account/Register">Get Started</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>
