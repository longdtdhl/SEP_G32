<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MindBridge</title>

    <!-- Favicon -->
    <link rel="icon" href="~/images/logo-cropped.png" type="image/png" />

    <!-- Google Fonts: Inter & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- MindBridge CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OPCBS.Web.styles.css" asp-append-version="true" />

    <style>
        .auth-layout {
            position: relative;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            padding: 2rem 1rem;
        }

        .auth-video-bg {
            position: absolute;
            top: 50%;
            left: 50%;
            min-width: 100%;
            min-height: 100%;
            width: auto;
            height: auto;
            transform: translateX(-50%) translateY(-50%);
            z-index: 0;
            object-fit: cover;
        }

        .auth-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(15, 30, 20, 0.4); /* Dark overlay to contrast the bright glass card */
            z-index: 1;
        }

        .auth-content {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 500px;
        }

        /* The auth card styling */
        .mb-auth-card {
            background: rgba(255, 255, 255, 0.65);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: 24px;
            padding: 40px;
            border: 1px solid rgba(255, 255, 255, 0.8);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.2);
        }

            .mb-auth-card h2 {
                font-family: 'Plus Jakarta Sans', sans-serif;
                font-weight: 800;
                color: #1E3A31;
                text-align: center;
                margin-bottom: 5px;
                font-size: 2rem;
            }

            .mb-auth-card .auth-subtitle {
                text-align: center;
                color: #4A5D54;
                margin-bottom: 30px;
                font-weight: 500;
            }

            .mb-auth-card .form-control {
                background: rgba(255, 255, 255, 0.8);
                border: 1px solid rgba(255, 255, 255, 0.9);
                border-radius: 12px;
                padding: 12px 16px;
                font-size: 0.95rem;
                transition: all 0.3s;
            }

                .mb-auth-card .form-control:focus {
                    background: #fff;
                    box-shadow: 0 0 0 4px rgba(21, 61, 54, 0.15);
                    border-color: var(--mb-primary);
                }

            .mb-auth-card .form-label {
                font-weight: 600;
                color: #1E3A31;
                margin-bottom: 8px;
                font-size: 0.9rem;
            }

            .mb-auth-card .btn-primary {
                border-radius: 12px;
                padding: 12px;
                font-weight: 700;
                font-size: 1.05rem;
                margin-top: 10px;
                background: var(--mb-primary);
                border: none;
                box-shadow: 0 4px 15px rgba(21, 61, 54, 0.3);
                transition: all 0.3s;
            }

                .mb-auth-card .btn-primary:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 8px 20px rgba(21, 61, 54, 0.4);
                    background: var(--mb-primary-hover);
                }

            .mb-auth-card .auth-footer {
                margin-top: 25px;
                text-align: center;
                font-size: 0.95rem;
                color: #4A5D54;
            }

                .mb-auth-card .auth-footer a {
                    color: var(--mb-primary);
                    font-weight: 700;
                    text-decoration: none;
                }

                    .mb-auth-card .auth-footer a:hover {
                        text-decoration: underline;
                    }

        .brand-logo-top {
            text-align: center;
            margin-bottom: 20px;
        }

            .brand-logo-top a {
                color: white;
                font-size: 2rem;
                font-weight: 800;
                text-decoration: none;
                font-family: 'Plus Jakarta Sans', sans-serif;
                text-shadow: 0 2px 10px rgba(0,0,0,0.2);
                display: inline-flex;
                align-items: center;
                gap: 10px;
            }
    </style>
</head>
<body>
    <div class="auth-layout">
        <!-- Video Background -->
        <video class="auth-video-bg" autoplay loop muted playsinline>
            <source src="/videos/hero-bg.mp4" type="video/mp4">
        </video>

        <!-- Overlay -->
        <div class="auth-overlay"></div>

        <!-- Content -->
        <div class="auth-content">
            <div class="brand-logo-top">
                <a asp-page="/Index" class="d-inline-flex align-items-center">
                    <img src="~/images/logo-cropped.png" alt="OPCBS Logo" style="max-height: 60px; width: auto;" />
                </a>
            </div>
            @RenderBody()
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
