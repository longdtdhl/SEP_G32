@inject OPCBS.Web.Helpers.JwtCookieService JwtService

@{
    var isLoggedIn = JwtService.IsLoggedIn;
}

@if (isLoggedIn)
{
    <li class="nav-item dropdown" id="notification-bell-container">
        <a class="nav-link position-relative p-0 d-flex align-items-center justify-content-center" href="#" role="button" 
           data-bs-toggle="dropdown" aria-expanded="false" id="notificationBellBtn"
           style="width:40px;height:40px;border-radius:10px;transition:background 0.2s;">
            <i class="bi bi-bell" style="font-size:1.2rem;color:#64748b;"></i>
            <span class="position-absolute badge rounded-pill bg-danger d-none" id="notifBadge" 
                  style="font-size:0.6rem;top:2px;right:2px;min-width:18px;padding:3px 5px;">
                0
            </span>
        </a>
        <div class="dropdown-menu dropdown-menu-end shadow-lg p-0" 
             style="min-width:360px;max-height:440px;border-radius:14px;border:1px solid #e5e7eb;" id="notifDropdown">
            <div class="d-flex justify-content-between align-items-center px-3 py-2" style="border-bottom:1px solid #f0f0f0;">
                <h6 class="mb-0 fw-bold" style="color:var(--mb-primary);font-size:0.9rem;">
                    <i class="bi bi-bell me-1"></i>Notifications
                </h6>
                <button class="btn btn-sm btn-link text-decoration-none p-0" id="markAllReadBtn" style="font-size:0.78rem;color:var(--mb-primary);">
                    Mark all read
                </button>
            </div>
            <div id="notifList" style="max-height:320px;overflow-y:auto;">
                <div class="text-center py-4 text-muted" id="notifEmpty">
                    <i class="bi bi-bell-slash fs-3 d-block mb-2"></i>
                    No new notifications
                </div>
            </div>
            <div class="text-center py-2" style="border-top:1px solid #f0f0f0;">
                <a href="/Notifications" class="text-decoration-none fw-semibold" style="font-size:0.82rem;color:var(--mb-primary);">
                    See all notifications →
                </a>
            </div>
        </div>
    </li>
}
