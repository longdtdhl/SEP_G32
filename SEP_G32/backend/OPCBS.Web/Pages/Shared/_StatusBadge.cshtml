@* Appointment status badge partial — pass ViewData["Status"] (int or string) *@
@{
    var rawStatus = ViewData["Status"];
    string statusText;
    string cssClass;
    
    if (rawStatus is int statusInt)
    {
        statusText = statusInt switch
        {
            0 => "Pending",
            1 => "Accepted",
            2 => "Rejected",
            3 => "In Progress",
            4 => "Completed",
            5 => "Cancelled",
            6 => "Reschedule Requested",
            7 => "Awaiting Confirmation",
            8 => "Absent",
            9 => "Awaiting Email Confirmation",
            10 => "Awaiting Completion",
            11 => "Completion Disputed",
            _ => "Unknown"
        };
        cssClass = statusInt switch
        {
            0 => "badge-pending",
            1 => "badge-approved",
            2 => "badge-rejected",
            3 => "badge-progress",
            4 => "badge-completed",
            5 => "badge-cancelled",
            6 => "badge-pending",
            7 => "badge-pending",
            8 => "badge-cancelled",
            9 => "badge-pending",
            10 => "badge-pending",
            11 => "badge-cancelled",
            _ => "badge-draft"
        };
    }
    else
    {
        var status = (rawStatus as string ?? "Unknown").ToLower();
        cssClass = status switch
        {
            "pending" => "badge-pending",
            "confirmed" => "badge-confirmed",
            "completed" => "badge-completed",
            "cancelled" => "badge-cancelled",
            "approved" => "badge-approved",
            "accepted" => "badge-approved",
            "in progress" => "badge-progress",
            "inprogress" => "badge-progress",
            "reschedule requested" => "badge-pending",
            "awaiting confirmation" => "badge-pending",
            "awaiting email confirmation" => "badge-pending",
            "awaiting completion" => "badge-pending",
            "completion disputed" => "badge-cancelled",
            "no show" => "badge-cancelled",
            "absent" => "badge-cancelled",
            "rejected" => "badge-rejected",
            "draft" => "badge-draft",
            "active" => "badge-active",
            "expired" => "badge-expired",
            _ => "badge-draft"
        };
        statusText = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(status);
    }
}
<span class="badge-status @cssClass">@statusText</span>
