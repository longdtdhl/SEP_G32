@inject OPCBS.Web.Helpers.JwtCookieService JwtService
@inject OPCBS.Web.Services.IVerificationApiService VerificationService

@{
    var role = JwtService.GetRole();
    var currentPath = Context.Request.Path.Value?.ToLower() ?? "";

    var isPatient = string.Equals(role, "Patient", StringComparison.OrdinalIgnoreCase);
    var isDoctor = string.Equals(role, "Doctor", StringComparison.OrdinalIgnoreCase);
    var isCS = string.Equals(role, "CustomerSupport", StringComparison.OrdinalIgnoreCase);
    var isBM = string.Equals(role, "BusinessManager", StringComparison.OrdinalIgnoreCase);
    var isAdmin = string.Equals(role, "SystemAdmin", StringComparison.OrdinalIgnoreCase);

    // Doctor verification check
    var isVerified = false;
    var verificationStatus = "NotSubmitted";
    if (isDoctor)
    {
        try
        {
            var (vData, _) = await VerificationService.GetMyVerificationAsync();
            if (vData != null)
            {
                verificationStatus = vData.Status ?? "NotSubmitted";
                if (string.Equals(vData.Status, "Approved", StringComparison.OrdinalIgnoreCase))
                    isVerified = true;
            }
        }
        catch { }
    }

    var portalLabel = role switch
    {
        "Patient" => "Patient Portal",
        "Doctor" => "Doctor Portal",
        "CustomerSupport" => "Support Portal",
        "BusinessManager" => "Business Portal",
        "SystemAdmin" => "Admin Portal",
        _ => "MindBridge"
    };

    var portalIcon = role switch
    {
        "Patient" => "bi-heart-pulse",
        "Doctor" => "bi-hospital",
        "CustomerSupport" => "bi-headset",
        "BusinessManager" => "bi-briefcase",
        "SystemAdmin" => "bi-shield-lock",
        _ => "bi-grid"
    };
}

<!-- Sidebar Backdrop (mobile) -->
<div class="mb-dash-sidebar-backdrop" id="sidebarBackdrop"></div>

<aside class="mb-dash-sidebar" id="dashSidebar">
    <!-- Portal Brand -->
    <div class="sidebar-brand">
        <i class="bi @portalIcon"></i>
        <span>@portalLabel</span>
    </div>

    <nav class="sidebar-nav">
        @* ============================== PATIENT ============================== *@
        @if (isPatient)
        {
            <div class="sb-section-label">Appointments</div>

            <a class="sb-link @(currentPath == "/patient/appointments" || currentPath == "/patient/appointments/index" ? "active" : "")" asp-page="/Patient/Appointments/Index">
                <i class="bi bi-calendar-check"></i><span>My Appointments</span>
            </a>

            <div class="sb-divider"></div>
            <div class="sb-section-label">Treatment</div>

            <a class="sb-link @(currentPath.StartsWith("/patient/treatmentcases") ? "active" : "")" asp-page="/Patient/TreatmentCases/Index">
                <i class="bi bi-heart-pulse"></i><span>Treatment Progress</span>
            </a>
            <a class="sb-link @(currentPath.StartsWith("/patient/treatmentpackages") ? "active" : "")" asp-page="/Patient/TreatmentPackages/Index">
                <i class="bi bi-box-seam"></i><span>Treatment Packages</span>
            </a>
            <a class="sb-link @(currentPath.StartsWith("/patient/consultationrecords") ? "active" : "")" asp-page="/Patient/ConsultationRecords/Index">
                <i class="bi bi-file-medical"></i><span>Clinical Records</span>
            </a>

            <div class="sb-divider"></div>
            <div class="sb-section-label">Wellbeing</div>

            <a class="sb-link @(currentPath.StartsWith("/patient/journal") ? "active" : "")" asp-page="/Patient/Journal/Index">
                <i class="bi bi-emoji-smile"></i><span>Mood Journey</span>
            </a>
            <a class="sb-link @(currentPath.StartsWith("/patient/psychometrics") ? "active" : "")" asp-page="/Patient/Psychometrics/TakeTest">
                <i class="bi bi-clipboard2-pulse"></i><span>Psychological Assessments</span>
            </a>

            <div class="sb-divider"></div>
            <div class="sb-section-label">Communication</div>

            <a class="sb-link @(currentPath.StartsWith("/patient/favorites") ? "active" : "")" asp-page="/Patient/Favorites/Index">
                <i class="bi bi-heart"></i><span>Favorite Doctors</span>
            </a>
            <a class="sb-link @(currentPath.StartsWith("/patient/messages") ? "active" : "")" asp-page="/Patient/Messages/Index">
                <i class="bi bi-chat-dots"></i><span>Messages</span>
                <span class="sb-badge d-none" id="sb-msg-badge"></span>
            </a>
        }

        @* ============================== DOCTOR ============================== *@
        else if (isDoctor)
        {
            <a class="sb-link @(currentPath == "/doctor/dashboard" ? "active" : "")" asp-page="/Doctor/Dashboard">
                <i class="bi bi-house"></i><span>Dashboard</span>
            </a>

            <div class="sb-divider"></div>
            <div class="sb-section-label">Schedule</div>

            @if (isVerified)
            {
                <a class="sb-link @(currentPath == "/doctor/appointments" || currentPath == "/doctor/appointments/index" ? "active" : "")" asp-page="/Doctor/Appointments/Index">
                    <i class="bi bi-calendar-check"></i><span>Appointments</span>
                </a>
                <a class="sb-link @(currentPath.StartsWith("/doctor/schedules") ? "active" : "")" asp-page="/Doctor/Schedules/Index">
                    <i class="bi bi-calendar-week"></i><span>Calendar & Availability</span>
                </a>

                <div class="sb-divider"></div>
                <div class="sb-section-label">Clinical Care</div>

                <a class="sb-link @(currentPath.StartsWith("/doctor/patients") ? "active" : "")" asp-page="/Doctor/Patients/Index">
                    <i class="bi bi-people"></i><span>Patient Records</span>
                </a>
                <a class="sb-link @(currentPath.StartsWith("/doctor/treatmentcases") ? "active" : "")" asp-page="/Doctor/TreatmentCases/Index">
                    <i class="bi bi-heart-pulse"></i><span>Treatment Cases</span>
                </a>
                <a class="sb-link @(currentPath.StartsWith("/doctor/psychometrics") ? "active" : "")" asp-page="/Doctor/Psychometrics/Index">
                    <i class="bi bi-clipboard2-pulse"></i><span>Psychometric Assessments</span>
                </a>

                <div class="sb-divider"></div>
                <div class="sb-section-label">Care Programs & Services</div>

                <a class="sb-link @(currentPath.StartsWith("/doctor/treatmentpackages") ? "active" : "")" asp-page="/Doctor/TreatmentPackages/Index">
                    <i class="bi bi-box-seam"></i><span>Treatment Packages</span>
                </a>
                <a class="sb-link @(currentPath.StartsWith("/doctor/servicepackages") ? "active" : "")" asp-page="/Doctor/ServicePackages/Index">
                    <i class="bi bi-gem"></i><span>Service Packages</span>
                </a>

                <div class="sb-divider"></div>
                <div class="sb-section-label">Communication</div>

                <a class="sb-link @(currentPath.StartsWith("/doctor/messages") ? "active" : "")" asp-page="/Doctor/Messages/Index">
                    <i class="bi bi-chat-dots"></i><span>Messages</span>
                    <span class="sb-badge d-none" id="sb-msg-badge-doc"></span>
                </a>
                <a class="sb-link @(currentPath.StartsWith("/doctor/blogs") ? "active" : "")" asp-page="/Doctor/Blogs/Index">
                    <i class="bi bi-journal-text"></i><span>My Articles</span>
                </a>
            }
            else
            {
                <!-- Locked items for unverified doctors -->
                <span class="sb-link sb-disabled"><i class="bi bi-calendar-check"></i><span>Appointments</span><i class="bi bi-lock-fill sb-lock-icon"></i></span>
                <span class="sb-link sb-disabled"><i class="bi bi-calendar-week"></i><span>Calendar & Availability</span><i class="bi bi-lock-fill sb-lock-icon"></i></span>
                <div class="sb-divider"></div>
                <div class="sb-section-label">Clinical Care</div>
                <span class="sb-link sb-disabled"><i class="bi bi-people"></i><span>Patient Records</span><i class="bi bi-lock-fill sb-lock-icon"></i></span>
                <span class="sb-link sb-disabled"><i class="bi bi-heart-pulse"></i><span>Treatment Cases</span><i class="bi bi-lock-fill sb-lock-icon"></i></span>
                <span class="sb-link sb-disabled"><i class="bi bi-clipboard2-pulse"></i><span>Psychometric Assessments</span><i class="bi bi-lock-fill sb-lock-icon"></i></span>
                <div class="sb-divider"></div>
                <div class="sb-section-label">Care Programs & Services</div>
                <span class="sb-link sb-disabled"><i class="bi bi-box-seam"></i><span>Treatment Packages</span><i class="bi bi-lock-fill sb-lock-icon"></i></span>
                <span class="sb-link sb-disabled"><i class="bi bi-gem"></i><span>Service Packages</span><i class="bi bi-lock-fill sb-lock-icon"></i></span>
                <div class="sb-divider"></div>
                <div class="sb-section-label">Communication</div>
                <span class="sb-link sb-disabled"><i class="bi bi-chat-dots"></i><span>Messages</span><i class="bi bi-lock-fill sb-lock-icon"></i></span>
                <span class="sb-link sb-disabled"><i class="bi bi-journal-text"></i><span>My Articles</span><i class="bi bi-lock-fill sb-lock-icon"></i></span>
            }

            <div class="sb-divider"></div>
            <div class="sb-section-label">Practice Setup</div>

            <a class="sb-link @(currentPath.StartsWith("/doctor/verification") ? "active" : "")" asp-page="/Doctor/Verification">
                <i class="bi bi-patch-check"></i><span>Professional Verification</span>
                @{
                    var vBadgeClass = verificationStatus switch
                    {
                        "Approved" => "sb-status-approved",
                        "Rejected" => "sb-status-rejected",
                        _ => "sb-status-pending"
                    };
                    var vBadgeLabel = verificationStatus switch
                    {
                        "Approved" => "Approved",
                        "Rejected" => "Rejected",
                        "Submitted" or "Pending" => "Pending",
                        _ => "Required"
                    };
                }
                <span class="sb-status @vBadgeClass">@vBadgeLabel</span>
            </a>

            @if (isVerified)
            {
                <a class="sb-link @(currentPath.StartsWith("/doctor/revenue") ? "active" : "")" asp-page="/Doctor/Revenue/Index">
                    <i class="bi bi-wallet2"></i><span>Earnings & Revenue</span>
                </a>
                <a class="sb-link @(currentPath.StartsWith("/doctor/subscriptions") ? "active" : "")" asp-page="/Doctor/Subscriptions/Status">
                    <i class="bi bi-credit-card"></i><span>Plan & Billing</span>
                </a>
            }
        }

        @* ============================== CUSTOMER SUPPORT ============================== *@
        else if (isCS)
        {
            <a class="sb-link @(currentPath == "/customersupport/dashboard" ? "active" : "")" asp-page="/CustomerSupport/Dashboard">
                <i class="bi bi-house"></i><span>Dashboard</span>
            </a>
            <a class="sb-link @(currentPath.StartsWith("/customersupport/doctorapplications") ? "active" : "")" asp-page="/CustomerSupport/DoctorApplications/Index">
                <i class="bi bi-person-check"></i><span>Doctor Applications</span>
                <span class="sb-badge d-none" id="sb-apps-badge"></span>
            </a>
            <a class="sb-link @(currentPath.StartsWith("/customersupport/blogmoderation") ? "active" : "")" asp-page="/CustomerSupport/BlogModeration/Index">
                <i class="bi bi-journal-check"></i><span>Blog Moderation</span>
                <span class="sb-badge d-none" id="sb-blog-badge"></span>
            </a>
            <a class="sb-link @(currentPath.StartsWith("/customersupport/violationreports") ? "active" : "")" asp-page="/CustomerSupport/ViolationReports/Index">
                <i class="bi bi-shield-exclamation"></i><span>Violation Reports</span>
            </a>

            <div class="sb-divider"></div>

            <form method="post" asp-page="/Account/Logout" class="m-0">
                <button type="submit" class="sb-link sb-logout">
                    <i class="bi bi-box-arrow-right"></i><span>Logout</span>
                </button>
            </form>
        }

        @* ============================== BUSINESS MANAGER ============================== *@
        else if (isBM)
        {
            <a class="sb-link @(currentPath == "/businessmanager/dashboard" ? "active" : "")" asp-page="/BusinessManager/Dashboard">
                <i class="bi bi-house"></i><span>Dashboard</span>
            </a>
            <a class="sb-link @(currentPath.StartsWith("/businessmanager/subscriptions") ? "active" : "")" asp-page="/BusinessManager/Subscriptions/Index">
                <i class="bi bi-credit-card"></i><span>Doctor Subscriptions</span>
            </a>
            <a class="sb-link @(currentPath.StartsWith("/businessmanager/servicepackages") ? "active" : "")" asp-page="/BusinessManager/ServicePackages/Index">
                <i class="bi bi-gem"></i><span>Service Packages</span>
            </a>
            <a class="sb-link @(currentPath.StartsWith("/businessmanager/specializations") ? "active" : "")" asp-page="/BusinessManager/Specializations/Index">
                <i class="bi bi-tags"></i><span>Specializations</span>
            </a>
            <a class="sb-link @(currentPath.StartsWith("/businessmanager/psychometrics") ? "active" : "")" asp-page="/BusinessManager/Psychometrics/Index">
                <i class="bi bi-clipboard2-pulse"></i><span>Psychometric Tests</span>
            </a>
            <a class="sb-link @(currentPath.StartsWith("/businessmanager/analytics") ? "active" : "")" asp-page="/BusinessManager/Analytics">
                <i class="bi bi-graph-up"></i><span>Analytics</span>
            </a>
            <a class="sb-link @(currentPath.StartsWith("/businessmanager/reports") ? "active" : "")" asp-page="/BusinessManager/Reports">
                <i class="bi bi-file-earmark-bar-graph"></i><span>Reports</span>
            </a>

            <div class="sb-divider"></div>

            <form method="post" asp-page="/Account/Logout" class="m-0">
                <button type="submit" class="sb-link sb-logout">
                    <i class="bi bi-box-arrow-right"></i><span>Logout</span>
                </button>
            </form>
        }

        @* ============================== SYSTEM ADMIN ============================== *@
        else if (isAdmin)
        {
            <a class="sb-link @(currentPath == "/admin/dashboard" ? "active" : "")" asp-page="/Admin/Dashboard">
                <i class="bi bi-house"></i><span>Dashboard</span>
            </a>
            <a class="sb-link @(currentPath.StartsWith("/admin/users") ? "active" : "")" asp-page="/Admin/Users/Index">
                <i class="bi bi-people"></i><span>User Management</span>
            </a>
            <a class="sb-link @(currentPath.StartsWith("/admin/roles") ? "active" : "")" asp-page="/Admin/Roles/Index">
                <i class="bi bi-shield-check"></i><span>Role Management</span>
            </a>
            <a class="sb-link @(currentPath.StartsWith("/admin/permissions") ? "active" : "")" asp-page="/Admin/Permissions/Index">
                <i class="bi bi-key"></i><span>Permission Management</span>
            </a>
            <a class="sb-link @(currentPath.StartsWith("/admin/violationreports") ? "active" : "")" asp-page="/Admin/ViolationReports/Index">
                <i class="bi bi-shield-exclamation"></i><span>Violation Reports</span>
            </a>
            <a class="sb-link @(currentPath.StartsWith("/admin/auditlogs") ? "active" : "")" asp-page="/Admin/AuditLogs/Index">
                <i class="bi bi-journal-text"></i><span>Audit Logs</span>
            </a>
            <a class="sb-link @(currentPath.StartsWith("/admin/settings") ? "active" : "")" asp-page="/Admin/Settings">
                <i class="bi bi-gear"></i><span>System Settings</span>
            </a>
            <a class="sb-link @(currentPath.StartsWith("/admin/reports") ? "active" : "")" asp-page="/Admin/Reports">
                <i class="bi bi-file-earmark-bar-graph"></i><span>Reports</span>
            </a>

            <div class="sb-divider"></div>

            <form method="post" asp-page="/Account/Logout" class="m-0">
                <button type="submit" class="sb-link sb-logout">
                    <i class="bi bi-box-arrow-right"></i><span>Logout</span>
                </button>
            </form>
        }
    </nav>
</aside>
