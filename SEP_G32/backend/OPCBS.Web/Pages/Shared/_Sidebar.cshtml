@inject OPCBS.Web.Helpers.JwtCookieService JwtService
@inject OPCBS.Web.Services.IVerificationApiService VerificationService

@{
    var role = JwtService.GetRole();
    var currentPath = Context.Request.Path.Value?.ToLower() ?? "";

    var isPatient = string.Equals(role, "Patient", StringComparison.OrdinalIgnoreCase);
    var isDoctor = string.Equals(role, "Doctor", StringComparison.OrdinalIgnoreCase);
    var isCS = string.Equals(role, "CustomerSupport", StringComparison.OrdinalIgnoreCase);
    var isBM = string.Equals(role, "BusinessManager", StringComparison.OrdinalIgnoreCase);
    var isAdmin = string.Equals(role, "SystemAdmin", StringComparison.OrdinalIgnoreCase);

    // For doctor verification gate - check via API
    var isVerified = ViewData["DoctorVerified"] as bool? ?? false;
    if (isDoctor && !isVerified)
    {
        try
        {
            var (vData, _) = await VerificationService.GetMyVerificationAsync();
            if (vData != null && string.Equals(vData.Status, "Approved", StringComparison.OrdinalIgnoreCase))
            {
                isVerified = true;
            }
        }
        catch { }
    }
}

<aside class="mb-sidebar" id="mb-sidebar">
    @if (isPatient)
    {
        <div class="sidebar-header">Patient Portal</div>
        <nav class="nav flex-column">
            <a class="nav-link @(currentPath == "/patient/appointments" || currentPath == "/patient/appointments/index" ? "active" : "")" asp-page="/Patient/Appointments/Index">
                <i class="bi bi-calendar-check"></i> My Appointments
            </a>
            <a class="nav-link @(currentPath.StartsWith("/patient/appointments/history") ? "active" : "")" asp-page="/Patient/Appointments/History">
                <i class="bi bi-clock-history"></i> Appointment History
            </a>
            <a class="nav-link @(currentPath.StartsWith("/patient/consultationrecords") ? "active" : "")" asp-page="/Patient/ConsultationRecords/Index">
                <i class="bi bi-file-medical"></i> Consultation Records
            </a>
            <a class="nav-link @(currentPath.StartsWith("/patient/treatmentcases") ? "active" : "")" asp-page="/Patient/TreatmentCases/Index">
                <i class="bi bi-heart-pulse"></i> Treatment Progress
            </a>
            <a class="nav-link @(currentPath.StartsWith("/patient/treatmentpackages") ? "active" : "")" asp-page="/Patient/TreatmentPackages/Index">
                <i class="bi bi-box-seam"></i> Treatment Packages
            </a>
            <a class="nav-link @(currentPath.StartsWith("/patient/journal") ? "active" : "")" asp-page="/Patient/Journal/Index">
                <i class="bi bi-journal-heart"></i> Mood Journal
            </a>
            <a class="nav-link @(currentPath.StartsWith("/patient/psyformetrics") ? "active" : "")" asp-page="/Patient/Psychometrics/TakeTest">
                <i class="bi bi-clipboard2-pulse"></i> Psychometric Tests
            </a>
            <a class="nav-link @(currentPath.StartsWith("/notifications") ? "active" : "")" asp-page="/Notifications/Index">
                <i class="bi bi-bell"></i> Notifications <span class="badge bg-danger rounded-pill ms-auto d-none" id="sidebar-notif-badge"></span>
            </a>
            <div class="sidebar-header mt-3">Quick Actions</div>
            <a class="nav-link" asp-page="/Doctors/Index">
                <i class="bi bi-search-heart"></i> Find a Therapist
            </a>
        </nav>
    }
    else if (isDoctor)
    {
        <div class="sidebar-header">Doctor Portal</div>
        <nav class="nav flex-column">
            <a class="nav-link @(currentPath == "/doctor/dashboard" ? "active" : "")" asp-page="/Doctor/Dashboard">
                <i class="bi bi-house"></i> Dashboard
            </a>

            @if (isVerified)
            {
                <a class="nav-link @(currentPath == "/doctor/appointments" || currentPath == "/doctor/appointments/index" ? "active" : "")" asp-page="/Doctor/Appointments/Index">
                    <i class="bi bi-calendar-check"></i> Appointment Management
                </a>
                <a class="nav-link @(currentPath.StartsWith("/doctor/appointments/history") ? "active" : "")" asp-page="/Doctor/Appointments/History">
                    <i class="bi bi-clock-history"></i> Appointment History
                </a>
                <a class="nav-link @(currentPath.StartsWith("/doctor/schedules") ? "active" : "")" asp-page="/Doctor/Schedules/Index">
                    <i class="bi bi-clock"></i> Schedules
                </a>
                <a class="nav-link @(currentPath.StartsWith("/doctor/patients") ? "active" : "")" asp-page="/Doctor/Patients/Index">
                    <i class="bi bi-person-lines-fill"></i> Patient Records
                </a>
                <a class="nav-link @(currentPath.StartsWith("/doctor/treatmentcases") ? "active" : "")" asp-page="/Doctor/TreatmentCases/Index">
                    <i class="bi bi-heart-pulse"></i> Treatment Progress
                </a>
                <a class="nav-link @(currentPath.StartsWith("/doctor/treatmentpackages") ? "active" : "")" asp-page="/Doctor/TreatmentPackages/Index">
                    <i class="bi bi-box-seam"></i> Treatment Packages
                </a>
                <a class="nav-link @(currentPath.StartsWith("/doctor/blogs") ? "active" : "")" asp-page="/Doctor/Blogs/Index">
                    <i class="bi bi-journal-text"></i> Blog Posts
                </a>
                <a class="nav-link @(currentPath.StartsWith("/notifications") ? "active" : "")" asp-page="/Notifications/Index">
                    <i class="bi bi-bell"></i> Notifications <span class="badge bg-danger rounded-pill ms-auto d-none" id="sidebar-notif-badge-doc"></span>
                </a>
            }
            else
            {
                <!-- Disabled items for unverified doctors -->
                <span class="nav-link disabled text-muted" title="Verification required">
                    <i class="bi bi-calendar-check"></i> Appointments <i class="bi bi-lock-fill ms-auto" style="font-size:0.7rem;"></i>
                </span>
                <span class="nav-link disabled text-muted" title="Verification required">
                    <i class="bi bi-clock"></i> Schedules <i class="bi bi-lock-fill ms-auto" style="font-size:0.7rem;"></i>
                </span>
                <span class="nav-link disabled text-muted" title="Verification required">
                    <i class="bi bi-person-lines-fill"></i> Patient Records <i class="bi bi-lock-fill ms-auto" style="font-size:0.7rem;"></i>
                </span>
                <span class="nav-link disabled text-muted" title="Verification required">
                    <i class="bi bi-box-seam"></i> Treatment Packages <i class="bi bi-lock-fill ms-auto" style="font-size:0.7rem;"></i>
                </span>
                <span class="nav-link disabled text-muted" title="Verification required">
                    <i class="bi bi-journal-text"></i> Blog Posts <i class="bi bi-lock-fill ms-auto" style="font-size:0.7rem;"></i>
                </span>
            }

            <div class="sidebar-header mt-3">Account</div>
            <a class="nav-link @(currentPath.StartsWith("/doctor/verification") ? "active" : "")" asp-page="/Doctor/Verification">
                <i class="bi bi-patch-check"></i> Identity Verification
                @if (!isVerified)
                {
                    <span class="badge bg-warning text-dark ms-auto" style="font-size:0.6rem;">Pending</span>
                }
            </a>

            @if (isVerified)
            {
                <a class="nav-link @(currentPath.StartsWith("/doctor/revenue") ? "active" : "")" asp-page="/Doctor/Revenue/Index">
                    <i class="bi bi-wallet2"></i> Earnings & Revenue
                </a>
                <a class="nav-link @(currentPath.StartsWith("/doctor/servicepackages") ? "active" : "")" asp-page="/Doctor/ServicePackages/Index">
                    <i class="bi bi-gem"></i> Service Packages
                </a>
                <a class="nav-link @(currentPath.StartsWith("/doctor/subscriptions") ? "active" : "")" asp-page="/Doctor/Subscriptions/Status">
                    <i class="bi bi-credit-card"></i> Subscription Status
                </a>
            }
        </nav>
    }
    else if (isCS)
    {
        <div class="sidebar-header">Customer Support</div>
        <nav class="nav flex-column">
            <a class="nav-link @(currentPath == "/customersupport/dashboard" ? "active" : "")" asp-page="/CustomerSupport/Dashboard">
                <i class="bi bi-house"></i> Dashboard
            </a>
            <a class="nav-link @(currentPath.StartsWith("/customersupport/doctorapplications") ? "active" : "")" asp-page="/CustomerSupport/DoctorApplications/Index">
                <i class="bi bi-person-check"></i> Doctor Applications
            </a>
            <a class="nav-link @(currentPath.StartsWith("/customersupport/blogmoderation") ? "active" : "")" asp-page="/CustomerSupport/BlogModeration/Index">
                <i class="bi bi-journal-check"></i> Blog Moderation
            </a>
        </nav>
    }
    else if (isBM)
    {
        <div class="sidebar-header">Business Manager</div>
        <nav class="nav flex-column">
            <a class="nav-link @(currentPath == "/businessmanager/dashboard" ? "active" : "")" asp-page="/BusinessManager/Dashboard">
                <i class="bi bi-house"></i> Dashboard
            </a>
            <a class="nav-link @(currentPath.StartsWith("/businessmanager/servicepackages") ? "active" : "")" asp-page="/BusinessManager/ServicePackages/Index">
                <i class="bi bi-gem"></i> Service Packages
            </a>
            <a class="nav-link @(currentPath.StartsWith("/businessmanager/specializations") ? "active" : "")" asp-page="/BusinessManager/Specializations/Index">
                <i class="bi bi-tags"></i> Specializations
            </a>
            <a class="nav-link @(currentPath.StartsWith("/businessmanager/analytics") ? "active" : "")" asp-page="/BusinessManager/Analytics">
                <i class="bi bi-graph-up"></i> Analytics
            </a>
            <a class="nav-link @(currentPath.StartsWith("/businessmanager/reports") ? "active" : "")" asp-page="/BusinessManager/Reports">
                <i class="bi bi-file-earmark-bar-graph"></i> Reports
            </a>
        </nav>
    }
    else if (isAdmin)
    {
        <div class="sidebar-header">System Admin</div>
        <nav class="nav flex-column">
            <a class="nav-link @(currentPath == "/admin/dashboard" ? "active" : "")" asp-page="/Admin/Dashboard">
                <i class="bi bi-house"></i> Dashboard
            </a>
            <a class="nav-link @(currentPath.StartsWith("/admin/users") ? "active" : "")" asp-page="/Admin/Users/Index">
                <i class="bi bi-people"></i> Users
            </a>
            <a class="nav-link @(currentPath.StartsWith("/admin/roles") ? "active" : "")" asp-page="/Admin/Roles/Index">
                <i class="bi bi-shield-check"></i> Roles
            </a>
            <a class="nav-link @(currentPath.StartsWith("/admin/permissions") ? "active" : "")" asp-page="/Admin/Permissions/Index">
                <i class="bi bi-key"></i> Permissions
            </a>
            <a class="nav-link @(currentPath.StartsWith("/admin/auditlogs") ? "active" : "")" asp-page="/Admin/AuditLogs/Index">
                <i class="bi bi-journal-text"></i> Audit Logs
            </a>
            <a class="nav-link @(currentPath.StartsWith("/admin/reports") ? "active" : "")" asp-page="/Admin/Reports">
                <i class="bi bi-file-earmark-bar-graph"></i> Reports
            </a>
            <a class="nav-link @(currentPath.StartsWith("/admin/settings") ? "active" : "")" asp-page="/Admin/Settings">
                <i class="bi bi-gear"></i> Settings
            </a>
        </nav>
    }
</aside>
