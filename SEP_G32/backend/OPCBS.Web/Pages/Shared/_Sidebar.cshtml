        </nav>

        <div class="sidebar-header mt-3">Clinical & Patients</div>
        <nav class="nav flex-column">
            @if (isVerified)
            {
                <a class="nav-link @(currentPath == "/doctor/appointments" || currentPath == "/doctor/appointments/index" ? "active" : "")" asp-page="/Doctor/Appointments/Index">
                    <i class="bi bi-calendar-check"></i> Appointments
                </a>
                <a class="nav-link @(currentPath.StartsWith("/doctor/schedules") ? "active" : "")" asp-page="/Doctor/Schedules/Index">
                    <i class="bi bi-clock"></i> Schedules & Hours
                </a>
                <a class="nav-link @(currentPath.StartsWith("/doctor/patients") ? "active" : "")" asp-page="/Doctor/Patients/Index">
                    <i class="bi bi-person-lines-fill"></i> Patient Records
                </a>
                <a class="nav-link @(currentPath.StartsWith("/doctor/treatmentcases") ? "active" : "")" asp-page="/Doctor/TreatmentCases/Index">
                    <i class="bi bi-heart-pulse"></i> Treatment Progress
                </a>
                <a class="nav-link @(currentPath.StartsWith("/doctor/psychometrics") ? "active" : "")" asp-page="/Doctor/Psychometrics/Index">
                    <i class="bi bi-clipboard2-pulse"></i> Psychometrics
                </a>
            }
            else
            {
                <span class="nav-link disabled text-muted" title="Verification required">
                    <i class="bi bi-calendar-check"></i> Appointments <i class="bi bi-lock-fill ms-auto" style="font-size:0.7rem;"></i>
                </span>
                <span class="nav-link disabled text-muted" title="Verification required">
                    <i class="bi bi-clock"></i> Schedules <i class="bi bi-lock-fill ms-auto" style="font-size:0.7rem;"></i>
                </span>
                <span class="nav-link disabled text-muted" title="Verification required">
                    <i class="bi bi-person-lines-fill"></i> Patient Records <i class="bi bi-lock-fill ms-auto" style="font-size:0.7rem;"></i>
                </span>
                <span class="nav-link disabled text-muted" title="Verification required">
                    <i class="bi bi-heart-pulse"></i> Treatment Progress <i class="bi bi-lock-fill ms-auto" style="font-size:0.7rem;"></i>
                </span>
                <span class="nav-link disabled text-muted" title="Verification required">
                    <i class="bi bi-clipboard2-pulse"></i> Psychometrics <i class="bi bi-lock-fill ms-auto" style="font-size:0.7rem;"></i>
                </span>
            }
        </nav>

        <div class="sidebar-header mt-3">Services & Content</div>
        <nav class="nav flex-column">
            @if (isVerified)
            {
                <a class="nav-link @(currentPath.StartsWith("/doctor/treatmentpackages") ? "active" : "")" asp-page="/Doctor/TreatmentPackages/Index">
                    <i class="bi bi-box-seam"></i> Treatment Packages
                </a>
                <a class="nav-link @(currentPath.StartsWith("/doctor/servicepackages") ? "active" : "")" asp-page="/Doctor/ServicePackages/Index">
                    <i class="bi bi-gem"></i> Service Packages
                </a>
                <a class="nav-link @(currentPath.StartsWith("/doctor/blogs") ? "active" : "")" asp-page="/Doctor/Blogs/Index">
                    <i class="bi bi-journal-text"></i> Blog Posts
                </a>
            }
            else
            {
                <span class="nav-link disabled text-muted" title="Verification required">
                    <i class="bi bi-box-seam"></i> Treatment Packages <i class="bi bi-lock-fill ms-auto" style="font-size:0.7rem;"></i>
                </span>
                <span class="nav-link disabled text-muted" title="Verification required">
                    <i class="bi bi-gem"></i> Service Packages <i class="bi bi-lock-fill ms-auto" style="font-size:0.7rem;"></i>
                </span>
                <span class="nav-link disabled text-muted" title="Verification required">
                    <i class="bi bi-journal-text"></i> Blog Posts <i class="bi bi-lock-fill ms-auto" style="font-size:0.7rem;"></i>
                </span>
            }
        </nav>

        <div class="sidebar-header mt-3">Practice & Finance</div>
        <nav class="nav flex-column">
            <a class="nav-link @(currentPath.StartsWith("/doctor/verification") ? "active" : "")" asp-page="/Doctor/Verification">
                <i class="bi bi-patch-check"></i> Identity Verification
                @if (!isVerified)
                {
                    <span class="badge bg-warning text-dark ms-auto" style="font-size:0.6rem;">Pending</span>
                }
            </a>

            @if (isVerified)
            {
                <a class="nav-link @(currentPath.StartsWith("/doctor/revenue") ? "active" : "")" asp-page="/Doctor/Revenue/Index">
                    <i class="bi bi-wallet2"></i> Earnings & Revenue
                </a>
                <a class="nav-link @(currentPath.StartsWith("/doctor/subscriptions") ? "active" : "")" asp-page="/Doctor/Subscriptions/Status">
                    <i class="bi bi-credit-card"></i> Subscription Status
                </a>
            }
        </nav>
    }
    else if (isCS)
    {
        <!-- ==================== CUSTOMER SUPPORT ==================== -->
        <div class="sidebar-header">Main</div>
        <nav class="nav flex-column">
            <a class="nav-link @(currentPath == "/customersupport/dashboard" ? "active" : "")" asp-page="/CustomerSupport/Dashboard">
                <i class="bi bi-house"></i> Dashboard
            </a>
            <a class="nav-link @(currentPath.StartsWith("/notifications") ? "active" : "")" asp-page="/Notifications/Index">
                <i class="bi bi-bell"></i> Notifications
            </a>
        </nav>

        <div class="sidebar-header mt-3">Moderation & Review</div>
        <nav class="nav flex-column">
            <a class="nav-link @(currentPath.StartsWith("/customersupport/doctorapplications") ? "active" : "")" asp-page="/CustomerSupport/DoctorApplications/Index">
                <i class="bi bi-person-check"></i> Doctor Applications
            </a>
            <a class="nav-link @(currentPath.StartsWith("/customersupport/blogmoderation") ? "active" : "")" asp-page="/CustomerSupport/BlogModeration/Index">
                <i class="bi bi-journal-check"></i> Blog Moderation
            </a>
            <a class="nav-link @(currentPath.StartsWith("/customersupport/violationreports") ? "active" : "")" asp-page="/CustomerSupport/ViolationReports/Index">
                <i class="bi bi-shield-exclamation"></i> Violation Reports
            </a>
        </nav>
    }
    else if (isBM)
    {
        <!-- ==================== BUSINESS MANAGER ==================== -->
        <div class="sidebar-header">Main</div>
        <nav class="nav flex-column">
            <a class="nav-link @(currentPath == "/businessmanager/dashboard" ? "active" : "")" asp-page="/BusinessManager/Dashboard">
                <i class="bi bi-house"></i> Dashboard
            </a>
            <a class="nav-link @(currentPath.StartsWith("/notifications") ? "active" : "")" asp-page="/Notifications/Index">
                <i class="bi bi-bell"></i> Notifications
            </a>
        </nav>

        <div class="sidebar-header mt-3">Catalog & Services</div>
        <nav class="nav flex-column">
            <a class="nav-link @(currentPath.StartsWith("/businessmanager/servicepackages") ? "active" : "")" asp-page="/BusinessManager/ServicePackages/Index">
