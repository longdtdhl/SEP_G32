@page "{id:guid}"
@model OPCBS.Web.Pages.CustomerSupport.BlogModeration.DetailsModel
@{
    ViewData["Title"] = "Article Review";
    Layout = "_DashboardLayout";
}

<style>
    .mod-detail-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }
    .mod-detail-title {
        font-size: 1.35rem;
        font-weight: 700;
        color: #0f172a;
        margin: 0;
    }

    .mod-content-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 2rem;
    }
    .mod-cover-img {
        width: 100%;
        max-height: 360px;
        object-fit: cover;
    }
    .mod-card-body {
        padding: 2rem;
    }

    .mod-category-badge {
        display: inline-block;
        background: #e6fffa;
        color: #0f766e;
        border: 1px solid #ccfbf1;
        padding: 0.2rem 0.65rem;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        margin-bottom: 0.75rem;
    }

    .mod-article-title {
        font-size: 1.6rem;
        font-weight: 700;
        color: #0f172a;
        line-height: 1.35;
        margin-bottom: 0.85rem;
    }

    .mod-article-meta {
        display: flex;
        gap: 1.25rem;
        font-size: 0.825rem;
        color: #64748b;
        margin-bottom: 1.25rem;
        flex-wrap: wrap;
        padding-bottom: 1rem;
        border-bottom: 1px solid #f1f5f9;
    }

    .mod-summary-box {
        background: #f8fafc;
        border-left: 4px solid var(--mb-primary);
        border-radius: 0 6px 6px 0;
        padding: 1rem 1.25rem;
        font-size: 0.9rem;
        color: #334155;
        margin-bottom: 1.5rem;
    }

    .mod-article-body {
        line-height: 1.8;
        font-size: 0.95rem;
        color: #334155;
    }

    /* Sidebar Cards */
    .mod-sidebar-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 1.25rem;
        margin-bottom: 1.25rem;
    }
    .mod-sidebar-title {
        font-size: 0.8rem;
        font-weight: 700;
        color: #0f172a;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.5rem 0;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.825rem;
    }
    .info-row:last-child {
        border-bottom: none;
    }

    .status-pill {
        padding: 0.25rem 0.6rem;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
    }
    .status-pending { background: #fffbeb; color: #92400e; border: 1px solid #fde68a; }
    .status-published { background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; }
    .status-rejected { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
</style>

<!-- Alerts -->
@{ var suc = TempData["Success"] as string; }
@if (suc != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" style="border-radius: 6px;">
        <i class="bi bi-check-circle me-1"></i>@suc
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (Model.Error != null)
{
    <div class="alert alert-warning alert-dismissible fade show mb-3" style="border-radius: 6px;">
        <i class="bi bi-exclamation-triangle me-1"></i>@Model.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Blog == null)
{
    <div class="mod-detail-header">
        <h1 class="mod-detail-title">Article Not Found</h1>
    </div>
    <div class="text-center py-5 text-muted">
        <i class="bi bi-journal-x d-block mb-3 display-5"></i>
        <p class="mb-3">This article post does not exist or has been deleted.</p>
        <a asp-page="Index" class="btn btn-sm btn-primary px-3" style="border-radius: 4px;">
            <i class="bi bi-arrow-left me-1"></i>Back to Queue
        </a>
    </div>
    return;
}

@{
    var blog = Model.Blog;
    var isPending = blog.Status?.Equals("PendingApproval", StringComparison.OrdinalIgnoreCase) == true || blog.Status?.Equals("Pending", StringComparison.OrdinalIgnoreCase) == true;
}

<!-- Header -->
<div class="mod-detail-header">
    <a asp-page="Index" class="btn btn-sm btn-outline-secondary" style="border-radius: 6px;" title="Back to Queue">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div>
        <h1 class="mod-detail-title"><i class="bi bi-journal-check me-2" style="color:var(--mb-primary);"></i>Review Article Submission</h1>
        <p class="text-muted small mb-0">Carefully examine article content before granting public publication.</p>
    </div>
</div>

<div class="row g-4">
    <!-- Article Content (8 cols) -->
    <div class="col-lg-8">
        <div class="mod-content-card">
            @if (!string.IsNullOrEmpty(blog.DisplayImage))
            {
                <img src="@blog.DisplayImage" alt="@blog.Title" class="mod-cover-img" />
            }
            <div class="mod-card-body">
                @if (!string.IsNullOrEmpty(blog.Category))
                {
                    <span class="mod-category-badge">@blog.Category</span>
                }
                <h2 class="mod-article-title">@blog.Title</h2>
                <div class="mod-article-meta">
                    <span><i class="bi bi-person me-1"></i>Author: <strong>@(blog.AuthorName ?? "Anonymous")</strong></span>
                    <span><i class="bi bi-calendar3 me-1"></i>Submitted: <strong>@blog.CreatedAt.ToString("MMM dd, yyyy HH:mm")</strong></span>
                    <span><i class="bi bi-eye me-1"></i>Views: <strong>@blog.ViewCount</strong></span>
                </div>
                @if (!string.IsNullOrEmpty(blog.DisplaySummary))
                {
                    <div class="mod-summary-box">
                        <strong>Summary Excerpt:</strong> @blog.DisplaySummary
                    </div>
                }
                @if (blog.Tags.Any())
                {
                    <div class="mb-3">
                        @foreach (var tag in blog.Tags)
                        {
                            <span class="badge bg-light text-dark border me-1">#@tag</span>
                        }
                    </div>
                }
                <div class="mod-article-body border-top pt-3">
                    @Html.Raw(blog.Content)
                </div>
            </div>
        </div>
    </div>

    <!-- Moderation Controls (4 cols) -->
    <div class="col-lg-4">
        <!-- Article Info Card -->
        <div class="mod-sidebar-card">
            <div class="mod-sidebar-title"><i class="bi bi-info-circle text-primary"></i>Article Information</div>
            @{
                var (statusText, statusClass) = blog.Status?.ToLower() switch
                {
                    "pending" or "pendingapproval" => ("Pending Review", "status-pending"),
                    "approved" or "published" => ("Published", "status-published"),
                    "rejected" => ("Rejected", "status-rejected"),
                    _ => ("Draft", "status-pending")
                };
            }
            <div class="info-row">
                <span class="text-muted">Status</span>
                <span class="status-pill @statusClass">@statusText</span>
            </div>
            <div class="info-row">
                <span class="text-muted">Author</span>
                <span class="fw-medium text-dark">@(blog.AuthorName ?? "—")</span>
            </div>
            <div class="info-row">
                <span class="text-muted">Category</span>
                <span class="fw-medium text-dark">@(blog.Category ?? "—")</span>
            </div>
            <div class="info-row">
                <span class="text-muted">Created Date</span>
                <span class="text-dark">@blog.CreatedAt.ToString("MMM dd, yyyy")</span>
            </div>
            @if (blog.UpdatedAt.HasValue)
            {
                <div class="info-row">
                    <span class="text-muted">Last Updated</span>
                    <span class="text-dark">@blog.UpdatedAt.Value.ToString("MMM dd, yyyy")</span>
                </div>
            }
        </div>

        <!-- Moderation Actions -->
        <div class="mod-sidebar-card">
            <div class="mod-sidebar-title"><i class="bi bi-clipboard-check text-primary"></i>Moderation Actions</div>
            @if (isPending)
            {
                <form method="post" asp-page-handler="Approve" asp-route-id="@blog.Id" class="mb-3">
                    <button type="submit" class="btn btn-success w-100" style="border-radius: 6px; font-weight: 600; font-size: 0.875rem;" onclick="return confirm('Confirm to approve and publish this article?')">
                        <i class="bi bi-check-circle me-1"></i>Approve & Publish
                    </button>
                </form>

                <div class="border-top pt-3">
                    <form method="post" asp-page-handler="Reject" asp-route-id="@blog.Id">
                        <div class="mb-2">
                            <label class="form-label small fw-semibold text-dark">Rejection Reason <span class="text-danger">*</span></label>
                            <textarea asp-for="RejectReason" class="form-control form-control-sm" rows="3" placeholder="Provide reason for rejection..." required style="border-radius: 6px;"></textarea>
                        </div>
                        <button type="submit" class="btn btn-outline-danger w-100" style="border-radius: 6px; font-weight: 600; font-size: 0.875rem;" onclick="return confirm('Confirm to reject this article?')">
                            <i class="bi bi-x-circle me-1"></i>Reject Article
                        </button>
                    </form>
                </div>
            }
            else
            {
                <div class="text-center py-3">
                    @if (blog.Status?.ToLower() is "approved" or "published")
                    {
                        <i class="bi bi-check-circle-fill text-success fs-2 mb-2 d-block"></i>
                        <p class="small text-dark mb-0">This article has been <strong>Approved & Published</strong>.</p>
                    }
                    else if (blog.Status?.ToLower() == "rejected")
                    {
                        <i class="bi bi-x-circle-fill text-danger fs-2 mb-2 d-block"></i>
                        <p class="small text-dark mb-0">This article has been <strong>Rejected</strong>.</p>
                    }
                    else
                    {
                        <i class="bi bi-file-earmark text-muted fs-2 mb-2 d-block"></i>
                        <p class="small text-muted mb-0">Article is in status <strong>@blog.Status</strong>.</p>
                    }
                </div>
            }
        </div>
    </div>
</div>
