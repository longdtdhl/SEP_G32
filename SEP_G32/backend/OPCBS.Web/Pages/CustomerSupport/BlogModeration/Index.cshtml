@page
@model OPCBS.Web.Pages.CustomerSupport.BlogModeration.IndexModel
@{
    ViewData["Title"] = "Blog Moderation Queue";
    Layout = "_DashboardLayout";
}

<style>
    .mod-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }
    .mod-header-title {
        font-size: 1.35rem;
        font-weight: 700;
        color: #0f172a;
        margin: 0;
    }
    .mod-header-subtitle {
        font-size: 0.85rem;
        color: #64748b;
        margin-top: 2px;
    }

    /* Table Container */
    .mod-table-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 2rem;
    }
    .mod-table-card .table {
        margin-bottom: 0;
    }
    .mod-table-card .table th {
        background: #f8fafc;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: #64748b;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid #e5e7eb;
    }
    .mod-table-card .table td {
        padding: 0.85rem 1rem;
        vertical-align: middle;
        font-size: 0.875rem;
        color: #334155;
        border-bottom: 1px solid #f1f5f9;
    }
    .mod-table-card .table tr:last-child td {
        border-bottom: none;
    }

    .mod-thumb-sm {
        width: 48px;
        height: 48px;
        border-radius: 6px;
        background: #f1f5f9;
        overflow: hidden;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #e5e7eb;
    }
    .mod-thumb-sm img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .mod-empty-state {
        text-align: center;
        padding: 4rem 2rem;
        background: #ffffff;
        border: 1px dashed #cbd5e1;
        border-radius: 8px;
    }
</style>

<!-- Header -->
<div class="mod-header">
    <div>
        <h1 class="mod-header-title"><i class="bi bi-journal-check me-2" style="color:var(--mb-primary);"></i>Blog Moderation Queue</h1>
        <p class="mod-header-subtitle">Review, verify, and publish submitted articles from medical specialists.</p>
    </div>
</div>

<!-- Alerts -->
@if (ViewData["Success"] is string suc)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" style="border-radius: 6px;">
        <i class="bi bi-check-circle me-1"></i>@suc
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (Model.Error != null)
{
    <div class="alert alert-warning alert-dismissible fade show mb-3" style="border-radius: 6px;">
        <i class="bi bi-exclamation-triangle me-1"></i>@Model.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Queue Table -->
@if (Model.Blogs.Any())
{
    <div class="mod-table-card">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th style="width: 60px;">Cover</th>
                        <th>Article Information</th>
                        <th style="width: 150px;">Author</th>
                        <th style="width: 140px;">Category</th>
                        <th style="width: 150px;">Submitted Date</th>
                        <th style="width: 110px;" class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var blog in Model.Blogs)
                    {
                        <tr>
                            <td>
                                <div class="mod-thumb-sm">
                                    @if (!string.IsNullOrEmpty(blog.DisplayImage))
                                    {
                                        <img src="@blog.DisplayImage" alt="" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-file-text text-muted"></i>
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark text-truncate" style="max-width: 400px;" title="@blog.Title">
                                    @blog.Title
                                </div>
                                <div class="text-muted text-xs text-truncate" style="max-width: 400px;">
                                    @(blog.DisplaySummary ?? "No summary provided")
                                </div>
                            </td>
                            <td>
                                <div class="fw-medium text-dark small">@(blog.AuthorName ?? "Anonymous")</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border fw-medium" style="font-size: 0.75rem;">
                                    @(blog.Category ?? "General")
                                </span>
                            </td>
                            <td class="small text-muted">
                                @(blog.SubmittedAt?.ToString("MMM dd, yyyy HH:mm") ?? blog.CreatedAt.ToString("MMM dd, yyyy"))
                            </td>
                            <td class="text-end">
                                <a asp-page="Details" asp-route-id="@blog.Id" class="btn btn-sm btn-primary px-3" style="border-radius: 4px; font-weight: 500;">
                                    Review
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="mod-empty-state">
        <i class="bi bi-check2-circle text-success display-6 mb-3 d-block" style="opacity: 0.6;"></i>
        <h5 class="fw-bold text-dark mb-1">No Pending Articles</h5>
        <p class="text-muted small mb-0">All submitted doctor articles have been moderated and published.</p>
    </div>
}

<!-- Pagination -->
@if (Model.Pagination != null && Model.Pagination.TotalPages > 1)
{
    <div class="d-flex justify-content-between align-items-center p-3" style="background:#ffffff; border-radius:8px; border:1px solid #e5e7eb;">
        <small class="text-muted">Page @Model.Pagination.Page of @Model.Pagination.TotalPages</small>
        <nav>
            <ul class="pagination pagination-sm mb-0">
                @for (int i = 1; i <= Math.Min(Model.Pagination.TotalPages, 10); i++)
                {
                    <li class="page-item @(i == Model.Pagination.Page ? "active" : "")">
                        <a class="page-link" asp-page="Index" asp-route-page="@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
}
