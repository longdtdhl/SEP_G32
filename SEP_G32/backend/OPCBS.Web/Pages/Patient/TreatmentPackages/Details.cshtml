@page
@model OPCBS.Web.Pages.Patient.TreatmentPackages.DetailsModel
@{
    ViewData["Title"] = "Treatment Package Details";
    Layout = "_DashboardLayout";
}

<style>
    .pkg-detail-sidebar { border-radius: 16px; border: 1px solid #f1f5f9; overflow: hidden; background: white; box-shadow: 0 1px 4px rgba(0,0,0,0.04); }
    .pkg-sidebar-header {
        padding: 1.1rem 1.25rem; border-bottom: 1px solid #f8fafc;
        font-weight: 700; font-size: 0.88rem; color: #1e293b;
        display: flex; align-items: center; gap: 8px; background: #fafbfc;
    }
    .pkg-sidebar-header i { color: var(--mb-primary); }
    .pkg-sidebar-row {
        display: flex; justify-content: space-between; align-items: center;
        padding: 10px 0; font-size: 0.85rem; border-bottom: 1px solid #f8fafc;
    }
    .pkg-sidebar-row:last-child { border-bottom: none; }
    .pkg-sidebar-row .label { color: #64748b; }
    .pkg-sidebar-row .value { font-weight: 600; color: #1e293b; }
    .instruction-box { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 12px; font-size: 0.85rem; color: #334155; white-space: pre-line; }
</style>

<!-- Page Header -->
<div class="mb-page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 style="font-size:1.4rem; font-weight:700; margin:0;">
            <i class="bi bi-box-seam-fill me-2" style="color:var(--mb-primary);"></i>Treatment Package Details
        </h1>
        <p style="margin:4px 0 0; font-size:0.85rem; color:#64748b;">View treatment package information assigned by your doctor</p>
    </div>
    <a asp-page="Index" class="btn btn-outline-secondary px-3 py-2" style="border-radius:10px; font-weight:600; font-size:0.85rem;">
        <i class="bi bi-arrow-left me-1"></i>Back to List
    </a>
</div>

@if (Model.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show" style="border-radius:12px; border:none;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Package != null)
{
    var pkg = Model.Package;
    var docName = string.IsNullOrWhiteSpace(pkg.DoctorName) ? "Therapist / Doctor" : pkg.DoctorName;

    <div class="row g-4">
        <!-- Main Content -->
        <div class="col-lg-8">
            <div class="pkg-detail-sidebar mb-4">
                <div class="pkg-sidebar-header"><i class="bi bi-info-circle-fill"></i>Package Overview</div>
                <div style="padding:1.25rem;">
                    <h4 class="fw-bold text-dark mb-2">@pkg.Title</h4>
                    <p class="text-secondary" style="font-size:0.9rem; line-height:1.6;">@pkg.Description</p>
                </div>
            </div>

            <!-- Detailed Treatment Plan -->
            @if (!string.IsNullOrEmpty(pkg.TargetOutcome) || !string.IsNullOrEmpty(pkg.RecommendedExercises) || !string.IsNullOrEmpty(pkg.Instructions))
            {
                <div class="pkg-detail-sidebar mb-4">
                    <div class="pkg-sidebar-header"><i class="bi bi-journal-medical"></i>Treatment Plan &amp; Goals</div>
                    <div style="padding:1.25rem;">
                        @if (!string.IsNullOrEmpty(pkg.TargetOutcome))
                        {
                            <div class="mb-3">
                                <span class="fw-bold text-dark d-block mb-1"><i class="bi bi-trophy me-1 text-warning"></i>Target Outcomes</span>
                                <div class="instruction-box">@pkg.TargetOutcome</div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(pkg.RecommendedExercises))
                        {
                            <div class="mb-3">
                                <span class="fw-bold text-dark d-block mb-1"><i class="bi bi-journal-check me-1 text-primary"></i>Recommended Exercises &amp; Activities</span>
                                <div class="instruction-box">@pkg.RecommendedExercises</div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(pkg.Instructions))
                        {
                            <div>
                                <span class="fw-bold text-dark d-block mb-1"><i class="bi bi-info-circle me-1 text-success"></i>Patient Guidance</span>
                                <div class="instruction-box">@pkg.Instructions</div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Sidebar Specifications & Register Action -->
        <div class="col-lg-4">
            <!-- Doctor Info -->
            <div class="pkg-detail-sidebar mb-3">
                <div class="pkg-sidebar-header"><i class="bi bi-person-badge-fill"></i>Assigned Doctor</div>
                <div style="padding:1.25rem; text-align:center;">
                    <div style="width:52px; height:52px; border-radius:14px; background:#f0fdf4; color:#166534; display:flex; align-items:center; justify-content:center; font-size:1.3rem; font-weight:700; margin:0 auto 8px;">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <div style="font-weight:700; font-size:1rem; color:#1e293b;">Dr. @docName</div>
                </div>
            </div>

            <!-- Package Specs -->
            <div class="pkg-detail-sidebar mb-3">
                <div class="pkg-sidebar-header"><i class="bi bi-sliders"></i>Package Details</div>
                <div style="padding:1rem 1.25rem;">
                    <div class="pkg-sidebar-row"><span class="label">Total Sessions</span><span class="value">@pkg.TotalSessions sessions</span></div>
                    <div class="pkg-sidebar-row"><span class="label">Completed Sessions</span><span class="value">@pkg.CompletedSessions sessions</span></div>
                    <div class="pkg-sidebar-row"><span class="label">Remaining Sessions</span><span class="value">@pkg.RemainingSessions sessions</span></div>
                    <div class="pkg-sidebar-row"><span class="label">Package Duration</span><span class="value">@pkg.ValidityDays days</span></div>
                    <div class="pkg-sidebar-row"><span class="label">Package Price</span><span class="value" style="color:var(--mb-primary); font-size:1.05rem;">@pkg.Price.ToString("N0") ₫</span></div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="pkg-detail-sidebar">
                <div class="pkg-sidebar-header"><i class="bi bi-lightning-charge"></i>Actions</div>
                <div style="padding:1.25rem;">
                    @if (pkg.Status == "Pending" || pkg.Status == "Created" || pkg.Status == "Assigned")
                    {
                        <p style="font-size:0.83rem; color:#64748b;" class="mb-3">
                            Confirm this treatment package to auto-create your personalized Treatment Case.
                        </p>
                        <form method="post" asp-page-handler="Accept" asp-route-id="@pkg.Id" class="mb-2">
                            <button type="submit" class="btn btn-primary w-100 py-2.5 fw-bold" style="border-radius:10px; background:var(--mb-primary); border-color:var(--mb-primary);">
                                <i class="bi bi-check-circle me-1"></i>Accept Package
                            </button>
                        </form>
                        <button type="button" class="btn btn-outline-danger w-100 py-2 fw-semibold" style="border-radius:10px;" data-bs-toggle="modal" data-bs-target="#rejectModal">
                            <i class="bi bi-x-circle me-1"></i>Decline Package
                        </button>
                    }
                    else if (pkg.Status == "Active" || pkg.Status == "Accepted")
                    {
                        <a asp-page="/Patient/TreatmentCases/Details" asp-route-id="@pkg.Id" class="btn btn-primary w-100 py-2.5 fw-bold" style="border-radius:10px; background:var(--mb-primary); border-color:var(--mb-primary);">
                            <i class="bi bi-graph-up me-1"></i>View Treatment Progress
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Reject Modal -->
    <div class="modal fade" id="rejectModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content" style="border-radius:14px;">
                <form method="post" asp-page-handler="Reject" asp-route-id="@pkg.Id">
                    <div class="modal-header border-0 pb-0">
                        <h5 class="modal-title fw-bold text-danger"><i class="bi bi-x-circle me-2"></i>Decline Treatment Package</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="small text-secondary mb-3">Are you sure you want to decline this treatment package?</p>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Reason for declining (optional)</label>
                            <textarea name="reason" class="form-control form-control-sm" rows="3" placeholder="Enter reason..." style="border-radius:8px;"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal" style="border-radius:8px;">Cancel</button>
                        <button type="submit" class="btn btn-danger btn-sm px-3" style="border-radius:8px;">Confirm Decline</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
