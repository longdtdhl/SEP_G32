@page
@model OPCBS.Web.Pages.Patient.Psychometrics.TakeTestModel
@{
    ViewData["Title"] = Model.Test?.Title ?? "Psychometric Screening";
    Layout = "_DashboardLayout";
}

@if (Model.Test != null)
{
    <div class="mb-page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h1><i class="bi bi-clipboard2-pulse me-2" style="color:var(--mb-primary);"></i>@Model.Test.Title</h1>
            <p class="text-muted mb-0">@Model.Test.Description</p>
        </div>
        @if (Model.AppointmentId.HasValue)
        {
            <a asp-page="/Patient/Appointments/Details" asp-route-id="@Model.AppointmentId.Value" class="btn btn-outline-secondary btn-sm" style="border-radius:10px;"><i class="bi bi-arrow-left me-1"></i>Back to Appointment</a>
        }
        else
        {
            <a asp-page="TakeTest" class="btn btn-outline-secondary btn-sm" style="border-radius:10px;"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
        }
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert" style="border-radius:12px; border:none;">
            <i class="bi bi-exclamation-triangle me-1"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Error != null)
    {
        <div class="alert alert-danger mt-3" style="border-radius:12px; border:none;">
            <i class="bi bi-exclamation-triangle me-1"></i>@Model.Error
        </div>
    }
    else
    {
        var isPhq9 = Model.Test.TestType == "PHQ9";
        
        <form method="post" asp-page-handler="Submit" asp-route-testId="@Model.Test.Id" asp-route-appointmentId="@Model.AppointmentId" id="testForm" class="mt-4">
            <div class="d-flex flex-column gap-3 mb-4">
                @foreach (var q in Model.Questions)
                {
                    <div class="card border-0 shadow-sm question-card" id="q-card-@q.Id" style="border-radius:16px;">
                        <div class="card-body p-4">
                            <h5 class="card-title d-flex align-items-start gap-2 fs-6">
                                <span class="badge bg-primary rounded-circle d-inline-flex align-items-center justify-content-center" style="width:24px;height:24px;flex-shrink:0; background-color:var(--mb-primary) !important;">@q.QuestionNumber</span>
                                <span class="lh-sm" style="color:#1e293b; font-weight:700;">@q.QuestionText</span>
                            </h5>
                            <div class="row g-2 mt-3 option-group">
                                @if (isPhq9)
                                {
                                    <div class="col-md-3 col-sm-6">
                                        <label class="option-label text-center p-3 rounded border w-100 cursor-pointer d-block" style="border-radius:12px !important;">
                                            <input type="radio" name="answers[@q.Id]" value="0" required class="d-none" />
                                            <strong>0</strong>
                                            <span class="d-block small text-muted mt-1">Not at all</span>
                                        </label>
                                    </div>
                                    <div class="col-md-3 col-sm-6">
                                        <label class="option-label text-center p-3 rounded border w-100 cursor-pointer d-block" style="border-radius:12px !important;">
                                            <input type="radio" name="answers[@q.Id]" value="1" class="d-none" />
                                            <strong>1</strong>
                                            <span class="d-block small text-muted mt-1">Several days</span>
                                        </label>
                                    </div>
                                    <div class="col-md-3 col-sm-6">
                                        <label class="option-label text-center p-3 rounded border w-100 cursor-pointer d-block" style="border-radius:12px !important;">
                                            <input type="radio" name="answers[@q.Id]" value="2" class="d-none" />
                                            <strong>2</strong>
                                            <span class="d-block small text-muted mt-1">More than half the days</span>
                                        </label>
                                    </div>
                                    <div class="col-md-3 col-sm-6">
                                        <label class="option-label text-center p-3 rounded border w-100 cursor-pointer d-block" style="border-radius:12px !important;">
                                            <input type="radio" name="answers[@q.Id]" value="3" class="d-none" />
                                            <strong>3</strong>
                                            <span class="d-block small text-muted mt-1">Nearly every day</span>
                                        </label>
                                    </div>
                                }
                                else
                                {
                                    <div class="col-md-3 col-sm-6">
                                        <label class="option-label text-center p-3 rounded border w-100 cursor-pointer d-block" style="border-radius:12px !important;">
                                            <input type="radio" name="answers[@q.Id]" value="0" required class="d-none" />
                                            <strong>0</strong>
                                            <span class="d-block small text-muted mt-1">Not at all</span>
                                        </label>
                                    </div>
                                    <div class="col-md-3 col-sm-6">
                                        <label class="option-label text-center p-3 rounded border w-100 cursor-pointer d-block" style="border-radius:12px !important;">
                                            <input type="radio" name="answers[@q.Id]" value="1" class="d-none" />
                                            <strong>1</strong>
                                            <span class="d-block small text-muted mt-1">Several days</span>
                                        </label>
                                    </div>
                                    <div class="col-md-3 col-sm-6">
                                        <label class="option-label text-center p-3 rounded border w-100 cursor-pointer d-block" style="border-radius:12px !important;">
                                            <input type="radio" name="answers[@q.Id]" value="2" class="d-none" />
                                            <strong>2</strong>
                                            <span class="d-block small text-muted mt-1">More than half the days</span>
                                        </label>
                                    </div>
                                    <div class="col-md-3 col-sm-6">
                                        <label class="option-label text-center p-3 rounded border w-100 cursor-pointer d-block" style="border-radius:12px !important;">
                                            <input type="radio" name="answers[@q.Id]" value="3" class="d-none" />
                                            <strong>3</strong>
                                            <span class="d-block small text-muted mt-1">Nearly every day</span>
                                        </label>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="card border-0 shadow-sm mb-5" style="border-radius:16px;">
                <div class="card-body p-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
                    <span class="text-muted fw-semibold" id="progressText">Answered: 0/@Model.Questions.Count questions</span>
                    <button type="submit" class="btn btn-primary px-4 py-2" id="submitBtn" style="border-radius:10px; background:var(--mb-primary); border-color:var(--mb-primary); font-weight:600;"><i class="bi bi-send-check me-2"></i>Submit Results</button>
                </div>
            </div>
        </form>
    }
}
else
{
    <!-- Overview/Landing page mode: list all tests & past submissions -->
    <div class="mb-page-header">
        <h1 style="font-size:1.4rem; font-weight:700; margin:0;">
            <i class="bi bi-clipboard2-pulse-fill me-2" style="color:var(--mb-primary);"></i>Psychometric Screening
        </h1>
        <p style="margin:4px 0 0; font-size:0.85rem; color:#64748b;">Take quick tests to monitor your psyforlogical state</p>
    </div>

    @if (Model.Error != null)
    {
        <div class="alert alert-danger mt-3" style="border-radius:12px; border:none;">
            <i class="bi bi-exclamation-triangle me-1"></i>@Model.Error
        </div>
    }
    else
    {
        <div class="row g-4 mt-2">
            <!-- Left Panel: Available Tests -->
            <div class="col-lg-6">
                <h5 class="fw-bold mb-3" style="font-size:1rem; color:#1e293b;">
                    <i class="bi bi-patch-check-fill me-2" style="color:var(--mb-primary);"></i>Available Tests
                </h5>
                <div class="d-flex flex-column gap-3">
                    @foreach (var t in Model.AvailableTests)
                    {
                        <div class="card border-0 shadow-sm" style="border-radius:16px; border-left: 4px solid var(--mb-primary) !important;">
                            <div class="card-body p-4">
                                <h6 class="fw-bold mb-2 text-dark" style="font-size:1rem;">@t.Title</h6>
                                <p class="text-secondary small mb-3" style="line-height:1.6;">@t.Description</p>
                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                    <span class="badge bg-light text-dark px-2.5 py-1.5 rounded-pill" style="font-size:0.75rem; font-weight:600;">Type: @t.TestType</span>
                                    <a asp-page="TakeTest" asp-route-testId="@t.Id" class="btn btn-primary btn-sm px-3" style="border-radius:8px; background:var(--mb-primary); border-color:var(--mb-primary); font-weight:600;">
                                        Start Test <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Right Panel: Submission History -->
            <div class="col-lg-6">
                <h5 class="fw-bold mb-3" style="font-size:1rem; color:#1e293b;">
                    <i class="bi bi-clock-history me-2" style="color:#6366f1;"></i>Test History
                </h5>
                @if (Model.Submissions.Any())
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var s in Model.Submissions)
                        {
                            <div class="card border-0 shadow-sm" style="border-radius:16px;">
                                <div class="card-body p-3">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h6 class="fw-bold mb-1 text-dark" style="font-size:0.9rem;">@s.TestTitle</h6>
                                            <div style="font-size:0.72rem; color:#94a3b8;">
                                                <i class="bi bi-calendar3 me-1"></i>@s.SubmittedAt.ToString("MM/dd/yyyy HH:mm")
                                            </div>
                                        </div>
                                        <span class="badge bg-primary rounded-pill px-2.5 py-1" style="font-size:0.75rem; background-color:rgba(78,139,112,0.12) !important; color:var(--mb-primary) !important;">
                                            Score: @s.TotalScore
                                        </span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(s.Interpretation))
                                    {
                                        <div class="p-2 rounded-3 mb-2 small text-secondary" style="background:#f8fafc; border-left:3px solid #cbd5e1;">
                                            <strong>Result:</strong> @s.Interpretation
                                        </div>
                                    }
                                    <div class="text-end">
                                        <a asp-page="Result" asp-route-submissionId="@s.Id" class="btn btn-link btn-sm text-decoration-none p-0 fw-bold" style="font-size:0.78rem;">
                                            View detailed results <i class="bi bi-arrow-right"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted border border-dashed rounded-3" style="border-radius:16px; background:#fafbfc;">
                        <i class="bi bi-clipboard2-x d-block mb-2" style="font-size:2.5rem; opacity:0.3;"></i>
                        <h6 class="fw-bold text-dark">No test submissions yet</h6>
                        <span class="small">Your screening test history will appear here.</span>
                    </div>
                }
            </div>
        </div>
    }
}

<style>
    .option-label {
        transition: all 0.2s ease;
        background: var(--mb-bg-light, #f8f9fa);
        border-color: #dee2e6;
    }
    .option-label:hover {
        background: #e9ecef;
        border-color: #adb5bd;
    }
    .option-label.selected {
        background: rgba(78,139,112,0.08) !important;
        border-color: var(--mb-primary, #4e8b70) !important;
        color: var(--mb-primary, #4e8b70) !important;
        box-shadow: 0 0 0 3px rgba(78, 139, 112, 0.15);
    }
    .question-card {
        transition: all 0.3s ease;
        border-left: 4px solid transparent !important;
    }
    .question-card.answered {
        border-left-color: var(--mb-primary, #4e8b70) !important;
    }
    .question-card.error {
        border-left-color: #dc3545 !important;
        box-shadow: 0 0 0 3px rgba(220, 53, 69, 0.1) !important;
    }
    .cursor-pointer {
        cursor: pointer;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("testForm");
            if (!form) return;

            const totalQuestions = @Model.Questions.Count;
            const progressText = document.getElementById("progressText");

            // Attach event listener to all radio options
            form.querySelectorAll("input[type='radio']").forEach(radio => {
                radio.addEventListener("change", function () {
                    const group = this.closest(".option-group");
                    const card = this.closest(".question-card");

                    // Clear previous selection in this group
                    group.querySelectorAll(".option-label").forEach(label => {
                        label.classList.remove("selected");
                    });

                    // Highlight selected option
                    this.closest(".option-label").classList.add("selected");
                    card.classList.add("answered");
                    card.classList.remove("error");

                    // Update progress
                    const answeredCount = form.querySelectorAll(".question-card.answered").length;
                    progressText.textContent = `Answered: ${answeredCount}/${totalQuestions} questions`;
                });
            });

            // Prevent form submit if not all questions are answered
            form.addEventListener("submit", function (e) {
                let hasError = false;
                form.querySelectorAll(".question-card").forEach(card => {
                    const radioChecked = card.querySelector("input[type='radio']:checked");
                    if (!radioChecked) {
                        card.classList.add("error");
                        hasError = true;
                    }
                });

                if (hasError) {
                    e.preventDefault();
                    // Scroll to first unanswered question
                    const firstError = form.querySelector(".question-card.error");
                    if (firstError) {
                        firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                    alert("Please answer all questions before submitting.");
                }
            });
        });
    </script>
}
