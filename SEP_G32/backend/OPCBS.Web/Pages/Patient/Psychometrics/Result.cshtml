@page
@model OPCBS.Web.Pages.Patient.Psychometrics.ResultModel
@{
    ViewData["Title"] = "Result reviews psyforlogy";
    ViewData["UseDashboardLayout"] = true;
}

<div class="mb-page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <h1><i class="bi bi-bar-chart-line-fill me-2" style="color:var(--mb-primary);"></i>Result reviews psyforlogy</h1>
        <p class="text-muted mb-0">Xem results chi tiết your and the recommend hữu ích.</p>
    </div>
    @if (Model.Submission?.AppointmentId != null)
    {
        <a asp-page="/Patient/Appointments/Details" asp-route-id="@Model.Submission.AppointmentId.Value" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back appointment</a>
    }
    else
    {
        <a asp-page="/Patient/Appointments/Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back danh sách</a>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        <i class="bi bi-check-circle-fill me-1"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Error != null)
{
    <div class="alert alert-danger mt-3">
        <i class="bi bi-exclamation-triangle me-1"></i>@Model.Error
    </div>
}
else if (Model.Submission != null)
{
    var sub = Model.Submission;
    var isDass21 = sub.TestType == "DASS21";
    
    <div class="row g-4 mt-2">
        <!-- Chart & Score Card -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h5 class="card-title mb-4">@sub.TestTitle</h5>
                    
                    @if (isDass21)
                    {
                        <!-- Depression Score -->
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong>Depression (Depression)</strong>
                                <span class="badge @GetDassBadgeClass(Model.DepressionScore, "Depression")">@Model.DepressionScore / 42 — @GetDassInterpretationText(Model.DepressionScore, "Depression")</span>
                            </div>
                            <div class="progress" style="height: 12px; border-radius: 6px;">
                                <div class="progress-bar @GetDassProgressBarClass(Model.DepressionScore, "Depression")" role="progressbar" style="width: @(Model.DepressionScore * 100 / 42)%;" aria-valuenow="@Model.DepressionScore" aria-valuemin="0" aria-valuemax="42"></div>
                            </div>
                            <small class="text-muted d-block mt-1">Đo lường the status giảm hứng thú, chán nản, u uất and mất động lực cuộc sống.</small>
                        </div>

                        <!-- Anxiety Score -->
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong>Anxiety (Anxiety)</strong>
                                <span class="badge @GetDassBadgeClass(Model.AnxietyScore, "Anxiety")">@Model.AnxietyScore / 42 — @GetDassInterpretationText(Model.AnxietyScore, "Anxiety")</span>
                            </div>
                            <div class="progress" style="height: 12px; border-radius: 6px;">
                                <div class="progress-bar @GetDassProgressBarClass(Model.AnxietyScore, "Anxiety")" role="progressbar" style="width: @(Model.AnxietyScore * 100 / 42)%;" aria-valuenow="@Model.AnxietyScore" aria-valuemin="0" aria-valuemax="42"></div>
                            </div>
                            <small class="text-muted d-block mt-1">Đo lường the phản ứng lo sợ vô cớ, run rẩy, khó breathing, lo lắng về the tình huống hoảng loạn.</small>
                        </div>

                        <!-- Stress Score -->
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong>Stressed (Stress)</strong>
                                <span class="badge @GetDassBadgeClass(Model.StressScore, "Stress")">@Model.StressScore / 42 — @GetDassInterpretationText(Model.StressScore, "Stress")</span>
                            </div>
                            <div class="progress" style="height: 12px; border-radius: 6px;">
                                <div class="progress-bar @GetDassProgressBarClass(Model.StressScore, "Stress")" role="progressbar" style="width: @(Model.StressScore * 100 / 42)%;" aria-valuenow="@Model.StressScore" aria-valuemin="0" aria-valuemax="42"></div>
                            </div>
                            <small class="text-muted d-block mt-1">Đo lường mức độ khó thư giãn, dễ kích động, thiếu kiên nhẫn and phản ứng thái quá.</small>
                        </div>
                    }
                    else
                    {
                        <!-- PHQ-9 Score -->
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong>Điểm depression PHQ-9</strong>
                                <span class="badge @GetPhq9BadgeClass(sub.TotalScore)">@sub.TotalScore / 27 — @sub.Interpretation</span>
                            </div>
                            <div class="progress" style="height: 12px; border-radius: 6px;">
                                <div class="progress-bar @GetPhq9ProgressBarClass(sub.TotalScore)" role="progressbar" style="width: @(sub.TotalScore * 100 / 27)%;" aria-valuenow="@sub.TotalScore" aria-valuemin="0" aria-valuemax="27"></div>
                            </div>
                            <small class="text-muted d-block mt-1">Thang reviews health patient đo lường mức độ the triệu chứng depression trong 2 tuần qua.</small>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Interpretation & Next Steps -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                    <h5 class="mb-0"><i class="bi bi-shield-heart text-danger me-2"></i>Diễn giải results</h5>
                </div>
                <div class="card-body p-4">
                    <p class="mb-3">Dựa trên câu trả lời your, system recorded tình trạng cảm xúc current:</p>
                    <div class="alert alert-secondary border-0 p-3 mb-4 text-center fs-5 fw-bold" style="border-radius:12px; background:#f0f2f5;">
                        @sub.Interpretation
                    </div>

                    <h6>Khuyến nghị of MindBridge:</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 text-muted small mt-2">
                        <li><i class="bi bi-circle-fill text-primary me-2" style="font-size:0.5rem; vertical-align:middle;"></i>Result this được đo lường dựa trên the câu trả lời mang tính tự báo cáo (self-report) and không thay thế for diagnosis y tế in-depth.</li>
                        <li><i class="bi bi-circle-fill text-primary me-2" style="font-size:0.5rem; vertical-align:middle;"></i>Hãy share results this with doctor psyforlogy trong appointment session upcoming to help orientation therapy accurate more.</li>
                        <li><i class="bi bi-circle-fill text-primary me-2" style="font-size:0.5rem; vertical-align:middle;"></i>Nếu the điểm số ở mức <strong>Severe hoặc Very Severe</strong>, bạn nên ưu tiên booking consultation sớm to được support chuyên nghiệp kịp thời.</li>
                    </ul>
                </div>
            </div>
            
            <div class="d-grid gap-2">
                @if (sub.AppointmentId != null)
                {
                    <a asp-page="/Patient/Appointments/Details" asp-route-id="@sub.AppointmentId.Value" class="btn btn-primary btn-lg"><i class="bi bi-calendar-check me-2"></i>Back chi tiết appointment</a>
                }
                else
                {
                    <a asp-page="/Patient/Appointments/Index" class="btn btn-primary btn-lg"><i class="bi bi-list-check me-2"></i>Xem danh sách appointment</a>
                }
            </div>
        </div>
    </div>
}

@functions {
    private string GetDassInterpretationText(int score, string category)
    {
        if (category == "Depression")
        {
            if (score <= 9) return "Normal";
            if (score <= 13) return "Mild";
            if (score <= 20) return "Vừa";
            if (score <= 27) return "Severe";
            return "Very Severe";
        }
        else if (category == "Anxiety")
        {
            if (score <= 7) return "Normal";
            if (score <= 9) return "Mild";
            if (score <= 14) return "Vừa";
            if (score <= 19) return "Severe";
            return "Very Severe";
        }
        else // Stress
        {
            if (score <= 14) return "Normal";
            if (score <= 18) return "Mild";
            if (score <= 25) return "Vừa";
            if (score <= 33) return "Severe";
            return "Very Severe";
        }
    }

    private string GetDassBadgeClass(int score, string category)
    {
        var interpretation = GetDassInterpretationText(score, category);
        return interpretation switch
        {
            "Normal" => "bg-success-subtle text-success",
            "Mild" => "bg-info-subtle text-info",
            "Vừa" => "bg-warning-subtle text-warning",
            "Severe" => "bg-danger-subtle text-danger",
            "Very Severe" => "bg-danger text-white",
            _ => "bg-secondary-subtle text-secondary"
        };
    }

    private string GetDassProgressBarClass(int score, string category)
    {
        var interpretation = GetDassInterpretationText(score, category);
        return interpretation switch
        {
            "Normal" => "bg-success",
            "Mild" => "bg-info",
            "Vừa" => "bg-warning",
            "Severe" => "bg-danger",
            "Very Severe" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private string GetPhq9BadgeClass(int score)
    {
        if (score <= 4) return "bg-success-subtle text-success";
        if (score <= 9) return "bg-info-subtle text-info";
        if (score <= 14) return "bg-warning-subtle text-warning";
        return "bg-danger-subtle text-danger";
    }

    private string GetPhq9ProgressBarClass(int score)
    {
        if (score <= 4) return "bg-success";
        if (score <= 9) return "bg-info";
        if (score <= 14) return "bg-warning";
        return "bg-danger";
    }
}
