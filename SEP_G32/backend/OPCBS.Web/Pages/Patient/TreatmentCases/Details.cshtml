@page
@model OPCBS.Web.Pages.Patient.TreatmentCases.DetailsModel
@{
    ViewData["Title"] = Model.Case?.CaseName ?? "My Treatment Progress";
    Layout = "_DashboardLayout";
}
<style>
    .tc-strip { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; font-size: 0.875rem; color: #475569; }
    .tc-strip .tc-chip { background: #f1f5f9; border-radius: 6px; padding: 5px 12px; font-weight: 600; white-space: nowrap; }
    .tc-strip .tc-chip strong { color: #1e293b; }
    .tc-tabs { background: #fff; padding: 4px; border-radius: 8px; border: 1px solid #e2e8f0; display: flex; flex-wrap: nowrap; gap: 2px; overflow-x: auto; }
    .tc-tabs .nav-link { border-radius: 6px; font-weight: 600; font-size: 0.875rem; color: #64748b; padding: 8px 16px; white-space: nowrap; }
    .tc-tabs .nav-link.active { background: #0d9488; color: #fff; }
    .tc-tabs .nav-link:hover:not(.active) { background: #f0fdfa; color: #0f766e; }
    .tc-section { background: #fff; border-radius: 8px; border: 1px solid #e2e8f0; padding: 1.5rem; }
    .tc-section h6 { font-size: 1.125rem; }
    .tc-tbl { font-size: 0.875rem; }
    .tc-tbl th { font-weight: 600; color: #475569; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em; border-bottom: 2px solid #e2e8f0; padding: 10px 12px; }
    .tc-tbl td { vertical-align: middle; border-bottom: 1px solid #f1f5f9; padding: 10px 12px; }
    .tc-empty { text-align: center; padding: 3rem 1rem; color: #94a3b8; }
    .tc-empty i { font-size: 2.5rem; display: block; margin-bottom: .75rem; }
    .tc-progress-bar { height: 8px; border-radius: 4px; background: #e2e8f0; overflow: hidden; min-width: 80px; }
    .tc-progress-bar .bar { height: 100%; border-radius: 4px; transition: width .3s; }
    .hw-submit-form { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1.25rem; margin-top: 0.75rem; }
</style>

<div class="container-fluid py-3">
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger rounded-3 mb-3"><i class="bi bi-exclamation-triangle me-2"></i>@Model.ErrorMessage</div>
    }

    @if (Model.Case == null)
    {
        <div class="alert alert-warning rounded-3">Treatment case not found.</div>
        return;
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success rounded-3 mb-3"><i class="bi bi-check-circle me-2"></i>@Model.SuccessMessage</div>
    }

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-start mb-3 gap-2">
        <div>
            <a href="/Patient/TreatmentCases" class="text-decoration-none text-muted small d-inline-block mb-1">
                <i class="bi bi-arrow-left me-1"></i>Back to Treatment Cases
            </a>
            <h4 class="fw-bold mb-1">@Model.Case.CaseName</h4>
            <div class="tc-strip">
                <span class="@Model.Case.StatusBadgeClass">@Model.Case.StatusText</span>
                <span class="tc-chip"><i class="bi bi-person-badge me-1"></i>Dr. @(Model.Case.DoctorName ?? "Unknown")</span>
                <span class="tc-chip"><i class="bi bi-calendar-event me-1"></i>@Model.Case.StartDate.ToString("MMM dd, yyyy")</span>
            </div>
        </div>
        <a href="/Patient/Journal/Index" class="btn btn-warning btn-sm text-dark fw-bold">
            <i class="bi bi-emoji-smile me-1"></i>Open Mood Journey
        </a>
    </div>

    <!-- Compact Info Strip -->
    <div class="tc-strip mb-3 p-2 rounded-3" style="background: #f8fafc; border: 1px solid #e2e8f0;">
        @{
            var prog = Model.Progress?.OverallProgressPercent ?? Model.Case.OverallProgressPercent;
        }
        <span class="tc-chip"><strong>@prog%</strong> Progress</span>
        <span class="tc-chip"><strong>@Model.Case.CompletedSessions</strong>/@Model.Case.TotalSessions Sessions</span>
        <span class="tc-chip"><strong>@Model.Case.AchievedGoalCount</strong>/@Model.Case.GoalCount Goals</span>
        @if (Model.Progress?.DaysRemaining.HasValue == true)
        {
            <span class="tc-chip"><strong>@Model.Progress.DaysRemaining</strong> days remaining</span>
        }
        <div class="tc-progress-sm flex-grow-1" style="max-width: 120px;">
            <div class="bar bg-success" style="width: @prog%"></div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <nav class="tc-tabs mb-3">
        <a class="nav-link @(Model.ActiveTab == "overview" ? "active" : "")" href="?id=@Model.Case.Id&tab=overview"><i class="bi bi-info-circle me-1"></i>Overview</a>
        <a class="nav-link @(Model.ActiveTab == "sessions" ? "active" : "")" href="?id=@Model.Case.Id&tab=sessions"><i class="bi bi-camera-video me-1"></i>Sessions <span class="badge bg-light text-dark ms-1">@Model.Sessions.Count</span></a>
        <a class="nav-link @(Model.ActiveTab == "goals" ? "active" : "")" href="?id=@Model.Case.Id&tab=goals"><i class="bi bi-bullseye me-1"></i>Goals <span class="badge bg-light text-dark ms-1">@Model.Goals.Count</span></a>
        <a class="nav-link @(Model.ActiveTab == "homework" ? "active" : "")" href="?id=@Model.Case.Id&tab=homework"><i class="bi bi-journal-check me-1"></i>Homework <span class="badge bg-light text-dark ms-1">@Model.HomeworkList.Count</span></a>
        <a class="nav-link @(Model.ActiveTab == "mood" ? "active" : "")" href="?id=@Model.Case.Id&tab=mood"><i class="bi bi-emoji-smile me-1"></i>Mood <span class="badge bg-light text-dark ms-1">@Model.MoodEntries.Count</span></a>
        <a class="nav-link @(Model.ActiveTab == "timeline" ? "active" : "")" href="?id=@Model.Case.Id&tab=timeline"><i class="bi bi-clock-history me-1"></i>Timeline</a>
    </nav>

    <!-- Tab Content -->
    <div>
        <!-- OVERVIEW -->
        @if (Model.ActiveTab == "overview")
        {
            <div class="row g-3">
                <div class="col-lg-6">
                    <div class="tc-section h-100">
                        <h6 class="fw-bold mb-3"><i class="bi bi-person-workspace me-2 text-primary"></i>Case Information</h6>
                        <p class="mb-2 small"><strong>Treatment Description:</strong></p>
                        <p class="text-secondary small">@(Model.Case.CaseDescription ?? "No description provided.")</p>
                        <p class="mb-2 small"><strong>Primary Concern:</strong></p>
                        <div class="p-2 bg-light rounded-2 small text-secondary">@(Model.Case.PrimaryConcern ?? "Not specified.")</div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="tc-section h-100">
                        <h6 class="fw-bold mb-3"><i class="bi bi-box-seam me-2 text-success"></i>Package Details</h6>
                        <table class="table table-borderless table-sm mb-0" style="font-size: 0.85rem;">
                            <tbody>
                                <tr><td class="text-muted" style="width:40%">Package</td><td class="fw-semibold">@(Model.Case.PackageNameSnapshot ?? Model.Case.CaseName)</td></tr>
                                <tr><td class="text-muted">Total Sessions</td><td>@Model.Case.TotalSessionsSnapshot sessions</td></tr>
                                <tr><td class="text-muted">Doctor Guidance</td><td>@(Model.Case.PatientGuidanceSnapshot ?? "Not specified")</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        <!-- SESSIONS (Patient sees summary only — no private notes) -->
        @if (Model.ActiveTab == "sessions")
        {
            <div class="tc-section">
                <h6 class="fw-bold mb-3">Treatment Sessions</h6>
                @if (!Model.Sessions.Any())
                {
                    <div class="tc-empty">
                        <i class="bi bi-calendar-x"></i>
                        <p>Your doctor has not scheduled any sessions yet.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table tc-tbl align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Title</th>
                                    <th>Date</th>
                                    <th>Summary</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model.Sessions.OrderBy(x => x.SessionNumber))
                                {
                                    <tr>
                                        <td class="fw-bold text-muted">@s.SessionNumber</td>
                                        <td class="fw-semibold">@(s.Title ?? $"Session {s.SessionNumber}")</td>
                                        <td class="small">@(s.PlannedStartTime?.ToString("MMM dd, yyyy HH:mm") ?? "Not scheduled")</td>
                                        <td class="small text-muted">@(s.PatientFriendlySummary ?? "—")</td>
                                        <td><span class="@s.StatusBadgeClass">@s.StatusText</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }

        <!-- GOALS -->
        @if (Model.ActiveTab == "goals")
        {
            <div class="tc-section">
                <h6 class="fw-bold mb-3">Treatment Goals</h6>
                @if (!Model.Goals.Any())
                {
                    <div class="tc-empty">
                        <i class="bi bi-bullseye"></i>
                        <p>Your doctor has not set any treatment goals yet.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table tc-tbl align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Goal</th>
                                    <th>Progress</th>
                                    <th>Deadline</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var g in Model.Goals)
                                {
                                    <tr>
                                        <td>
                                            <span class="fw-semibold">@g.Title</span>
                                            @if (!string.IsNullOrEmpty(g.Description))
                                            {
                                                <br /><small class="text-muted">@(g.Description.Length > 80 ? g.Description[..80] + "…" : g.Description)</small>
                                            }
                                        </td>
                                        <td style="min-width: 100px;">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="tc-progress-sm flex-grow-1"><div class="bar bg-success" style="width: @g.ProgressPercent%"></div></div>
                                                <small class="fw-bold">@g.ProgressPercent%</small>
                                            </div>
                                        </td>
                                        <td class="small">@(g.TargetDate?.ToString("MMM dd, yyyy") ?? "—")</td>
                                        <td><span class="@g.StatusBadgeClass">@g.StatusText</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }

        <!-- HOMEWORK -->
        @if (Model.ActiveTab == "homework")
        {
            <div class="tc-section">
                <h6 class="fw-bold mb-3">Homework Assignments</h6>
                @if (!Model.HomeworkList.Any())
                {
                    <div class="tc-empty">
                        <i class="bi bi-journal-x"></i>
                        <p>No homework assigned yet.</p>
                    </div>
                }
                else
                {
                    @foreach (var h in Model.HomeworkList.OrderByDescending(x => x.CreatedAt))
                    {
                        <div class="border rounded-3 p-3 mb-2 @(h.IsOverdue ? "border-warning" : "")">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <span class="fw-semibold">@h.Title</span>
                                    <span class="@h.StatusBadgeClass ms-2">@h.StatusText</span>
                                </div>
                                <small class="text-muted">Due: @(h.DueDate?.ToString("MMM dd, yyyy") ?? "—")</small>
                            </div>

                            @if (!string.IsNullOrEmpty(h.Description))
                            {
                                <p class="text-muted small mb-2">@h.Description</p>
                            }

                            @if (!string.IsNullOrEmpty(h.DetailedInstructions))
                            {
                                <div class="p-2 bg-light rounded-2 small mb-2"><strong>Instructions:</strong> @h.DetailedInstructions</div>
                            }

                            @if (!string.IsNullOrEmpty(h.PatientSubmission))
                            {
                                <div class="p-2 bg-light rounded-2 small mb-2">
                                    <strong class="text-success"><i class="bi bi-check-circle me-1"></i>Your Submission:</strong> @h.PatientSubmission
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(h.DoctorFeedback))
                            {
                                <div class="p-2 rounded-2 small mb-2 border-start border-3 border-info" style="background: #f0f9ff;">
                                    <strong class="text-primary"><i class="bi bi-chat-left-quote me-1"></i>Doctor Feedback:</strong> @h.DoctorFeedback
                                </div>
                            }

                            @if (h.Status == 0)
                            {
                                <!-- Inline Submit Homework Form -->
                                <div class="hw-submit-form" id="hwForm-@h.Id" style="display:none;">
                                    <form method="post" asp-page-handler="SubmitHomework">
                                        <input type="hidden" name="caseId" value="@Model.Case.Id" />
                                        <input type="hidden" name="homeworkId" value="@h.Id" />
                                        <h6 class="fw-bold mb-3" style="font-size: 1rem;"><i class="bi bi-send me-2" style="color: #0d9488;"></i>Submit: @h.Title</h6>
                                        <div class="mb-3">
                                            <label class="form-label fw-semibold">Your answer / work</label>
                                            <textarea name="patientSubmission" class="form-control" rows="4" placeholder="Enter your homework response..." required></textarea>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label fw-semibold">Attachment URL <span class="fw-normal text-muted">(optional)</span></label>
                                            <input type="url" name="patientSubmissionUrl" class="form-control" placeholder="https://..." />
                                        </div>
                                        <div class="d-flex gap-2">
                                            <button type="button" class="btn btn-outline-secondary" onclick="document.getElementById('hwForm-@h.Id').style.display='none'">Cancel</button>
                                            <button type="submit" class="btn" style="background: #0d9488; color: #fff; font-weight: 600;">Submit Homework</button>
                                        </div>
                                    </form>
                                </div>
                                <button class="btn mt-2 px-3" style="background: #0d9488; color: #fff; font-weight: 600; border-radius: 6px;" onclick="document.getElementById('hwForm-@h.Id').style.display='block'; this.style.display='none';">
                                    <i class="bi bi-send me-1"></i>Submit Homework
                                </button>
                            }
                        </div>
                    }
                }
            </div>
        }

        <!-- MOOD -->
        @if (Model.ActiveTab == "mood")
        {
            <div class="tc-section">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-emoji-smile me-2 text-warning"></i>Mood Journal</h6>
                    <a href="/Patient/Journal/Index" class="btn btn-outline-secondary" style="border-radius: 6px;">
                        <i class="bi bi-box-arrow-up-right me-1"></i>Open Full Mood Journey
                    </a>
                </div>

                <!-- Inline Add Mood Entry Form -->
                <div class="p-3 rounded-2 mb-3" style="background: #fffbeb; border: 1px solid #fde68a;">
                    <h6 class="fw-bold mb-3" style="font-size: 1rem;"><i class="bi bi-plus-circle me-2" style="color: #d97706;"></i>Log Today's Mood</h6>
                    <form method="post" asp-page-handler="AddMoodEntry">
                        <input type="hidden" name="caseId" value="@Model.Case.Id" />
                        <div class="row g-3 mb-3">
                            <div class="col-md-4 col-6">
                                <label class="form-label fw-semibold">Mood <span class="text-danger">*</span></label>
                                <input type="range" name="moodScore" class="form-range" min="1" max="10" value="5" id="moodScoreRange" oninput="document.getElementById('moodScoreVal').textContent=this.value" />
                                <div class="text-center fw-bold" style="color: #d97706;"><span id="moodScoreVal">5</span>/10</div>
                            </div>
                            <div class="col-md-4 col-6">
                                <label class="form-label fw-semibold">Anxiety</label>
                                <input type="range" name="anxietyScore" class="form-range" min="0" max="10" value="0" oninput="document.getElementById('anxVal').textContent=this.value" />
                                <div class="text-center text-muted"><span id="anxVal">0</span>/10</div>
                            </div>
                            <div class="col-md-4 col-6">
                                <label class="form-label fw-semibold">Stress</label>
                                <input type="range" name="stressScore" class="form-range" min="0" max="10" value="0" oninput="document.getElementById('strVal').textContent=this.value" />
                                <div class="text-center text-muted"><span id="strVal">0</span>/10</div>
                            </div>
                            <div class="col-md-4 col-6">
                                <label class="form-label fw-semibold">Sleep Quality</label>
                                <input type="range" name="sleepQualityScore" class="form-range" min="0" max="10" value="0" oninput="document.getElementById('slpVal').textContent=this.value" />
                                <div class="text-center text-muted"><span id="slpVal">0</span>/10</div>
                            </div>
                            <div class="col-md-8">
                                <label class="form-label fw-semibold">Note <span class="fw-normal text-muted">(optional)</span></label>
                                <input type="text" name="note" class="form-control" placeholder="How are you feeling today?" />
                            </div>
                        </div>
                        <button type="submit" class="btn px-3" style="background: #d97706; color: #fff; font-weight: 600; border-radius: 6px;">
                            <i class="bi bi-plus-circle me-1"></i>Save Mood Entry
                        </button>
                    </form>
                </div>

                @if (!Model.MoodEntries.Any())
                {
                    <div class="tc-empty">
                        <i class="bi bi-emoji-neutral"></i>
                        <p>No mood entries logged yet. Use the form above to log your first entry.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table tc-tbl align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Mood</th>
                                    <th>Anxiety</th>
                                    <th>Stress</th>
                                    <th>Sleep</th>
                                    <th>Note</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in Model.MoodEntries.OrderByDescending(x => x.RecordedAt).Take(10))
                                {
                                    <tr>
                                        <td>@m.RecordedAt.ToString("MMM dd, yyyy")</td>
                                        <td><span class="badge @(m.MoodScore >= 7 ? "bg-success" : m.MoodScore <= 4 ? "bg-danger" : "bg-warning text-dark")">@m.MoodScore/10</span></td>
                                        <td>@(m.AnxietyScore?.ToString() ?? "–")/10</td>
                                        <td>@(m.StressScore?.ToString() ?? "–")/10</td>
                                        <td>@(m.SleepQualityScore?.ToString() ?? "–")/10</td>
                                        <td class="text-muted">@(m.Note ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (Model.MoodEntries.Count > 10)
                    {
                        <div class="text-center mt-2">
                            <a href="/Patient/Journal/Index" style="color: #0d9488;">View all @Model.MoodEntries.Count entries →</a>
                        </div>
                    }
                }
            </div>
        }

        <!-- TIMELINE -->
        @if (Model.ActiveTab == "timeline")
        {
            <div class="tc-section">
                <h6 class="fw-bold mb-3"><i class="bi bi-clock-history me-2 text-primary"></i>Activity Timeline</h6>
                @if (!Model.Timeline.Any())
                {
                    <div class="tc-empty">
                        <i class="bi bi-clock-history"></i>
                        <p>No activities logged yet.</p>
                    </div>
                }
                else
                {
                    @foreach (var t in Model.Timeline)
                    {
                        <div class="d-flex gap-3 mb-3">
                            <div style="width: 10px; height: 10px; border-radius: 50%; background: var(--mb-primary, #4f46e5); flex-shrink: 0; margin-top: 5px;"></div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="fw-semibold small">@t.Title</span>
                                    <small class="text-muted">@t.EventDate.ToString("MMM dd, yyyy HH:mm")</small>
                                </div>
                                <p class="text-muted small mb-0">@t.Description</p>
                            </div>
                        </div>
                    }
                }
            </div>
        }
    </div>
</div>
