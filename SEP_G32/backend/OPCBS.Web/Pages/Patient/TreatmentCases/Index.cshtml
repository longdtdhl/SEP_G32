@page
@model OPCBS.Web.Pages.Patient.TreatmentCases.IndexModel
@{
    ViewData["Title"] = "My Treatment Progress";
    Layout = "_DashboardLayout";
    var mode = Model.ViewMode?.ToLowerInvariant() == "history" ? "history" : "active";
    var displayList = mode == "history" ? Model.HistoryCases : Model.ActiveCases;
}

<style>
    /* ── Segmented control ── */
    .tp-seg { display: inline-flex; background: #f1f5f9; border-radius: 10px; padding: 3px; gap: 2px; }
    .tp-seg a {
        padding: 7px 20px; border-radius: 8px; font-size: .82rem; font-weight: 600;
        color: #64748b; text-decoration: none; transition: all .2s; white-space: nowrap; display: inline-flex; align-items: center;
    }
    .tp-seg a.active { background: #fff; color: #0f766e; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
    .tp-seg a:hover:not(.active) { color: #0f766e; background: #e2e8f0; }

    /* ── Search ── */
    .tp-search { position: relative; max-width: 280px; }
    .tp-search input {
        padding: 8px 12px 8px 36px; border: 1px solid #e2e8f0; border-radius: 8px;
        font-size: 0.82rem; width: 100%; background: #fff; transition: border-color .2s;
    }
    .tp-search input:focus { border-color: #0d9488; outline: none; box-shadow: 0 0 0 3px rgba(13,148,136,.1); }
    .tp-search i { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 0.85rem; }

    /* ── Card ── */
    .tp-card {
        background: #fff; border-radius: 14px; border: 1px solid #e2e8f0; overflow: hidden;
        transition: all .25s ease; display: flex; flex-direction: column; height: 100%;
    }
    .tp-card:hover { box-shadow: 0 8px 24px rgba(0,0,0,.07); transform: translateY(-2px); }
    .tp-card-body { padding: 1.25rem; flex: 1; }
    .tp-card-footer { padding: .75rem 1.25rem; border-top: 1px solid #f1f5f9; background: #fafbfc; }

    /* ── Status ── */
    .tp-status {
        display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px;
        border-radius: 20px; font-size: .7rem; font-weight: 700; letter-spacing: .3px;
    }
    .tp-status.active     { background: #dcfce7; color: #15803d; }
    .tp-status.on-hold    { background: #fef3c7; color: #92400e; }
    .tp-status.completed  { background: #e0e7ff; color: #3730a3; }
    .tp-status.cancelled  { background: #f1f5f9; color: #64748b; }
    .tp-status.terminated { background: #fee2e2; color: #991b1b; }
    .tp-status.expired    { background: #fee2e2; color: #991b1b; border: 1px solid #fecaca; }

    /* ── Meta row ── */
    .tp-meta { display: flex; align-items: center; gap: 6px; font-size: .8rem; color: #64748b; margin-bottom: 5px; }
    .tp-meta i { color: #0d9488; width: 16px; text-align: center; font-size: .82rem; }
    .tp-meta strong { color: #1e293b; }

    /* ── Progress ── */
    .tp-progress-track { background: #e2e8f0; border-radius: 6px; height: 6px; overflow: hidden; }
    .tp-progress-fill { height: 100%; border-radius: 6px; transition: width .5s ease; }

    /* ── Doctor chip ── */
    .tp-doctor {
        display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px;
        border-radius: 8px; background: linear-gradient(135deg, #f0fdf4, #dcfce7);
        color: #166534; font-size: .78rem; font-weight: 600;
    }

    /* ── Empty state ── */
    .tp-empty {
        text-align: center; padding: 4rem 2rem; background: #fff;
        border-radius: 16px; border: 2px dashed #e2e8f0;
    }
</style>

<!-- ── Page Header ── -->
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <h1 style="font-size:1.35rem; font-weight:800; margin:0; color:#1e293b;">
            <i class="bi bi-heart-pulse-fill me-2" style="color:#0d9488;"></i>My Treatment Progress
        </h1>
        <p style="margin:4px 0 0; font-size:.82rem; color:#94a3b8;">Track your therapy journey, goals, homework, and session history</p>
    </div>
    <div class="tp-search">
        <i class="bi bi-search"></i>
        <form method="get">
            <input type="hidden" name="ViewMode" value="@mode" />
            <input type="text" name="SearchTerm" value="@Model.SearchTerm" placeholder="Search treatment cases..." />
        </form>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" style="border-radius:12px; border:none;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Cases.Any())
{
    <div class="tp-empty">
        <i class="bi bi-heart-pulse d-block mb-3" style="font-size:3rem; color:#cbd5e1;"></i>
        <h5 style="font-weight:700; color:#475569; margin-bottom:6px;">No Treatment Cases Yet</h5>
        <p style="font-size:.85rem; color:#94a3b8; margin-bottom:1.5rem;">When you accept a treatment proposal from your therapist, your active case will appear here.</p>
        <a asp-page="/Patient/TreatmentPackages/Index" class="btn px-4 py-2" style="border-radius:10px; background:#0d9488; color:#fff; font-weight:600;">
            <i class="bi bi-box-seam me-1"></i>View My Packages
        </a>
    </div>
}
else
{
    <!-- ── Segmented Control (Server-Driven) ── -->
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div class="tp-seg">
            <a href="?ViewMode=active&SearchTerm=@Model.SearchTerm" class="@(mode == "active" ? "active" : "")">
                <i class="bi bi-activity me-1"></i>Active (@Model.ActiveCount)
            </a>
            <a href="?ViewMode=history&SearchTerm=@Model.SearchTerm" class="@(mode == "history" ? "active" : "")">
                <i class="bi bi-clock-history me-1"></i>History (@Model.HistoryCount)
            </a>
        </div>
        <span class="text-muted" style="font-size:.78rem;">Showing @displayList.Count case(s)</span>
    </div>

    @if (!displayList.Any())
    {
        <div class="tp-empty">
            <i class="bi bi-journal-medical d-block mb-3" style="font-size:2.5rem; color:#cbd5e1;"></i>
            @if (mode == "history")
            {
                <h6 style="font-weight:700; color:#475569; margin-bottom:4px;">No History Cases</h6>
                <p style="font-size:.85rem; color:#94a3b8; margin:0;">Completed, expired, or terminated treatment cases will appear here in read-only mode.</p>
            }
            else
            {
                <h6 style="font-weight:700; color:#475569; margin-bottom:4px;">No Active Treatment Cases</h6>
                <p style="font-size:.85rem; color:#94a3b8; margin-bottom:1rem;">You currently do not have any active or on-hold treatment programs.</p>
                <a asp-page="/Patient/TreatmentPackages/Index" class="btn btn-sm px-3 py-2" style="border-radius:8px; background:#0d9488; color:#fff; font-weight:600;">
                    <i class="bi bi-box-seam me-1"></i>View Package Proposals
                </a>
            }
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var c in displayList)
            {
                string statusClass;
                string statusLabel;

                switch (c.Status)
                {
                    case 0:
                        statusClass = "active";
                        statusLabel = "Active";
                        break;
                    case 1:
                        statusClass = "on-hold";
                        statusLabel = "On Hold";
                        break;
                    case 2:
                        statusClass = "completed";
                        statusLabel = "Completed";
                        break;
                    case 3:
                        statusClass = "cancelled";
                        statusLabel = "Cancelled";
                        break;
                    case 4:
                        statusClass = "terminated";
                        statusLabel = "Terminated";
                        break;
                    case 5:
                        statusClass = "expired";
                        statusLabel = "Expired";
                        break;
                    default:
                        statusClass = "cancelled";
                        statusLabel = "Archived";
                        break;
                }

                var progressColor = c.OverallProgressPercent >= 100 ? "#10b981" : c.OverallProgressPercent >= 50 ? "#3b82f6" : "#f59e0b";

                <div class="col-md-6 col-xl-4">
                    <div class="tp-card h-100">
                        <div class="tp-card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h6 style="font-weight:700; font-size:.95rem; color:#1e293b; margin:0; max-width:65%;" class="text-truncate" title="@c.CaseName">@c.CaseName</h6>
                                @if (c.IsHoldRequested)
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle" style="font-size:0.68rem;"><i class="bi bi-clock-history me-1"></i>Hold Requested</span>
                                }
                                else
                                {
                                    <span class="tp-status @statusClass">@statusLabel</span>
                                }
                            </div>
                            <div class="tp-doctor mb-3">
                                <i class="bi bi-person-badge"></i>Dr. @(c.DoctorName ?? "Therapist")
                            </div>
                            <div class="tp-meta"><i class="bi bi-camera-video"></i><span>Sessions Completed: <strong>@c.CompletedSessions / @c.TotalSessions</strong></span></div>
                            <div class="tp-meta"><i class="bi bi-calendar3"></i><span>Start Date: <strong>@c.StartDate.ToString("MMM dd, yyyy")</strong></span></div>
                            
                            <!-- Clinical progress representation belongs on Treatment Cases -->
                            <div style="margin-top:10px;">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span style="font-size:.7rem; color:#94a3b8; font-weight:500;">Clinical Progress</span>
                                    <span style="font-size:.7rem; color:@progressColor; font-weight:700;">@(c.OverallProgressPercent)%</span>
                                </div>
                                <div class="tp-progress-track"><div class="tp-progress-fill" style="width:@(c.OverallProgressPercent)%; background:@progressColor;"></div></div>
                            </div>
                        </div>
                        <div class="tp-card-footer">
                            @if (mode == "active")
                            {
                                <a href="/Patient/TreatmentCases/Details?id=@c.Id"
                                   class="btn btn-sm w-100 d-flex align-items-center justify-content-center gap-1"
                                   style="border-radius:8px; font-size:.8rem; font-weight:700; background:#0d9488; color:#fff; border:none;">
                                    <i class="bi bi-graph-up"></i>View My Progress
                                </a>
                            }
                            else
                            {
                                <a href="/Patient/TreatmentCases/Details?id=@c.Id"
                                   class="btn btn-sm btn-outline-primary w-100 d-flex align-items-center justify-content-center gap-1"
                                   style="border-radius:8px; font-size:.8rem; font-weight:600;">
                                    <i class="bi bi-eye"></i>View Details
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
