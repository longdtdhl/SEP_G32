@page
@model OPCBS.Web.Pages.Patient.TreatmentCases.IndexModel
@{ ViewData["Title"] = "My Treatment Progress"; Layout = "_DashboardLayout"; }

<style>
    .tc-card {
        background: white; border-radius: 16px; border: 1px solid #f1f5f9;
        overflow: hidden; transition: all 0.2s; box-shadow: 0 1px 4px rgba(0,0,0,0.04);
    }
    .tc-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.08); transform: translateY(-2px); }
    .tc-card-header { padding: 1.25rem; border-bottom: 1px solid #f8fafc; }
    .tc-card-body { padding: 1rem 1.25rem; }
    .tc-card-footer { padding: 0.75rem 1.25rem; border-top: 1px solid #f8fafc; background: #fafbfc; }
    .tc-status { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 20px; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.3px; }
    .tc-status.active { background: #dcfce7; color: #15803d; }
    .tc-status.paused { background: #fef3c7; color: #92400e; }
    .tc-status.completed { background: #e0e7ff; color: #3730a3; }
    .tc-status.cancelled { background: #f1f5f9; color: #64748b; }
    .tc-meta-row { display: flex; align-items: center; gap: 8px; font-size: 0.8rem; color: #64748b; margin-bottom: 6px; }
    .tc-meta-row i { color: var(--mb-primary); font-size: 0.85rem; width: 16px; text-align: center; }
    .tc-progress-track { background: #e2e8f0; border-radius: 6px; height: 6px; overflow: hidden; }
    .tc-progress-fill { height: 100%; border-radius: 6px; transition: width 0.6s ease; }
    .tc-empty { text-align: center; padding: 4rem 2rem; background: white; border-radius: 16px; border: 2px dashed #e2e8f0; }
</style>

<!-- Page Header -->
<div class="mb-page-header mb-4">
    <h1 style="font-size:1.4rem; font-weight:700; margin:0;">
        <i class="bi bi-heart-pulse-fill me-2" style="color:var(--mb-primary);"></i>My Treatment Progress
    </h1>
    <p style="margin:4px 0 0; font-size:0.85rem; color:#64748b;">Track your therapy progress and treatment plans</p>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" style="border-radius:12px; border:none;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Cases.Any())
{
    <div class="tc-empty">
        <i class="bi bi-heart-pulse d-block mb-3" style="font-size:3rem; color:#cbd5e1;"></i>
        <h5 style="font-weight:700; color:#475569; margin-bottom:8px;">No Active Treatment Cases</h5>
        <p style="font-size:0.85rem; color:#94a3b8; margin-bottom:1.5rem;">When your therapist starts a treatment plan for you, it will appear here.</p>
        <a asp-page="/Doctors/Index" class="btn btn-primary px-4 py-2" style="border-radius:10px; background:var(--mb-primary); border-color:var(--mb-primary);">
            <i class="bi bi-search me-1"></i>Find a Doctor
        </a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var c in Model.Cases)
        {
            var statusClass = c.Status == 0 ? "active" : c.Status == 1 ? "paused" : c.Status == 2 ? "completed" : "cancelled";
            var statusLabel = c.Status == 0 ? "Active" : c.Status == 1 ? "Paused" : c.Status == 2 ? "Completed" : "Cancelled";
            var progressColor = c.OverallProgressPercent >= 100 ? "#10b981" : c.OverallProgressPercent >= 50 ? "#3b82f6" : "#f59e0b";
            <div class="col-md-6 col-xl-4">
                <div class="tc-card h-100 d-flex flex-column justify-content-between">
                    <div>
                        <!-- Header -->
                        <div class="tc-card-header">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <h6 style="font-weight:700; font-size:0.95rem; color:#1e293b; margin:0; max-width:70%;" class="text-truncate" title="@c.CaseName">@c.CaseName</h6>
                                <span class="tc-status @statusClass">@statusLabel</span>
                            </div>
                            <span class="text-muted" style="font-size:0.8rem;"><i class="bi bi-person-badge me-1" style="color:var(--mb-primary);"></i>Dr. @(c.DoctorName ?? "Unknown")</span>
                        </div>
                        <!-- Body -->
                        <div class="tc-card-body">
                            <div class="tc-meta-row"><i class="bi bi-camera-video"></i><span>Sessions: <strong style="color:#1e293b;">@c.CompletedSessions / @c.TotalSessions</strong></span></div>
                            <div class="tc-meta-row"><i class="bi bi-calendar3"></i><span>Started: <strong style="color:#1e293b;">@c.StartDate.ToString("MMM dd, yyyy")</strong></span></div>
                            <!-- Progress -->
                            <div style="margin-top:10px;">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span style="font-size:0.72rem; color:#94a3b8; font-weight:500;">Overall Progress</span>
                                    <span style="font-size:0.72rem; color:@progressColor; font-weight:700;">@(c.OverallProgressPercent)%</span>
                                </div>
                                <div class="tc-progress-track">
                                    <div class="tc-progress-fill" style="width:@(c.OverallProgressPercent)%; background:@progressColor;"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Footer -->
                    <div class="tc-card-footer">
                        <a href="/Patient/TreatmentCases/Details?id=@c.Id" class="btn btn-sm btn-primary w-100 d-flex align-items-center justify-content-center gap-1" style="border-radius:8px; font-size:0.8rem; font-weight:600; background:var(--mb-primary); border-color:var(--mb-primary);">
                            <i class="bi bi-graph-up"></i>View Progress
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
