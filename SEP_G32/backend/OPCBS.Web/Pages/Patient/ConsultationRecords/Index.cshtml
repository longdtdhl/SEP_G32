@page
@model OPCBS.Web.Pages.Patient.ConsultationRecords.IndexModel
@{
    ViewData["Title"] = "Hồ sơ sức khỏe & tư vấn";
    ViewData["UseDashboardLayout"] = true;
}

<style>
    .record-card {
        border-radius: 20px !important;
        transition: all 0.3s ease;
        border: 1px solid rgba(0,0,0,0.03) !important;
    }
    .record-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.05) !important;
    }
    .record-doctor-avatar {
        width: 48px;
        height: 48px;
        background-color: var(--mb-primary-light);
        color: var(--mb-primary);
        font-weight: 700;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .record-section-title {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #888;
        margin-bottom: 6px;
    }
</style>

<div class="mb-page-header">
    <h1><i class="bi bi-file-earmark-medical-fill me-2 text-primary"></i>Hồ sơ sức khỏe của tôi</h1>
    <p class="text-muted mb-0">Theo dõi lịch sử chẩn đoán, ghi chép buổi trị liệu và các bài tập thực hành từ bác sĩ chuyên môn</p>
</div>

@if (Model.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-octagon-fill me-1"></i>@Model.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Records.Any())
{
    <div class="row g-4">
        @foreach (var record in Model.Records.OrderByDescending(r => r.CreatedAt))
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm record-card">
                    <div class="card-body p-4 p-md-5">
                        
                        <!-- Card Header: Doctor & Date info -->
                        <div class="d-flex flex-wrap align-items-center justify-content-between border-bottom pb-4 mb-4 gap-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="record-doctor-avatar">
                                    @(record.DoctorName?.Substring(0, 1).ToUpper() ?? "?")
                                </div>
                                <div>
                                    <h5 class="mb-0 fw-bold text-dark">Bác sĩ: @(record.DoctorName ?? "Chuyên gia MindBridge")</h5>
                                    <span class="text-muted small"><i class="bi bi-calendar3 me-1"></i>Ngày tư vấn: @record.CreatedAt.ToString("dd/MM/yyyy • HH:mm")</span>
                                </div>
                            </div>
                            <div>
                                @if (!string.IsNullOrEmpty(record.Diagnosis))
                                {
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-2 rounded-pill fw-bold">
                                        <i class="bi bi-activity me-1"></i>Chẩn đoán: @record.Diagnosis
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Card Body Content Sections -->
                        <div class="row g-4">
                            <!-- Notes / Summary -->
                            @if (!string.IsNullOrEmpty(record.ConsultationSummary))
                            {
                                <div class="col-12">
                                    <div class="record-section-title">Ghi chép & Nhận xét buổi tư vấn</div>
                                    <div class="p-3 bg-light rounded-3 text-dark small" style="line-height: 1.6; white-space: pre-wrap;">
                                        @record.ConsultationSummary
                                    </div>
                                </div>
                            }

                            <!-- Prescription -->
                            @if (!string.IsNullOrEmpty(record.Prescription))
                            {
                                <div class="col-md-6">
                                    <div class="card border-0 shadow-none bg-light h-100 rounded-3 border-start border-3 border-info">
                                        <div class="card-body p-3">
                                            <div class="record-section-title d-flex align-items-center gap-1.5 text-info">
                                                <i class="bi bi-capsule"></i> Toa thuốc / Trị liệu y khoa
                                            </div>
                                            <p class="mb-0 small text-dark" style="white-space: pre-wrap;">@record.Prescription</p>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Advice / Home exercises -->
                            @if (!string.IsNullOrEmpty(record.Recommendation))
                            {
                                <div class="col-md-@(string.IsNullOrEmpty(record.Prescription) ? "12" : "6")">
                                    <div class="card border-0 shadow-none bg-primary bg-opacity-10 h-100 rounded-3 border-start border-3 border-primary">
                                        <div class="card-body p-3">
                                            <div class="record-section-title d-flex align-items-center gap-1.5 text-primary">
                                                <i class="bi bi-heart-pulse-fill"></i> Bài tập tâm lý & Lời khuyên
                                            </div>
                                            <p class="mb-0 small text-dark" style="white-space: pre-wrap;">@record.Recommendation</p>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Follow up notes -->
                            @if (!string.IsNullOrEmpty(record.FollowUpNotes))
                            {
                                <div class="col-12 mt-3 text-muted small">
                                    <hr class="my-3" />
                                    <span class="fw-semibold text-dark"><i class="bi bi-arrow-return-right me-1"></i>Lịch trình theo dõi tiếp theo: </span>
                                    <span>@record.FollowUpNotes</span>
                                </div>
                            }
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-4 text-center py-5">
        <div class="card-body p-5">
            <i class="bi bi-file-earmark-medical text-muted mb-3" style="font-size: 4rem; opacity: 0.4;"></i>
            <h5 class="fw-bold text-dark">Bạn chưa có hồ sơ tư vấn nào</h5>
            <p class="text-muted small mb-4">Các chuẩn trị bệnh án, toa thuốc và bài tập tự rèn luyện từ bác sĩ sẽ được lưu trữ tại đây sau khi hoàn tất buổi tư vấn.</p>
            <a asp-page="/Doctors/Index" class="btn btn-primary rounded-pill px-4 py-2.5 fw-bold shadow-sm">
                <i class="bi bi-search-heart me-1"></i>Tìm bác sĩ & Đặt lịch ngay
            </a>
        </div>
    </div>
}
