@page
@model OPCBS.Web.Pages.Patient.ConsultationNotes.IndexModel
@{
    ViewData["Title"] = "Consultation Records";

    Layout = "_DashboardLayout";}

<style>
    /* ── Record Cards ── */
    .record-card {
        border-radius: 16px !important;
        transition: all 0.25s ease;
        border: 1px solid #e2e8f0 !important;
        background: white;
        overflow: hidden;
    }
    .record-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.04) !important;
        border-color: #cbd5e1 !important;
    }
    .record-doctor-avatar {
        width: 44px;
        height: 44px;
        background-color: #eff6ff;
        color: #2563eb;
        font-weight: 700;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        border: 2px solid #dbeafe;
    }
    .record-section-title {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #94a3b8;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    
    /* ── Search & Filter Bar ── */
    .search-filter-bar {
        display: flex; 
        gap: 12px; 
        align-items: center; 
        margin-bottom: 1.75rem; 
        flex-wrap: wrap;
        background: white; 
        padding: 1rem; 
        border-radius: 14px; 
        border: 1px solid #e2e8f0;
    }
    .search-wrapper {
        position: relative;
        flex: 1;
        min-width: 280px;
    }
    .search-wrapper i {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        font-size: 0.95rem;
    }
    .search-input {
        width: 100%;
        padding: 10px 14px 10px 40px; 
        border: 1px solid #e2e8f0;
        border-radius: 10px; 
        font-size: 0.85rem; 
        outline: none; 
        transition: all 0.2s;
        background: #fff;
    }
    .search-input:focus { 
        border-color: #3b82f6; 
        box-shadow: 0 0 0 3px rgba(59,130,246,0.1); 
        background: #fff;
    }

    /* ── Active Package Banner ── */
    .package-banner-card {
        background: linear-gradient(135deg, #f0fdf4, #ecfdf5);
        border: 1px solid #a7f3d0;
        border-radius: 16px;
        padding: 1.5rem;
        margin-bottom: 2rem;
    }
    .progress-track {
        height: 6px; 
        border-radius: 10px; 
        background-color: #cbd5e1;
        overflow: hidden;
    }

    /* ── Badges ── */
    .badge-diagnosis {
        background: #eff6ff; 
        color: #1e40af; 
        border: 1px solid #bfdbfe; 
        padding: 6px 14px; 
        border-radius: 20px; 
        font-size: 0.75rem;
        font-weight: 600;
    }
    .badge-pkg-active {
        background: #d1fae5;
        color: #065f46;
        border: 1px solid #a7f3d0;
        font-size: 0.7rem;
        font-weight: 700;
        border-radius: 20px;
        padding: 4px 12px;
    }
</style>

<!-- Page Header -->
<div class="mb-page-header">
    <h1><i class="bi bi-file-earmark-medical-fill me-2 text-primary"></i>Consultation Records</h1>
    <p class="text-muted mb-0">Track your clinical diagnostics, session summaries, treatment plans, and doctor recommendations</p>
</div>

@if (Model.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show" style="border-radius:12px; border:none; margin-bottom: 1.5rem;">
        <i class="bi bi-exclamation-octagon-fill me-1"></i>@Model.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Active Treatment Packages Section -->
@if (Model.ActivePackages.Any())
{
    @foreach (var pkg in Model.ActivePackages)
    {
        var progress = pkg.TotalSessions > 0 ? (int)((double)pkg.CompletedSessions / pkg.TotalSessions * 100) : 0;
        <div class="package-banner-card shadow-sm animate__animated animate__fadeIn">
            <div class="row align-items-center g-3">
                <div class="col-lg-8">
                    <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                        <span class="badge-pkg-active">Active Treatment Package</span>
                        <span class="text-muted small"><i class="bi bi-calendar-event me-1"></i>Expires: @pkg.ExpirationDate.ToString("MM/dd/yyyy")</span>
                    </div>
                    <h4 class="fw-bold text-dark mb-1" style="font-size: 1.15rem;">@pkg.Title</h4>
                    <p class="text-secondary small mb-3" style="max-width: 65ch;">@pkg.Description</p>
                    <div class="d-flex align-items-center gap-4 flex-wrap">
                        <div class="small text-dark"><i class="bi bi-person-badge-fill me-1 text-success"></i>Doctor: <strong>@pkg.DoctorName</strong></div>
                        <div class="small text-dark"><i class="bi bi-chat-left-dots-fill me-1 text-success"></i>Completed: <strong>@pkg.CompletedSessions / @pkg.TotalSessions sessions</strong></div>
                        <div style="width: 160px;">
                            <div class="d-flex justify-content-between small mb-1" style="font-size: 0.72rem;">
                                <span class="text-muted">Progress</span>
                                <span class="fw-bold text-success">@progress%</span>
                            </div>
                            <div class="progress progress-track">
                                <div class="progress-bar bg-success" role="progressbar" style="width: @progress%"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 text-lg-end d-flex gap-2 justify-content-lg-end flex-wrap mt-3 mt-lg-0">
                    <a asp-page="/Patient/TreatmentPackages/Details" asp-route-id="@pkg.Id" class="btn btn-sm btn-outline-success px-3 py-2 fw-bold" style="border-radius:10px; font-size:0.78rem;">
                        <i class="bi bi-info-circle me-1"></i>View Details
                    </a>
                    <a asp-page="/Appointment/Book" asp-route-doctorId="@pkg.DoctorId" asp-route-treatmentPackageId="@pkg.Id" class="btn btn-sm btn-success px-3 py-2 fw-bold" style="border-radius:10px; font-size:0.78rem;">
                        <i class="bi bi-calendar-plus me-1"></i>Book Next Session
                    </a>
                </div>
            </div>
        </div>
    }
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Search bar & Filters -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 16px;">
    <div class="card-body p-3.5 p-md-4">
        <div class="d-flex flex-wrap align-items-center gap-3">
            <div class="search-box flex-grow-1" style="min-width: 260px;">
                <i class="bi bi-search search-icon"></i>
                <input type="text" class="search-input" placeholder="Search by doctor name, diagnosis, notes..." id="crSearch" oninput="filterConsultationNotes()" />
            </div>
            
            <div style="min-width: 180px;">
                <select id="doctorFilter" class="form-select" onchange="filterConsultationNotes()" style="height: 44px; border-radius: 10px; border: 1px solid #e2e8f0; font-size: 0.85rem; color: #475569; font-weight: 500; outline: none; box-shadow: none;">
                    <option value="all">All Doctors</option>
                    @foreach (var docName in Model.Records.Select(r => r.DoctorName).Where(d => !string.IsNullOrEmpty(d)).Distinct())
                    {
                        <option value="@docName?.ToLower()">@docName</option>
                    }
                </select>
            </div>

            <div style="min-width: 160px;">
                <input type="date" id="dateFilter" class="form-control" onchange="filterConsultationNotes()" style="height: 44px; border-radius: 10px; border: 1px solid #e2e8f0; font-size: 0.85rem; color: #475569; font-weight: 500; outline: none; box-shadow: none;" />
            </div>

            <button type="button" class="btn-reset" onclick="resetFilters()">
                <i class="bi bi-arrow-counterclockwise"></i> Reset
            </button>
        </div>
    </div>
</div>

<!-- Consultation Records list -->
@if (Model.Records.Any())
{
    <div class="row g-4" id="crContainer">
        @foreach (var record in Model.Records.OrderByDescending(r => r.CreatedAt))
        {
            var docNameLower = (record.DoctorName ?? "Specialist MindBridge").ToLower();
            var diagLower = (record.Diagnosis ?? "").ToLower();
            var summaryLower = (record.ConsultationSummary ?? "").ToLower();

            <div class="col-12 cr-card-item animate__animated animate__fadeIn" data-doctor="@docNameLower" data-diagnosis="@diagLower" data-summary="@summaryLower" data-date="@record.CreatedAt.ToString("yyyy-MM-dd")">
                <div class="card border-0 shadow-sm record-card">
                    <div class="card-body p-4 p-md-4">
                        
                        <!-- Card Header: Doctor & Date info -->
                        <div class="d-flex flex-wrap align-items-center justify-content-between border-bottom pb-3 mb-3 gap-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="record-doctor-avatar">
                                    @((record.DoctorName ?? "C").Substring(0, 1).ToUpper())
                                </div>
                                <div>
                                    <h5 class="mb-0 fw-bold text-dark" style="font-size: 1rem;">Doctor: @(record.DoctorName ?? "Specialist Therapist")</h5>
                                    <span class="text-muted small"><i class="bi bi-calendar3 me-1"></i>Consultation Date: @record.CreatedAt.ToString("MM/dd/yyyy • HH:mm")</span>
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                @if (record.IsPatientConfirmed)
                                {
                                    <span class="badge rounded-pill px-2.5 py-1 fw-medium" style="background:#ecfdf5; color:#065f46; border:1px solid #a7f3d0; font-size:0.75rem;">
                                        <i class="bi bi-check-circle-fill me-1" style="color:#10b981;"></i>Confirmed (@record.PatientConfirmedAt?.ToString("dd/MM/yyyy HH:mm"))
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill px-2.5 py-1 fw-medium" style="background:#fffbeb; color:#92400e; border:1px solid #fde68a; font-size:0.75rem;">
                                        <i class="bi bi-hourglass-split me-1" style="color:#d97706;"></i>Awaiting Confirmation
                                    </span>
                                }
                                @if (!string.IsNullOrEmpty(record.Diagnosis))
                                {
                                    <span class="badge rounded-pill px-2.5 py-1 fw-medium" style="background:#f1f5f9; color:#334155; border:1px solid #e2e8f0; font-size:0.75rem;">
                                        <i class="bi bi-journal-medical me-1 text-primary"></i>Diagnosis: @record.Diagnosis
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Card Body Content Sections -->
                        <div class="d-flex flex-column gap-3">
                            <!-- Notes / Summary -->
                            @if (!string.IsNullOrEmpty(record.ConsultationSummary))
                            {
                                <div class="p-3 rounded-3" style="background:#f8fafc; border:1px solid #e2e8f0;">
                                    <div class="fw-semibold text-secondary mb-1.5 small d-flex align-items-center gap-1.5" style="color:#475569 !important; font-size:0.78rem; text-transform:uppercase; letter-spacing:0.03em;">
                                        <i class="bi bi-chat-left-text text-primary"></i>
                                        <span>Consultation Notes &amp; Feedback</span>
                                    </div>
                                    <div class="text-dark" style="font-size:0.88rem; line-height:1.6; white-space:pre-wrap; word-break:break-word;">@record.ConsultationSummary</div>
                                </div>
                            }

                            <!-- TherapyPlan & Recommendations -->
                            @if (!string.IsNullOrEmpty(record.TherapyPlan) || !string.IsNullOrEmpty(record.Recommendation))
                            {
                                <div class="row g-3">
                                    @if (!string.IsNullOrEmpty(record.TherapyPlan))
                                    {
                                        <div class="@(!string.IsNullOrEmpty(record.Recommendation) ? "col-md-6" : "col-12")">
                                            <div class="p-3 rounded-3 h-100" style="background:#f8fafc; border:1px solid #e2e8f0;">
                                                <div class="fw-semibold text-secondary mb-1.5 small d-flex align-items-center gap-1.5" style="color:#475569 !important; font-size:0.78rem; text-transform:uppercase; letter-spacing:0.03em;">
                                                    <i class="bi bi-compass text-primary"></i>
                                                    <span>Therapy Plan</span>
                                                </div>
                                                <div class="text-dark" style="font-size:0.88rem; line-height:1.6; white-space:pre-wrap; word-break:break-word;">@record.TherapyPlan</div>
                                            </div>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(record.Recommendation))
                                    {
                                        <div class="@(!string.IsNullOrEmpty(record.TherapyPlan) ? "col-md-6" : "col-12")">
                                            <div class="p-3 rounded-3 h-100" style="background:#f8fafc; border:1px solid #e2e8f0;">
                                                <div class="fw-semibold text-secondary mb-1.5 small d-flex align-items-center gap-1.5" style="color:#475569 !important; font-size:0.78rem; text-transform:uppercase; letter-spacing:0.03em;">
                                                    <i class="bi bi-lightbulb text-primary"></i>
                                                    <span>Recommendations &amp; Advice</span>
                                                </div>
                                                <div class="text-dark" style="font-size:0.88rem; line-height:1.6; white-space:pre-wrap; word-break:break-word;">@record.Recommendation</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            <!-- Next appointment recommended date & slot -->
                            @if (record.NextAppointmentRecommendedDate.HasValue)
                            {
                                <div class="col-12 mt-2">
                                    <div style="background:#fffbeb; border: 1px solid #fde68a; color:#92400e; padding: 12px 16px; border-radius:12px; font-size: 0.85rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-calendar-check-fill text-warning fs-5"></i>
                                            <div>
                                                <div class="fw-bold">Lịch hẹn tái khám được gợi ý:</div>
                                                <div>
                                                    @record.NextAppointmentRecommendedDate.Value.ToString("dd/MM/yyyy")
                                                    @if (!string.IsNullOrEmpty(record.NextAppointmentRecommendedSlotStartTime))
                                                    {
                                                        <span class="badge bg-warning text-dark ms-1">@record.NextAppointmentRecommendedSlotStartTime - @record.NextAppointmentRecommendedSlotEndTime</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        @if (record.FollowUpAppointmentId.HasValue)
                                        {
                                            <div>
                                                <a asp-page="/Patient/Appointments/Details" asp-route-id="@record.FollowUpAppointmentId" class="btn btn-sm btn-outline-success fw-bold">
                                                    <i class="bi bi-check-circle-fill me-1"></i>Lịch tái khám đã tạo (@(record.FollowUpAppointmentBookingCode ?? "Chi tiết"))
                                                </a>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                             <!-- Follow up notes -->
                            @if (!string.IsNullOrEmpty(record.FollowUpNotes))
                            {
                                <div class="col-12 mt-2 text-muted small">
                                    <hr class="my-2" style="border-color: #e2e8f0;" />
                                    <span class="fw-semibold text-dark"><i class="bi bi-arrow-return-right me-1 text-primary"></i>Next Follow-up Notes: </span>
                                    <span style="font-size: 0.82rem;">@record.FollowUpNotes</span>
                                </div>
                            }

                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
    
    <div class="card border-0 shadow-sm text-center py-5" id="noFilteredRecordContainer" style="border-radius: 16px; display: none; margin-top: 1rem;">
        <div class="card-body p-4">
            <i class="bi bi-filter-circle text-muted mb-3" style="font-size: 3rem; opacity: 0.4;"></i>
            <h5 class="fw-bold text-dark">No Matching Records</h5>
            <p class="text-muted small mb-0">Try adjusting your search query, selected doctor, or date filter.</p>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm text-center py-5" id="noRecordContainer" style="border-radius: 16px;">
        <div class="card-body p-5">
            <i class="bi bi-file-earmark-medical text-muted mb-3" style="font-size: 3.5rem; opacity: 0.4;"></i>
            <h5 class="fw-bold text-dark" style="font-size: 1.15rem;">No Consultation Records Found</h5>
            <p class="text-muted small mb-4" style="max-width: 50ch; margin: 0 auto 1.5rem;">Your clinical records, diagnoses, plans, and recommended exercises from therapists will appear here after your sessions are completed.</p>
            <a asp-page="/Doctors/Index" class="btn btn-primary px-4 py-2.5 fw-bold shadow-sm" style="border-radius: 10px;">
                <i class="bi bi-search-heart me-1"></i>Find a Therapist & Book Now
            </a>
        </div>
    </div>
}

<script>
function filterConsultationNotes() {
    const query = document.getElementById('crSearch').value.trim().toLowerCase();
    const selectedDoctor = document.getElementById('doctorFilter').value.trim().toLowerCase();
    const selectedDate = document.getElementById('dateFilter').value; // yyyy-MM-dd

    let visibleCount = 0;
    
    document.querySelectorAll('.cr-card-item').forEach(item => {
        const doc = item.dataset.doctor || '';
        const diag = item.dataset.diagnosis || '';
        const summary = item.dataset.summary || '';
        const date = item.dataset.date || ''; // yyyy-MM-dd
        
        const matchesQuery = !query || doc.includes(query) || diag.includes(query) || summary.includes(query);
        const matchesDoctor = !selectedDoctor || doc === selectedDoctor;
        const matchesDate = !selectedDate || date === selectedDate;
        
        if (matchesQuery && matchesDoctor && matchesDate) {
            item.style.display = 'block';
            visibleCount++;
        } else {
            item.style.display = 'none';
        }
    });

    const noFilteredAlert = document.getElementById('noFilteredRecordContainer');
    if (noFilteredAlert) {
        if (visibleCount === 0) {
            noFilteredAlert.style.display = 'block';
        } else {
            noFilteredAlert.style.display = 'none';
        }
    }
}

function clearFilters() {
    document.getElementById('crSearch').value = '';
    document.getElementById('doctorFilter').value = '';
    document.getElementById('dateFilter').value = '';
    filterConsultationNotes();
}
</script>
