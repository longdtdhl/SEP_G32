@page
@model OPCBS.Web.Pages.Patient.Appointments.IndexModel
@{
    ViewData["Title"] = "Lịch hẹn của tôi";
    ViewData["UseDashboardLayout"] = true;

    var pending = Model.Appointments.Count(a => a.Status == 0);
    var approved = Model.Appointments.Count(a => a.Status == 1);
    var completed = Model.Appointments.Count(a => a.Status == 4);
}

<div class="mb-page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <h1><i class="bi bi-calendar-check me-2" style="color:var(--mb-primary);"></i>Lịch hẹn của tôi</h1>
        <p class="text-muted mb-0 mt-1" style="font-size:0.875rem;">Quản lý và theo dõi các lịch hẹn tư vấn tâm lý</p>
    </div>
    <a asp-page="/Doctors/Index" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Đặt lịch mới
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Appointments.Any())
{
    <!-- Summary Stats -->
    <div class="row g-3 mb-4">
        <div class="col-4">
            <div class="appointment-stat-card stat-pending">
                <div class="stat-number">@pending</div>
                <div class="stat-label">Chờ xác nhận</div>
            </div>
        </div>
        <div class="col-4">
            <div class="appointment-stat-card stat-approved">
                <div class="stat-number">@approved</div>
                <div class="stat-label">Đã xác nhận</div>
            </div>
        </div>
        <div class="col-4">
            <div class="appointment-stat-card stat-completed">
                <div class="stat-number">@completed</div>
                <div class="stat-label">Hoàn thành</div>
            </div>
        </div>
    </div>

    <!-- Appointment Cards -->
    <div class="appointment-list">
        @foreach (var apt in Model.Appointments.OrderByDescending(a => a.StartAt))
        {
            var isPending = apt.Status == 0;
            var isApproved = apt.Status == 1;
            var isCompleted = apt.Status == 4;
            var isCancelled = apt.Status == 3;
            var isRejected = apt.Status == 2;

            var borderClass = isPending ? "border-start-warning" :
                              isApproved ? "border-start-primary" :
                              isCompleted ? "border-start-success" :
                              isCancelled || isRejected ? "border-start-danger" : "";

            <div class="appointment-card @borderClass">
                <div class="appointment-card-body">
                    <div class="d-flex align-items-start justify-content-between flex-wrap gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="appointment-date-badge">
                                @{
                                    var dateDisplay = apt.AppointmentDate ?? "";
                                    var dayNum = "";
                                    var monthStr = "";
                                    if (DateTime.TryParse(apt.AppointmentDate, out var parsedDate))
                                    {
                                        dayNum = parsedDate.Day.ToString();
                                        monthStr = parsedDate.ToString("MMM").ToUpper();
                                    }
                                    else
                                    {
                                        dayNum = "—";
                                        monthStr = "";
                                    }
                                }
                                <span class="date-day">@dayNum</span>
                                <span class="date-month">@monthStr</span>
                            </div>
                            <div>
                                <h6 class="mb-1">@(apt.DoctorName ?? "Chuyên gia")</h6>
                                @if (!string.IsNullOrEmpty(apt.Specialization))
                                {
                                    <span class="mb-chip small">@apt.Specialization</span>
                                }
                                <div class="mt-1 d-flex flex-wrap gap-2 align-items-center" style="font-size:0.8125rem;color:var(--mb-text-secondary);">
                                    <span><i class="bi bi-clock me-1"></i>@(apt.StartTime ?? "—")</span>
                                    @if (!string.IsNullOrEmpty(apt.BookingCode))
                                    {
                                        <span class="d-none d-sm-inline"><i class="bi bi-upc me-1"></i>@apt.BookingCode</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="d-flex flex-column align-items-end gap-2">
                            <partial name="_StatusBadge" view-data='@(new ViewDataDictionary(ViewData) { { "Status", apt.Status } })' />
                            <a asp-page="Details" asp-route-id="@apt.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye me-1"></i>Chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (Model.Pagination != null)
    {
        <partial name="_Pagination" view-data='@(new ViewDataDictionary(ViewData) { { "Pagination", Model.Pagination }, { "PageUrl", "/Patient/Appointments" } })' />
    }
}
else
{
    <!-- Empty State -->
    <div class="empty-appointments-state">
        <div class="empty-icon-wrapper">
            <i class="bi bi-calendar-heart"></i>
        </div>
        <h4>Chưa có lịch hẹn nào</h4>
        <p class="text-muted mb-4">Hãy bắt đầu hành trình chăm sóc sức khỏe tinh thần của bạn ngay hôm nay.</p>
        <a asp-page="/Doctors/Index" class="btn btn-primary btn-lg">
            <i class="bi bi-search-heart me-2"></i>Tìm chuyên gia tâm lý
        </a>
    </div>
}
