@page
@model OPCBS.Web.Pages.Patient.Appointments.IndexModel
@{
    ViewData["Title"] = "My Appointments";
    ViewData["UseDashboardLayout"] = true;
}

<style>
    /* ── Filter Bar ── */
    .apt-filter-bar {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 1.25rem;
        margin-bottom: 1.75rem;
    }

    /* ── Appointment Cards ── */
    .apt-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        margin-bottom: 0.875rem;
        border-left: 4px solid transparent;
        transition: all 0.2s ease;
        overflow: hidden;
    }

    .apt-card:hover {
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
        transform: translateX(2px);
    }

    .apt-card.st-pending {
        border-left-color: #f59e0b;
    }

    .apt-card.st-approved {
        border-left-color: #3b82f6;
    }

    .apt-card.st-inprogress {
        border-left-color: #8b5cf6;
    }

    .apt-card.st-completed {
        border-left-color: #10b981;
    }

    .apt-card.st-cancelled {
        border-left-color: #ef4444;
    }

    .apt-card.st-rejected {
        border-left-color: #6b7280;
    }

    .apt-card-body {
        padding: 1.25rem 1.5rem;
    }

    .apt-date-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: #f8fafc;
        border-radius: 12px;
        width: 56px;
        height: 56px;
        flex-shrink: 0;
        border: 1px solid #f1f5f9;
    }

    .apt-date-day {
        font-size: 1.25rem;
        font-weight: 700;
        color: #1e293b;
        line-height: 1.1;
    }

    .apt-date-month {
        font-size: 0.6rem;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .apt-spec-chip {
        display: inline-block;
        background: #eff6ff;
        color: #2563eb;
        padding: 2px 10px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.72rem;
    }

    .apt-pkg-chip {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #f0fdf4;
        color: #16a34a;
        padding: 2px 8px;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.68rem;
    }

    .apt-meta {
        font-size: 0.8rem;
        color: #64748b;
    }

    /* ── Status Badges ── */
    .apt-status {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.02em;
    }

    .apt-status.s-pending {
        background: #fef3c7;
        color: #92400e;
    }

    .apt-status.s-approved {
        background: #dbeafe;
        color: #1e40af;
    }

    .apt-status.s-inprogress {
        background: #ede9fe;
        color: #5b21b6;
    }

    .apt-status.s-completed {
        background: #d1fae5;
        color: #065f46;
    }

    .apt-status.s-cancelled {
        background: #fee2e2;
        color: #991b1b;
    }

    .apt-status.s-rejected {
        background: #f3f4f6;
        color: #374151;
    }

    /* ── Action Buttons ── */
    .apt-btn {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 5px 14px;
        border-radius: 10px;
        font-size: 0.78rem;
        font-weight: 600;
        border: 1px solid #e2e8f0;
        background: #fff;
        color: #475569;
        transition: all 0.15s ease;
        text-decoration: none;
    }

    .apt-btn:hover {
        background: #f8fafc;
        border-color: #cbd5e1;
        color: #1e293b;
    }

    .apt-btn.btn-view {
        border-color: #bfdbfe;
        color: #2563eb;
    }

    .apt-btn.btn-view:hover {
        background: #eff6ff;
    }

    .apt-btn.btn-chat {
        border-color: #a5f3fc;
        color: #0891b2;
    }

    .apt-btn.btn-chat:hover {
        background: #ecfeff;
    }

    .apt-btn.btn-star {
        border-color: #fde68a;
        color: #d97706;
    }

    .apt-btn.btn-star:hover {
        background: #fffbeb;
    }

    /* ── Empty State ── */
    .apt-empty {
        text-align: center;
        padding: 80px 24px;
        background: #fff;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
    }

    .apt-empty-icon {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: #f1f5f9;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        color: #94a3b8;
        margin-bottom: 1.25rem;
    }

    /* ── Pagination Styling ── */
    .apt-pagination-link {
        border-radius: 10px !important;
        border: 1px solid #e2e8f0 !important;
        font-weight: 600;
        padding: 8px 14px;
        font-size: 0.85rem;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #475569;
        background-color: #fff;
        text-decoration: none;
    }

    .apt-pagination-link:hover {
        background-color: #f8fafc;
        border-color: #cbd5e1;
        color: #1e293b;
    }

    .apt-pagination-item.active .apt-pagination-link {
        background-color: #2563eb !important;
        border-color: #2563eb !important;
        color: #fff !important;
    }

    .apt-pagination-item.disabled .apt-pagination-link {
        color: #cbd5e1 !important;
        border-color: #f1f5f9 !important;
        background-color: #fff !important;
        pointer-events: none;
    }
</style>

<!-- Page Header -->
<div class="mb-page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <h1><i class="bi bi-calendar-check me-2" style="color:var(--mb-primary);"></i>My Appointments</h1>
        <p class="text-muted mb-0 mt-1" style="font-size:0.875rem;">Manage and track your consultation appointments</p>
    </div>
    <a asp-page="/Doctors/Index" class="btn btn-primary" style="border-radius:10px; padding:8px 20px;">
        <i class="bi bi-plus-lg me-1"></i>Book New Appointment
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert"
         style="border-radius:12px; border:none; margin-bottom: 1.5rem;">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert"
         style="border-radius:12px; border:none; margin-bottom: 1.5rem;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filter Bar Form -->
<form method="get" id="filterForm">
    <!-- Reset page to 1 when changing filters -->
    <input type="hidden" name="page" value="1" />

    <div class="apt-filter-bar d-flex gap-3 align-items-center flex-wrap">
        <div style="flex: 1.2; min-width: 180px;">
            <select name="Status" onchange="this.form.submit()" class="form-select"
                    style="height: 44px; border-radius: 10px; border: 1px solid #e2e8f0; font-size: 0.85rem; color: #475569; font-weight: 500; outline: none; box-shadow: none;">
                <option value="" selected="@(string.IsNullOrEmpty(Model.Status) ? "selected" : null)">All Statuses
                </option>
                <option value="Pending" selected="@(Model.Status == "Pending" ? "selected" : null)">Pending</option>
                <option value="Approved" selected="@(Model.Status == "Approved" ? "selected" : null)">Confirmed</option>
                <option value="InProgress" selected="@(Model.Status == "InProgress" ? "selected" : null)">In Progress
                </option>
                <option value="Completed" selected="@(Model.Status == "Completed" ? "selected" : null)">Completed
                </option>
                <option value="Rejected" selected="@(Model.Status == "Rejected" ? "selected" : null)">Rejected</option>
                <option value="Cancelled" selected="@(Model.Status == "Cancelled" ? "selected" : null)">Cancelled
                </option>
            </select>
        </div>
        <div style="flex: 1.5; min-width: 200px;">
            <select name="Doctor" onchange="this.form.submit()" class="form-select"
                    style="height: 44px; border-radius: 10px; border: 1px solid #e2e8f0; font-size: 0.85rem; color: #475569; font-weight: 500; outline: none; box-shadow: none;">
                <option value="" selected="@(string.IsNullOrEmpty(Model.Doctor) ? "selected" : null)">All Doctors
                </option>
                @foreach (var docName in Model.UniqueDoctors)
                {
                    <option value="@docName" selected="@(Model.Doctor == docName ? "selected" : null)">Doctor:@docName
                    </option>
                }
            </select>
        </div>
        <div style="flex: 1; min-width: 150px;">
            <input type="date" name="Date" value="@Model.Date" onchange="this.form.submit()" class="form-control"
                   style="height: 44px; border-radius: 10px; border: 1px solid #e2e8f0; font-size: 0.85rem; color: #475569; font-weight: 500; outline: none; box-shadow: none;" />
        </div>
        @if (!string.IsNullOrEmpty(Model.Status) || !string.IsNullOrEmpty(Model.Doctor) ||
        !string.IsNullOrEmpty(Model.Date))
        {
            <div>
                <a href="?" class="btn btn-outline-secondary"
                   style="height: 44px; border-radius: 10px; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 6px; font-weight: 500;">
                    <i class="bi bi-arrow-counterclockwise"></i> Reset
                </a>
            </div>
        }
    </div>
</form>

@if (Model.Appointments.Any())
{
    <div class="appointment-list">
        @foreach (var apt in Model.Appointments)
        {
            var isPending = apt.Status == 0;
            var isApproved = apt.Status == 1;
            var isRejected = apt.Status == 2;
            var isInProgress = apt.Status == 3;
            var isCompleted = apt.Status == 4;
            var isCancelled = apt.Status == 5;

            var borderClass = isPending ? "st-pending" :
                              isApproved ? "st-approved" :
                              isInProgress ? "st-inprogress" :
                              isCompleted ? "st-completed" :
                              isCancelled ? "st-cancelled" :
                              isRejected ? "st-rejected" : "";

            var statusClass = isPending ? "s-pending" :
                              isApproved ? "s-approved" :
                              isInProgress ? "s-inprogress" :
                              isCompleted ? "s-completed" :
                              isCancelled ? "s-cancelled" :
                              isRejected ? "s-rejected" : "";

            var statusIcon = isPending ? "bi-hourglass-split" :
                             isApproved ? "bi-check-circle-fill" :
                             isInProgress ? "bi-play-circle-fill" :
                             isCompleted ? "bi-patch-check-fill" :
                             isCancelled ? "bi-x-circle-fill" :
                             isRejected ? "bi-slash-circle" : "bi-question-circle";

            <div class="apt-card @borderClass">
                <div class="apt-card-body">
                    <div class="d-flex align-items-start justify-content-between flex-wrap gap-3">
                        <!-- Left: Date + Info -->
                        <div class="d-flex align-items-center gap-3" style="flex:1; min-width:0;">
                            <div class="apt-date-box">
                                @{
                                    var dayNum = "";
                                    var monthStr = "";
                                    if (DateTime.TryParse(apt.AppointmentDate, out var parsedDate))
                                    {
                                        dayNum = parsedDate.Day.ToString();
                                        monthStr = parsedDate.ToString("MMM").ToUpper();
                                    }
                                    else
                                    {
                                        dayNum = "—";
                                    }
                                }
                                <span class="apt-date-day">@dayNum</span>
                                <span class="apt-date-month">@monthStr</span>
                            </div>
                            <div style="min-width:0;">
                                <h6 class="mb-1 fw-bold" style="font-size:0.95rem; color:#1e293b;">Doctor: @(apt.DoctorName ?? "Specialist")</h6>
                                    <div class="d-flex flex-wrap gap-2 align-items-center mb-1">
                                        @if (!string.IsNullOrEmpty(apt.Specialization))
                                        {
                                            <span class="apt-spec-chip">@apt.Specialization</span>
                                        }
                                        @if (apt.TreatmentPackageId.HasValue)
                                        {
                                            <span class="apt-pkg-chip"><i class="bi bi-box-seam"></i>Package</span>
                                        }
                                    </div>
                                    <div class="d-flex flex-wrap gap-3 apt-meta">
                                        <span><i class="bi bi-clock me-1"></i>@(apt.StartTime ?? "—") — @(apt.EndTime ?? "")</span>
                                        @if (!string.IsNullOrEmpty(apt.BookingCode))
                                        {
                                            <span class="d-none d-sm-inline"><i class="bi bi-upc me-1"></i>@apt.BookingCode</span>
                                        }
                                        @if (apt.Fee.HasValue && apt.Fee > 0)
                                        {
                                            <span><i class="bi bi-wallet2 me-1"></i>@apt.Fee?.ToString("N0") VND</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Right: Status + Actions -->
                            <div class="d-flex flex-column align-items-end gap-2">
                                <span class="apt-status @statusClass">
                                    <i class="bi @statusIcon"></i>
                                    @apt.StatusText
                                </span>
                                <div class="d-flex gap-1 flex-wrap">
                                    @if (isCompleted)
                                    {
                                        <a asp-page="/Patient/Reviews/Create" asp-route-appointmentId="@apt.Id" class="apt-btn btn-star"
                                           title="Write Review">
                                            <i class="bi bi-star"></i>
                                        </a>
                                    }
                                    @if (isApproved || isInProgress)
                                    {
                                        <a asp-page="/Patient/Messages/Index" asp-route-doctorId="@apt.DoctorId"
                                           class="apt-btn btn-chat" title="Chat with Doctor">
                                            <i class="bi bi-chat-dots-fill"></i>
                                        </a>
                                    }
                                    <a asp-page="Details" asp-route-id="@apt.Id" class="apt-btn btn-view">
                                        <i class="bi bi-eye me-1"></i>Details
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination Controls -->
        @if (Model.Pagination != null && Model.Pagination.TotalPages > 1)
        {
            <nav aria-label="Page navigation" class="mt-4">
                <ul class="pagination justify-content-center gap-1 border-0">
                    <!-- Previous Button -->
                    <li class="page-item apt-pagination-item @(Model.Pagination.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link apt-pagination-link"
                           href="@Url.Page("./Index", new { page = Model.Pagination.Page - 1, Status = Model.Status, Doctor = Model.Doctor, Date = Model.Date })">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                    </li>

                    <!-- Page Number Buttons -->
                    @for (int i = 1; i <= Model.Pagination.TotalPages; i++)
                    {
                        <li class="page-item apt-pagination-item @(Model.Pagination.Page == i ? "active" : "")">
                            <a class="page-link apt-pagination-link"
                               href="@Url.Page("./Index", new { page = i, Status = Model.Status, Doctor = Model.Doctor, Date = Model.Date })">
                                @i
                            </a>
                        </li>
                    }

                    <!-- Next Button -->
                    <li class="page-item apt-pagination-item @(Model.Pagination.HasNextPage ? "" : "disabled")">
                        <a class="page-link apt-pagination-link"
                           href="@Url.Page("./Index", new { page = Model.Pagination.Page + 1, Status = Model.Status, Doctor = Model.Doctor, Date = Model.Date })">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
else
    {
        <div class="apt-empty">
            <div class="apt-empty-icon">
                <i class="bi bi-calendar-heart"></i>
            </div>
            <h4 style="color:#475569; font-weight:700; margin-bottom:8px;">No matching appointments</h4>
            <p class="text-muted mb-4" style="font-size:0.9rem;">Adjust your filters or look for a new therapist.</p>
            <a asp-page="/Doctors/Index" class="btn btn-primary btn-lg" style="border-radius:12px; padding:10px 28px;">
                <i class="bi bi-search-heart me-2"></i>Find a Therapist
            </a>
        </div>
    }
