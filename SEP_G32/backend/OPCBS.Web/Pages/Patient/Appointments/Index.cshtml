@page
@model OPCBS.Web.Pages.Patient.Appointments.IndexModel
@{
    ViewData["Title"] = "My Appointments";
    ViewData["UseDashboardLayout"] = true;
}

<style>
    .stat-card {
        border-radius: 12px;
        border: none;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        cursor: pointer;
        text-decoration: none;
    }
    .stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.08) !important;
    }
    .stat-card .stat-icon {
        width: 48px; height: 48px;
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.25rem;
    }
    .stat-card .stat-value { font-size: 1.75rem; font-weight: 700; line-height: 1; }
    .stat-card .stat-label { font-size: 0.8rem; color: #6c757d; font-weight: 500; }

    .appointment-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        margin-bottom: 1rem;
        border-left: 4px solid transparent;
        transition: all 0.2s ease;
    }
    .appointment-card:hover {
        box-shadow: 0 4px 16px rgba(0,0,0,0.06);
        transform: translateX(2px);
    }
    .appointment-card.status-pending { border-left-color: #f59e0b; }
    .appointment-card.status-approved { border-left-color: #3b82f6; }
    .appointment-card.status-inprogress { border-left-color: #f59e0b; }
    .appointment-card.status-completed { border-left-color: #10b981; }
    .appointment-card.status-cancelled { border-left-color: #ef4444; }
    .appointment-card.status-rejected { border-left-color: #6c757d; }

    .appointment-card-body { padding: 1.25rem; }

    .appointment-date-badge {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        background: #f1f5f9; border-radius: 10px; width: 54px; height: 54px; text-align: center;
        flex-shrink: 0;
    }
    .date-day { font-size: 1.2rem; font-weight: 700; color: #1e293b; line-height: 1.2; }
    .date-month { font-size: 0.65rem; font-weight: 600; color: #64748b; text-transform: uppercase; }
    .mb-chip {
        display: inline-block; background: #e0f2fe; color: #0369a1; padding: 2px 10px; border-radius: 8px; font-weight: 600; font-size: 0.75rem;
    }

    .filter-section {
        border-radius: 12px;
        border: none;
    }

    .empty-appointments-state {
        text-align: center;
        padding: 80px 20px;
    }
    .empty-appointments-state i { font-size: 3.5rem; color: #dee2e6; }
    .empty-appointments-state h4 { color: #6c757d; margin-top: 16px; }
    .empty-appointments-state p { color: #adb5bd; font-size: 0.9rem; }
</style>

<div class="mb-page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <h1><i class="bi bi-calendar-check me-2" style="color:var(--mb-primary);"></i>My Appointments</h1>
        <p class="text-muted mb-0 mt-1" style="font-size:0.875rem;">Manage and track your consultation appointments</p>
    </div>
    <a asp-page="/Doctors/Index" class="btn btn-primary" style="border-radius:10px;">
        <i class="bi bi-plus-lg me-1"></i>Book New Appointment
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Status Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <a href="?status=Pending" class="stat-card card shadow-sm d-block @(Model.Status == "Pending" ? "ring ring-warning" : "")">
            <div class="card-body d-flex align-items-center gap-3 py-3">
                <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                    <i class="bi bi-clock-history"></i>
                </div>
                <div>
                    <div class="stat-value text-warning">@Model.PendingCount</div>
                    <div class="stat-label">Pending</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a href="?status=Approved" class="stat-card card shadow-sm d-block @(Model.Status == "Approved" ? "ring ring-info" : "")">
            <div class="card-body d-flex align-items-center gap-3 py-3">
                <div class="stat-icon bg-info bg-opacity-10 text-info">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div>
                    <div class="stat-value text-info">@Model.ApprovedCount</div>
                    <div class="stat-label">Confirmed</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a href="?status=Completed" class="stat-card card shadow-sm d-block @(Model.Status == "Completed" ? "ring ring-success" : "")">
            <div class="card-body d-flex align-items-center gap-3 py-3">
                <div class="stat-icon bg-success bg-opacity-10 text-success">
                    <i class="bi bi-check-all"></i>
                </div>
                <div>
                    <div class="stat-value text-success">@Model.CompletedCount</div>
                    <div class="stat-label">Completed</div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a href="?" class="stat-card card shadow-sm d-block @(string.IsNullOrEmpty(Model.Status) ? "ring ring-secondary" : "")">
            <div class="card-body d-flex align-items-center gap-3 py-3">
                <div class="stat-icon bg-secondary bg-opacity-10 text-secondary">
                    <i class="bi bi-list-ul"></i>
                </div>
                <div>
                    <div class="stat-value text-secondary">@Model.TotalCount</div>
                    <div class="stat-label">All</div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Search & Filter Bar -->
<div class="card filter-section shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" id="filterForm">
            <input type="hidden" name="page" id="pageInput" value="1" />
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-5 col-lg-4">
                    <label class="form-label small fw-bold text-muted text-uppercase mb-1" style="letter-spacing:0.04em; font-size:0.7rem;">Filter by Status</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0" style="border-radius:12px 0 0 12px; padding-left:14px; padding-right:8px; color:var(--mb-primary);">
                            <i class="bi bi-funnel-fill"></i>
                        </span>
                        <select name="Status" onchange="document.getElementById('pageInput').value='1'; this.form.submit();" class="form-select bg-light border-0" style="border-radius:0 12px 12px 0; padding:10px 14px; font-size:0.875rem; color:#1e293b; font-weight:600;">
                            <option value="" selected="@(string.IsNullOrEmpty(Model.Status) ? "selected" : null)">All Appointments</option>
                            <option value="Pending" selected="@(Model.Status == "Pending" ? "selected" : null)">Pending</option>
                            <option value="Approved" selected="@(Model.Status == "Approved" ? "selected" : null)">Confirmed</option>
                            <option value="InProgress" selected="@(Model.Status == "InProgress" ? "selected" : null)">In Progress</option>
                            <option value="Completed" selected="@(Model.Status == "Completed" ? "selected" : null)">Completed</option>
                            <option value="Cancelled" selected="@(Model.Status == "Cancelled" ? "selected" : null)">Cancelled</option>
                            <option value="Rejected" selected="@(Model.Status == "Rejected" ? "selected" : null)">Rejected</option>
                        </select>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@if (Model.Appointments.Any())
{
    <!-- Appointment Cards -->
    <div class="appointment-list">
        @foreach (var apt in Model.Appointments.OrderByDescending(a => a.StartAt))
        {
            var isPending = apt.Status == 0;
            var isApproved = apt.Status == 1;
            var isRejected = apt.Status == 2;
            var isInProgress = apt.Status == 3;
            var isCompleted = apt.Status == 4;
            var isCancelled = apt.Status == 5;

            var borderClass = isPending ? "status-pending" :
                              isApproved ? "status-approved" :
                              isInProgress ? "status-inprogress" :
                              isCompleted ? "status-completed" :
                              isCancelled ? "status-cancelled" :
                              isRejected ? "status-rejected" : "";

            <div class="appointment-card @borderClass">
                <div class="appointment-card-body">
                    <div class="d-flex align-items-start justify-content-between flex-wrap gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="appointment-date-badge">
                                @{
                                    var dateDisplay = apt.AppointmentDate ?? "";
                                    var dayNum = "";
                                    var monthStr = "";
                                    if (DateTime.TryParse(apt.AppointmentDate, out var parsedDate))
                                    {
                                        dayNum = parsedDate.Day.ToString();
                                        monthStr = parsedDate.ToString("MMM").ToUpper();
                                    }
                                    else
                                    {
                                        dayNum = "—";
                                        monthStr = "";
                                    }
                                }
                                <span class="date-day">@dayNum</span>
                                <span class="date-month">@monthStr</span>
                            </div>
                            <div>
                                <h6 class="mb-1">@(apt.DoctorName ?? "Specialist")</h6>
                                @if (!string.IsNullOrEmpty(apt.Specialization))
                                {
                                    <span class="mb-chip">@apt.Specialization</span>
                                }
                                <div class="mt-1 d-flex flex-wrap gap-2 align-items-center" style="font-size:0.8125rem;color:var(--mb-text-secondary);">
                                    <span><i class="bi bi-clock me-1"></i>@(apt.StartTime ?? "—")</span>
                                    @if (!string.IsNullOrEmpty(apt.BookingCode))
                                    {
                                        <span class="d-none d-sm-inline"><i class="bi bi-upc me-1"></i>@apt.BookingCode</span>
                                    }
                                    @if (apt.TreatmentPackageId.HasValue)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success" style="font-size:0.7rem;"><i class="bi bi-box-seam me-1"></i>Package</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="d-flex flex-column align-items-end gap-2">
                            <partial name="_StatusBadge" view-data='@(new ViewDataDictionary(ViewData) { { "Status", apt.Status } })' />
                            <div class="d-flex gap-1">
                                @if (isCompleted)
                                {
                                    <a asp-page="/Patient/Reviews/Create" asp-route-appointmentId="@apt.Id" class="btn btn-sm btn-outline-warning" title="Write Review">
                                        <i class="bi bi-star"></i>
                                    </a>
                                }
                                <a asp-page="Details" asp-route-id="@apt.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye me-1"></i>Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (Model.Pagination != null)
    {
        <partial name="_Pagination" view-data='@(new ViewDataDictionary(ViewData) { { "Pagination", Model.Pagination }, { "PageUrl", "/Patient/Appointments" } })' />
    }
}
else
{
    <!-- Empty State -->
    <div class="empty-appointments-state">
        <i class="bi bi-calendar-heart d-block"></i>
        <h4>No appointments found</h4>
        <p class="text-muted mb-4">Start your mental health care journey today.</p>
        <a asp-page="/Doctors/Index" class="btn btn-primary btn-lg" style="border-radius:12px;">
            <i class="bi bi-search-heart me-2"></i>Find a Therapist
        </a>
    </div>
}
