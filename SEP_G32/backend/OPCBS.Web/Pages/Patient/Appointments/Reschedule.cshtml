@page "{id:guid}"
@model OPCBS.Web.Pages.Patient.Appointments.RescheduleModel
@{
    ViewData["Title"] = "Reschedule Appointment";
    ViewData["UseDashboardLayout"] = true;
}

<div class="mb-page-header d-flex justify-content-between align-items-center">
    <h1>Reschedule Appointment</h1>
    <a asp-page="Details" asp-route-id="@ViewContext.HttpContext.Request.RouteValues["id"]" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

@if (Model.Error != null) { <div class="alert alert-danger">@Model.Error</div> }

@if (Model.Appointment != null)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="alert alert-info mb-4">
                <i class="bi bi-info-circle me-1"></i>
                Appointment current: <strong>@Model.Appointment.DoctorName</strong> — @Model.Appointment.AppointmentDate @Model.Appointment.StartTime
            </div>
            <form method="post" asp-route-id="@Model.Appointment.Id">
                <div class="mb-3">
                    <label class="form-label">Reason đổi lịch</label>
                    <textarea asp-for="Reason" class="form-control" rows="3" placeholder="Enter lý do..."></textarea>
                </div>
                <p class="text-muted small"><i class="bi bi-info-circle me-1"></i>Please liên hệ doctor to select slot new matching.</p>
                <button type="submit" class="btn btn-primary"><i class="bi bi-arrow-repeat me-1"></i>Submit Request đổi lịch</button>
            </form>
        </div>
    </div>
}
