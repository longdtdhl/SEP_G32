@page "{id:guid}"
@model OPCBS.Web.Pages.Patient.Appointments.DetailsModel
@{
    ViewData["Title"] = "Appointment Details";
    ViewData["UseDashboardLayout"] = true;
}

<div class="mb-page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <h1><i class="bi bi-calendar-event me-2" style="color:var(--mb-primary);"></i>Appointment Details</h1>
    </div>
    <a asp-page="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

@if (Model.Error != null)
{
    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-1"></i>@Model.Error</div>
}

@if (Model.Appointment != null)
{
    var apt = Model.Appointment;
    var isPending = apt.Status == 0;
    var isApproved = apt.Status == 1;
    var isCompleted = apt.Status == 4;
    var isCancelled = apt.Status == 3;
    var isRejected = apt.Status == 2;
    var canCancel = isPending || isApproved;

    <!-- Status Banner -->
    @if (isPending)
    {
        <div class="appointment-status-banner status-pending">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-hourglass-split"></i>
                <span><strong>Pending Confirmation</strong> — Doctor sẽ review and response soon.</span>
            </div>
        </div>
    }
    else if (isApproved)
    {
        <div class="appointment-status-banner status-approved">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-check-circle-fill"></i>
                <span><strong>Confirmed</strong> — Appointment your đã được doctor confirm.</span>
            </div>
        </div>
    }
    else if (isCompleted)
    {
        <div class="appointment-status-banner status-completed">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-patch-check-fill"></i>
                    <span><strong>Completed</strong> — Buổi consultation đã kết thúc.</span>
                </div>
                <a asp-page="/Patient/Reviews/Create" asp-route-appointmentId="@apt.Id" class="btn btn-sm btn-warning">
                    <i class="bi bi-star me-1"></i>Write Review
                </a>
            </div>
        </div>
    }
    else if (isCancelled)
    {
        <div class="appointment-status-banner status-cancelled">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-x-circle-fill"></i>
                <span><strong>Cancelled</strong></span>
            </div>
        </div>
    }
    else if (isRejected)
    {
        <div class="appointment-status-banner status-rejected">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-x-octagon-fill"></i>
                <span><strong>Rejected</strong> — Doctor đã rejected appointment this.</span>
            </div>
        </div>
    }

    <div class="row g-4 mt-1">
        <!-- Main Info -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <!-- Doctor info -->
                    <div class="d-flex align-items-center gap-3 mb-4 pb-4" style="border-bottom:1px solid var(--mb-border-light);">
                        @if (!string.IsNullOrEmpty(apt.DoctorAvatarUrl))
                        {
                            <img src="@apt.DoctorAvatarUrl" alt="@apt.DoctorName" class="rounded-circle" style="width:64px;height:64px;object-fit:cover;border:3px solid var(--mb-secondary);" />
                        }
                        else
                        {
                            <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:64px;height:64px;background:var(--mb-secondary);flex-shrink:0;">
                                <i class="bi bi-person-fill" style="font-size:1.5rem;color:var(--mb-primary);"></i>
                            </div>
                        }
                        <div class="flex-grow-1">
                            <h4 class="mb-1">@apt.DoctorName</h4>
                            @if (!string.IsNullOrEmpty(apt.Specialization))
                            {
                                <span class="mb-chip">@apt.Specialization</span>
                            }
                        </div>
                        <partial name="_StatusBadge" view-data='@(new ViewDataDictionary(ViewData) { { "Status", apt.Status } })' />
                    </div>

                    <!-- Appointment Details Grid -->
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="detail-info-box">
                                <div class="detail-info-icon"><i class="bi bi-calendar3"></i></div>
                                <div>
                                    <small class="text-muted d-block">Appointment Date</small>
                                    <strong>@apt.AppointmentDate</strong>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="detail-info-box">
                                <div class="detail-info-icon"><i class="bi bi-clock"></i></div>
                                <div>
                                    <small class="text-muted d-block">Time</small>
                                    <strong>@apt.StartTime — @apt.EndTime</strong>
                                </div>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(apt.BookingCode))
                        {
                            <div class="col-sm-6">
                                <div class="detail-info-box">
                                    <div class="detail-info-icon"><i class="bi bi-upc-scan"></i></div>
                                    <div>
                                        <small class="text-muted d-block">Booking Code</small>
                                        <strong class="font-monospace" style="color:var(--mb-primary);">@apt.BookingCode</strong>
                                    </div>
                                </div>
                            </div>
                        }
                        @if (apt.Fee.HasValue)
                        {
                            <div class="col-sm-6">
                                <div class="detail-info-box">
                                    <div class="detail-info-icon"><i class="bi bi-wallet2"></i></div>
                                    <div>
                                        <small class="text-muted d-block">Fee consultation</small>
                                        <strong>@apt.Fee?.ToString("N0") VND</strong>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Psychometric Test Section -->
                    <div class="mt-4 pt-3" style="border-top:1px solid var(--mb-border-light);">
                        <h6 class="mb-3"><i class="bi bi-clipboard2-pulse me-2" style="color:var(--mb-primary);"></i>Review health mental before appointment session</h6>
                        @if (Model.PsychometricSubmission != null)
                        {
                            <div class="p-3 bg-light rounded-3 d-flex align-items-center justify-content-between flex-wrap gap-3">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="badge bg-success-subtle text-success">Completed</span>
                                        <strong class="text-primary">@Model.PsychometricSubmission.TestTitle</strong>
                                    </div>
                                    <small class="text-muted d-block">Completed lúc: @Model.PsychometricSubmission.SubmittedAt.ToString("HH:mm MM/dd/yyyy")</small>
                                    <span class="text-secondary d-block mt-1">Result: <strong>@Model.PsychometricSubmission.Interpretation</strong> (Total Score: @Model.PsychometricSubmission.TotalScore)</span>
                                </div>
                                <a asp-page="/Patient/Psychometrics/Result" asp-route-submissionId="@Model.PsychometricSubmission.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-bar-chart-fill me-1"></i>Xem biểu đồ chi tiết
                                </a>
                            </div>
                        }
                        else if (isApproved || isPending)
                        {
                            <div class="p-3 border border-warning-subtle bg-warning-subtle bg-opacity-10 rounded-3">
                                <div class="d-flex align-items-start gap-2 mb-2">
                                    <i class="bi bi-info-circle-fill text-warning mt-1"></i>
                                    <div>
                                        <strong>Khuyến nghị làm bài check psyforlogy before appointment session</strong>
                                        <p class="mb-0 text-muted" style="font-size: 0.875rem;">Để doctor hiểu rõ more về tình trạng psyforlogy mental your before buổi consultation, bạn hãy làm bài reviews nhanh dưới here.</p>
                                    </div>
                                </div>
                                <div class="d-flex gap-2 flex-wrap mt-2">
                                    @foreach (var test in Model.AvailableTests)
                                    {
                                        <a asp-page="/Patient/Psychometrics/TakeTest" asp-route-testId="@test.Id" asp-route-appointmentId="@Model.Appointment.Id" class="btn btn-sm btn-primary">
                                            <i class="bi bi-pencil-square me-1"></i>Làm bài test: @test.Title
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted small">None bài test psyforlogy nào được làm for appointment this.</p>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(apt.Notes))
                    {
                        <div class="mt-4 pt-3" style="border-top:1px solid var(--mb-border-light);">
                            <h6><i class="bi bi-chat-left-text me-2" style="color:var(--mb-primary);"></i>Notes</h6>
                            <p class="mb-0 text-muted" style="background:var(--mb-bg);padding:12px 16px;border-radius:10px;">@apt.Notes</p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(apt.CancellationReason))
                    {
                        <div class="mt-4">
                            <div class="alert alert-warning mb-0 d-flex align-items-start gap-2" style="border-radius:10px;">
                                <i class="bi bi-exclamation-triangle-fill mt-1"></i>
                                <div>
                                    <strong>Cancellation Reason:</strong><br />
                                    @apt.CancellationReason
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Sidebar Actions -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 pb-0 pt-4 px-4">
                    <h6 class="mb-0"><i class="bi bi-lightning-charge me-2" style="color:var(--mb-primary);"></i>Actions</h6>
                </div>
                <div class="card-body d-grid gap-2 px-4 pb-4">
                    @if (isCompleted)
                    {
                        <a asp-page="/Patient/Reviews/Create" asp-route-appointmentId="@apt.Id" class="btn btn-primary">
                            <i class="bi bi-star me-1"></i>Rate Doctor
                        </a>
                        <a asp-page="/Patient/ConsultationRecords/Index" class="btn btn-outline-primary">
                            <i class="bi bi-file-medical me-1"></i>View Profile consultation
                        </a>
                    }

                    @if (canCancel)
                    {
                        <a asp-page="/Patient/Appointments/Reschedule" asp-route-id="@apt.Id" class="btn btn-outline-primary">
                            <i class="bi bi-arrow-repeat me-1"></i>Reschedule
                        </a>
                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelModal">
                            <i class="bi bi-x-circle me-1"></i>Cancel Appointment
                        </button>
                    }

                    <hr class="my-1" />
                    <a asp-page="/Doctors/Index" class="btn btn-outline-secondary">
                        <i class="bi bi-search-heart me-1"></i>Book Again
                    </a>
                </div>
            </div>

            <!-- Quick Info -->
            <div class="card border-0 shadow-sm mt-3">
                <div class="card-body p-4">
                    <h6 class="mb-3"><i class="bi bi-lightbulb me-2" style="color:var(--mb-warning);"></i>Tips</h6>
                    <ul class="list-unstyled mb-0" style="font-size:0.8125rem;color:var(--mb-text-secondary);line-height:1.8;">
                        <li><i class="bi bi-check2 me-2" style="color:var(--mb-primary);"></i>Đến đúng giờ to buổi consultation effective</li>
                        <li><i class="bi bi-check2 me-2" style="color:var(--mb-primary);"></i>Chuẩn bị before the câu hỏi muốn trao đổi</li>
                        <li><i class="bi bi-check2 me-2" style="color:var(--mb-primary);"></i>Cancel before 24h nếu không thể tham dự</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    @if (canCancel)
    {
        <!-- Cancel Modal -->
        <div class="modal fade" id="cancelModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content" style="border-radius:16px;border:none;">
                    <form method="post" asp-page-handler="Cancel" asp-route-id="@apt.Id">
                        <div class="modal-header border-0 pb-0">
                            <h5 class="modal-title"><i class="bi bi-exclamation-triangle text-danger me-2"></i>Cancel Appointment</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <p class="text-muted">Bạn có chắc chắn muốn hủy appointment with <strong>@apt.DoctorName</strong> ando ngày <strong>@apt.AppointmentDate</strong>?</p>
                            <div class="mb-3">
                                <label class="form-label">Cancellation Reason <span class="text-muted">(optional)</span></label>
                                <textarea asp-for="CancelReason" class="form-control" rows="3" placeholder="Enter lý do hủy..." style="border-radius:10px;"></textarea>
                            </div>
                        </div>
                        <div class="modal-footer border-0 pt-0">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                            <button type="submit" class="btn btn-danger"><i class="bi bi-x-circle me-1"></i>Confirm hủy</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="text-center py-5">
        <div class="mb-3">
            <i class="bi bi-calendar-x" style="font-size:3rem;color:var(--mb-text-muted);"></i>
        </div>
        <h5>Not found appointment</h5>
        <p class="text-muted">Appointment this không tồn at hoặc đã bị xóa.</p>
        <a asp-page="Index" class="btn btn-primary mt-2"><i class="bi bi-arrow-left me-1"></i>Back danh sách</a>
    </div>
}
