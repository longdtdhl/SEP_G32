@page
@model OPCBS.Web.Pages.Patient.Journal.IndexModel
@{ ViewData["Title"] = "Emotion Journal"; }

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-journal-heart me-2"></i>Emotion Journal</h2>
            <p class="text-muted mb-0">Write down how you're feeling today</p>
        </div>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createJournalModal">
            <i class="bi bi-plus-circle me-1"></i>New Entry
        </button>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>@Model.ErrorMessage</div>
    }

    @if (!Model.Journals.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-journal-heart display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">No Entries Yet</h4>
            <p class="text-muted">Start writing to track your emotional journey.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var j in Model.Journals)
            {
                <div class="col-md-6">
                    <div class="card h-100 shadow-sm border-0" style="border-radius: 12px;">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h6 class="fw-bold mb-0">@j.Title</h6>
                                <span style="font-size: 1.5rem;">@j.MoodEmoji</span>
                            </div>
                            @if (!string.IsNullOrEmpty(j.Content))
                            {
                                <p class="text-muted small mb-3">@j.Content</p>
                            }
                            <div class="d-flex justify-content-between small text-muted">
                                <span>Mood: @j.MoodText &middot; Stress: @j.StressText</span>
                                <span>@j.CreatedAt.ToString("MMM dd, yyyy")</span>
                            </div>
                            @if (j.IsShared)
                            {
                                <span class="badge bg-info mt-2"><i class="bi bi-share me-1"></i>Shared with therapist</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Create Journal Modal -->
<div class="modal fade" id="createJournalModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form method="post" asp-page-handler="Create">
            <div class="modal-header"><h5 class="modal-title">New Journal Entry</h5></div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label">Title</label>
                    <input type="text" name="title" class="form-control" required /></div>
                <div class="mb-3"><label class="form-label">What's on your mind?</label>
                    <textarea name="content" class="form-control" rows="4"></textarea></div>
                <div class="row g-3">
                    <div class="col-6"><label class="form-label">Mood (1-5)</label>
                        <select name="moodScale" class="form-select">
                            <option value="1">😢 Rất tệ</option>
                            <option value="2">😔 Tệ</option>
                            <option value="3" selected>😐 Bình thường</option>
                            <option value="4">😊 Tốt</option>
                            <option value="5">😄 Rất tốt</option>
                        </select></div>
                    <div class="col-6"><label class="form-label">Stress (1-5)</label>
                        <select name="stressScale" class="form-select">
                            <option value="1">Rất thấp</option>
                            <option value="2">Thấp</option>
                            <option value="3" selected>Trung bình</option>
                            <option value="4">Cao</option>
                            <option value="5">Rất cao</option>
                        </select></div>
                </div>
                <div class="form-check mt-3">
                    <input type="checkbox" name="isShared" value="true" class="form-check-input" id="isSharedCheck" />
                    <label class="form-check-label" for="isSharedCheck">Share this entry with my therapist</label>
                </div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save Entry</button></div>
        </form>
    </div></div>
</div>
