@page
@model OPCBS.Web.Pages.Patient.Journal.IndexModel
@{
    ViewData["Title"] = "Emotion & Mood Journal";
    Layout = "_DashboardLayout";
}

<style>
    .mood-picker-btn {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        border: 2px solid #e2e8f0;
        background: #ffffff;
        font-size: 1.5rem;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .mood-picker-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08);
        border-color: #cbd5e1;
    }
    .mood-picker-btn.selected {
        border-color: var(--mb-primary, #0d9488);
        background: rgba(13, 148, 136, 0.08);
        box-shadow: 0 0 0 3px rgba(13, 148, 136, 0.2);
        transform: translateY(-2px);
    }

    .stress-picker-btn {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        border: 2px solid #e2e8f0;
        background: #ffffff;
        font-size: 1.35rem;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .stress-picker-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08);
        border-color: #cbd5e1;
    }
    .stress-picker-btn.selected {
        border-color: #f59e0b;
        background: #fefce8;
        box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.2);
        transform: translateY(-2px);
    }

    .depression-picker-btn {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        border: 2px solid #e2e8f0;
        background: #ffffff;
        font-size: 1.1rem;
        font-weight: 800;
        color: #475569;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2px;
    }
    .depression-picker-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08);
        border-color: #818cf8;
    }
    .depression-picker-btn.selected {
        border-color: #6366f1;
        background: #eef2ff;
        color: #4338ca;
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.25);
        transform: translateY(-2px);
    }

    /* Journal Timeline Styles */
    .journal-timeline {
        position: relative;
        padding-left: 36px;
    }
    .journal-timeline::before {
        content: "";
        position: absolute;
        top: 20px;
        bottom: 20px;
        left: 13px;
        width: 2px;
        background: #e2e8f0;
    }
    .journal-timeline-item {
        position: relative;
        margin-bottom: 1.5rem;
    }
    .journal-timeline-item:last-child {
        margin-bottom: 0;
    }
    .journal-timeline-marker {
        position: absolute;
        left: -36px;
        top: 14px;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: #ffffff;
        border: 2px solid #cbd5e1;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        box-shadow: 0 2px 6px rgba(15, 23, 42, 0.08);
        z-index: 2;
        transition: all 0.2s;
    }
    .journal-timeline-item:hover .journal-timeline-marker {
        border-color: var(--mb-primary, #0d9488);
        transform: scale(1.15);
        box-shadow: 0 0 0 4px rgba(13, 148, 136, 0.15);
    }

    .journal-entry-card {
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        background: #ffffff;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
        transition: transform 0.15s ease, box-shadow 0.15s ease;
        overflow: hidden;
    }
    .journal-entry-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.08);
    }

    .btn-journal-delete {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        border: 1px solid transparent;
        background: transparent;
        color: #94a3b8;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.15s;
    }
    .btn-journal-delete:hover {
        background: #fee2e2;
        color: #dc2626;
        border-color: #fecaca;
    }

    .metric-pill-card {
        border-radius: 10px;
        padding: 0.55rem 0.8rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        flex: 1;
        min-width: 130px;
    }
</style>

<!-- Page Header -->
<div class="mb-page-header d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h1 class="h4 fw-bold text-dark mb-1">
            <i class="bi bi-journal-heart-fill me-2 text-teal" style="color:var(--mb-primary, #0d9488);"></i>Emotion & Mood Journal
        </h1>
        <p class="text-muted mb-0" style="font-size:0.85rem;">Log your daily emotions, sleep, stress, and mental well-being to track your therapeutic progress.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        @if (Model.CaseId.HasValue)
        {
            <a asp-page="/Patient/TreatmentCases/Details" asp-route-id="@Model.CaseId.Value" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold" style="border-radius:8px; font-size:0.82rem;">
                <i class="bi bi-arrow-left me-1"></i>Back to Treatment Case
            </a>
        }
        else
        {
            <a asp-page="/Patient/TreatmentCases/Index" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold" style="border-radius:8px; font-size:0.82rem;">
                <i class="bi bi-heart-pulse me-1"></i>Treatment Progress
            </a>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" style="border-radius:10px;">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (Model.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert" style="border-radius:10px;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <!-- Left Column: Create Journal Form -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm mb-4" style="border-radius:16px; border:1px solid #e2e8f0; background:#ffffff;">
            <div class="card-body p-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h5 class="fw-bold mb-0 text-dark" style="font-size:1rem;">
                        <i class="bi bi-pencil-square me-2 text-teal" style="color:var(--mb-primary, #0d9488);"></i>Record Daily Journal
                    </h5>
                </div>
                <form method="post">
                    <!-- Title -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark" style="font-size:0.82rem;">Journal Title <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control" placeholder="How are you feeling today?" style="border-radius:10px; font-size:0.88rem;" required />
                    </div>

                    <!-- Mood Rating -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label fw-semibold text-dark mb-0" style="font-size:0.82rem;">Mood Rating <span class="text-danger">*</span></label>
                            <span class="text-muted small" id="moodLabelText" style="font-size:0.75rem; font-weight:600;">Select rating</span>
                        </div>
                        <div class="d-flex gap-2 flex-wrap mt-1">
                            <button type="button" class="mood-picker-btn" data-mood="1" onclick="selectMood(1, 'Very Bad (1/5)')" title="1 - Very Bad">😢</button>
                            <button type="button" class="mood-picker-btn" data-mood="2" onclick="selectMood(2, 'Bad (2/5)')" title="2 - Bad">😔</button>
                            <button type="button" class="mood-picker-btn" data-mood="3" onclick="selectMood(3, 'Neutral (3/5)')" title="3 - Neutral">😐</button>
                            <button type="button" class="mood-picker-btn" data-mood="4" onclick="selectMood(4, 'Good (4/5)')" title="4 - Good">😊</button>
                            <button type="button" class="mood-picker-btn" data-mood="5" onclick="selectMood(5, 'Great (5/5)')" title="5 - Great">😄</button>
                        </div>
                        <input type="hidden" asp-for="MoodScale" id="moodInput" />
                    </div>

                    <!-- Stress Level -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label fw-semibold text-dark mb-0" style="font-size:0.82rem;">Stress Level <span class="text-danger">*</span></label>
                            <span class="text-muted small" id="stressLabelText" style="font-size:0.75rem; font-weight:600;">Select level</span>
                        </div>
                        <div class="d-flex gap-2 flex-wrap mt-1">
                            <button type="button" class="stress-picker-btn" data-stress="1" onclick="selectStress(1, 'Very Low (1/5)')" title="1 - Very Low">🟢</button>
                            <button type="button" class="stress-picker-btn" data-stress="2" onclick="selectStress(2, 'Low (2/5)')" title="2 - Low">🟡</button>
                            <button type="button" class="stress-picker-btn" data-stress="3" onclick="selectStress(3, 'Moderate (3/5)')" title="3 - Moderate">🟠</button>
                            <button type="button" class="stress-picker-btn" data-stress="4" onclick="selectStress(4, 'High (4/5)')" title="4 - High">🔴</button>
                            <button type="button" class="stress-picker-btn" data-stress="5" onclick="selectStress(5, 'Extreme (5/5)')" title="5 - Extreme">⛔</button>
                        </div>
                        <input type="hidden" asp-for="StressScale" id="stressInput" />
                    </div>

                    <!-- Sleep Hours (Dedicated Row) -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label fw-semibold text-dark mb-0" style="font-size:0.82rem;">
                                <i class="bi bi-moon-stars-fill me-1" style="color:#6366f1;"></i>Sleep (Last Night)
                            </label>
                            <span class="text-muted small" style="font-size:0.75rem;">Hours slept</span>
                        </div>
                        <div class="input-group" style="max-width:200px;">
                            <input asp-for="SleepHours" type="number" step="0.5" min="0" max="24" class="form-control" placeholder="7.5" style="border-radius:10px 0 0 10px; font-weight:600; font-size:0.88rem;" />
                            <span class="input-group-text bg-light text-muted" style="border-radius:0 10px 10px 0; font-size:0.78rem; font-weight:600;">hours</span>
                        </div>
                    </div>

                    <!-- Depression Level (Dedicated Intuitive Visual Row) -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label fw-semibold text-dark mb-0" style="font-size:0.82rem;">
                                <i class="bi bi-cloud-rain-fill me-1" style="color:#818cf8;"></i>Depression Level <span class="text-danger">*</span>
                            </label>
                            <span class="text-muted small" id="depressionLabelText" style="font-size:0.75rem; font-weight:600; color:#6366f1;">Very Low (1/5)</span>
                        </div>
                        <div class="d-flex gap-2 flex-wrap mt-1">
                            <button type="button" class="depression-picker-btn selected" data-dep="1" onclick="selectDepression(1, 'Very Low (1/5)')" title="1 - Very Low">
                                <span>1</span>
                            </button>
                            <button type="button" class="depression-picker-btn" data-dep="2" onclick="selectDepression(2, 'Low (2/5)')" title="2 - Low">
                                <span>2</span>
                            </button>
                            <button type="button" class="depression-picker-btn" data-dep="3" onclick="selectDepression(3, 'Moderate (3/5)')" title="3 - Moderate">
                                <span>3</span>
                            </button>
                            <button type="button" class="depression-picker-btn" data-dep="4" onclick="selectDepression(4, 'High (4/5)')" title="4 - High">
                                <span>4</span>
                            </button>
                            <button type="button" class="depression-picker-btn" data-dep="5" onclick="selectDepression(5, 'Extreme (5/5)')" title="5 - Extreme">
                                <span>5</span>
                            </button>
                        </div>
                        <div class="d-flex justify-content-between text-muted mt-1 px-1" style="font-size:0.72rem; font-weight:600; max-width:290px;">
                            <span>Very Low</span>
                            <span>Moderate</span>
                            <span>High</span>
                        </div>
                        <input type="hidden" asp-for="DepressionScale" id="depressionInput" value="1" />
                    </div>

                    <!-- Detailed Notes -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark" style="font-size:0.82rem;">Detailed Notes (Optional)</label>
                        <textarea asp-for="Content" class="form-control" rows="3" placeholder="Share your thoughts, triggers, or key reflections of the day..." style="border-radius:10px; font-size:0.85rem; line-height:1.6;"></textarea>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="IsShared" class="form-check-input" type="checkbox" id="shareCheck" />
                        <label class="form-check-label text-muted" for="shareCheck" style="font-size:0.82rem;">
                            <i class="bi bi-shield-check me-1 text-teal" style="color:var(--mb-primary, #0d9488);"></i>Share this journal entry with my therapist
                        </label>
                    </div>

                    <button type="submit" class="btn text-white w-100 py-2.5 fw-semibold" style="border-radius:10px; background:var(--mb-primary, #0d9488); font-size:0.9rem;">
                        <i class="bi bi-journal-plus me-1.5"></i>Save Journal Entry
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Right Column: Journal Timeline -->
    <div class="col-lg-7">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0 text-dark" style="font-size:1.05rem;">
                <i class="bi bi-clock-history me-2" style="color:var(--mb-primary, #0d9488);"></i>Recent Journals
            </h5>
            @if (Model.Journals.Any())
            {
                <span class="badge bg-light text-muted border px-2.5 py-1" style="font-size:0.75rem;">
                    @Model.Journals.Count entries
                </span>
            }
        </div>

        @if (Model.Journals.Any())
        {
            <div class="journal-timeline">
                @foreach (var j in Model.Journals)
                {
                    var mStyle = j.MoodStyle;
                    var sStyle = j.StressStyle;
                    var dStyle = j.DepressionStyle;

                    <div class="journal-timeline-item">
                        <div class="journal-timeline-marker">
                            @j.MoodEmoji
                        </div>
                        <div class="journal-timeline-content">
                            <div class="journal-entry-card">
                                <div class="p-3.5" style="padding: 1.25rem;">
                                    <!-- Header Row -->
                                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2.5">
                                        <div class="flex-grow-1">
                                            <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                                <h6 class="fw-bold text-dark mb-0" style="font-size:1rem; letter-spacing:-0.01em;">@j.Title</h6>
                                                @if (j.IsShared)
                                                {
                                                    <span class="badge" style="background:#eff6ff; color:#1d4ed8; border:1px solid #bfdbfe; font-size:0.68rem; font-weight:600; padding:3px 8px;">
                                                        <i class="bi bi-people-fill me-1"></i>Shared with Doctor
                                                    </span>
                                                }
                                            </div>
                                            <div class="text-muted d-flex align-items-center gap-1" style="font-size:0.75rem;">
                                                <i class="bi bi-calendar3"></i>
                                                <span>@j.CreatedAt.ToString("MMM dd, yyyy · HH:mm")</span>
                                            </div>
                                        </div>

                                        <form method="post" asp-page-handler="Delete" asp-route-journalId="@j.Id" onsubmit="return confirm('Do you want to delete this journal entry?');" class="ms-2">
                                            <button type="submit" class="btn-journal-delete" title="Delete entry">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </form>
                                    </div>

                                    <!-- Multi-Metric Pill Grid (Mood, Stress, Sleep, Depression) -->
                                    <div class="row g-2 my-2">
                                        <!-- Mood Metric -->
                                        <div class="col-6 col-sm-3">
                                            <div class="metric-pill-card h-100" style="background:@mStyle.Bg; border:1px solid @mStyle.Border;">
                                                <div>
                                                    <div class="text-muted text-uppercase" style="font-size:0.65rem; font-weight:700; letter-spacing:0.04em;">Mood</div>
                                                    <div class="fw-bold text-truncate" style="color:@mStyle.Text; font-size:0.8rem;">@j.MoodText</div>
                                                </div>
                                                <div class="text-end">
                                                    <span style="font-size:1.1rem; line-height:1;">@j.MoodEmoji</span>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Stress Metric -->
                                        <div class="col-6 col-sm-3">
                                            <div class="metric-pill-card h-100" style="background:@sStyle.Bg; border:1px solid @sStyle.Border;">
                                                <div>
                                                    <div class="text-muted text-uppercase" style="font-size:0.65rem; font-weight:700; letter-spacing:0.04em;">Stress</div>
                                                    <div class="fw-bold text-truncate" style="color:@sStyle.Text; font-size:0.8rem;">@j.StressText</div>
                                                </div>
                                                <div class="text-end">
                                                    <span class="badge" style="background:#ffffff; color:@sStyle.Text; border:1px solid @sStyle.Border; font-size:0.68rem; font-weight:700;">@j.StressScale/5</span>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Sleep Metric -->
                                        <div class="col-6 col-sm-3">
                                            <div class="metric-pill-card h-100" style="background:#f5f3ff; border:1px solid #ddd6fe;">
                                                <div>
                                                    <div class="text-muted text-uppercase" style="font-size:0.65rem; font-weight:700; letter-spacing:0.04em;">Sleep</div>
                                                    <div class="fw-bold" style="color:#5b21b6; font-size:0.8rem;">@(j.SleepHours.HasValue ? $"{j.SleepHours.Value:0.#} hrs" : "—")</div>
                                                </div>
                                                <div class="text-end">
                                                    <i class="bi bi-moon-stars-fill" style="color:#7c3aed; font-size:0.95rem;"></i>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Depression Metric -->
                                        <div class="col-6 col-sm-3">
                                            <div class="metric-pill-card h-100" style="background:@dStyle.Bg; border:1px solid @dStyle.Border;">
                                                <div>
                                                    <div class="text-muted text-uppercase" style="font-size:0.65rem; font-weight:700; letter-spacing:0.04em;">Depression</div>
                                                    <div class="fw-bold text-truncate" style="color:@dStyle.Text; font-size:0.8rem;">@(j.DepressionScale.HasValue ? j.DepressionText : "—")</div>
                                                </div>
                                                <div class="text-end">
                                                    <span class="badge" style="background:#ffffff; color:@dStyle.Text; border:1px solid @dStyle.Border; font-size:0.68rem; font-weight:700;">@(j.DepressionScale.HasValue ? $"{j.DepressionScale.Value}/5" : "—")</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Content Notes (Only rendered if present) -->
                                    @if (!string.IsNullOrWhiteSpace(j.Content))
                                    {
                                        <div class="mt-2.5 p-3 rounded-3" style="background:#f8fafc; border:1px solid #f1f5f9; border-left:3px solid var(--mb-primary, #0d9488); font-size:0.85rem; color:#334155; line-height:1.6; white-space:pre-line;">
                                            @j.Content
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted border border-dashed rounded-3" style="border-radius: 16px; background: #fafbfc;">
                <i class="bi bi-journal-x d-block mb-2" style="font-size: 2.5rem; opacity:0.3;"></i>
                <h6 class="fw-bold text-dark">No journal entries recorded yet</h6>
                <span class="small">Start logging your daily thoughts and emotions to track your emotional well-being over time.</span>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function selectMood(val, text) {
            document.getElementById('moodInput').value = val;
            document.querySelectorAll('.mood-picker-btn').forEach(b => b.classList.remove('selected'));
            document.querySelector(`.mood-picker-btn[data-mood="${val}"]`).classList.add('selected');
            document.getElementById('moodLabelText').textContent = text;
            document.getElementById('moodLabelText').style.color = '#0d9488';
        }
        function selectStress(val, text) {
            document.getElementById('stressInput').value = val;
            document.querySelectorAll('.stress-picker-btn').forEach(b => b.classList.remove('selected'));
            document.querySelector(`.stress-picker-btn[data-stress="${val}"]`).classList.add('selected');
            document.getElementById('stressLabelText').textContent = text;
            document.getElementById('stressLabelText').style.color = '#f59e0b';
        }
        function selectDepression(val, text) {
            document.getElementById('depressionInput').value = val;
            document.querySelectorAll('.depression-picker-btn').forEach(b => b.classList.remove('selected'));
            document.querySelector(`.depression-picker-btn[data-dep="${val}"]`).classList.add('selected');
            document.getElementById('depressionLabelText').textContent = text;
            document.getElementById('depressionLabelText').style.color = '#6366f1';
        }
    </script>
}
