    <!-- 6. Latest Mental Health Resources -->
    <section class="landing-container landing-section">
        <div class="d-flex justify-content-between align-items-end landing-section-header flex-wrap gap-2">
            <div>
                <h2 class="landing-section-title">Latest Mental Health Resources</h2>
                <p class="landing-section-subtitle">Evidence-based guides, self-care practices, and insights from OPCBS specialists.</p>
            </div>
            <a asp-page="/Blog/Index" class="landing-section-link">
                View all resources <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        @if (Model.LatestBlogs.Any())
        {
            <div class="row g-4">
                @foreach (var blog in Model.LatestBlogs)
                {
                    var displayImg = blog.DisplayImage;
                    <div class="col-lg-4 col-md-6 col-12">
                        <a asp-page="/Blog/Details" asp-route-id="@blog.Id" class="blog-card-landing landing-glass-card">
                            <div class="blog-thumb-frame">
                                @if (!string.IsNullOrEmpty(displayImg))
                                {
                                    <img src="@displayImg" alt="@blog.Title" class="blog-thumb-img" loading="lazy" />
                                }
                                else
                                {
                                    <div class="blog-thumb-fallback">
                                        <i class="bi bi-journal-medical"></i>
                                    </div>
                                }
                            </div>
                            <div class="blog-content-body">
                                @if (!string.IsNullOrEmpty(blog.Category))
                                {
                                    <span class="blog-cat-chip">@blog.Category</span>
                                }
                                <h3 class="blog-title-landing">@blog.Title</h3>
                                <p class="blog-summary-landing">@(blog.DisplaySummary ?? "Clinical perspectives and self-care strategies from OPCBS healthcare specialists.")</p>
                                
                                <div class="blog-meta-footer">
                                    <span><i class="bi bi-person-circle me-1"></i>@(string.IsNullOrEmpty(blog.AuthorName) ? "OPCBS Clinical Team" : blog.AuthorName)</span>
                                    <span>@(blog.PublishedAt?.ToString("MMM dd, yyyy") ?? blog.CreatedAt.ToString("MMM dd, yyyy"))</span>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
    </section>

    <!-- 7. Final Call to Action -->
    <section class="landing-container landing-section">
        <div class="cta-banner-landing">
            <div class="cta-banner-content">
                <h2 class="cta-banner-title">Ready to take the next step?</h2>
                <p class="cta-banner-desc">
                    Connect with a verified mental health professional and start your care journey with confidence.
                </p>
                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    <a asp-page="/Account/Register" class="btn btn-cta-primary">
                        <i class="bi bi-check2-circle me-1"></i>Get Started
                    </a>
                    <a asp-page="/Doctors/Index" class="btn btn-cta-secondary">
                        <i class="bi bi-search me-1"></i>Browse Therapists
                    </a>
                </div>
            </div>
        </div>
    </section>

</div>

