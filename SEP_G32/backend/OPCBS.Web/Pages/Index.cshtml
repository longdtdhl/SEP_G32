@page
@model IndexModel
@{
    ViewData["Title"] = "Connect with the Right Mental Health Professional";
    ViewData["FullWidthLayout"] = true;
}

<!-- Hero Section -->
<style>
    .mb-hero {
        position: relative;
        height: calc(100vh - 76px); /* Full height minus header */
        min-height: 500px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        padding: 0;
        /* Soft fade into the background */
        -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 65%, rgba(0,0,0,0) 100%);
        mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 65%, rgba(0,0,0,0) 100%);
    }
    .hero-video-bg {
        position: absolute;
        top: 50%;
        left: 50%;
        min-width: 100%;
        min-height: 100%;
        width: auto;
        height: auto;
        transform: translateX(-50%) translateY(-50%);
        z-index: 0;
        object-fit: cover;
    }
    .hero-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(255, 255, 255, 0.4); /* Light overlay for dark text readability */
        z-index: 1;
    }
    .hero-content {
        position: relative;
        z-index: 2;
        text-align: center;
        color: #1E3A31;
        padding: 0 20px;
        width: 100%;
        margin-top: -50px; /* Slight lift to compensate for the bottom mask */
    }
    .mb-hero h1, .hero-title {
        color: #1E3A31;
        font-size: 3.5rem;
        text-shadow: 0 4px 15px rgba(255,255,255,0.9);
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-weight: 800;
        letter-spacing: -0.02em;
    }
    .mb-hero p {
        color: #2D6A51;
        font-size: 1.25rem;
        max-width: 700px;
        margin: 0 auto 2rem;
        text-shadow: 0 2px 10px rgba(255,255,255,0.8);
        font-weight: 500;
    }
    .mb-hero .btn-outline-dark {
        color: #1E3A31;
        border-color: #1E3A31;
    }
    .mb-hero .btn-outline-dark:hover {
        background: #1E3A31;
        color: white;
    }
    
    /* Background for sections below hero */
    .home-content-bg {
        padding-top: 1rem;
        padding-bottom: 2rem;
    }
    /* Add glassmorphism to cards so text is readable on the new background */
    .home-content-bg .glass-stat, .home-content-bg .mb-blog-card {
        background: rgba(255, 255, 255, 0.5);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.6);
        border-radius: 24px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .home-content-bg .glass-stat:hover, .home-content-bg .mb-blog-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(30, 58, 49, 0.1);
        background: rgba(255, 255, 255, 0.7);
    }
    /* Category container wrapper */
    .specialization-container {
      max-width: 1200px;
      margin: 40px auto;
      padding: 0 20px;
    }

    /* Title "Specialization Categories" */
    .specialization-container h2 {
      font-size: 24px;
      font-weight: 700;
      color: #1E3A31; /* Dark green high contrast */
      margin-bottom: 20px;
    }

    /* Tag container using Flexbox for smooth wrapping */
    .tags-wrapper {
      display: flex;
      flex-wrap: wrap;
      gap: 12px; /* Gap between tags */
    }

    /* Individual specialty tag styling */
    .spec-tag {
      font-family: 'Inter', sans-serif;
      font-size: 14px;
      font-weight: 500;
      color: #2D6A51; /* Brand green text color */
      background-color: rgba(226, 240, 233, 0.6); /* Very light mint green transparent background */
      padding: 8px 18px;
      border: 1px solid rgba(45, 106, 81, 0.15); /* Subtle thin border */
      border-radius: 50px; /* Fully rounded capsule shape */
      cursor: pointer;
      transition: all 0.25s ease; /* Smooth transition effect */
      text-decoration: none;
    }

    /* Tag hover effect */
    .spec-tag:hover {
      background-color: #2D6A51;
      color: #ffffff;
      box-shadow: 0 4px 12px rgba(45, 106, 81, 0.15);
      transform: translateY(-2px); /* Lift tag slightly */
    }

    /* Doctor list container */
    .doctors-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 24px;
      margin-bottom: 50px;
    }

    /* Individual doctor profile card */
    .doctor-card {
      background: rgba(255, 255, 255, 0.5);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-radius: 24px;
      padding: 32px 24px;
      text-align: center;
      border: 1px solid rgba(255, 255, 255, 0.8);
      box-shadow: 0 10px 40px rgba(30, 58, 49, 0.08);
      transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
      position: relative;
      overflow: hidden;
      height: 100%;
      display: flex;
      flex-direction: column;
    }

    .doctor-card::before {
      content: "";
      position: absolute;
      top: 0; left: 0; right: 0; height: 120px;
      background: linear-gradient(135deg, rgba(78,139,112,0.15) 0%, rgba(255,255,255,0) 100%);
      z-index: 0;
    }

    .doctor-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 20px 40px rgba(30, 58, 49, 0.12);
      background: rgba(255, 255, 255, 0.8);
    }

    /* Doctor avatar section */
    .doctor-avatar {
      width: 110px;
      height: 110px;
      border-radius: 50%;
      background-color: #e2f0e9;
      margin: 0 auto 20px auto;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 4px solid #ffffff;
      box-shadow: 0 8px 20px rgba(0,0,0,0.08);
      overflow: hidden;
      position: relative;
      z-index: 1;
      transition: transform 0.4s ease;
      flex-shrink: 0;
    }
    
    .doctor-card:hover .doctor-avatar {
        transform: scale(1.05);
    }

    .doctor-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* Doctor name */
    .doctor-name {
      font-size: 1.15rem;
      font-weight: 700;
      color: #1E3A31;
      margin-bottom: 6px;
      font-family: 'Plus Jakarta Sans', sans-serif;
      position: relative;
      z-index: 1;
    }

    /* Title/Degree */
    .doctor-title {
      font-size: 0.9rem;
      color: #4A5D54;
      margin-bottom: 16px;
      font-weight: 500;
      position: relative;
      z-index: 1;
      flex-grow: 1;
    }

    /* Star rating section */
    .doctor-rating {
      color: #FFB800;
      font-size: 15px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      position: relative;
      z-index: 1;
      background: rgba(255,255,255,0.7);
      padding: 6px 12px;
      border-radius: 20px;
      display: inline-flex;
      margin: 0 auto;
    }

    .doctor-rating span {
      color: #4A5D54;
      font-size: 13px;
      margin-left: 6px;
      font-weight: 600;
    }
    
    .mb-page-header h2 {
      font-size: 2rem;
      font-weight: 800;
      color: #1E3A31;
      font-family: 'Plus Jakarta Sans', sans-serif;
      letter-spacing: -0.02em;
    }

    /* Stats Strip */
    .stats-strip {
        background: rgba(255, 255, 255, 0.4);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border-top: 1px solid rgba(255,255,255,0.6);
        border-bottom: 1px solid rgba(255,255,255,0.6);
        padding: 40px 0;
        margin-bottom: 50px;
    }
    .stat-item {
        text-align: center;
        border-right: 1px solid rgba(30, 58, 49, 0.1);
    }
    .stat-item:last-child {
        border-right: none;
    }
    .stat-item h3 {
        font-family: 'Plus Jakarta Sans', sans-serif;
        color: #1E3A31;
        font-size: 2.5rem;
        font-weight: 800;
        margin-bottom: 5px;
    }
    .stat-item p {
        color: #4A5D54;
        font-weight: 600;
        font-size: 1rem;
        margin: 0;
    }

    /* Testimonials */
    .testimonial-card {
        background: rgba(255, 255, 255, 0.6);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-radius: 20px;
        padding: 30px;
        border: 1px solid rgba(255, 255, 255, 0.8);
        box-shadow: 0 10px 30px rgba(30, 58, 49, 0.05);
        position: relative;
        height: 100%;
        transition: transform 0.3s ease;
    }
    .testimonial-card:hover {
        transform: translateY(-5px);
    }
    .testimonial-quote {
        font-size: 1.05rem;
        color: #1E3A31;
        font-style: italic;
        margin-bottom: 20px;
        line-height: 1.6;
        position: relative;
        z-index: 1;
    }
    .testimonial-author {
        display: flex;
        align-items: center;
        gap: 15px;
    }
    .testimonial-author .avatar-placeholder {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: var(--mb-primary-light);
        color: var(--mb-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1.2rem;
    }
    .testimonial-author h6 {
        margin: 0;
        font-weight: 700;
        color: #1E3A31;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .testimonial-author span {
        font-size: 0.85rem;
        color: #667A70;
    }
    .quote-icon {
        position: absolute;
        top: 15px;
        right: 20px;
        font-size: 4rem;
        color: rgba(78, 139, 112, 0.1);
        z-index: 0;
        line-height: 1;
        font-family: serif;
    }

    /* CTA Banner */
    .cta-section {
        background: linear-gradient(135deg, #1E3A31 0%, #2D6A51 100%);
        border-radius: 24px;
        padding: 60px 40px;
        text-align: center;
        color: white;
        margin: 80px auto;
        position: relative;
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(30, 58, 49, 0.2);
    }
    .cta-section::before {
        content: "";
        position: absolute;
        top: -50%; left: -50%; width: 200%; height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0) 60%);
        z-index: 0;
    }
    .cta-content {
        position: relative;
        z-index: 1;
    }
    .cta-content h2 {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-weight: 800;
        font-size: 2.5rem;
        margin-bottom: 15px;
        color: white;
    }
    .cta-content p {
        font-size: 1.15rem;
        opacity: 0.9;
        max-width: 600px;
        margin: 0 auto 30px;
    }
</style>

<section class="mb-hero">
    <!-- Video Background -->
    <video class="hero-video-bg" autoplay loop muted playsinline>
        <source src="/videos/hero-bg.mp4" type="video/mp4">
    </video>
    
    <!-- Overlay -->
    <div class="hero-overlay"></div>

    <!-- Content -->
    <div class="hero-content container">
        <h1 class="hero-title">Connect with the Right<br />Mental Health Professional</h1>
        <p>
            MindBridge helps individuals access trusted mental health support through
            professional counseling, personalized care, and meaningful human connection.
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a asp-page="/Doctors/Index" class="btn btn-primary btn-lg px-4 pulse-glow"
               style="border-radius:var(--mb-radius-full);font-weight:600;">
                <i class="bi bi-search-heart me-2"></i>Find a Therapist
            </a>
            <a asp-page="/Account/Register" class="btn btn-outline-dark btn-lg px-4"
               style="border-radius:var(--mb-radius-full);font-weight:600;background:rgba(255,255,255,0.7);backdrop-filter:blur(4px);">Get Started</a>
            <a asp-page="/Account/RegisterDoctor" class="btn btn-outline-dark btn-lg px-4"
               style="border-radius:var(--mb-radius-full);font-weight:600;background:rgba(255,255,255,0.7);backdrop-filter:blur(4px);">
                <i class="bi bi-heart-pulse me-1"></i>Become a Doctor
            </a>
        </div>
    </div>
</section>

<div class="home-content-bg">

<!-- Trust Stats Strip -->
<div class="stats-strip">
    <div class="container">
        <div class="row">
            <div class="col-md-3 stat-item">
                <h3>500+</h3>
                <p>Verified Specialists</p>
            </div>
            <div class="col-md-3 stat-item">
                <h3>10k+</h3>
                <p>Happy Patients</p>
            </div>
            <div class="col-md-3 stat-item">
                <h3>4.9/5</h3>
                <p>Average Rating</p>
            </div>
            <div class="col-md-3 stat-item">
                <h3>24/7</h3>
                <p>Confidential Support</p>
            </div>
        </div>
    </div>
</div>

<!-- Featured Doctors -->
<section class="mb-section container mt-5">
    <div class="mb-page-header">
        <h2>Featured Specialists</h2>
        <a asp-page="/Doctors/Index" class="text-decoration-none" style="font-weight:500;font-size:0.9375rem;">
            View all <i class="bi bi-arrow-right"></i>
        </a>
    </div>
    @if (Model.FeaturedDoctors.Any())
    {
        <div class="doctors-grid">
            @foreach (var doc in Model.FeaturedDoctors)
            {
                <a asp-page="/Doctors/Details" asp-route-id="@doc.Id" class="text-decoration-none">
                    <div class="doctor-card">
                        <div class="doctor-avatar">
                            @if (!string.IsNullOrEmpty(doc.AvatarUrl))
                            {
                                <img src="@doc.AvatarUrl" alt="@doc.FullName" />
                            }
                            else
                            {
                                <i class="bi bi-person-fill" style="font-size:2rem;color:var(--mb-primary);"></i>
                            }
                        </div>
                        <h5 class="doctor-name">@doc.FullName</h5>
                        <p class="doctor-title">@doc.Specialization</p>
                        @if (doc.Rating > 0)
                        {
                            <div class="doctor-rating">
                                <partial name="_RatingStars" view-data='@(new ViewDataDictionary(ViewData) { { "Rating", doc.Rating }, { "ReviewCount", doc.ReviewCount } })' />
                            </div>
                        }
                    </div>
                </a>
            }
        </div>
    }
    else
    {
        <div class="text-center py-4 text-muted">
            <i class="bi bi-people d-block mb-2" style="font-size:2rem;"></i>
            <p>Specialists coming soon.</p>
        </div>
    }
</section>

<!-- Specialization Categories -->
<section class="specialization-container">
    <h2>Specialization Categories</h2>
    <div class="tags-wrapper">
        @if (Model.Specializations.Any())
        {
            @foreach (var cat in Model.Specializations)
            {
                <a asp-page="/Doctors/Index" asp-route-specialization="@cat" class="spec-tag">@cat</a>
            }
        }
        else
        {
            <p class="text-muted">Loading categories...</p>
        }
    </div>
</section>

<!-- How It Works -->
<section class="mb-section container" style="padding:3rem 15px;">
    <h2 class="text-center mb-2" style="font-weight:700;">How MindBridge Works</h2>
    <p class="text-center text-muted mb-5" style="max-width:500px;margin:0 auto;">Simple steps to begin your wellness journey</p>
    <div class="row g-4 text-center">
        <div class="col-md-4">
            <div class="glass-stat h-100 text-center p-5">
                <div class="rounded-circle mx-auto mb-4 d-flex align-items-center justify-content-center"
                     style="width:80px;height:80px;background:#4E8B70;box-shadow:0 8px 20px rgba(78,139,112,0.3);">
                    <i class="bi bi-search" style="font-size:2rem;color:#fff;"></i>
                </div>
                <h5 style="font-family:'Plus Jakarta Sans'; font-weight:700; color:#1E3A31; margin-bottom:1rem;">Find Your Therapist</h5>
                <p class="text-muted mb-0" style="font-size:0.95rem;">Browse verified mental health professionals by specialization, rating, and availability.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-stat h-100 text-center p-5">
                <div class="rounded-circle mx-auto mb-4 d-flex align-items-center justify-content-center"
                     style="width:80px;height:80px;background:#4E8B70;box-shadow:0 8px 20px rgba(78,139,112,0.3);">
                    <i class="bi bi-calendar-check" style="font-size:2rem;color:#fff;"></i>
                </div>
                <h5 style="font-family:'Plus Jakarta Sans'; font-weight:700; color:#1E3A31; margin-bottom:1rem;">Book a Session</h5>
                <p class="text-muted mb-0" style="font-size:0.95rem;">Choose a convenient time slot and book your appointment online in just a few clicks.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="glass-stat h-100 text-center p-5">
                <div class="rounded-circle mx-auto mb-4 d-flex align-items-center justify-content-center"
                     style="width:80px;height:80px;background:#4E8B70;box-shadow:0 8px 20px rgba(78,139,112,0.3);">
                    <i class="bi bi-heart-pulse" style="font-size:2rem;color:#fff;"></i>
                </div>
                <h5 style="font-family:'Plus Jakarta Sans'; font-weight:700; color:#1E3A31; margin-bottom:1rem;">Start Your Journey</h5>
                <p class="text-muted mb-0" style="font-size:0.95rem;">Begin your path to wellness with personalized care and professional support.</p>
            </div>
        </div>
    </div>
</section>

<!-- Patient Testimonials -->
<section class="mb-section container mb-5">
    <div class="mb-page-header text-center d-block mb-5">
        <h2 style="font-family:'Plus Jakarta Sans', sans-serif; font-weight:800; color:#1E3A31;">Stories of Healing</h2>
        <p class="text-muted" style="font-size:1.1rem;">Hear from individuals who found their path to wellness with us.</p>
    </div>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="testimonial-card">
                <span class="quote-icon">"</span>
                <p class="testimonial-quote">MindBridge completely changed my perspective on therapy. It was so easy to find a specialist who truly understands my anxiety. The booking process is seamless.</p>
                <div class="testimonial-author">
                    <div class="avatar-placeholder">S</div>
                    <div>
                        <h6>Sarah Jenkins</h6>
                        <span>Verified Patient</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="testimonial-card">
                <span class="quote-icon">"</span>
                <p class="testimonial-quote">After years of struggling to find the right therapist, I was matched with an incredible psyforlogist here. The video sessions are secure and very convenient for my schedule.</p>
                <div class="testimonial-author">
                    <div class="avatar-placeholder">M</div>
                    <div>
                        <h6>Michael T.</h6>
                        <span>Verified Patient</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="testimonial-card">
                <span class="quote-icon">"</span>
                <p class="testimonial-quote">The platform is incredibly user-friendly and private. I love being able to read verified reviews before booking. Highly recommend to anyone seeking mental health support.</p>
                <div class="testimonial-author">
                    <div class="avatar-placeholder">E</div>
                    <div>
                        <h6>Emily R.</h6>
                        <span>Verified Patient</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Latest Articles -->
<section class="mb-section container mb-5">
    <div class="mb-page-header">
        <h2>Latest Resources</h2>
        <a asp-page="/Blog/Index" class="text-decoration-none" style="font-weight:500;font-size:0.9375rem;">
            View all <i class="bi bi-arrow-right"></i>
        </a>
    </div>
    @if (Model.LatestBlogs.Any())
    {
        <div class="row g-4">
            @foreach (var blog in Model.LatestBlogs)
            {
                <div class="col-md-4">
                    <a asp-page="/Blog/Details" asp-route-id="@blog.Id" class="text-decoration-none">
                        <div class="mb-blog-card h-100">
                            <div class="blog-image d-flex align-items-center justify-content-center" style="background:linear-gradient(135deg, var(--mb-secondary) 0%, var(--mb-primary-light) 100%);">
                                @if (!string.IsNullOrEmpty(blog.ImageUrl))
                                {
                                    <img src="@blog.ImageUrl" alt="@blog.Title" class="w-100 h-100" style="object-fit:cover;" />
                                }
                                else
                                {
                                    <i class="bi bi-journal-text" style="font-size:2.5rem;color:var(--mb-primary);"></i>
                                }
                            </div>
                            <div class="blog-body">
                                @if (!string.IsNullOrEmpty(blog.Category))
                                {
                                    <span class="blog-category">@blog.Category</span>
                                }
                                <h5 class="blog-title">@blog.Title</h5>
                                <p class="blog-excerpt">@blog.Summary</p>
                                <div class="blog-meta d-flex justify-content-between">
                                    <span>@blog.AuthorName</span>
                                    <span>@blog.CreatedAt.ToString("MMM dd, yyyy")</span>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</section>

<!-- Call To Action -->
<section class="container">
    <div class="cta-section">
        <div class="cta-content">
            <h2>Ready to Transform Your Life?</h2>
            <p>Take the first step towards better mental health today. Join thousands of users who have found their perfect therapist on MindBridge.</p>
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a asp-page="/Account/Register" class="btn btn-light btn-lg px-5" style="border-radius: 50px; font-weight: 700; color: #1E3A31;">Get Started Now</a>
                <a asp-page="/Doctors/Index" class="btn btn-outline-light btn-lg px-5" style="border-radius: 50px; font-weight: 600;">Browse Therapists</a>
            </div>
        </div>
    </div>
</section>

</div>
