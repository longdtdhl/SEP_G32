@page
@model IndexModel
@{
    ViewData["Title"] = "Connect with the Right Mental Health Professional";
    ViewData["FullWidthLayout"] = true;
}

<!-- Hero Section -->
<style>
    .mb-hero {
        position: relative;
        height: calc(100vh - 70px); /* Full viewport height */
        min-height: 760px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        padding: 0;
        /* Soft, graceful fade at bottom edge */
        -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 82%, rgba(0,0,0,0) 100%);
        mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 82%, rgba(0,0,0,0) 100%);
    }
    .hero-video-bg {
        position: absolute;
        top: 50%;
        left: 50%;
        min-width: 100%;
        min-height: 100%;
        width: auto;
        height: auto;
        transform: translateX(-50%) translateY(-50%);
        z-index: 0;
        object-fit: cover;
    }
    .hero-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(255, 255, 255, 0.35); /* Soft overlay for crisp dark green text */
        z-index: 1;
    }
    .hero-content {
        position: relative;
        z-index: 2;
        text-align: center;
        color: #1E3A31;
        padding: 0 20px;
        width: 100%;
        margin-top: 0;
    }
    .mb-hero h1, .hero-title {
        color: #1E3A31;
        font-size: clamp(2.5rem, 4.8vw, 4rem);
        text-shadow: 0 4px 20px rgba(255,255,255,0.95);
        font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
        font-weight: 850;
        letter-spacing: -0.03em;
        line-height: 1.15;
    }
    .mb-hero p {
        color: #2D6A51;
        font-size: clamp(1.1rem, 1.85vw, 1.3rem);
        max-width: 750px;
        margin: 1.5rem auto 2.5rem;
        text-shadow: 0 2px 10px rgba(255,255,255,0.85);
        font-weight: 500;
        line-height: 1.65;
    }
    .mb-hero .btn-outline-dark {
        color: #1E3A31;
        border-color: #1E3A31;
    }
    .mb-hero .btn-outline-dark:hover {
        background: #1E3A31;
        color: white;
    }

    /* ============================================================
       LANDING PAGE LOWER SECTIONS STYLES
       ============================================================ */
    .landing-wrapper {
        width: 100%;
        padding-bottom: 4rem;
        position: relative;
        z-index: 2;
    }
    .landing-container {
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 24px;
    }

    /* Section Headers */
    .landing-section {
        margin: 80px auto;
    }
    .landing-section-header {
        margin-bottom: 36px;
    }
    .landing-section-header.text-center {
        margin-bottom: 48px;
    }
    .landing-section-title {
        font-size: clamp(1.75rem, 2.6vw, 2.25rem);
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.025em;
        font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
        margin-bottom: 8px;
    }
    .landing-section-subtitle {
        font-size: 1.05rem;
        color: #475569;
        font-weight: 450;
        line-height: 1.55;
        margin-bottom: 0;
    }
    .landing-section-link {
        font-size: 0.95rem;
        font-weight: 650;
        color: #0d9488;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        transition: all 0.2s ease;
    }
    .landing-section-link:hover {
        color: #0f766e;
        transform: translateX(3px);
    }

    /* Enhanced Frosted Glass Cards (More translucent & blurred) */
    .landing-glass-card {
        background: rgba(255, 255, 255, 0.64);
        backdrop-filter: blur(24px) saturate(190%);
        -webkit-backdrop-filter: blur(24px) saturate(190%);
        border: 1px solid rgba(255, 255, 255, 0.82);
        box-shadow: 0 12px 36px rgba(15, 23, 42, 0.05);
        border-radius: 20px;
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1), background 0.3s ease;
    }
    .landing-glass-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 22px 48px rgba(13, 148, 136, 0.12);
        background: rgba(255, 255, 255, 0.78);
    }

    /* 1. Trust Stats Strip */
    .stats-strip-container {
        margin: 20px auto 60px;
        position: relative;
        z-index: 10;
    }
    .stats-strip-card {
        background: rgba(255, 255, 255, 0.68);
        backdrop-filter: blur(26px) saturate(190%);
        -webkit-backdrop-filter: blur(26px) saturate(190%);
        border: 1px solid rgba(255, 255, 255, 0.88);
        border-radius: 24px;
        padding: 32px 40px;
        box-shadow: 0 14px 40px rgba(15, 23, 42, 0.06);
    }
    .stat-item-box {
        display: flex;
        align-items: center;
        gap: 18px;
    }
    .stat-icon-wrapper {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        background: linear-gradient(135deg, rgba(230, 244, 241, 0.85) 0%, rgba(209, 237, 232, 0.85) 100%);
        color: #0d9488;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        flex-shrink: 0;
        box-shadow: 0 4px 12px rgba(13, 148, 136, 0.12);
    }
    .stat-number {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 2.15rem;
        font-weight: 850;
        color: #0f172a;
        line-height: 1.1;
        letter-spacing: -0.03em;
        margin-bottom: 2px;
    }
    .stat-label {
        font-size: 0.925rem;
        font-weight: 600;
        color: #64748b;
        margin: 0;
    }
    .stat-divider {
        border-right: 1px solid rgba(226, 232, 240, 0.8);
    }

    /* 2. Featured Therapists Section */
    .doctor-grid-landing {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 24px;
    }
    .doctor-landing-card {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 28px 22px 22px;
        border-radius: 20px;
        text-align: center;
        position: relative;
        text-decoration: none !important;
        color: inherit;
    }
    .doctor-avatar-box {
        position: relative;
        width: 96px;
        height: 96px;
        margin: 0 auto 16px;
    }
    .doctor-avatar-img {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        border: 3.5px solid #ffffff;
        box-shadow: 0 8px 20px rgba(13, 148, 136, 0.15);
    }
    .doctor-avatar-placeholder {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background: linear-gradient(135deg, #0d9488 0%, #115e59 100%);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.85rem;
        font-weight: 750;
        border: 3.5px solid #ffffff;
        box-shadow: 0 8px 20px rgba(13, 148, 136, 0.15);
    }
    .doctor-verified-badge {
        position: absolute;
        bottom: 2px;
        right: 2px;
        background: #ffffff;
        color: #0d9488;
        width: 26px;
        height: 26px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.12);
    }
    .doctor-landing-name {
        font-size: 1.125rem;
        font-weight: 750;
        color: #0f172a;
        margin-bottom: 4px;
        line-height: 1.35;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .doctor-landing-specialty {
        font-size: 0.875rem;
        font-weight: 600;
        color: #0d9488;
        margin-bottom: 12px;
        min-height: 22px;
    }
    .doctor-landing-rating {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: rgba(254, 243, 199, 0.5);
        border: 1px solid rgba(245, 158, 11, 0.2);
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 0.8125rem;
        font-weight: 700;
        color: #b45309;
        margin-bottom: 14px;
        backdrop-filter: blur(8px);
    }
    .doctor-landing-meta {
        font-size: 0.825rem;
        color: #64748b;
        margin-bottom: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        flex-wrap: wrap;
    }
    .doctor-meta-tag {
        background: rgba(241, 245, 249, 0.75);
        backdrop-filter: blur(8px);
        padding: 3px 10px;
        border-radius: 12px;
        font-weight: 500;
    }
    .doctor-card-btn {
        margin-top: auto;
        width: 100%;
        padding: 9px 16px;
        font-size: 0.875rem;
        font-weight: 650;
        border-radius: 12px;
        background: rgba(13, 148, 136, 0.08);
        color: #0d9488;
        border: 1px solid rgba(13, 148, 136, 0.2);
        transition: all 0.25s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }
    .doctor-landing-card:hover .doctor-card-btn {
        background: #0d9488;
        color: #ffffff;
        border-color: #0d9488;
        box-shadow: 0 4px 14px rgba(13, 148, 136, 0.3);
    }

    /* 3. Browse by Specialization */
    .specialization-card-container {
        padding: 40px;
        border-radius: 24px;
    }
    .specialization-chips-wrap {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        align-items: center;
    }
    .spec-pill-chip {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 12px 22px;
        border-radius: 9999px;
        background: rgba(255, 255, 255, 0.70);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        color: #1e3a31;
        border: 1.5px solid rgba(13, 148, 136, 0.2);
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none !important;
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 0 2px 6px rgba(0,0,0,0.03);
    }
    .spec-pill-chip i {
        font-size: 1.1rem;
        color: #0d9488;
        transition: color 0.25s ease;
    }
    .spec-pill-chip:hover {
        background: #0d9488;
        color: #ffffff;
        border-color: #0d9488;
        transform: translateY(-3px);
        box-shadow: 0 6px 18px rgba(13, 148, 136, 0.25);
    }
    .spec-pill-chip:hover i {
        color: #ffffff;
    }

    /* 4. How MindBridge Works */
    .how-it-works-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 28px;
        position: relative;
    }
    .how-step-card {
        padding: 38px 30px;
        border-radius: 22px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        height: 100%;
    }
    .how-step-badge {
        position: absolute;
        top: 20px;
        left: 24px;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 1.1rem;
        font-weight: 850;
        color: rgba(13, 148, 136, 0.35);
        letter-spacing: -0.02em;
    }
    .how-step-icon {
        width: 80px;
        height: 80px;
        border-radius: 24px;
        background: linear-gradient(135deg, #0d9488 0%, #115e59 100%);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.1rem;
        margin-bottom: 24px;
        box-shadow: 0 10px 24px rgba(13, 148, 136, 0.3);
        transition: transform 0.3s ease;
    }
    .how-step-card:hover .how-step-icon {
        transform: scale(1.08) rotate(3deg);
    }
    .how-step-title {
        font-size: 1.25rem;
        font-weight: 750;
        color: #0f172a;
        margin-bottom: 12px;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .how-step-desc {
        font-size: 0.95rem;
        color: #475569;
        line-height: 1.6;
        margin-bottom: 0;
    }

    /* 5. Stories of Healing (Testimonials) */
    .testimonial-card-landing {
        padding: 34px 28px;
        border-radius: 22px;
        display: flex;
        flex-direction: column;
        height: 100%;
        position: relative;
    }
    .testimonial-stars {
        color: #f59e0b;
        font-size: 1.05rem;
        margin-bottom: 16px;
        display: flex;
        gap: 4px;
    }
    .testimonial-text {
        font-size: 1.025rem;
        color: #1e293b;
        line-height: 1.65;
        font-weight: 450;
        margin-bottom: 24px;
        flex-grow: 1;
        position: relative;
        z-index: 1;
    }
    .testimonial-author-row {
        display: flex;
        align-items: center;
        gap: 14px;
        border-top: 1px solid rgba(226, 232, 240, 0.8);
        padding-top: 18px;
    }
    .testimonial-avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: linear-gradient(135deg, #e6f4f1 0%, #d1ede8 100%);
        color: #0d9488;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 750;
        font-size: 1.15rem;
        flex-shrink: 0;
    }
    .testimonial-author-name {
        font-size: 1rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 2px;
        font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .testimonial-author-tag {
        font-size: 0.8125rem;
        color: #0d9488;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    /* 6. Latest Resources */
    .blog-card-landing {
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
        border-radius: 22px;
        text-decoration: none !important;
        color: inherit;
    }
    .blog-thumb-frame {
        aspect-ratio: 16 / 9;
        width: 100%;
        overflow: hidden;
        position: relative;
        background: linear-gradient(135deg, #e6f4f1 0%, #d1ede8 100%);
    }
    .blog-thumb-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .blog-card-landing:hover .blog-thumb-img {
        transform: scale(1.05);
    }
    .blog-thumb-fallback {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #0d9488;
        font-size: 2.5rem;
    }
    .blog-content-body {
        padding: 24px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }
    .blog-cat-chip {
        display: inline-block;
        font-size: 0.775rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: #0d9488;
        background: rgba(13, 148, 136, 0.08);
        padding: 3px 10px;
        border-radius: 6px;
        margin-bottom: 10px;
        width: fit-content;
    }
    .blog-title-landing {
        font-size: 1.15rem;
        font-weight: 750;
        color: #0f172a;
        line-height: 1.4;
        margin-bottom: 8px;
        font-family: 'Plus Jakarta Sans', sans-serif;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .blog-summary-landing {
        font-size: 0.925rem;
        color: #64748b;
        line-height: 1.55;
        margin-bottom: 18px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        flex-grow: 1;
    }
    .blog-meta-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 0.8125rem;
        color: #94a3b8;
        padding-top: 14px;
        border-top: 1px solid rgba(226, 232, 240, 0.8);
    }

    /* 7. Final CTA Banner */
    .cta-banner-landing {
        background: linear-gradient(135deg, #09332a 0%, #0d5c52 50%, #0f766e 100%);
        border-radius: 26px;
        padding: 64px 48px;
        text-align: center;
        color: #ffffff;
        position: relative;
        overflow: hidden;
        box-shadow: 0 20px 48px rgba(11, 59, 50, 0.25);
    }
    .cta-banner-landing::before {
        content: "";
        position: absolute;
        top: -50%; left: -50%; width: 200%; height: 200%;
        background: radial-gradient(circle at 50% 50%, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0) 65%);
        z-index: 0;
        pointer-events: none;
    }
    .cta-banner-content {
        position: relative;
        z-index: 1;
    }
    .cta-banner-title {
        font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
        font-weight: 850;
        font-size: clamp(2rem, 3.5vw, 2.75rem);
        margin-bottom: 16px;
        color: #ffffff;
        letter-spacing: -0.025em;
    }
    .cta-banner-desc {
        font-size: 1.15rem;
        color: rgba(255, 255, 255, 0.9);
        max-width: 660px;
        margin: 0 auto 36px;
        line-height: 1.6;
    }
    .btn-cta-primary {
        background-color: #ffffff !important;
        color: #0f766e !important;
        font-weight: 700;
        font-size: 1rem;
        padding: 14px 34px;
        border-radius: 9999px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
        transition: all 0.25s ease;
    }
    .btn-cta-primary:hover {
        background-color: #f8fafc !important;
        transform: translateY(-2px);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2);
    }
    .btn-cta-secondary {
        background-color: rgba(255, 255, 255, 0.15) !important;
        color: #ffffff !important;
        border: 1.5px solid rgba(255, 255, 255, 0.4) !important;
        font-weight: 650;
        font-size: 1rem;
        padding: 14px 34px;
        border-radius: 9999px;
        backdrop-filter: blur(8px);
        transition: all 0.25s ease;
    }
    .btn-cta-secondary:hover {
        background-color: rgba(255, 255, 255, 0.25) !important;
        border-color: #ffffff !important;
        transform: translateY(-2px);
    }

    /* Responsive adjustments */
    @@media (max-width: 1100px) {
        .doctor-grid-landing {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    @@media (max-width: 991px) {
        .stat-divider {
            border-right: none;
            border-bottom: 1px solid rgba(226, 232, 240, 0.8);
            padding-bottom: 16px;
            margin-bottom: 16px;
        }
        .how-it-works-grid {
            grid-template-columns: 1fr;
            gap: 20px;
        }
        .cta-banner-landing {
            padding: 48px 28px;
        }
    }
    @@media (max-width: 600px) {
        .doctor-grid-landing {
            grid-template-columns: 1fr;
        }
        .stats-strip-card {
            padding: 24px 20px;
        }
        .specialization-card-container {
            padding: 24px 20px;
        }
    }
</style>

<section class="mb-hero">
    <!-- Video Background -->
    <video class="hero-video-bg" autoplay loop muted playsinline>
        <source src="/videos/hero-bg.mp4" type="video/mp4">
    </video>
    
    <!-- Overlay -->
    <div class="hero-overlay"></div>

    <!-- Content -->
    <div class="hero-content container">
        <h1 class="hero-title">Connect with the Right<br />Mental Health Professional</h1>
        <p>
            MindBridge helps individuals access trusted mental health support through
            professional counseling, personalized care, and meaningful human connection.
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a asp-page="/Doctors/Index" class="btn btn-primary btn-lg px-4 pulse-glow"
               style="border-radius:var(--mb-radius-full);font-weight:600;">
                <i class="bi bi-search-heart me-2"></i>Find a Therapist
            </a>
            <a asp-page="/Account/Register" class="btn btn-outline-dark btn-lg px-4"
               style="border-radius:var(--mb-radius-full);font-weight:600;background:rgba(255,255,255,0.7);backdrop-filter:blur(4px);">Get Started</a>
            <a asp-page="/Account/RegisterDoctor" class="btn btn-outline-dark btn-lg px-4"
               style="border-radius:var(--mb-radius-full);font-weight:600;background:rgba(255,255,255,0.7);backdrop-filter:blur(4px);">
                <i class="bi bi-heart-pulse me-1"></i>Become a Doctor
            </a>
        </div>
    </div>
</section>

<div class="landing-wrapper">

    <!-- 1. Trust Stats Strip -->
    <div class="landing-container stats-strip-container">
        <div class="stats-strip-card">
            <div class="row g-4 align-items-center">
                <div class="col-lg-3 col-6 stat-divider">
                    <div class="stat-item-box">
                        <div class="stat-icon-wrapper">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <div>
                            <div class="stat-number">500+</div>
                            <div class="stat-label">Verified Specialists</div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-6 stat-divider">
                    <div class="stat-item-box">
                        <div class="stat-icon-wrapper">
                            <i class="bi bi-emoji-smile"></i>
                        </div>
                        <div>
                            <div class="stat-number">10k+</div>
                            <div class="stat-label">Happy Patients</div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-6 stat-divider">
                    <div class="stat-item-box">
                        <div class="stat-icon-wrapper">
                            <i class="bi bi-star-fill text-warning"></i>
                        </div>
                        <div>
                            <div class="stat-number">4.9/5</div>
                            <div class="stat-label">Average Rating</div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-3 col-6">
                    <div class="stat-item-box">
                        <div class="stat-icon-wrapper">
                            <i class="bi bi-lock-fill"></i>
                        </div>
                        <div>
                            <div class="stat-number">100%</div>
                            <div class="stat-label">Confidential Support</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Featured Therapists Section -->
    <section class="landing-container landing-section">
        <div class="d-flex justify-content-between align-items-end landing-section-header flex-wrap gap-2">
            <div>
                <h2 class="landing-section-title">Featured Therapists</h2>
                <p class="landing-section-subtitle">Verified specialists ready to support your mental health journey.</p>
            </div>
            <a asp-page="/Doctors/Index" class="landing-section-link">
                View all therapists <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        @if (Model.FeaturedDoctors.Any())
        {
            <div class="doctor-grid-landing">
                @foreach (var doc in Model.FeaturedDoctors)
                {
                    <a asp-page="/Doctors/Details" asp-route-id="@doc.Id" class="doctor-landing-card landing-glass-card">
                        <div class="doctor-avatar-box">
                            @if (!string.IsNullOrEmpty(doc.AvatarUrl))
                            {
                                <img src="@doc.AvatarUrl" alt="@doc.FullName" class="doctor-avatar-img" />
                            }
                            else
                            {
                                var initials = string.Join("", (doc.FullName ?? "Dr").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0])).ToUpper();
                                <div class="doctor-avatar-placeholder">@initials</div>
                            }
                            <span class="doctor-verified-badge" title="Verified Specialist">
                                <i class="bi bi-patch-check-fill"></i>
                            </span>
                        </div>

                        <h3 class="doctor-landing-name">@doc.FullName</h3>
                        <div class="doctor-landing-specialty">@(string.IsNullOrEmpty(doc.Specialization) ? "Clinical Psychologist" : doc.Specialization)</div>

                        @if (doc.Rating > 0)
                        {
                            <div class="doctor-landing-rating">
                                <i class="bi bi-star-fill text-warning"></i>
                                <span>@doc.Rating.ToString("F1")</span>
                                <span class="text-muted fw-normal">(@doc.ReviewCount)</span>
                            </div>
                        }
                        else
                        {
                            <div class="doctor-landing-rating" style="background:rgba(241, 245, 249, 0.8); border-color:transparent; color:#64748b;">
                                <i class="bi bi-star text-muted"></i>
                                <span>New Specialist</span>
                            </div>
                        }

                        <div class="doctor-landing-meta">
                            @if (doc.ExperienceYears > 0)
                            {
                                <span class="doctor-meta-tag"><i class="bi bi-award me-1 text-teal"></i>@doc.ExperienceYears+ yrs exp</span>
                            }
                            else
                            {
                                <span class="doctor-meta-tag"><i class="bi bi-shield-check me-1 text-teal"></i>Licensed</span>
                            }
                            @if (doc.AvailableSlotCount > 0)
                            {
                                <span class="doctor-meta-tag" style="background:rgba(209, 250, 229, 0.8); color:#047857;">Open Slots</span>
                            }
                        </div>

                        <div class="doctor-card-btn">
                            View Profile <i class="bi bi-arrow-right-short"></i>
                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="landing-glass-card text-center py-5">
                <i class="bi bi-people text-muted d-block mb-3" style="font-size:2.5rem;"></i>
                <h5 class="fw-bold text-dark">Specialists Available Soon</h5>
                <p class="text-muted mb-0">Our clinical team is currently reviewing and verifying new practitioner profiles.</p>
            </div>
        }
    </section>

    <!-- 3. Specialization Categories -->
    <section class="landing-container landing-section">
        <div class="specialization-card-container landing-glass-card">
            <div class="landing-section-header mb-4">
                <h2 class="landing-section-title">Browse by Specialization</h2>
                <p class="landing-section-subtitle">Find dedicated specialists tailored to your specific mental health needs.</p>
            </div>

            <div class="specialization-chips-wrap">
                @if (Model.Specializations.Any())
                {
                    @foreach (var spec in Model.Specializations)
                    {
                        var iconClass = "bi-heart-pulse";
                        var specLower = spec.ToLowerInvariant();
                        if (specLower.Contains("anxiety")) { iconClass = "bi-wind"; }
                        else if (specLower.Contains("depress")) { iconClass = "bi-brightness-high"; }
                        else if (specLower.Contains("trauma") || specLower.Contains("ptsd")) { iconClass = "bi-bandaid"; }
                        else if (specLower.Contains("relation") || specLower.Contains("couple") || specLower.Contains("family")) { iconClass = "bi-people"; }
                        else if (specLower.Contains("child") || specLower.Contains("adolescent") || specLower.Contains("teen")) { iconClass = "bi-emoji-smile"; }
                        else if (specLower.Contains("sleep") || specLower.Contains("insomnia")) { iconClass = "bi-moon-stars"; }
                        else if (specLower.Contains("stress") || specLower.Contains("burnout")) { iconClass = "bi-shield-heart"; }
                        else if (specLower.Contains("addict") || specLower.Contains("substance")) { iconClass = "bi-shield-exclamation"; }

                        <a asp-page="/Doctors/Index" asp-route-specialization="@spec" class="spec-pill-chip">
                            <i class="bi @iconClass"></i>
                            <span>@spec</span>
                        </a>
                    }
                }
                else
                {
                    <a asp-page="/Doctors/Index" asp-route-specialization="Anxiety & Stress" class="spec-pill-chip"><i class="bi bi-wind"></i><span>Anxiety & Stress</span></a>
                    <a asp-page="/Doctors/Index" asp-route-specialization="Depression" class="spec-pill-chip"><i class="bi bi-brightness-high"></i><span>Depression</span></a>
                    <a asp-page="/Doctors/Index" asp-route-specialization="Trauma & PTSD" class="spec-pill-chip"><i class="bi bi-bandaid"></i><span>Trauma & PTSD</span></a>
                    <a asp-page="/Doctors/Index" asp-route-specialization="Couples Therapy" class="spec-pill-chip"><i class="bi bi-people"></i><span>Couples Therapy</span></a>
                    <a asp-page="/Doctors/Index" asp-route-specialization="Sleep & Insomnia" class="spec-pill-chip"><i class="bi bi-moon-stars"></i><span>Sleep & Insomnia</span></a>
                    <a asp-page="/Doctors/Index" asp-route-specialization="Adolescent Health" class="spec-pill-chip"><i class="bi bi-emoji-smile"></i><span>Adolescent Health</span></a>
                }
            </div>
        </div>
    </section>

    <!-- 4. How MindBridge Works -->
    <section class="landing-container landing-section">
        <div class="landing-section-header text-center">
            <h2 class="landing-section-title">How MindBridge Works</h2>
            <p class="landing-section-subtitle mx-auto" style="max-width: 580px;">Simple, confidential steps to begin your personal wellness journey.</p>
        </div>

        <div class="how-it-works-grid">
            <div class="how-step-card landing-glass-card">
                <span class="how-step-badge">01</span>
                <div class="how-step-icon">
                    <i class="bi bi-search-heart"></i>
                </div>
                <h3 class="how-step-title">Find Your Therapist</h3>
                <p class="how-step-desc">
                    Browse verified psychologists and psychiatrists by specialization, care approach, and language to find the perfect fit.
                </p>
            </div>

            <div class="how-step-card landing-glass-card">
                <span class="how-step-badge">02</span>
                <div class="how-step-icon">
                    <i class="bi bi-calendar2-check"></i>
                </div>
                <h3 class="how-step-title">Book a Session</h3>
                <p class="how-step-desc">
                    Pick a convenient date and consultation time with transparent fees and immediate confirmation—no waiting lists.
                </p>
            </div>

            <div class="how-step-card landing-glass-card">
                <span class="how-step-badge">03</span>
                <div class="how-step-icon">
                    <i class="bi bi-heart-pulse"></i>
                </div>
                <h3 class="how-step-title">Start Your Journey</h3>
                <p class="how-step-desc">
                    Attend secure, private consultations online or in-person with continuous care and actionable personalized guidance.
                </p>
            </div>
        </div>
    </section>

    <!-- 5. Stories of Healing (Testimonials) -->
