@page
@model OPCBS.Web.Pages.Doctor.VerificationStatusModel
@{
    ViewData["Title"] = "Verification Status"; ViewData["UseDashboardLayout"] = true;
}

<div class="mb-page-header"><h1>Verification Status</h1></div>

@if (Model.Verification != null)
{
    var v = Model.Verification;
    var badge = v.Status switch { "Pending" => "bg-warning text-dark", "Approved" => "bg-success", "Rejected" => "bg-danger", _ => "bg-secondary" };
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-4">
            <span class="badge @badge fs-5 mb-3">@(v.Status ?? "N/A")</span>
            <h4>@(v.DoctorName ?? "N/A")</h4>
            <p class="text-muted">Submitted on @v.SubmittedAt.ToString("MM/dd/yyyy")</p>
            @if (!string.IsNullOrEmpty(v.RejectionReason))
            {
                <div class="alert alert-danger">@v.RejectionReason</div>
            }
            <a asp-page="Verification" class="btn btn-outline-primary mt-2">View Details</a>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5 text-muted">
            <p>Not Submitted profile verification</p>
            <a asp-page="Verification" class="btn btn-primary">Submit profile</a>
        </div>
    </div>
}
