@page
@model OPCBS.Web.Pages.Doctor.ConsultationRecords.IndexModel
@{
    ViewData["Title"] = "Hồ sơ tư vấn";
    ViewData["UseDashboardLayout"] = true;
    // Group records by patient
    var groupedByPatient = Model.Records.GroupBy(r => r.PatientName ?? "Không xác định").ToList();
}

<div class="mb-page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <h1><i class="bi bi-file-earmark-medical me-2" style="color:var(--mb-primary);"></i>Hồ sơ tư vấn</h1>
        <p class="text-muted mb-0 mt-1" style="font-size:0.875rem;">Quản lý hồ sơ bệnh án và ghi chú tư vấn</p>
    </div>
    <a asp-page="Create" class="btn btn-primary d-flex align-items-center gap-2" style="border-radius:12px;">
        <i class="bi bi-plus-lg"></i>Tạo hồ sơ mới
    </a>
</div>

@if (Model.Error != null) { <div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-1"></i>@Model.Error</div> }
@if (TempData["Success"] != null) { <div class="alert alert-success"><i class="bi bi-check-circle me-1"></i>@TempData["Success"]</div> }

<div class="d-flex gap-4">
    <!-- Tree View Sidebar -->
    <div class="d-none d-lg-block" style="width:280px;min-width:260px;">
        <div class="card border-0 shadow-sm" style="border-radius:16px;">
            <div class="card-body p-3">
                <h6 class="text-uppercase small text-muted fw-semibold mb-3" style="letter-spacing:0.05em;">
                    <i class="bi bi-diagram-3 me-1"></i>Bệnh nhân
                </h6>
                @if (groupedByPatient.Any())
                {
                    @foreach (var group in groupedByPatient)
                    {
                        <div class="mb-2">
                            <div class="d-flex align-items-center gap-2 p-2 rounded-3 cursor-pointer" style="transition:background 0.2s;" onmouseover="this.style.background='var(--mb-primary-light)';" onmouseout="this.style.background='';">
                                <i class="bi bi-person" style="color:var(--mb-primary);"></i>
                                <span class="small fw-medium">@group.Key</span>
                                <span class="badge rounded-pill ms-auto" style="background:var(--mb-primary-light);color:var(--mb-primary);font-size:0.7rem;">@group.Count()</span>
                            </div>
                            <div class="ms-3 ps-2" style="border-left:2px solid var(--mb-primary-light);">
                                @foreach (var record in group.OrderByDescending(r => r.ConsultationDate))
                                {
                                    <a asp-page="Edit" asp-route-id="@record.Id" class="d-flex align-items-center gap-2 p-2 rounded-3 text-decoration-none" style="transition:background 0.2s;color:inherit;" onmouseover="this.style.background='#f0f4f2';" onmouseout="this.style.background='';">
                                        <i class="bi bi-journal-medical" style="font-size:0.85rem;color:var(--mb-secondary);"></i>
                                        <span style="font-size:0.8rem;">@record.ConsultationDate.ToString("dd/MM/yyyy")</span>
                                    </a>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted small text-center py-3 mb-0">Chưa có hồ sơ</p>
                }
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="flex-grow-1">
        <div class="card border-0 shadow-sm" style="border-radius:16px;">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead>
                            <tr style="background:#f8faf8;">
                                <th class="py-3 ps-4">Bệnh nhân</th>
                                <th class="py-3">Chẩn đoán</th>
                                <th class="py-3">Ngày tư vấn</th>
                                <th class="py-3 text-end pe-4">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Records.Any())
                            {
                                @foreach (var r in Model.Records.OrderByDescending(r => r.ConsultationDate))
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:36px;height:36px;background:var(--mb-primary-light);color:var(--mb-primary);font-size:0.85rem;font-weight:600;">
                                                    @(r.PatientName?.Substring(0, 1) ?? "?")
                                                </div>
                                                <strong>@(r.PatientName ?? "N/A")</strong>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="text-truncate d-inline-block" style="max-width:250px;">@(r.Diagnosis ?? "—")</span>
                                        </td>
                                        <td>@r.ConsultationDate.ToString("dd/MM/yyyy")</td>
                                        <td class="text-end pe-4">
                                            <a asp-page="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary" style="border-radius:8px;">
                                                <i class="bi bi-eye me-1"></i>Chi tiết
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-5 text-muted">
                                        <i class="bi bi-file-earmark-x d-block mb-2" style="font-size:2rem;"></i>
                                        <p class="mb-2">Chưa có hồ sơ tư vấn nào</p>
                                        <a asp-page="Create" class="btn btn-sm btn-outline-primary">Tạo hồ sơ đầu tiên</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @if (Model.Pagination != null && Model.Pagination.TotalPages > 1)
        {
            <nav class="mt-3"><ul class="pagination justify-content-center">
                @for (int i = 1; i <= Model.Pagination.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-page="Index" asp-route-page="@i" style="border-radius:8px;">@i</a>
                    </li>
                }
            </ul></nav>
        }
    </div>
</div>
