@page
@model OPCBS.Web.Pages.Doctor.ConsultationRecords.IndexModel
@{
    ViewData["Title"] = "Hồ sơ tư vấn";
    ViewData["UseDashboardLayout"] = true;
    var groupedByPatient = Model.Records.GroupBy(r => r.PatientName ?? "Không xác định").ToList();
}

<style>
    .patient-tree-item {
        transition: all 0.2s ease;
        border-radius: 12px;
        margin-bottom: 4px;
    }
    .patient-tree-item:hover {
        background-color: rgba(78, 139, 112, 0.05);
    }
    .record-sub-item {
        font-size: 0.85rem;
        padding: 8px 12px;
        border-radius: 8px;
        color: #555;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .record-sub-item:hover {
        background-color: #f0f4f2;
        color: var(--mb-primary);
    }
    .record-table th {
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.5px;
        color: #777;
    }
</style>

<div class="mb-page-header d-flex justify-content-between align-items-center flex-wrap gap-3">
    <div>
        <h1><i class="bi bi-file-earmark-medical me-2 text-primary"></i>Hồ sơ tư vấn</h1>
        <p class="text-muted mb-0 mt-1">Quản lý bệnh án, chẩn đoán, ghi chú trị liệu và đơn thuốc của bệnh nhân</p>
    </div>
    <a asp-page="Create" class="btn btn-primary d-flex align-items-center gap-2 rounded-3 px-4 py-2.5 fw-semibold shadow-sm">
        <i class="bi bi-plus-lg"></i>Tạo hồ sơ mới
    </a>
</div>

@if (Model.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-1"></i>@Model.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill me-1"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <!-- Patient Tree Sidebar (Left) -->
    <div class="col-lg-4 col-xl-3 d-none d-lg-block">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-3">
                <h6 class="text-uppercase small text-muted fw-bold mb-3 d-flex align-items-center gap-2 px-2">
                    <i class="bi bi-people-fill text-primary"></i>Danh sách bệnh nhân
                </h6>
                
                @if (groupedByPatient.Any())
                {
                    <div class="accordion accordion-flush" id="patientTreeAccordion">
                        @for (int i = 0; i < groupedByPatient.Count; i++)
                        {
                            var group = groupedByPatient[i];
                            var targetId = $"collapse_patient_{i}";
                            
                            <div class="accordion-item border-0">
                                <h2 class="accordion-header">
                                    <button class="accordion-button collapsed px-2 py-2.5 rounded-3 fw-semibold small text-dark d-flex gap-2 align-items-center bg-transparent border-0" type="button" data-bs-toggle="collapse" data-bs-target="#@targetId" aria-expanded="false">
                                        <i class="bi bi-person-bounding-box text-primary"></i>
                                        <span>@group.Key</span>
                                        <span class="badge bg-light text-primary border rounded-pill ms-auto small">@group.Count()</span>
                                    </button>
                                </h2>
                                <div id="@targetId" class="accordion-collapse collapse" data-bs-parent="#patientTreeAccordion">
                                    <div class="accordion-body p-1 ps-3 border-start ms-3 my-1">
                                        @foreach (var record in group.OrderByDescending(r => r.ConsultationDate))
                                        {
                                            <a asp-page="Edit" asp-route-id="@record.Id" class="record-sub-item text-decoration-none text-dark">
                                                <i class="bi bi-journal-check text-secondary"></i>
                                                <span>@record.ConsultationDate.ToString("dd/MM/yyyy")</span>
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted small">
                        <i class="bi bi-inbox d-block fs-3 mb-2"></i>
                        Chưa có dữ liệu bệnh nhân
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Records Main Table (Right) -->
    <div class="col-lg-8 col-xl-9">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle record-table">
                        <thead class="bg-light">
                            <tr>
                                <th class="py-3.5 ps-4">Bệnh nhân</th>
                                <th class="py-3.5">Chẩn đoán chuyên môn</th>
                                <th class="py-3.5">Ngày lập hồ sơ</th>
                                <th class="py-3.5 text-end pe-4">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Records.Any())
                            {
                                @foreach (var r in Model.Records.OrderByDescending(r => r.ConsultationDate))
                                {
                                    <tr>
                                        <td class="ps-4 py-3">
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px;">
                                                    @(r.PatientName?.Substring(0, 1).ToUpper() ?? "?")
                                                </div>
                                                <div>
                                                    <span class="fw-bold text-dark d-block">@(r.PatientName ?? "Không xác định")</span>
                                                    <span class="text-muted small">ID: @r.AppointmentId.ToString()[..8]...</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="py-3">
                                            <span class="fw-medium text-dark text-truncate d-inline-block" style="max-width: 320px;" title="@r.Diagnosis">
                                                @(string.IsNullOrEmpty(r.Diagnosis) ? "Chưa có chẩn đoán" : r.Diagnosis)
                                            </span>
                                        </td>
                                        <td class="py-3 text-muted small">
                                            <i class="bi bi-calendar3 me-1"></i>@r.ConsultationDate.ToString("dd/MM/yyyy • HH:mm")
                                        </td>
                                        <td class="text-end pe-4 py-3">
                                            <a asp-page="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary px-3 rounded-pill">
                                                <i class="bi bi-pencil-square me-1"></i>Chi tiết / Sửa
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-5 text-muted">
                                        <div class="py-4">
                                            <i class="bi bi-file-earmark-medical text-muted mb-3" style="font-size: 3rem; opacity: 0.5;"></i>
                                            <h6 class="fw-bold text-dark mt-2">Chưa có hồ sơ tư vấn nào được lập</h6>
                                            <p class="text-muted small mb-3">Tất cả các hồ sơ chuẩn trị của bạn dành cho bệnh nhân sẽ xuất hiện ở đây.</p>
                                            <a asp-page="Create" class="btn btn-sm btn-primary px-4 rounded-pill">Tạo hồ sơ đầu tiên</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @if (Model.Pagination != null && Model.Pagination.TotalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center gap-1">
                    @for (int i = 1; i <= Model.Pagination.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link border-0 rounded-3 text-dark fw-semibold" asp-page="Index" asp-route-page="@i" style="@(i == Model.CurrentPage ? "background-color: var(--mb-primary); color: white !important;" : "background-color: #f8faf8;")">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>
