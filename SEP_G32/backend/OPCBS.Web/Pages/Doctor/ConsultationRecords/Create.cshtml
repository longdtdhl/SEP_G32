@page
@model OPCBS.Web.Pages.Doctor.ConsultationRecords.CreateModel
@{
    ViewData["Title"] = "Tạo hồ sơ tư vấn";
    ViewData["UseDashboardLayout"] = true;
}

<div class="mb-page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="bi bi-file-earmark-medical-fill me-2 text-primary"></i>Tạo hồ sơ tư vấn</h1>
        <p class="text-muted mb-0 mt-1">Lập bệnh án, ghi chú tư vấn và khuyến nghị bài tập sau buổi trị liệu</p>
    </div>
    <a asp-page="Index" class="btn btn-outline-secondary rounded-3"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>
</div>

@if (Model.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-1"></i>@Model.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form method="post">
    <div class="row g-4">
        <!-- Sidebar Info: Appointment Details Selection -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3 text-dark border-bottom pb-2">
                        <i class="bi bi-link-45deg text-primary me-1"></i>Thông tin lịch hẹn
                    </h5>

                    @if (Model.SelectedAppointment != null)
                    {
                        <input type="hidden" asp-for="Input.AppointmentId" value="@Model.SelectedAppointment.Id" />
                        <div class="mb-3">
                            <label class="text-muted small d-block mb-1">Mã cuộc hẹn (Booking Code)</label>
                            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 fw-semibold rounded-pill">
                                @Model.SelectedAppointment.BookingCode
                            </span>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small d-block mb-1">Bệnh nhân</label>
                            <div class="fw-bold text-dark fs-5">
                                <i class="bi bi-person-fill text-muted me-1"></i>@(Model.SelectedAppointment.PatientName ?? "Không xác định")
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small d-block mb-1">Thời gian tư vấn</label>
                            <div class="fw-semibold text-dark small">
                                <i class="bi bi-calendar3 text-muted me-1"></i>
                                @Model.SelectedAppointment.AppointmentDate • @Model.SelectedAppointment.StartTime - @Model.SelectedAppointment.EndTime
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.SelectedAppointment.Notes))
                        {
                            <div class="mb-3">
                                <label class="text-muted small d-block mb-1">Yêu cầu từ bệnh nhân</label>
                                <p class="mb-0 bg-light p-2.5 rounded-3 text-muted small" style="white-space: pre-wrap;">@Model.SelectedAppointment.Notes</p>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark small">Chọn lịch hẹn tư vấn <span class="text-danger">*</span></label>
                            <select asp-for="Input.AppointmentId" class="form-select rounded-3 shadow-none border-secondary-subtle py-2" required>
                                <option value="">-- Chọn bệnh nhân & lịch hẹn --</option>
                                @foreach (var appt in Model.Appointments)
                                {
                                    var timeStr = DateTime.TryParse(appt.AppointmentDate, out var d) ? d.ToString("dd/MM/yyyy") : appt.AppointmentDate;
                                    <option value="@appt.Id">@appt.PatientName (@timeStr • @appt.StartTime)</option>
                                }
                            </select>
                            <div class="form-text small text-muted mt-1">Danh sách chứa các lịch hẹn trị liệu đã duyệt hoặc đã hoàn thành gần đây.</div>
                        </div>
                    }
                </div>
            </div>
            
            <div class="card border-0 shadow-sm rounded-4 bg-primary bg-opacity-10 border-start border-4 border-primary">
                <div class="card-body p-4">
                    <h6 class="fw-bold text-dark mb-2"><i class="bi bi-lightbulb-fill text-warning me-1"></i>Lưu ý khi lập hồ sơ</h6>
                    <ul class="small text-muted ps-3 mb-0">
                        <li class="mb-1">Ghi chẩn đoán lâm sàng rõ ràng để bệnh nhân dễ dàng theo dõi.</li>
                        <li class="mb-1">Khuyến nghị các bài tập thực hành (VD: thiền, viết nhật ký) giúp tiến trình trị liệu hiệu quả hơn.</li>
                        <li class="mb-0">Hồ sơ sẽ hiển thị trong trang cá nhân của bệnh nhân ngay sau khi bạn lưu.</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Main Form Fields -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">
                    
                    <!-- Diagnosis Section -->
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark d-flex align-items-center gap-2">
                            <i class="bi bi-clipboard2-pulse-fill text-primary"></i>Chẩn đoán lâm sàng <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Input.Diagnosis" class="form-control rounded-3 py-2.5" placeholder="Ví dụ: Rối loạn lo âu lan tỏa (GAD), Stress công việc nặng..." required />
                    </div>

                    <!-- Consultation Summary Section -->
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark d-flex align-items-center gap-2">
                            <i class="bi bi-journal-text text-primary"></i>Nội dung & Ghi chú tư vấn <span class="text-danger">*</span>
                        </label>
                        <textarea asp-for="Input.Notes" class="form-control rounded-3" rows="6" placeholder="Ghi nhận diễn biến buổi tư vấn, các biểu hiện tâm lý, kết quả kiểm tra phản ứng của bệnh nhân..." required></textarea>
                    </div>

                    <!-- Prescription Section -->
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark d-flex align-items-center gap-2">
                            <i class="bi bi-capsule text-primary"></i>Toa thuốc / Trị liệu y khoa (Nếu có)
                        </label>
                        <textarea asp-for="Input.Prescription" class="form-control rounded-3" rows="2" placeholder="Tên thuốc, liều lượng dùng hoặc hướng dẫn trị liệu kết hợp (nếu có)..."></textarea>
                    </div>

                    <!-- Recommendations Section -->
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark d-flex align-items-center gap-2">
                            <i class="bi bi-heart-pulse-fill text-primary"></i>Lời khuyên / Bài tập tâm lý tại nhà
                        </label>
                        <textarea asp-for="Input.Recommendations" class="form-control rounded-3" rows="4" placeholder="Ví dụ:
- Thực hành bài tập thở 4-7-8 trước khi đi ngủ.
- Viết nhật ký biết ơn mỗi tối.
- Hạn chế sử dụng thiết bị điện tử sau 22h..."></textarea>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex justify-content-end gap-3 pt-3 border-top mt-5">
                        <a asp-page="Index" class="btn btn-outline-secondary px-4 py-2.5 rounded-3 fw-bold">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4 py-2.5 rounded-3 fw-bold d-flex align-items-center gap-2">
                            <i class="bi bi-save2-fill"></i>Lưu hồ sơ tư vấn
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>
</form>
