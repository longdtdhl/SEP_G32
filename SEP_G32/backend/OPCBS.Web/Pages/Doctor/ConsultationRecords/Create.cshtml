@page
@model OPCBS.Web.Pages.Doctor.ConsultationRecords.CreateModel
@{
    ViewData["Title"] = "Tạo hồ sơ tư vấn";
    ViewData["UseDashboardLayout"] = true;
}

<div class="mb-page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="bi bi-file-earmark-medical me-2" style="color:var(--mb-primary);"></i>Tạo hồ sơ tư vấn</h1>
        <p class="text-muted mb-0 mt-1" style="font-size:0.875rem;">Ghi lại kết quả buổi tư vấn</p>
    </div>
    <a asp-page="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>
</div>

@if (Model.Error != null) { <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-1"></i>@Model.Error</div> }

<form method="post">
    <input type="hidden" asp-for="Input.AppointmentId" />

    @if (!Model.AppointmentId.HasValue)
    {
        <div class="card border-0 shadow-sm mb-3" style="border-radius:16px;">
            <div class="card-body">
                <label class="form-label fw-semibold"><i class="bi bi-link-45deg me-1" style="color:var(--mb-primary);"></i>Appointment ID <span class="text-danger">*</span></label>
                <input asp-for="Input.AppointmentId" class="form-control" />
            </div>
        </div>
    }

    <!-- Diagnosis Section -->
    <div class="card border-0 shadow-sm mb-3" style="border-radius:16px;">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <label class="form-label fw-semibold mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-clipboard2-pulse" style="color:var(--mb-primary);font-size:1.2rem;"></i>
                    Chẩn đoán
                </label>
            </div>
            <input asp-for="Input.Diagnosis" class="form-control" placeholder="VD: Rối loạn lo âu lan tỏa, kèm triệu chứng soma..." />
        </div>
    </div>

    <!-- Notes Section -->
    <div class="card border-0 shadow-sm mb-3" style="border-radius:16px;">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <label class="form-label fw-semibold mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-journal-text" style="color:var(--mb-primary);font-size:1.2rem;"></i>
                    Ghi chú tư vấn
                </label>
            </div>
            <div class="p-3 rounded-3" style="background:#f8f9fa;">
                <textarea asp-for="Input.Notes" class="form-control border-0 bg-transparent" rows="4" placeholder="Ghi chú chi tiết về buổi tư vấn..." style="resize:vertical;"></textarea>
            </div>
        </div>
    </div>

    <!-- Prescription Section -->
    <div class="card border-0 shadow-sm mb-3" style="border-radius:16px;">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <label class="form-label fw-semibold mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-capsule" style="color:var(--mb-primary);font-size:1.2rem;"></i>
                    Đơn thuốc / Chỉ định
                </label>
            </div>
            <textarea asp-for="Input.Prescription" class="form-control" rows="2" placeholder="Thuốc hoặc chỉ định (nếu có)..."></textarea>
        </div>
    </div>

    <!-- Advice/Exercises Section -->
    <div class="card border-0 shadow-sm mb-3" style="border-radius:16px;">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <label class="form-label fw-semibold mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-heart-pulse" style="color:var(--mb-primary);font-size:1.2rem;"></i>
                    Khuyến nghị / Bài tập
                </label>
            </div>
            <textarea asp-for="Input.Recommendations" class="form-control" rows="3" placeholder="VD: Thực hành hít thở 4-7-8, viết nhật ký 3 điều tích cực mỗi ngày..."></textarea>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="d-flex justify-content-end gap-3 mt-4">
        <a asp-page="Index" class="btn btn-outline-secondary px-4 py-2" style="border-radius:12px;">
            <i class="bi bi-x-lg me-1"></i>Hủy
        </a>
        <button type="submit" class="btn btn-primary px-4 py-2 d-flex align-items-center gap-2" style="border-radius:12px;">
            <i class="bi bi-check-circle"></i>
            Lưu hồ sơ
        </button>
    </div>
</form>
