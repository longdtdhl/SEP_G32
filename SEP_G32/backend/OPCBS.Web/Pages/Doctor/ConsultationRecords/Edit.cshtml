@page "{id:guid}"
@model OPCBS.Web.Pages.Doctor.ConsultationRecords.EditModel
@{
    ViewData["Title"] = "Chi tiết hồ sơ tư vấn";
    ViewData["UseDashboardLayout"] = true;
}

<div class="mb-page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="bi bi-file-earmark-medical me-2" style="color:var(--mb-primary);"></i>Hồ sơ tư vấn</h1>
        <p class="text-muted mb-0 mt-1" style="font-size:0.875rem;">Xem và chỉnh sửa hồ sơ buổi tư vấn</p>
    </div>
    <a asp-page="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>
</div>

@if (Model.Error != null) { <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-1"></i>@Model.Error</div> }

<!-- Patient Header Card -->
@if (Model.Record != null)
{
    <div class="card border-0 shadow-sm mb-4" style="border-radius:20px;">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:56px;height:56px;background:var(--mb-primary-light);color:var(--mb-primary);font-size:1.5rem;">
                        <i class="bi bi-person-circle"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h4 class="mb-0">@(Model.Record.PatientName ?? "Bệnh nhân")</h4>
                            <span class="badge rounded-pill" style="background:var(--mb-primary-light);color:var(--mb-primary);font-size:0.75rem;">Client</span>
                        </div>
                        <div class="d-flex gap-3 mt-1">
                            <small class="text-muted"><i class="bi bi-calendar3 me-1"></i>@Model.Record.ConsultationDate.ToString("dd/MM/yyyy")</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Case Details Form -->
<form method="post" asp-route-id="@Model.RecordId">
    <div class="card border-0 shadow-sm" style="border-radius:20px;">
        <div class="card-body p-4">

            @if (Model.Record != null)
            {
                <!-- Package / Session Info -->
                <div class="row g-4 pb-4 mb-4 border-bottom">
                    <div class="col-md-4">
                        <p class="text-uppercase text-muted small mb-1 fw-semibold" style="letter-spacing:0.05em;">Appointment ID</p>
                        <p class="mb-0" style="color:var(--mb-primary);font-weight:600;">@Model.Record.AppointmentId.ToString()[..8]...</p>
                    </div>
                    <div class="col-md-4">
                        <p class="text-uppercase text-muted small mb-1 fw-semibold" style="letter-spacing:0.05em;">Ngày tư vấn</p>
                        <p class="mb-0">@Model.Record.ConsultationDate.ToString("dd/MM/yyyy • HH:mm")</p>
                    </div>
                    <div class="col-md-4">
                        <p class="text-uppercase text-muted small mb-1 fw-semibold" style="letter-spacing:0.05em;">Trạng thái</p>
                        <span class="badge bg-success">Đã ghi nhận</span>
                    </div>
                </div>
            }

            <!-- Editable: Diagnosis -->
            <div class="p-3 rounded-3 mb-3 position-relative" style="border:1px solid transparent;transition:all 0.2s;" onmouseover="this.style.background='#f8faf6';this.style.borderColor='#e0e7e3';" onmouseout="this.style.background='';this.style.borderColor='transparent';">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label class="form-label fw-semibold mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-clipboard2-pulse" style="color:var(--mb-primary);font-size:1.1rem;"></i>
                        Chẩn đoán
                    </label>
                    <i class="bi bi-pencil text-muted" style="font-size:0.85rem;"></i>
                </div>
                <input asp-for="Input.Diagnosis" class="form-control" placeholder="Nhập chẩn đoán..." />
            </div>

            <!-- Editable: Notes -->
            <div class="p-3 rounded-3 mb-3 position-relative" style="border:1px solid transparent;transition:all 0.2s;" onmouseover="this.style.background='#f8faf6';this.style.borderColor='#e0e7e3';" onmouseout="this.style.background='';this.style.borderColor='transparent';">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label class="form-label fw-semibold mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-journal-text" style="color:var(--mb-primary);font-size:1.1rem;"></i>
                        Ghi chú tư vấn
                    </label>
                    <i class="bi bi-pencil text-muted" style="font-size:0.85rem;"></i>
                </div>
                <div class="p-3 rounded-3" style="background:#f5f7f5;">
                    <textarea asp-for="Input.Notes" class="form-control border-0 bg-transparent" rows="4" style="resize:vertical;" placeholder="Ghi chú chi tiết..."></textarea>
                </div>
            </div>

            <!-- Editable: Prescription -->
            <div class="p-3 rounded-3 mb-3 position-relative" style="border:1px solid transparent;transition:all 0.2s;" onmouseover="this.style.background='#f8faf6';this.style.borderColor='#e0e7e3';" onmouseout="this.style.background='';this.style.borderColor='transparent';">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label class="form-label fw-semibold mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-capsule" style="color:var(--mb-primary);font-size:1.1rem;"></i>
                        Đơn thuốc / Chỉ định
                    </label>
                    <i class="bi bi-pencil text-muted" style="font-size:0.85rem;"></i>
                </div>
                <textarea asp-for="Input.Prescription" class="form-control" rows="2" placeholder="Thuốc hoặc chỉ định..."></textarea>
            </div>

            <!-- Editable: Advice/Exercises -->
            <div class="p-3 rounded-3 mb-3 position-relative" style="border:1px solid transparent;transition:all 0.2s;" onmouseover="this.style.background='#f8faf6';this.style.borderColor='#e0e7e3';" onmouseout="this.style.background='';this.style.borderColor='transparent';">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label class="form-label fw-semibold mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-heart-pulse" style="color:var(--mb-primary);font-size:1.1rem;"></i>
                        Khuyến nghị / Bài tập
                    </label>
                    <i class="bi bi-pencil text-muted" style="font-size:0.85rem;"></i>
                </div>
                <textarea asp-for="Input.Recommendations" class="form-control" rows="3" placeholder="VD: Thực hành hít thở 4-7-8, viết nhật ký..."></textarea>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex justify-content-end gap-3 pt-3 border-top mt-4">
                <a asp-page="Index" class="btn btn-outline-secondary px-4 py-2" style="border-radius:12px;">
                    Hủy
                </a>
                <button type="submit" class="btn btn-primary px-4 py-2 d-flex align-items-center gap-2" style="border-radius:12px;">
                    <i class="bi bi-check-circle"></i>
                    Cập nhật hồ sơ
                </button>
            </div>
        </div>
    </div>
</form>
