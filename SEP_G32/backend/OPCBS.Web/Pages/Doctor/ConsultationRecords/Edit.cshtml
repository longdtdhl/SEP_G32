@page "{id:guid}"
@model OPCBS.Web.Pages.Doctor.ConsultationRecords.EditModel
@{
    ViewData["Title"] = "Chi tiết hồ sơ tư vấn";
    ViewData["UseDashboardLayout"] = true;
}

<div class="mb-page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="bi bi-file-earmark-medical-fill me-2 text-primary"></i>Hồ sơ tư vấn chi tiết</h1>
        <p class="text-muted mb-0 mt-1">Xem chi tiết hoặc cập nhật thông tin chẩn đoán và ghi chú buổi trị liệu</p>
    </div>
    <a asp-page="Index" class="btn btn-outline-secondary rounded-3"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>
</div>

@if (Model.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-1"></i>@Model.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill me-1"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Record != null)
{
    <!-- Patient Info Banner Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
                        <i class="bi bi-person-circle fs-2"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <h4 class="mb-0 fw-bold text-dark">@(Model.Record.PatientName ?? "Bệnh nhân")</h4>
                            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-1.5 fw-semibold small">Bệnh nhân</span>
                        </div>
                        <div class="d-flex gap-3 mt-1 text-muted small">
                            <span><i class="bi bi-calendar3 me-1"></i>Ngày tư vấn: @Model.Record.ConsultationDate.ToString("dd/MM/yyyy • HH:mm")</span>
                            <span>•</span>
                            <span><i class="bi bi-bookmark-fill me-1"></i>Mã lịch hẹn: @Model.Record.AppointmentId.ToString()[..8]...</span>
                        </div>
                    </div>
                </div>
                <div class="text-end">
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill fw-bold">
                        <i class="bi bi-shield-check me-1"></i>Đã hoàn thành ghi chép
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Sidebar Column: Treatment Packages -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
                            <i class="bi bi-box-seam text-primary fs-5"></i>Gói điều trị liên kết
                        </h6>
                        <a asp-page="/Doctor/TreatmentPackages/Create" asp-route-patientId="@Model.Record.PatientId"
                           class="btn btn-xs btn-outline-primary rounded-3 d-flex align-items-center gap-1">
                            <i class="bi bi-plus-lg"></i>Gói mới
                        </a>
                    </div>

                    @if (Model.PatientPackages.Any())
                    {
                        @foreach (var pkg in Model.PatientPackages)
                        {
                            var progress = pkg.TotalSessions > 0 ? (int)((double)pkg.CompletedSessions / pkg.TotalSessions * 100) : 0;
                            var statusBadge = pkg.Status switch {
                                "Active" => "bg-success",
                                "Created" => "bg-warning text-dark",
                                _ => "bg-secondary"
                            };
                            
                            <div class="p-3 rounded-3 mb-3 bg-light border border-light-subtle">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div>
                                        <div class="fw-bold text-dark small text-truncate" style="max-width: 170px;">@pkg.Name</div>
                                        <small class="text-muted text-truncate d-block" style="max-width: 170px;">@(pkg.Description ?? "Không có mô tả")</small>
                                    </div>
                                    <span class="badge @statusBadge rounded-pill small">@pkg.Status</span>
                                </div>
                                <div class="row g-2 mb-2 text-center">
                                    <div class="col-4">
                                        <small class="text-muted d-block" style="font-size:0.65rem; letter-spacing: 0.5px;">ĐÃ HẸN</small>
                                        <span class="fw-bold text-primary small">@pkg.CompletedSessions / @pkg.TotalSessions</span>
                                    </div>
                                    <div class="col-4">
                                        <small class="text-muted d-block" style="font-size:0.65rem; letter-spacing: 0.5px;">CÒN LẠI</small>
                                        <span class="fw-bold text-dark small">@pkg.RemainingSessions</span>
                                    </div>
                                    <div class="col-4">
                                        <small class="text-muted d-block" style="font-size:0.65rem; letter-spacing: 0.5px;">HẾT HẠN</small>
                                        <span class="fw-medium text-dark small" style="font-size:0.75rem;">@pkg.ExpirationDate.ToString("dd/MM")</span>
                                    </div>
                                </div>
                                <div class="progress" style="height:6px; border-radius:4px;">
                                    <div class="progress-bar" style="width:@(progress)%; background:var(--mb-primary);" role="progressbar"></div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-clipboard-x d-block fs-3 mb-2" style="opacity: 0.5;"></i>
                            <small class="small d-block">Chưa đăng ký gói điều trị dài hạn nào.</small>
                        </div>
                    }
                </div>
            </div>
            
            <div class="card border-0 shadow-sm rounded-4 bg-light">
                <div class="card-body p-4 small text-muted">
                    <h6 class="fw-bold text-dark mb-2"><i class="bi bi-clock-history me-1"></i>Lần cập nhật cuối</h6>
                    <p class="mb-0">Hồ sơ được tạo lúc: <strong>@Model.Record.CreatedAt.ToString("dd/MM/yyyy HH:mm")</strong></p>
                </div>
            </div>
        </div>

        <!-- Main Form Column -->
        <div class="col-lg-8">
            <form method="post" asp-route-id="@Model.RecordId">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-4 p-md-5">
                        
                        <!-- Diagnosis Field -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark d-flex align-items-center gap-2">
                                <i class="bi bi-clipboard2-pulse-fill text-primary"></i>Chẩn đoán lâm sàng <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Input.Diagnosis" class="form-control rounded-3 py-2.5" placeholder="Nhập chẩn đoán..." required />
                        </div>

                        <!-- Notes Field -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark d-flex align-items-center gap-2">
                                <i class="bi bi-journal-text text-primary"></i>Nội dung & Ghi chú tư vấn <span class="text-danger">*</span>
                            </label>
                            <textarea asp-for="Input.Notes" class="form-control rounded-3" rows="6" placeholder="Ghi chú chi tiết..." required></textarea>
                        </div>

                        <!-- Prescription Field -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark d-flex align-items-center gap-2">
                                <i class="bi bi-capsule text-primary"></i>Toa thuốc / Chỉ định y khoa (Nếu có)
                            </label>
                            <textarea asp-for="Input.Prescription" class="form-control rounded-3" rows="2" placeholder="Tên thuốc hoặc chỉ định bổ sung..."></textarea>
                        </div>

                        <!-- Advice/Recommendations Field -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark d-flex align-items-center gap-2">
                                <i class="bi bi-heart-pulse-fill text-primary"></i>Khuyến nghị / Bài tập tâm lý tại nhà
                            </label>
                            <textarea asp-for="Input.Recommendations" class="form-control rounded-3" rows="4" placeholder="Ví dụ các bài tập hoặc lời khuyên..."></textarea>
                        </div>

                        <!-- Form Actions -->
                        <div class="d-flex justify-content-end gap-3 pt-3 border-top mt-5">
                            <a asp-page="Index" class="btn btn-outline-secondary px-4 py-2.5 rounded-3 fw-bold">Hủy bỏ</a>
                            <button type="submit" class="btn btn-primary px-4 py-2.5 rounded-3 fw-bold d-flex align-items-center gap-2">
                                <i class="bi bi-check-circle-fill"></i>Cập nhật hồ sơ tư vấn
                            </button>
                        </div>

                    </div>
                </div>
            </form>
        </div>
    </div>
}
