@page
@model OPCBS.Web.Pages.Doctor.Schedules.IndexModel
@{
    ViewData["Title"] = "Schedule Management";
    ViewData["UseDashboardLayout"] = true;
    
    var today = DateTime.Today;
    var currentMonth = new DateTime(today.Year, today.Month, 1);
    
    // Stats
    int totalSlots = Model.ActualSlots.Count;
    int availableSlots = Model.ActualSlots.Count(s => s.Status == 0);
    int bookedSlots = Model.ActualSlots.Count(s => s.Status == 1);
    int blockedSlots = Model.ActualSlots.Count(s => s.Status == 2);
    
    // Days off as background events for calendar
    var daysOffJson = System.Text.Json.JsonSerializer.Serialize(Model.DaysOff.SelectMany(d => {
        var dates = new List<object>();
        for (var dt = d.StartDate.Date; dt <= d.EndDate.Date; dt = dt.AddDays(1))
        {
            dates.Add(new {
                start = dt.ToString("yyyy-MM-dd"),
                end = dt.AddDays(1).ToString("yyyy-MM-dd"),
                display = "background",
                backgroundColor = "rgba(239,68,68,0.08)",
                borderColor = "transparent",
                title = "Day Off",
                extendedProps = new { isDayOff = true, reason = d.Reason ?? "" }
            });
        }
        return dates;
    }));
    
    var eventsJson = System.Text.Json.JsonSerializer.Serialize(Model.ActualSlots.Select(s => {
        var isPartial = s.Status == 0 && s.CurrentBookings > 0 && s.CurrentBookings < s.MaxPatients;
        var bgColor = isPartial ? "#fffbeb" : s.Status == 0 ? "#ecfdf5" : s.Status == 1 ? "#fef3c7" : "#f1f5f9";
        var bdColor = isPartial ? "#f59e0b" : s.Status == 0 ? "#10b981" : s.Status == 1 ? "#f59e0b" : "#94a3b8";
        var txColor = isPartial ? "#92400e" : s.Status == 0 ? "#065f46" : s.Status == 1 ? "#92400e" : "#475569";
        return new {
            id = s.Id,
            title = isPartial ? "Partial" : s.Status == 0 ? "Available" : s.Status == 1 ? "Booked" : "Blocked",
            start = $"{s.Date}T{s.StartTime}",
            end = $"{s.Date}T{s.EndTime}",
            backgroundColor = bgColor,
            borderColor = bdColor,
            textColor = txColor,
            extendedProps = new { status = s.Status, notes = s.Notes ?? "", maxPatients = s.MaxPatients, currentBookings = s.CurrentBookings }
        };
    }));
}

<style>
    /* === Schedule Page Premium Styles === */
    .schedule-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 1.5rem; }
    .stat-card {
        background: white; border-radius: 14px; padding: 1.25rem; border: 1px solid rgba(78,139,112,0.08);
        display: flex; align-items: center; gap: 1rem; transition: all 0.2s;
    }
    .stat-card:hover { transform: translateY(-2px); box-shadow: 0 4px 15px rgba(0,0,0,0.06); }
    .stat-icon {
        width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center;
        font-size: 1.25rem; flex-shrink: 0;
    }
    .stat-icon.total { background: rgba(99,102,241,0.1); color: #6366f1; }
    .stat-icon.available { background: rgba(16,185,129,0.1); color: #10b981; }
    .stat-icon.booked { background: rgba(245,158,11,0.1); color: #f59e0b; }
    .stat-icon.blocked { background: rgba(148,163,184,0.15); color: #64748b; }
    .stat-value { font-size: 1.5rem; font-weight: 700; color: #1e293b; line-height: 1; }
    .stat-label { font-size: 0.8rem; color: #64748b; margin-top: 2px; }

    .calendar-card {
        background: white; border-radius: 16px; border: 1px solid rgba(78,139,112,0.08);
        overflow: hidden; margin-bottom: 1.5rem;
    }
    .calendar-card .card-body { padding: 1.5rem; }

    /* FullCalendar Customization */
    .fc { font-family: 'Segoe UI', sans-serif; }
    .fc-event {
        cursor: pointer; border-radius: 10px !important;
        box-shadow: 0 2px 6px rgba(0,0,0,0.06);
        transition: all 0.2s ease;
        margin: 0 2px !important;
    }
    .fc-event:hover { box-shadow: 0 4px 14px rgba(0,0,0,0.12); transform: translateY(-1px); }
    .fc-v-event .fc-event-main-frame { padding: 0; }
    .fc-v-event { border-left-width: 3px !important; }
    .fc-theme-standard th { padding: 10px 0; background: linear-gradient(135deg, #f8fffe, #f0fdf8); font-weight: 600; color: #1e293b; }
    .fc-toolbar-title { font-size: 1.2rem !important; font-weight: 700 !important; color: #1e293b; }
    .fc-button { border-radius: 8px !important; font-weight: 500 !important; font-size: 0.85rem !important; padding: 6px 14px !important; }
    .fc-button-primary { background-color: var(--mb-primary) !important; border-color: var(--mb-primary) !important; }
    .fc-button-primary:not(.fc-button-active):hover { background-color: var(--mb-primary-dark) !important; }
    .fc-button-primary:not(.fc-button-active) { background-color: white !important; color: var(--mb-primary) !important; border-color: #e2e8f0 !important; }
    .fc-button-active { background-color: var(--mb-primary) !important; color: white !important; }
    .fc-today-button { background-color: var(--mb-primary) !important; border-color: var(--mb-primary) !important; color: white !important; }
    .fc-day-today { background-color: rgba(16,185,129,0.04) !important; }
    .fc-timegrid-slot { height: 3em; }
    .fc-col-header-cell { border-bottom: 2px solid rgba(78,139,112,0.15) !important; }

    /* Slot card inner layout */
    .slot-card { padding: 6px 8px; display: flex; flex-direction: column; height: 100%; overflow: hidden; cursor: pointer; position: relative; }
    .slot-card .slot-time { font-weight: 700; font-size: 0.72rem; letter-spacing: 0.3px; opacity: 0.85; }
    .slot-card .slot-badge {
        display: inline-flex; align-items: center; gap: 3px; font-size: 0.62rem; font-weight: 700;
        padding: 2px 7px; border-radius: 20px; margin-top: 3px; width: fit-content;
        text-transform: uppercase; letter-spacing: 0.5px;
    }
    .slot-card .slot-badge.available { background: rgba(16,185,129,0.2); color: #065f46; }
    .slot-card .slot-badge.booked { background: rgba(245,158,11,0.2); color: #92400e; }
    .slot-card .slot-badge.blocked { background: rgba(148,163,184,0.25); color: #334155; }
    .slot-card .slot-notes {
        font-size: 0.6rem; color: rgba(0,0,0,0.45); margin-top: 3px;
        overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
        display: flex; align-items: center; gap: 2px;
    }
    .slot-card .slot-duration {
        font-size: 0.58rem; color: rgba(0,0,0,0.35); margin-top: 2px;
        display: flex; align-items: center; gap: 3px; font-weight: 500;
    }
    .slot-card .slot-hint {
        font-size: 0.55rem; color: rgba(0,0,0,0.3); margin-top: auto;
        display: flex; align-items: center; gap: 3px; padding-top: 2px;
    }

    /* Day off background */
    .fc-bg-event { opacity: 1 !important; }

    /* Legend */
    .schedule-legend {
        background: white; border-radius: 14px; padding: 1rem 1.5rem; border: 1px solid rgba(78,139,112,0.08);
        display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;
    }
    .legend-items { display: flex; gap: 1.25rem; align-items: center; flex-wrap: wrap; }
    .legend-item { display: flex; align-items: center; gap: 6px; font-size: 0.8rem; font-weight: 500; color: #475569; }
    .legend-dot { width: 12px; height: 12px; border-radius: 4px; flex-shrink: 0; }

    /* Days off badge list */
    .days-off-bar {
        background: white; border-radius: 14px; padding: 1rem 1.5rem; border: 1px solid rgba(78,139,112,0.08);
        margin-bottom: 1.5rem;
    }
    .days-off-bar .bar-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; }
    .days-off-bar .bar-header h6 { margin: 0; font-size: 0.85rem; font-weight: 600; color: #1e293b; }
    .day-off-chip {
        display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; background: #fef2f2;
        border: 1px solid #fecaca; border-radius: 20px; font-size: 0.78rem; color: #991b1b; font-weight: 500;
    }
    .day-off-chip .bi { font-size: 0.7rem; }
    .day-off-chip form { display: inline; }
    .day-off-chip .btn-remove { background: none; border: none; color: #ef4444; cursor: pointer; padding: 0 0 0 4px; font-size: 0.8rem; }
    .day-off-chip .btn-remove:hover { color: #b91c1c; }

    /* Modal */
    .modal-content { border-radius: 16px !important; border: none !important; box-shadow: 0 25px 50px rgba(0,0,0,0.15) !important; }
    .modal-header { border-bottom: 1px solid #f1f5f9; padding: 1.25rem 1.5rem; }
    .modal-body { padding: 1.5rem; }
    .modal-footer { border-top: none; padding: 1rem 1.5rem; background: #f8fafc; }

    /* Header actions */
    .header-actions .btn { border-radius: 10px; font-weight: 500; font-size: 0.8rem; padding: 6px 14px; }

    @@media (max-width: 768px) {
        .schedule-stats { grid-template-columns: repeat(2, 1fr); }
    }
</style>

<!-- Page Header -->
<div class="mb-page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 style="font-size:1.4rem; font-weight:700; margin:0;">
            <i class="bi bi-calendar-week me-2" style="color:var(--mb-primary);"></i>Schedule Management
        </h1>
        <p style="margin:4px 0 0; font-size:0.85rem; color:#64748b;">Create, manage and track your consultation schedule</p>
    </div>
    <div class="header-actions d-flex gap-2 align-items-center">
        <select id="monthSelector" class="form-select form-select-sm" style="width:auto; border-radius:10px; font-size:0.8rem;">
            @for (int i = 0; i < 12; i++)
            {
                var d = currentMonth.AddMonths(i);
                <option value="@d.ToString("yyyy-MM-01")">@d.ToString("MMMM yyyy")</option>
            }
        </select>
        <form method="post" asp-page-handler="ResetSchedule" class="m-0 p-0 d-inline-block" onsubmit="return confirm('Are you sure you want to delete all available slots? (Blocked and booked slots will be kept)');">
            <button type="submit" class="btn btn-outline-danger btn-sm">
                <i class="bi bi-arrow-counterclockwise me-1"></i>Reset
            </button>
        </form>
        <a asp-page="DaysOff" class="btn btn-outline-secondary btn-sm"><i class="bi bi-calendar-x me-1"></i>Day Off</a>
    </div>
</div>

<!-- Alerts -->
@if (Model.Success != null) { 
    <div class="alert alert-success alert-dismissible fade show" style="border-radius:12px; border:none; background:linear-gradient(135deg,#ecfdf5,#d1fae5);">
        <i class="bi bi-check-circle-fill me-2" style="color:#10b981;"></i>@Model.Success
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div> 
}
@if (Model.Error != null) { 
    <div class="alert alert-warning alert-dismissible fade show" style="border-radius:12px; border:none;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div> 
}


<!-- Days Off Bar (inline) -->
@if (Model.DaysOff.Any())
{
    <div class="days-off-bar">
        <div class="bar-header">
            <h6><i class="bi bi-calendar-x me-1 text-danger"></i>Registered Days Off</h6>
            <a asp-page="DaysOff" style="font-size:0.78rem; color:var(--mb-primary); text-decoration:none; font-weight:500;">Manage →</a>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var d in Model.DaysOff)
            {
                <div class="day-off-chip">
                    <i class="bi bi-x-circle-fill"></i>
                    @d.StartDate.ToString("dd/MM") @(d.EndDate != d.StartDate ? $"- {d.EndDate:dd/MM}" : "")
                    @if (!string.IsNullOrEmpty(d.Reason)) { <span style="opacity:0.7;">(@d.Reason)</span> }
                    <form method="post" asp-page-handler="DeleteDayOff" onsubmit="return confirm('Are you sure you want to delete this day off?');">
                        <input type="hidden" name="id" value="@d.Id" />
                        <button type="submit" class="btn-remove" title="Delete"><i class="bi bi-x-lg"></i></button>
                    </form>
                </div>
            }
        </div>
    </div>
}

<!-- Calendar -->
<div class="calendar-card">
    <div class="card-body">
        <div id="calendar"></div>
    </div>
</div>

<!-- Legend -->
<div class="schedule-legend">
    <div class="legend-items">
        <span style="font-weight:600; color:#1e293b; font-size:0.8rem;"><i class="bi bi-info-circle me-1"></i>Legend:</span>
        <div class="legend-item"><div class="legend-dot" style="background:#ecfdf5; border:1.5px solid #10b981;"></div>Available</div>
        <div class="legend-item"><div class="legend-dot" style="background:#fffbeb; border:1.5px solid #f59e0b;"></div>Partially Booked</div>
        <div class="legend-item"><div class="legend-dot" style="background:#fef3c7; border:1.5px solid #f59e0b;"></div>Booked (Full)</div>
        <div class="legend-item"><div class="legend-dot" style="background:#f1f5f9; border:1.5px solid #94a3b8;"></div>Blocked</div>
        <div class="legend-item"><div class="legend-dot" style="background:rgba(239,68,68,0.08); border:1.5px solid #fca5a5;"></div>Day Off</div>
    </div>
    <div style="font-size:0.78rem; color:#94a3b8;"><i class="bi bi-hand-index-thumb me-1"></i>Drag on the calendar to create a new slot</div>
</div>

<!-- Create Slot Modal -->
<div class="modal fade" id="createSlotModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="CreateSlot">
                <div class="modal-header">
                    <h5 class="modal-title" style="font-size:1.05rem; font-weight:600;">
                        <i class="bi bi-calendar-plus me-2" style="color:var(--mb-primary);"></i>Add Appointment Slot
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="date" id="modalDate" />
                    
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label small fw-medium">Date</label>
                            <input type="text" class="form-control" id="modalDateDisplay" readonly style="background:#f8fafc; border-radius:10px;" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-medium">Start Time</label>
                            <input type="time" name="startTime" id="modalStartTime" class="form-control" required style="border-radius:10px;" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-medium">End Time</label>
                            <input type="time" name="endTime" id="modalEndTime" class="form-control" required style="border-radius:10px;" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small fw-medium d-flex align-items-center gap-1">
                                Max Patients
                                <i class="bi bi-info-circle text-muted" title="Number of patients allowed to book this slot. Slot auto-locks when full." style="cursor:help;"></i>
                            </label>
                            <input type="number" name="maxPatients" id="modalMaxPatients" class="form-control" min="1" max="10" value="1" style="border-radius:10px;" />
                        </div>
                    </div>
                    
                    <div class="mt-2 text-center">
                        <span id="durationPreview" class="badge bg-light text-muted" style="font-size:0.75rem; border-radius:8px; padding:4px 12px;">
                            <i class="bi bi-clock me-1"></i>Duration: --
                        </span>
                    </div>
                    
                    <div class="mb-0 mt-3">
                        <label class="form-label small fw-medium">Notes (optional)</label>
                        <textarea name="notes" id="modalNotes" class="form-control" rows="2" placeholder="e.g. General checkup, Psychological counseling..." style="border-radius:10px; resize:none;"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" style="border-radius:10px;">Cancel</button>
                    <button type="submit" class="btn btn-primary" style="border-radius:10px; background:var(--mb-primary); border-color:var(--mb-primary);">
                        <i class="bi bi-check-lg me-1"></i>Save Slot
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Slot Detail Modal -->
<div class="modal fade" id="slotDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" style="font-size:1.05rem; font-weight:600;">
                    <i class="bi bi-calendar-event me-2" style="color:var(--mb-primary);"></i>Slot Details & Edit
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="UpdateSlot" class="m-0">
                <div class="modal-body">
                    <input type="hidden" name="slotId" id="updateSlotId" />
                    
                    <!-- Status Badge -->
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div id="detailStatusBadge" class="px-3 py-1 rounded-pill fw-semibold" style="font-size:0.85rem;"></div>
                        <div id="detailCapacityBadge" class="px-3 py-1 rounded-pill fw-semibold" style="font-size:0.85rem; background:#f0f9ff; color:#0369a1;"></div>
                    </div>

                    <div class="row g-3">
                        <!-- Left column: Date & Time -->
                        <div class="col-md-6">
                            <div style="background:#f8fafc; border-radius:12px; padding:1.25rem;">
                                <div class="mb-3">
                                    <label class="form-label small fw-medium text-muted"><i class="bi bi-calendar3 me-1"></i>Date</label>
                                    <div id="detailDate" style="font-size:1rem; font-weight:600; color:#1e293b;"></div>
                                </div>
                                <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <label class="form-label small fw-medium text-muted"><i class="bi bi-play-fill me-1"></i>Start Time</label>
                                        <input type="time" name="startTime" id="detailStartTime" class="form-control" style="border-radius:10px;" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small fw-medium text-muted"><i class="bi bi-stop-fill me-1"></i>End Time</label>
                                        <input type="time" name="endTime" id="detailEndTime" class="form-control" style="border-radius:10px;" />
                                    </div>
                                </div>
                                <div class="mb-0">
                                    <label class="form-label small fw-medium text-muted d-flex align-items-center gap-1">
                                        <i class="bi bi-people-fill me-1"></i>Max Patients per Slot
                                        <i class="bi bi-info-circle" title="Slot auto-locks when the booking count reaches this limit." style="cursor:help;"></i>
                                    </label>
                                    <input type="number" name="maxPatients" id="detailMaxPatients" class="form-control" min="1" max="10" style="border-radius:10px;" />
                                </div>
                            </div>
                        </div>
                        
                        <!-- Right column: Capacity + Notes -->
                        <div class="col-md-6">
                            <!-- Capacity Progress -->
                            <div id="capacitySection" style="background:#f0f9ff; border-radius:12px; padding:1.25rem; margin-bottom:1rem;">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="small fw-semibold text-muted"><i class="bi bi-people me-1"></i>Booking Capacity</span>
                                    <span id="capacityText" class="small fw-bold"></span>
                                </div>
                                <div class="progress" style="height:8px; border-radius:4px; background:#e0f2fe;">
                                    <div id="capacityBar" class="progress-bar" role="progressbar" style="border-radius:4px; transition:width 0.3s;"></div>
                                </div>
                                <div id="capacityHint" class="mt-1" style="font-size:0.72rem; color:#64748b;"></div>
                            </div>

                            <!-- Notes -->
                            <div>
                                <label class="form-label small fw-medium text-muted"><i class="bi bi-sticky me-1"></i>Notes</label>
                                <textarea name="notes" id="detailNotesInput" class="form-control" rows="4" placeholder="Add notes for this slot..." style="border-radius:10px; resize:none;"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer" style="gap:8px; flex-wrap:nowrap;">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" style="border-radius:10px;">Close</button>
                    
                    <!-- Save edits -->
                    <button type="submit" id="btnSaveSlot" class="btn btn-primary" style="border-radius:10px; background:var(--mb-primary); border-color:var(--mb-primary);">
                        <i class="bi bi-check-lg me-1"></i>Save Changes
                    </button>
                    
                    <!-- Toggle Block (separate form) -->
                </div>
            </form>
            
            <!-- Action forms outside the main edit form -->
            <div class="px-3 pb-3 d-flex gap-2">
                <form id="toggleForm" method="post" asp-page-handler="ToggleBlock" class="flex-fill m-0" style="display:none;">
                    <input type="hidden" name="slotId" id="toggleSlotId" />
                    <button type="submit" id="btnToggleSlot" class="btn btn-outline-secondary w-100" style="border-radius:10px;"></button>
                </form>
                
                <form id="deleteForm" method="post" asp-page-handler="DeleteSlot" class="flex-fill m-0" style="display:none;" onsubmit="return confirm('Are you sure you want to delete this slot?');">
                    <input type="hidden" name="slotId" id="deleteSlotId" />
                    <button type="submit" class="btn btn-danger w-100" style="border-radius:10px;">
                        <i class="bi bi-trash3 me-1"></i>Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js'></script>
    <script>
        var currentSlotId = null;
        var currentSlotStatus = null;

        function showSlotDetail(event) {
            currentSlotId = event.id;
            currentSlotStatus = event.extendedProps.status;
            var maxP = event.extendedProps.maxPatients || 1;
            var curB = event.extendedProps.currentBookings || 0;

            var badge = document.getElementById('detailStatusBadge');
            var capBadge = document.getElementById('detailCapacityBadge');
            var detailDate = document.getElementById('detailDate');
            var toggleForm = document.getElementById('toggleForm');
            var deleteForm = document.getElementById('deleteForm');
            var btnToggle = document.getElementById('btnToggleSlot');

            // Set IDs on all forms
            document.getElementById('updateSlotId').value = currentSlotId;
            document.getElementById('toggleSlotId').value = currentSlotId;
            document.getElementById('deleteSlotId').value = currentSlotId;

            // Date & time
            var start = event.start;
            var end = event.end;
            var dayNames = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
            detailDate.textContent = dayNames[start.getDay()] + ', ' + String(start.getDate()).padStart(2,'0') + '/' + String(start.getMonth()+1).padStart(2,'0') + '/' + start.getFullYear();
            
            // Set editable time inputs
            document.getElementById('detailStartTime').value = String(start.getHours()).padStart(2,'0') + ':' + String(start.getMinutes()).padStart(2,'0');
            document.getElementById('detailEndTime').value = String(end.getHours()).padStart(2,'0') + ':' + String(end.getMinutes()).padStart(2,'0');
            document.getElementById('detailMaxPatients').value = maxP;

            // Capacity progress
            var pct = maxP > 0 ? Math.round((curB / maxP) * 100) : 0;
            document.getElementById('capacityText').textContent = curB + ' / ' + maxP + ' patients';
            var bar = document.getElementById('capacityBar');
            bar.style.width = pct + '%';
            bar.className = 'progress-bar ' + (pct >= 100 ? 'bg-warning' : pct > 0 ? 'bg-info' : 'bg-success');
            capBadge.textContent = '\uD83D\uDC65 ' + curB + '/' + maxP;
            
            var hint = document.getElementById('capacityHint');
            if (curB === 0) hint.textContent = 'No bookings yet. Slot is open for patients.';
            else if (curB < maxP) hint.textContent = (maxP - curB) + ' spot(s) remaining before auto-lock.';
            else hint.textContent = 'Slot is fully booked.';

            // Disable time editing for booked slots
            var isBooked = currentSlotStatus === 1;
            document.getElementById('detailStartTime').disabled = isBooked;
            document.getElementById('detailEndTime').disabled = isBooked;
            document.getElementById('btnSaveSlot').style.display = isBooked ? 'none' : '';

            // Status badge & show/hide action forms
            if (currentSlotStatus === 0) {
                badge.textContent = '\u2705 Available';
                badge.style.cssText = 'background:#ecfdf5; color:#065f46; font-size:0.85rem; padding:4px 14px;';
                btnToggle.innerHTML = '<i class="bi bi-lock me-1"></i>Block Slot';
                btnToggle.className = 'btn btn-outline-secondary w-100';
                btnToggle.style.borderRadius = '10px';
                toggleForm.style.display = '';
                deleteForm.style.display = '';
            } else if (currentSlotStatus === 1) {
                badge.textContent = '\uD83D\uDCC5 Booked';
                badge.style.cssText = 'background:#fef3c7; color:#92400e; font-size:0.85rem; padding:4px 14px;';
                toggleForm.style.display = 'none';
                deleteForm.style.display = 'none';
            } else {
                badge.textContent = '\uD83D\uDD12 Blocked';
                badge.style.cssText = 'background:#f1f5f9; color:#475569; font-size:0.85rem; padding:4px 14px;';
                btnToggle.innerHTML = '<i class="bi bi-unlock me-1"></i>Unblock Slot';
                btnToggle.className = 'btn btn-outline-primary w-100';
                btnToggle.style.borderRadius = '10px';
                toggleForm.style.display = '';
                deleteForm.style.display = '';
            }

            var modal = new bootstrap.Modal(document.getElementById('slotDetailModal'));

            // Set notes
            var notes = event.extendedProps.notes;
            document.getElementById('detailNotesInput').value = (notes && notes.trim() !== '') ? notes : '';

            modal.show();
        }

        document.addEventListener('DOMContentLoaded', function() {
            var calendarEl = document.getElementById('calendar');
            var events = @Html.Raw(eventsJson);
            var daysOffEvents = @Html.Raw(daysOffJson);
            var allEvents = events.concat(daysOffEvents);
            
            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'timeGridWeek',
                locale: 'en',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'timeGridWeek,timeGridDay'
                },
                buttonText: {
                    today: 'Today',
                    week: 'Week',
                    day: 'Day'
                },
                slotMinTime: '06:00:00',
                slotMaxTime: '22:00:00',
                allDaySlot: false,
                selectable: true,
                selectMirror: true,
                events: allEvents,
                slotDuration: '00:30:00',
                snapDuration: '00:15:00',
                selectLongPressDelay: 100,
                height: 700,
                expandRows: false,
                slotLabelFormat: { hour: '2-digit', minute: '2-digit', hour12: false },
                eventTimeFormat: { hour: '2-digit', minute: '2-digit', hour12: false },
                validRange: {
                    start: '@today.ToString("yyyy-MM-dd")'
                },
                
                select: function(info) {
                    var startDate = info.start;
                    var endDate = info.end;
                    
                    var dateStr = startDate.getFullYear() + '-' + 
                                  String(startDate.getMonth() + 1).padStart(2, '0') + '-' + 
                                  String(startDate.getDate()).padStart(2, '0');
                                  
                    var startTimeStr = String(startDate.getHours()).padStart(2, '0') + ':' + String(startDate.getMinutes()).padStart(2, '0');
                    var endTimeStr = String(endDate.getHours()).padStart(2, '0') + ':' + String(endDate.getMinutes()).padStart(2, '0');
                    
                    document.getElementById('modalDate').value = dateStr;
                    document.getElementById('modalDateDisplay').value = dateStr;
                    document.getElementById('modalStartTime').value = startTimeStr;
                    document.getElementById('modalEndTime').value = endTimeStr;
                    
                    var modal = new bootstrap.Modal(document.getElementById('createSlotModal'));
                    modal.show();
                    
                    calendar.unselect();
                },
                
                eventClick: function(info) {
                    // Ignore day-off background events
                    if (info.event.extendedProps.isDayOff) return;
                    
                    // Open slot detail modal
                    showSlotDetail(info.event);
                },
                
                eventContent: function(arg) {
                    // Don't customize day-off background events
                    if (arg.event.extendedProps.isDayOff) return;
                    
                    var status = arg.event.extendedProps.status;
                    var maxP = arg.event.extendedProps.maxPatients || 1;
                    var curB = arg.event.extendedProps.currentBookings || 0;
                    var isPartial = status === 0 && curB > 0 && curB < maxP;
                    var icon, statusLabel, badgeClass;
                    
                    if (isPartial) {
                        icon = 'bi-person-plus-fill'; statusLabel = 'Partial'; badgeClass = 'booked';
                    } else if (status === 0) {
                        icon = 'bi-check-circle-fill'; statusLabel = 'Available'; badgeClass = 'available';
                    } else if (status === 1) {
                        icon = 'bi-person-check-fill'; statusLabel = 'Booked'; badgeClass = 'booked';
                    } else {
                        icon = 'bi-lock-fill'; statusLabel = 'Blocked'; badgeClass = 'blocked';
                    }
                    
                    // Calculate duration
                    var durationMs = arg.event.end - arg.event.start;
                    var durationMin = Math.round(durationMs / 60000);
                    var durationText = durationMin >= 60 
                        ? Math.floor(durationMin/60) + 'h' + (durationMin%60 > 0 ? durationMin%60 + 'm' : '')
                        : durationMin + 'min';
                    
                    var notes = arg.event.extendedProps.notes;
                    var notesHtml = notes ? '<div class="slot-notes"><i class="bi bi-sticky-fill"></i>' + notes + '</div>' : '';

                    // Capacity indicator
                    var capHtml = maxP > 1 
                        ? '<div class="slot-duration" style="color:#0369a1;"><i class="bi bi-people-fill"></i>' + curB + '/' + maxP + '</div>'
                        : '';
                    
                    return {
                        html: '<div class="slot-card">' +
                              '<div class="slot-time">' + arg.timeText + '</div>' +
                              '<div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap;">' +
                              '<div class="slot-badge ' + badgeClass + '">' +
                              '<i class="bi ' + icon + '"></i>' + statusLabel +
                              '</div>' +
                              '<div class="slot-duration"><i class="bi bi-clock"></i>' + durationText + '</div>' +
                              capHtml +
                              '</div>' +
                              notesHtml +
                              '<div class="slot-hint"><i class="bi bi-hand-index"></i>Click to manage</div>' +
                              '</div>'
                    };
                }
            });
            
            calendar.render();
            window.calendarObj = calendar;
            
            // Link month selector
            document.getElementById('monthSelector').addEventListener('change', function() {
                if (window.calendarObj) {
                    window.calendarObj.gotoDate(this.value);
                }
            });
            
            // Live duration preview in Create Slot modal
            function updateDurationPreview() {
                var startEl = document.getElementById('modalStartTime');
                var endEl = document.getElementById('modalEndTime');
                var previewEl = document.getElementById('durationPreview');
                if (!startEl.value || !endEl.value) { previewEl.innerHTML = '<i class="bi bi-clock me-1"></i>Duration: --'; return; }
                var startParts = startEl.value.split(':'), endParts = endEl.value.split(':');
                var startMin = parseInt(startParts[0]) * 60 + parseInt(startParts[1]);
                var endMin = parseInt(endParts[0]) * 60 + parseInt(endParts[1]);
                var diff = endMin - startMin;
                if (diff <= 0) {
                    previewEl.innerHTML = '<i class="bi bi-exclamation-triangle me-1"></i>Invalid time range';
                    previewEl.className = 'badge bg-danger bg-opacity-10 text-danger';
                } else {
                    var h = Math.floor(diff / 60), m = diff % 60;
                    var text = h > 0 ? h + 'h ' + (m > 0 ? m + 'min' : '') : m + 'min';
                    previewEl.innerHTML = '<i class="bi bi-clock me-1"></i>Duration: ' + text.trim();
                    previewEl.className = 'badge bg-success bg-opacity-10 text-success';
                }
                previewEl.style.cssText = 'font-size:0.75rem; border-radius:8px; padding:4px 12px;';
            }
            document.getElementById('modalStartTime').addEventListener('change', updateDurationPreview);
            document.getElementById('modalEndTime').addEventListener('change', updateDurationPreview);
        });
    </script>
}
