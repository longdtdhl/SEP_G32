@section Scripts {
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js'></script>
    <script>
        var rawEvents = @Html.Raw(eventsJson);
        var currentView = '@Model.View';
        var selectedDateStr = '@selectedDateStr';
        function isPastSlot(dateStr, timeStr) {
            if (!dateStr || !timeStr) return true;
            return new Date(dateStr + 'T' + timeStr + ':00') <= new Date();
        }

        function openAddSlotModal(dateStr, startTime, endTime) {
            if (isPastSlot(dateStr, startTime)) {
                window.alert('Cannot create a slot in the past.');
                return;
            }
            if (dateStr) document.getElementById('createSlotDate').value = dateStr;
            if (startTime) document.getElementById('createStartTime').value = startTime;
            if (endTime) document.getElementById('createEndTime').value = endTime;
            updateDurationText(document.getElementById('createStartTime').value, document.getElementById('createEndTime').value, 'createSlotDurationPreview');
            var m = new bootstrap.Modal(document.getElementById('createSlotModal'));
            m.show();
        }

        function onSlotTypeChanged(mode) {
            var form = document.getElementById('createSlotForm');
            var pContainer = document.getElementById('treatmentPatientContainer');
            var maxContainer = document.getElementById('maxPatientsContainer');
            var btnSave = document.getElementById('btnSaveSlot');

            if (mode === 'treatment') {
                form.action = '?handler=CreateTreatmentAppointment';
                pContainer.classList.remove('d-none');
                maxContainer.classList.add('d-none');
                document.getElementById('createMaxPatients').value = 1;
                btnSave.textContent = 'Save Treatment Appointment';
            } else {
                form.action = '?handler=CreateSlot';
                pContainer.classList.add('d-none');
                maxContainer.classList.remove('d-none');
                btnSave.textContent = 'Save Slot';
            }
        }

        function onTreatmentPatientSelected(selectEl) {
            var opt = selectEl.options[selectEl.selectedIndex];
            var infoCard = document.getElementById('patientTreatmentInfoCard');

            if (!opt || !opt.value) {
                document.getElementById('treatPatientId').value = '';
                document.getElementById('treatCaseId').value = '';
                document.getElementById('treatSessionId').value = '';
                infoCard.classList.add('d-none');
                return;
            }

            document.getElementById('treatPatientId').value = opt.value;
            document.getElementById('treatCaseId').value = opt.getAttribute('data-case-id') || '';
            document.getElementById('treatSessionId').value = opt.getAttribute('data-session-id') || '';

            document.getElementById('infoPackageName').textContent = opt.getAttribute('data-package') || '';
            document.getElementById('infoSessionNum').textContent = opt.getAttribute('data-session-num') || '1';
            document.getElementById('infoCompleted').textContent = opt.getAttribute('data-completed') || '0';
            document.getElementById('infoTotal').textContent = opt.getAttribute('data-total') || '0';

            infoCard.classList.remove('d-none');
        }

        function triggerWeeklyPreview() {
            var previewEl = document.getElementById('weeklyPreviewContent');
            previewEl.innerHTML = '<i class="bi bi-hourglass-split me-1 text-primary"></i> Calculating expected schedule slots...';

            var checkedDays = Array.from(document.querySelectorAll('input[name="workingDays"]:checked')).map(cb => cb.value);
            var startTime = document.getElementById('weeklyStartTime').value;
            var endTime = document.getElementById('weeklyEndTime').value;
            var duration = parseInt(document.getElementById('weeklyDuration').value) || 45;
            var weeks = parseInt(document.getElementById('weeklyWeeks').value) || 4;

            if (checkedDays.length === 0) {
                previewEl.innerHTML = '<span class="text-danger">Please select at least one working day.</span>';
                return;
            }

            if (!startTime || !endTime || startTime < '07:00' || endTime > '23:00' || startTime >= endTime) {
                previewEl.innerHTML = '<span class="text-danger">Working hours must be between 07:00 and 23:00.</span>';
                return;
            }

            var payload = {
                workingDays: checkedDays,
                timeRanges: [{ startTime: startTime, endTime: endTime }],
                slotDurationMinutes: duration,
                breakTimeMinutes: 0,
                startDate: document.getElementById('weeklyStartDate').value,
                weeksToApply: weeks
            };

            fetch('/api/v1/schedules/preview-weekly', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(res => res.json())
            .then(res => {
                var d = res.data || res;
                previewEl.innerHTML = `
                    <div class="d-flex flex-wrap gap-3">
                        <div><strong class="text-dark">${d.totalWeeks || weeks}</strong> Weeks</div>
                        <div><strong class="text-teal" style="color:#0f766e;">${d.expectedSlotsCount || 0}</strong> Expected New Slots</div>
                        <div><strong class="text-danger">${d.slotConflictCount || 0}</strong> Conflicts Avoided</div>
                    </div>
                `;
            })
            .catch(err => {
                previewEl.innerHTML = '<span class="text-muted">Preview calculated based on working days and time ranges.</span>';
            });
        }

        function formatEventsForFC(eventsList, filterType) {
            var filtered = eventsList.filter(function(e) {
                if (filterType === 'all') return true;
                if (e.eventType === filterType) return true;
                return (e.status || '').toLowerCase() === filterType.toLowerCase();
            });

            var slotIdsWithAppt = new Set();
            var seenApptIds = new Set();
            filtered.forEach(function(e) {
                if (e.eventType === 'Appointment' && e.slotId) {
                    slotIdsWithAppt.add(e.slotId);
                }
            });

            var deduplicated = [];
            filtered.forEach(function(e) {
                if (e.eventType === 'Appointment') {
                    var apptKey = e.appointmentId || e.id;
                    if (seenApptIds.has(apptKey)) return;
                    seenApptIds.add(apptKey);
                    deduplicated.push(e);
                } else {
                    if (e.slotId && slotIdsWithAppt.has(e.slotId)) {
                        return;
                    }
                    deduplicated.push(e);
                }
            });

            return deduplicated.map(function(e) {
                return {
                    id: e.id,
                    title: e.title,
                    start: e.start,
                    end: e.end,
                    allDay: e.isAllDay,
                    extendedProps: e
                };
            });
        }

        function openViewNoteModal(date, time, title, content) {
            document.getElementById('vNoteDate').textContent = date;
            document.getElementById('vNoteTime').textContent = time;
            document.getElementById('vNoteTitle').textContent = title;
            document.getElementById('vNoteContent').textContent = content;
            var m = new bootstrap.Modal(document.getElementById('viewNoteModal'));
            m.show();
        }

        function openEditNoteModal(slotId, content) {
            document.getElementById('eNoteSlotId').value = slotId;
            document.getElementById('eNoteContent').value = content;
            var m = new bootstrap.Modal(document.getElementById('editNoteModal'));
            m.show();
        }

        function renderYearView(year, eventsList) {
            var grid = document.getElementById('yearCalendarGrid');
            grid.innerHTML = '';
            var monthNames = ['January','February','March','April','May','June','July','August','September','October','November','December'];

            for (var m = 0; m < 12; m++) {
                var card = document.createElement('div');
                card.className = 'year-month-card';

                var title = document.createElement('div');
                title.className = 'year-month-title';
                title.textContent = monthNames[m];
                (function(monthIdx) {
                    title.onclick = function() {
                        var targetDate = year + '-' + String(monthIdx + 1).padStart(2, '0') + '-01';
                        window.location.href = '?view=month&date=' + targetDate;
                    };
                })(m);
                card.appendChild(title);

                var table = document.createElement('table');
                table.className = 'year-days-table';
                table.innerHTML = '<thead><tr><th>M</th><th>T</th><th>W</th><th>T</th><th>F</th><th>S</th><th>S</th></tr></thead>';

                var tbody = document.createElement('tbody');
                var firstDay = new Date(year, m, 1);
                var daysInMonth = new Date(year, m + 1, 0).getDate();
                var startDay = (firstDay.getDay() + 6) % 7; // Monday start

                var row = document.createElement('tr');
                for (var i = 0; i < startDay; i++) {
                    row.appendChild(document.createElement('td'));
                }

                for (var day = 1; day <= daysInMonth; day++) {
                    if ((startDay + day - 1) % 7 === 0 && day > 1) {
                        tbody.appendChild(row);
                        row = document.createElement('tr');
                    }
                    var cell = document.createElement('td');
                    cell.textContent = day;
                    var dateKey = year + '-' + String(m + 1).padStart(2, '0') + '-' + String(day).padStart(2, '0');

                    // Check day status
                    var hasAppt = eventsList.some(e => e.start && e.start.startsWith(dateKey) && e.eventType === 'Appointment');
                    var hasAvailable = eventsList.some(e => e.start && e.start.startsWith(dateKey) && e.eventType === 'Availability');
                    if (hasAppt) cell.className = 'has-appt';
                    else if (hasAvailable) cell.className = 'has-available';

                    (function(dKey) {
                        cell.onclick = function() {
                            openAddSlotModal(dKey, '08:00', '09:00');
                        };
                    })(dateKey);

                    row.appendChild(cell);
                }
                tbody.appendChild(row);
                table.appendChild(tbody);
                card.appendChild(table);
                grid.appendChild(card);
            }
        }

        function updateDurationText(startVal, endVal, targetElId) {
            var target = document.getElementById(targetElId);
            if (!target) return;
            if (!startVal || !endVal) {
                target.textContent = '';
                return;
            }
            var s = startVal.split(':');
            var e = endVal.split(':');
            var startMin = parseInt(s[0]) * 60 + parseInt(s[1]);
            var endMin = parseInt(e[0]) * 60 + parseInt(e[1]);
            var diff = endMin - startMin;
            if (diff <= 0) {
                target.textContent = 'Start time must be before end time.';
                target.className = 'small mt-1 mb-3 fw-semibold text-danger';
                return;
            }
            target.className = 'small mt-1 mb-3 fw-semibold text-teal';
            target.style.color = '#0f766e';
            var hrs = Math.floor(diff / 60);
            var mins = diff % 60;
            var text = 'Duration: ';
            if (hrs > 0 && mins > 0) {
                text += (hrs === 1 ? '1 hour ' : hrs + ' hours ') + mins + ' minutes';
            } else if (hrs > 0) {
                text += hrs === 1 ? '1 hour' : hrs + ' hours';
            } else {
                text += mins + ' minutes';
            }
            target.textContent = text;
        }

        document.addEventListener('DOMContentLoaded', function() {
            var createStartEl = document.getElementById('createStartTime');
            var createEndEl = document.getElementById('createEndTime');
            if (createStartEl && createEndEl) {
                var syncCreateDuration = function() { updateDurationText(createStartEl.value, createEndEl.value, 'createSlotDurationPreview'); };
                createStartEl.addEventListener('change', syncCreateDuration);
                createEndEl.addEventListener('change', syncCreateDuration);
                syncCreateDuration();
            }

            var detailStartEl = document.getElementById('detailStartTime');
            var detailEndEl = document.getElementById('detailEndTime');
            if (detailStartEl && detailEndEl) {
                var syncDetailDuration = function() { updateDurationText(detailStartEl.value, detailEndEl.value, 'detailSlotDurationPreview'); };
                detailStartEl.addEventListener('change', syncDetailDuration);
                detailEndEl.addEventListener('change', syncDetailDuration);
            }

            var fcView = currentView === 'day' ? 'timeGridDay' : currentView === 'month' ? 'dayGridMonth' : 'timeGridWeek';
            var calendarEl = document.getElementById('calendar');

            if (currentView === 'year') {
                var year = new Date(selectedDateStr).getFullYear();
                renderYearView(year, rawEvents);
            } else {
                var fcEvents = formatEventsForFC(rawEvents, 'all');

                var calendar = new FullCalendar.Calendar(calendarEl, {
                    initialView: fcView,
                    initialDate: selectedDateStr,
                    locale: 'en',
                    headerToolbar: false,
                    slotMinTime: '07:00:00',
                    slotMaxTime: '23:00:00',
                    scrollTime: '08:00:00',
                    allDaySlot: false,
                    selectable: true,
                    selectMirror: true,
                    selectAllow: function(selectInfo) {
                        return selectInfo.start > new Date();
                    },
                    events: fcEvents,
                    dayMaxEvents: 4,
                    height: 'auto',
                    nowIndicator: true,
                    eventClassNames: function(arg) {
                        var props = arg.event.extendedProps || {};
                        var status = (props.status || arg.event.title || '').toLowerCase();
                        var type = (props.eventType || '').toLowerCase();

                        if (status.includes('cancelled')) return ['fc-event-cancelled'];
                        if (status.includes('expired')) return ['fc-event-expired'];
                        if (status.includes('completed')) return ['fc-event-completed'];
                        if (status.includes('inprogress') || status.includes('in progress')) return ['fc-event-inprogress'];
                        if (status.includes('pending') || status.includes('reschedule')) return ['fc-event-pending'];
                        if (status.includes('partial')) {
                            return ['fc-event-partial'];
                        }
                        if (type === 'blocked' || status.includes('blocked')) {
                            return ['fc-event-blocked'];
                        }
                        if (type === 'appointment' || type === 'booked' || status.includes('booked') || status.includes('approved') || status.includes('confirmed')) {
                            return ['fc-event-booked'];
                        }
                        return ['fc-event-available'];
                    },
                    eventContent: function(arg) {
                        var event = arg.event;
                        var props = event.extendedProps || {};
                        var viewType = arg.view.type;
                        var displayStatus = (props.status || '').replace('InProgress', 'In Progress');

                        var container = document.createElement('div');
                        container.className = 'fc-custom-event-container';

                        var tooltipParts = [];
                        if (props.bookingCode) tooltipParts.push('[' + props.bookingCode + ']');
                        if (props.appointmentId) tooltipParts.push('ApptId: ' + props.appointmentId);
                        else if (props.slotId) tooltipParts.push('SlotId: ' + props.slotId);
                        if (tooltipParts.length > 0) {
                            container.setAttribute('title', tooltipParts.join(' '));
                        }

                        if (viewType === 'dayGridMonth') {
                            var monthTitle = document.createElement('div');
                            monthTitle.className = 'fc-custom-event-title';
                            monthTitle.textContent = props.patientName
                                ? props.patientName + (displayStatus ? ' - ' + displayStatus : '')
                                : event.title;
                            container.appendChild(monthTitle);
                        } else {
                            var timeEl = document.createElement('div');
                            timeEl.className = 'fc-custom-event-time';
                            var startTime = event.start ? event.start.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit', hour12: false}) : '';
                            var endTime = event.end ? event.end.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit', hour12: false}) : '';
                            timeEl.textContent = (startTime && endTime) ? (startTime + ' - ' + endTime) : event.title;
                            container.appendChild(timeEl);

                            var titleEl = document.createElement('div');
                            titleEl.className = 'fc-custom-event-title';
                            titleEl.textContent = props.patientName
                                ? props.patientName + (displayStatus ? ' - ' + displayStatus : '')
                                : event.title;

                            if (props.hasNotes || (props.description && props.description.trim() !== '')) {
                                var noteIcon = document.createElement('span');
                                noteIcon.className = 'fc-custom-event-note-icon';
                                noteIcon.textContent = ' 📝';
                                titleEl.appendChild(noteIcon);
                            }
                            container.appendChild(titleEl);
                        }

                        return { domNodes: [container] };
                    },
                    eventClick: function(info) {
                        var props = info.event.extendedProps;
                        if (props.eventType === 'Appointment' && props.appointmentId) {
                            window.location.href = '/Doctor/Appointments/Details/' + encodeURIComponent(props.appointmentId);
                        } else if (props.eventType === 'Note') {
                            openViewNoteModal(props.start.split('T')[0], 'Note', props.title, props.description || props.title);
                        } else if (props.slotId) {
                            document.getElementById('detailSlotId').value = props.slotId;
                            document.getElementById('deleteSlotId').value = props.slotId;
                            if (props.start && props.start.includes('T')) {
                                var sVal = props.start.split('T')[1].substring(0, 5);
                                document.getElementById('detailStartTime').value = sVal;
                            }
                            if (props.end && props.end.includes('T')) {
                                var eVal = props.end.split('T')[1].substring(0, 5);
                                document.getElementById('detailEndTime').value = eVal;
                            }
                            if (props.maxPatients) {
                                document.getElementById('detailMaxPatients').value = props.maxPatients;
                            }
                            document.getElementById('detailNotes').value = props.description || '';

                            var normalizedStatus = (props.status || 'Available').toLowerCase();
                            var statusValues = {
                                available: '0',
                                partial: '0',
                                booked: '1',
                                blocked: '2',
                                expired: '3',
                                cancelled: '4',
                                completed: '5'
                            };
                            var statusSelect = document.getElementById('detailStatus');
                            statusSelect.value = statusValues[normalizedStatus] || '0';

                            var hasBookings = Number(props.currentBookings || 0) > 0;
                            var slotHasEnded = props.end ? new Date(props.end) <= new Date() : false;
                            var doctorManagedStatus = normalizedStatus === 'available' ||
                                normalizedStatus === 'blocked' ||
                                normalizedStatus === 'cancelled';
                            var canManageSlot = doctorManagedStatus && !hasBookings && !slotHasEnded;

                            statusSelect.disabled = !canManageSlot;
                            document.getElementById('detailStartTime').disabled = !canManageSlot;
                            document.getElementById('detailEndTime').disabled = !canManageSlot;
                            document.getElementById('detailMaxPatients').disabled = !canManageSlot;
                            document.getElementById('detailNotes').disabled = !canManageSlot;
                            document.getElementById('detailSaveButton').classList.toggle('d-none', !canManageSlot);
                            document.getElementById('detailDeleteButton').disabled = hasBookings || normalizedStatus === 'booked' || normalizedStatus === 'completed';

                            var statusHint = document.getElementById('detailStatusHint');
                            statusHint.textContent = canManageSlot
                                ? 'Available, blocked, and cancelled can be changed by the doctor.'
                                : hasBookings
                                    ? 'This slot has a patient booking. Manage its status from Appointment Details.'
                                    : 'This status is managed automatically and is read-only.';
                            updateDurationText(document.getElementById('detailStartTime').value, document.getElementById('detailEndTime').value, 'detailSlotDurationPreview');
                            var modal = new bootstrap.Modal(document.getElementById('slotDetailModal'));
                            modal.show();
                        }
                    },
                    select: function(info) {
                        var dateStr = info.startStr.split('T')[0];
                        var startTime = '08:00';
                        var endTime = '09:00';
                        if (info.startStr.includes('T')) {
                            startTime = info.startStr.split('T')[1].substring(0, 5);
                        }
                        if (info.endStr.includes('T')) {
                            endTime = info.endStr.split('T')[1].substring(0, 5);
                        }
                        if (isPastSlot(dateStr, startTime)) {
                            window.alert('Cannot create a slot in the past.');
                            return;
                        }
                        openAddSlotModal(dateStr, startTime, endTime);
                    }
                });

                calendar.render();
                window.fcObj = calendar;
            }

            // Toolbar Controls
            document.getElementById('btnPrev').addEventListener('click', function() {
                var dt = new Date(selectedDateStr);
                if (currentView === 'day') dt.setDate(dt.getDate() - 1);
                else if (currentView === 'month') dt.setMonth(dt.getMonth() - 1);
                else if (currentView === 'year') dt.setFullYear(dt.getFullYear() - 1);
                else dt.setDate(dt.getDate() - 7);
                var newDate = dt.toISOString().split('T')[0];
                window.location.href = '?view=' + currentView + '&date=' + newDate;
            });

            document.getElementById('btnToday').addEventListener('click', function() {
                var todayStr = new Date().toISOString().split('T')[0];
                window.location.href = '?view=' + currentView + '&date=' + todayStr;
            });

            document.getElementById('btnNext').addEventListener('click', function() {
                var dt = new Date(selectedDateStr);
                if (currentView === 'day') dt.setDate(dt.getDate() + 1);
                else if (currentView === 'month') dt.setMonth(dt.getMonth() + 1);
                else if (currentView === 'year') dt.setFullYear(dt.getFullYear() + 1);
                else dt.setDate(dt.getDate() + 7);
                var newDate = dt.toISOString().split('T')[0];
                window.location.href = '?view=' + currentView + '&date=' + newDate;
            });

            var calendarDatePicker = document.getElementById('calendarDatePicker');
            if (calendarDatePicker) {
                calendarDatePicker.addEventListener('change', function() {
                    window.location.href = '?view=day&date=' + this.value;
                });
            }

            var createSlotForm = document.getElementById('createSlotForm');
            if (createSlotForm) {
                createSlotForm.addEventListener('submit', function(event) {
                    var dateValue = document.getElementById('createSlotDate').value;
                    var startValue = document.getElementById('createStartTime').value;
                    if (isPastSlot(dateValue, startValue)) {
                        event.preventDefault();
                        window.alert('Cannot create a slot or appointment in the past.');
                    }
                });
            }

            document.getElementById('eventFilterSelect').addEventListener('change', function() {
                if (window.fcObj) {
                    window.fcObj.removeAllEvents();
                    var filtered = formatEventsForFC(rawEvents, this.value);
                    window.fcObj.addEventSource(filtered);
                }
            });
        });
    </script>
}
