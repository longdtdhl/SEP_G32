<!-- Enhanced Create Slot / Treatment Appointment Modal -->
<div class="modal fade" id="createSlotModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content schedule-modal" style="box-shadow:0 20px 40px rgba(0,0,0,0.15);">
            <form id="createSlotForm" method="post" asp-page-handler="CreateSlot">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark"><i class="bi bi-plus-circle me-2 text-teal" style="color:var(--mb-primary, #0f766e);"></i>Schedule Consultation / Treatment</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    
                    <!-- Inline Form Alert for Validation Feedback -->
                    <div id="slotFormAlert" class="alert alert-danger d-none rounded-3 py-2 small mb-3"></div>

                    <!-- Slot Type Segmented Control -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Schedule Mode</label>
                        <div class="btn-group w-100" role="group">
                            <input type="radio" class="btn-check" name="slotTypeToggle" id="typeGeneral" value="general" checked onchange="onSlotTypeChanged(this.value)">
                            <label class="btn btn-outline-primary py-2 fw-semibold" for="typeGeneral"><i class="bi bi-calendar-check me-1"></i>General Availability</label>
                            
                            <input type="radio" class="btn-check" name="slotTypeToggle" id="typeTreatment" value="treatment" onchange="onSlotTypeChanged(this.value)">
                            <label class="btn btn-outline-teal py-2 fw-semibold" for="typeTreatment"><i class="bi bi-journal-medical me-1"></i>Treatment Appointment</label>
                        </div>
                    </div>

                    <!-- Treatment Appointment Panel (Shown when Treatment Appointment mode active) -->
                    <div id="treatmentPatientContainer" class="d-none mb-3 p-3 bg-light rounded-3 border">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-dark"><i class="bi bi-person-fill me-1 text-teal" style="color:#0d9488;"></i>Select Patient (Active Treatment Cases Only)</label>
                            <select id="treatmentPatientSelect" class="form-select" onchange="onTreatmentPatientSelected(this)" style="border-radius:10px;">
                                <option value="">-- Choose Patient with Active Treatment --</option>
                                @foreach (var p in Model.EligiblePatients.GroupBy(x => x.PatientId).Select(g => g.First()))
                                {
                                    <option value="@p.PatientId">@p.PatientName</option>
                                }
                            </select>
                        </div>

                        <!-- Case selector if patient has multiple active cases -->
                        <div id="caseSelectContainer" class="mb-3 d-none">
                            <label class="form-label small fw-semibold text-dark"><i class="bi bi-box-seam me-1 text-teal" style="color:#0d9488;"></i>Select Active Treatment Case</label>
                            <select id="treatmentCaseSelect" class="form-select" onchange="onTreatmentCaseSelected(this)" style="border-radius:10px;">
                                <option value="">-- Select Active Case --</option>
                            </select>
                        </div>

                        <!-- Hidden fields for Treatment Appointment post -->
                        <input type="hidden" name="patientId" id="treatPatientId" />
                        <input type="hidden" name="treatmentCaseId" id="treatCaseId" />
                        <input type="hidden" name="treatmentSessionId" id="treatSessionId" />

                        <!-- Case Details Summary Card -->
                        <div id="patientTreatmentInfoCard" class="alert alert-teal mt-2 mb-0 py-2.5 px-3 small d-none" style="border-radius:10px; background:#f0fdfa; border:1px solid #99f6e4;">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <div><strong>Package/Case:</strong> <span id="infoPackageName" class="fw-semibold text-teal" style="color:#0d9488;"></span></div>
                                <span class="badge bg-teal text-white px-2 py-1" style="font-size:0.72rem; background:#0d9488;">Active</span>
                            </div>
                            <div class="row g-2 mt-1">
                                <div class="col-6"><strong>Completed Sessions:</strong> <span id="infoCompleted">0</span>/<span id="infoTotal">0</span></div>
                                <div class="col-6"><strong>Scheduling Session:</strong> #<span id="infoSessionNum">1</span></div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Date</label>
                        <input type="date" name="date" id="createSlotDate" class="form-control" value="@schedulableDateStr" min="@todayStr" required style="border-radius:10px;" />
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-secondary">Start Time</label>
                            <input type="time" name="startTime" id="createStartTime" step="300" min="07:00" max="22:55" class="form-control" value="08:00" required style="border-radius:10px;" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-secondary">End Time</label>
                            <input type="time" name="endTime" id="createEndTime" step="300" min="07:05" max="23:00" class="form-control" value="09:00" required style="border-radius:10px;" />
                        </div>
                    </div>
                    <div id="createSlotDurationPreview" class="small mt-1 mb-3 fw-semibold text-teal" style="color:var(--mb-primary, #0f766e);">Duration: 1 hour</div>
                    <div class="mb-3" id="maxPatientsContainer">
                        <label class="form-label small fw-semibold text-secondary">Max Patients Capacity</label>
                        <input type="number" name="maxPatients" id="createMaxPatients" class="form-control" value="1" min="1" max="10" style="border-radius:10px;" />
                    </div>
                    <div class="mb-0">
                        <label class="form-label small fw-semibold text-secondary">Notes (optional)</label>
                        <textarea name="notes" id="createSlotNotes" class="form-control" rows="2" placeholder="Internal note for this slot..." style="border-radius:10px; resize:none;"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="btnSaveSlot" class="btn btn-primary rounded-pill px-4" style="background:var(--mb-primary, #0f766e); border-color:var(--mb-primary, #0f766e);">Save Slot</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Configure Weekly Schedule Modal -->
<div class="modal fade" id="configureWeeklyModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content schedule-modal" style="box-shadow:0 20px 40px rgba(0,0,0,0.15);">
            <form method="post" asp-page-handler="GenerateWeeklySchedule" id="weeklyScheduleForm">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold text-dark"><i class="bi bi-gear-wide-connected me-2 text-teal" style="color:var(--mb-primary, #0f766e);"></i>Configure Weekly Working Schedule</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Working Days Checkboxes -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Working Days</label>
                        <div class="d-flex flex-wrap gap-2">
                            <div class="form-check form-check-inline weekly-day-option px-3 py-2 rounded-2">
                                <input class="form-check-input" type="checkbox" name="workingDays" value="Monday" id="wdMon" checked>
                                <label class="form-check-label fw-semibold small" for="wdMon">Mon</label>
                            </div>
                            <div class="form-check form-check-inline weekly-day-option px-3 py-2 rounded-2">
                                <input class="form-check-input" type="checkbox" name="workingDays" value="Tuesday" id="wdTue" checked>
                                <label class="form-check-label fw-semibold small" for="wdTue">Tue</label>
                            </div>
                            <div class="form-check form-check-inline weekly-day-option px-3 py-2 rounded-2">
                                <input class="form-check-input" type="checkbox" name="workingDays" value="Wednesday" id="wdWed" checked>
                                <label class="form-check-label fw-semibold small" for="wdWed">Wed</label>
                            </div>
                            <div class="form-check form-check-inline weekly-day-option px-3 py-2 rounded-2">
                                <input class="form-check-input" type="checkbox" name="workingDays" value="Thursday" id="wdThu" checked>
                                <label class="form-check-label fw-semibold small" for="wdThu">Thu</label>
                            </div>
                            <div class="form-check form-check-inline weekly-day-option px-3 py-2 rounded-2">
                                <input class="form-check-input" type="checkbox" name="workingDays" value="Friday" id="wdFri" checked>
                                <label class="form-check-label fw-semibold small" for="wdFri">Fri</label>
                            </div>
                            <div class="form-check form-check-inline weekly-day-option px-3 py-2 rounded-2">
                                <input class="form-check-input" type="checkbox" name="workingDays" value="Saturday" id="wdSat">
                                <label class="form-check-label fw-semibold small" for="wdSat">Sat</label>
                            </div>
                            <div class="form-check form-check-inline weekly-day-option px-3 py-2 rounded-2">
                                <input class="form-check-input" type="checkbox" name="workingDays" value="Sunday" id="wdSun">
                                <label class="form-check-label fw-semibold small" for="wdSun">Sun</label>
                            </div>
                        </div>
                    </div>

                    <!-- One continuous daily working range -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Daily Working Hours</label>
                        <div class="weekly-time-panel">
                            <div class="row g-3 align-items-end">
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold text-dark">Start time</label>
                                    <input type="time" name="startTime" id="weeklyStartTime" class="form-control" value="08:00" min="07:00" max="22:55" step="300" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold text-dark">End time</label>
                                    <input type="time" name="endTime" id="weeklyEndTime" class="form-control" value="17:00" min="07:05" max="23:00" step="300" required />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-semibold text-dark">Slot duration</label>
                                    <select name="slotDurationMinutes" id="weeklyDuration" class="form-select" required>
                                        <option value="30">30 minutes</option>
                                        <option value="45">45 minutes</option>
                                        <option value="60" selected>60 minutes</option>
                                        <option value="90">90 minutes</option>
                                        <option value="120">120 minutes</option>
                                    </select>
                                </div>
                            </div>
                            <div class="small text-secondary mt-2"><i class="bi bi-info-circle me-1"></i>Slots are generated continuously between 07:00 and 23:00 with no break interval.</div>
                        </div>
                    </div>

                    <!-- Slot Configurations -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Default Max Patients</label>
                            <input type="number" name="defaultMaxPatients" class="form-control" value="1" min="1" max="10" style="border-radius:10px;" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Start Date</label>
                            <input type="date" name="startDate" id="weeklyStartDate" class="form-control" value="@schedulableDateStr" min="@todayStr" required style="border-radius:10px;" />
                        </div>
                    </div>

                    <!-- Application Period -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Apply for (Weeks)</label>
                            <input type="number" name="weeksToApply" id="weeklyWeeks" class="form-control" value="4" min="1" max="52" required style="border-radius:10px;" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold text-secondary">Default Slot Notes (optional)</label>
                            <input type="text" name="defaultNotes" class="form-control" placeholder="e.g. Regular weekly consultation slot" style="border-radius:10px;" />
                        </div>
                    </div>

                    <!-- Live Preview Box -->
                    <div id="weeklyPreviewBox" class="p-3 bg-light rounded-3 border">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-bold small text-dark"><i class="bi bi-eye me-1"></i>Generation Preview:</span>
                            <button type="button" class="btn btn-sm btn-link text-decoration-none p-0" onclick="triggerWeeklyPreview()"><i class="bi bi-arrow-clockwise me-1"></i>Refresh Preview</button>
                        </div>
                        <div id="weeklyPreviewContent" class="small text-secondary">
                            Select working days and refresh to calculate new slots and conflicts.
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4" style="background:var(--mb-primary, #0f766e); border-color:var(--mb-primary, #0f766e);">Generate Slots</button>
                </div>
            </form>
        </div>
    </div>
</div>

