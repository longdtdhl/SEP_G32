@page
@model OPCBS.Web.Pages.Doctor.Schedules.DaysOffModel
@{ ViewData["Title"] = "Quản lý ngày nghỉ"; ViewData["UseDashboardLayout"] = true; }

<style>
    .daysoff-header { margin-bottom: 1.5rem; }
    .daysoff-header h1 { font-size: 1.4rem; font-weight: 700; margin: 0; }
    .daysoff-header p { margin: 4px 0 0; font-size: 0.85rem; color: #64748b; }

    .daysoff-card {
        background: white; border-radius: 16px; border: 1px solid rgba(78,139,112,0.08);
        overflow: hidden;
    }
    .daysoff-card .card-header-custom {
        padding: 1.25rem 1.5rem; border-bottom: 1px solid #f1f5f9;
        display: flex; align-items: center; gap: 0.75rem;
    }
    .daysoff-card .card-header-custom h5 { margin: 0; font-size: 1rem; font-weight: 600; color: #1e293b; }
    .daysoff-card .card-header-custom .icon-wrap {
        width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center;
        font-size: 1rem;
    }
    .daysoff-card .card-body-custom { padding: 1.5rem; }

    .form-label { font-size: 0.85rem; font-weight: 500; color: #374151; margin-bottom: 6px; }
    .form-control { border-radius: 10px; border: 1.5px solid #e2e8f0; font-size: 0.9rem; }
    .form-control:focus { border-color: var(--mb-primary); box-shadow: 0 0 0 3px rgba(78,139,112,0.1); }

    .btn-add {
        background: var(--mb-primary); color: white; border: none; border-radius: 12px; padding: 10px;
        font-weight: 600; font-size: 0.9rem; width: 100%; transition: all 0.2s;
    }
    .btn-add:hover { background: var(--mb-primary-dark); transform: translateY(-1px); box-shadow: 0 4px 12px rgba(78,139,112,0.3); }

    .dayoff-item {
        display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.25rem;
        border-bottom: 1px solid #f8fafc; transition: background 0.15s;
    }
    .dayoff-item:last-child { border-bottom: none; }
    .dayoff-item:hover { background: #f8fffe; }
    .dayoff-item .date-badge {
        display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px;
        background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px;
        font-size: 0.85rem; font-weight: 600; color: #991b1b;
    }
    .dayoff-item .reason { font-size: 0.85rem; color: #64748b; margin-top: 4px; }
    .btn-delete-dayoff {
        background: rgba(239,68,68,0.08); border: 1px solid rgba(239,68,68,0.2); border-radius: 8px;
        padding: 6px 10px; color: #ef4444; cursor: pointer; font-size: 0.8rem; transition: all 0.15s;
    }
    .btn-delete-dayoff:hover { background: #ef4444; color: white; }

    .empty-state {
        text-align: center; padding: 3rem 1rem; color: #94a3b8;
    }
    .empty-state i { font-size: 2.5rem; opacity: 0.3; display: block; margin-bottom: 0.75rem; }
</style>

<div class="daysoff-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="bi bi-calendar-x me-2" style="color:#ef4444;"></i>Quản lý ngày nghỉ</h1>
        <p>Đăng ký ngày nghỉ để tự động ẩn lịch khám trong những ngày đó</p>
    </div>
    <a asp-page="Index" class="btn btn-outline-secondary btn-sm" style="border-radius:10px; font-weight:500;">
        <i class="bi bi-arrow-left me-1"></i>Quay lại lịch
    </a>
</div>

@if (Model.Error != null) {
    <div class="alert alert-danger" style="border-radius:12px; border:none; background:linear-gradient(135deg,#fef2f2,#fecaca);">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.Error
    </div>
}
@if (TempData["Success"] is string suc) {
    <div class="alert alert-success" style="border-radius:12px; border:none; background:linear-gradient(135deg,#ecfdf5,#d1fae5);">
        <i class="bi bi-check-circle-fill me-2" style="color:#10b981;"></i>@suc
    </div>
}

<div class="row g-4">
    <!-- Add Form -->
    <div class="col-md-5">
        <div class="daysoff-card">
            <div class="card-header-custom">
                <div class="icon-wrap" style="background:rgba(239,68,68,0.1); color:#ef4444;">
                    <i class="bi bi-plus-circle"></i>
                </div>
                <h5>Thêm ngày nghỉ mới</h5>
            </div>
            <div class="card-body-custom">
                <form method="post">
                    <div class="mb-3">
                        <label class="form-label">Ngày bắt đầu <span class="text-danger">*</span></label>
                        <input type="date" asp-for="Input.StartDate" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ngày kết thúc</label>
                        <input type="date" asp-for="Input.EndDate" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <div class="form-text" style="font-size:0.75rem;">Để trống nếu chỉ nghỉ 1 ngày</div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Lý do</label>
                        <input asp-for="Input.Reason" class="form-control" placeholder="VD: Nghỉ phép, Hội thảo..." />
                    </div>
                    <button type="submit" class="btn-add">
                        <i class="bi bi-plus-lg me-1"></i>Thêm ngày nghỉ
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- List -->
    <div class="col-md-7">
        <div class="daysoff-card">
            <div class="card-header-custom">
                <div class="icon-wrap" style="background:rgba(99,102,241,0.1); color:#6366f1;">
                    <i class="bi bi-list-check"></i>
                </div>
                <h5>Danh sách ngày nghỉ</h5>
                @if (Model.DaysOff.Any())
                {
                    <span style="margin-left:auto; background:#f1f5f9; padding:2px 10px; border-radius:20px; font-size:0.75rem; font-weight:600; color:#475569;">
                        @Model.DaysOff.Count
                    </span>
                }
            </div>
            <div>
                @if (Model.DaysOff.Any())
                {
                    @foreach (var d in Model.DaysOff.OrderBy(x => x.StartDate))
                    {
                        <div class="dayoff-item">
                            <div>
                                <div class="date-badge">
                                    <i class="bi bi-calendar-x"></i>
                                    @d.StartDate.ToString("dd/MM/yyyy")
                                    @if (d.EndDate.Date != d.StartDate.Date) { <span>→ @d.EndDate.ToString("dd/MM/yyyy")</span> }
                                </div>
                                @if (!string.IsNullOrEmpty(d.Reason))
                                {
                                    <div class="reason"><i class="bi bi-chat-left-text me-1"></i>@d.Reason</div>
                                }
                            </div>
                            <form method="post" asp-page-handler="Delete" class="d-inline" onsubmit="return confirm('Xóa ngày nghỉ này?');">
                                <input type="hidden" name="id" value="@d.Id" />
                                <button type="submit" class="btn-delete-dayoff" title="Xóa">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </form>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-calendar-check"></i>
                        <p style="font-size:0.9rem; margin:0;">Chưa có ngày nghỉ nào được đăng ký</p>
                        <p style="font-size:0.8rem; margin:4px 0 0;">Thêm ngày nghỉ để tự động ẩn lịch khám</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
