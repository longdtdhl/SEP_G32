@page
@model OPCBS.Web.Pages.Doctor.ProfileModel
@{
    ViewData["Title"] = "Personal Profile";
    ViewData["UseDashboardLayout"] = true;
}

<div class="mb-page-header d-flex justify-content-between align-items-center">
    <h1><i class="bi bi-person-lines-fill me-2 text-primary"></i>Personal Profile</h1>
    @if (Model.Profile != null && !Model.IsEditing)
    {
        <a asp-page="Profile" asp-route-edit="true" class="btn btn-primary"><i class="bi bi-pencil-square me-1"></i>Edit profile</a>
    }
</div>

@if (Model.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-octagon me-1"></i>@Model.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (Model.Success != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-1"></i>@Model.Success
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Profile != null && !Model.IsEditing)
{
    <div class="row g-4">
        <!-- Sidebar Info Card -->
        <div class="col-lg-4 col-md-5">
            <div class="card border-0 shadow-sm text-center p-4">
                <div class="card-body">
                    <div class="mb-3 position-relative d-inline-block">
                        <div class="rounded-circle border p-1 bg-white shadow-sm" style="width: 120px; height: 120px; overflow: hidden; margin: 0 auto; display: flex; align-items: center; justify-content: center;">
                            @if (!string.IsNullOrEmpty(Model.Profile.AvatarUrl))
                            {
                                <img src="@Model.Profile.AvatarUrl" class="rounded-circle" style="width:100%; height:100%; object-fit:cover;" />
                            }
                            else
                            {
                                <i class="bi bi-person-fill text-muted" style="font-size: 4.5rem;"></i>
                            }
                        </div>
                    </div>
                    <h5 class="fw-bold mb-1">@Model.Profile.FullName</h5>
                    <p class="text-muted small mb-3">@Model.Profile.Email</p>

                    <div class="mb-3">
                        <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill fw-semibold"><i class="bi bi-shield-check me-1"></i>Doctor psyforlogy</span>
                    </div>

                    <hr />

                    <div class="text-start">
                        <div class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted small">Member ID:</span>
                            <span class="fw-medium small text-truncate" style="max-width: 150px;">@Model.Profile.Id</span>
                        </div>
                        <div class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted small">Date join:</span>
                            <span class="fw-medium small">@Model.Profile.CreatedAt.ToString("MM/dd/yyyy")</span>
                        </div>
                        <div class="d-flex justify-content-between py-2">
                            <span class="text-muted small">Search Visibility:</span>
                            <span class="badge @(Model.DoctorProfile?.IsVisible == true ? "bg-success" : "bg-secondary")">
                                @(Model.DoctorProfile?.IsVisible == true ? "Visible" : "Hidden")
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Detail Profile Card -->
        <div class="col-lg-8 col-md-7">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4 border-bottom pb-2 text-dark"><i class="bi bi-info-circle me-2 text-primary"></i>Personal Information</h5>
                    <div class="row g-3 mb-5">
                        <div class="col-md-6">
                            <div class="text-muted small mb-1">Full Name</div>
                            <div class="fw-semibold text-dark">@Model.Profile.FullName</div>
                        </div>
                        <div class="col-md-6">
                            <div class="text-muted small mb-1">Phone Number</div>
                            <div class="fw-semibold text-dark">@(Model.Profile.PhoneNumber ?? "-")</div>
                        </div>
                        <div class="col-md-6">
                            <div class="text-muted small mb-1">Gender</div>
                            <div class="fw-semibold text-dark">@(Model.Profile.Gender == "Male" ? "Male" : Model.Profile.Gender == "Female" ? "Female" : Model.Profile.Gender ?? "-")</div>
                        </div>
                        <div class="col-md-6">
                            <div class="text-muted small mb-1">Date of Birth</div>
                            <div class="fw-semibold text-dark">@(Model.Profile.DateOfBirth?.ToString("MM/dd/yyyy") ?? "-")</div>
                        </div>
                        <div class="col-12">
                            <div class="text-muted small mb-1">Address</div>
                            <div class="fw-semibold text-dark">@(Model.Profile.Address ?? "-")</div>
                        </div>
                    </div>

                    <h5 class="fw-bold mb-4 border-bottom pb-2 text-dark"><i class="bi bi-mortarboard me-2 text-primary"></i>Professional Profile</h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="text-muted small mb-1">Academic Title / Degree</div>
                            <div class="fw-semibold text-dark">@(Model.DoctorProfile?.Specialization ?? "-")</div>
                        </div>
                        <div class="col-md-6">
                            <div class="text-muted small mb-1">Years of Experience</div>
                            <div class="fw-semibold text-dark">@(Model.DoctorProfile?.ExperienceYears ?? 0) years</div>
                        </div>
                        <div class="col-12">
                            <div class="text-muted small mb-1">Specialization</div>
                            <div class="d-flex flex-wrap gap-2 mt-1">
                                @if (Model.DoctorProfile?.Specializations != null && Model.DoctorProfile.Specializations.Any())
                                {
                                    @foreach (var specName in Model.DoctorProfile.Specializations)
                                    {
                                        <span class="badge bg-light text-primary border border-primary border-opacity-25 px-3 py-2 rounded-3 small">@specName</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="text-muted small mb-1">About Me</div>
                            <div class="p-3 bg-light rounded-3 text-dark small" style="white-space: pre-line; line-height: 1.6;">
                                @(Model.DoctorProfile?.Bio ?? "No biography configured yet.")
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- Edit Mode Form -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form method="post">
                <h5 class="fw-bold mb-4 border-bottom pb-2 text-dark"><i class="bi bi-person-gear me-2 text-primary"></i>Personal Information</h5>
                <div class="row g-3 mb-5">
                    <div class="col-md-6">
                        <label class="form-label fw-medium small">Full Name <span class="text-danger">*</span></label>
                        <input asp-for="Input.FullName" class="form-control" placeholder="Enter full name" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-medium small">Phone Number</label>
                        <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Enter phone number" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-medium small">Gender</label>
                        <select asp-for="Input.Gender" class="form-select">
                            <option value="">-- Select Gender --</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-medium small">Date of Birth</label>
                        <input type="date" asp-for="Input.DateOfBirth" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-medium small">Address</label>
                        <input asp-for="Input.Address" class="form-control" placeholder="Enter address" />
                    </div>
                </div>

                <h5 class="fw-bold mb-4 border-bottom pb-2 text-dark"><i class="bi bi-mortarboard-fill me-2 text-primary"></i>Professional Profile</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-medium small">Academic Title / Degree <span class="text-danger">*</span></label>
                        <input asp-for="DoctorInput.ProfessionalTitle" class="form-control" placeholder="e.g. Clinical Psychology PhD" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-medium small">Years of Experience <span class="text-danger">*</span></label>
                        <input type="number" asp-for="DoctorInput.ExperienceYears" class="form-control" min="0" required />
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-medium small d-block">Professional Specialization <span class="text-danger">*</span></label>
                        <div class="row g-2 border rounded-3 p-3 bg-light m-0">
                            @foreach (var spec in Model.Specializations)
                            {
                                <div class="col-md-4 col-sm-6">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="SelectedSpecializations" value="@spec.Id" id="spec_@spec.Id"
                                               @(Model.SelectedSpecializations.Contains(spec.Id) ? "checked" : "") />
                                        <label class="form-check-label small" for="spec_@spec.Id">@spec.Name</label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-medium small">About Me <span class="text-danger">*</span></label>
                        <textarea asp-for="DoctorInput.Biography" class="form-control" rows="6" placeholder="Write a brief introduction about your experience, orientation work and professional therapy..." required></textarea>
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" role="switch" asp-for="DoctorInput.IsVisible" id="isVisibleSwitch" />
                            <label class="form-check-label fw-medium small text-dark" for="isVisibleSwitch">Agree to display this profile on the doctor search page for patients</label>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Save Changes</button>
                    <a asp-page="Profile" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
}
