@page
@model OPCBS.Web.Pages.Doctor.ProfileModel
@{
    ViewData["Title"] = "Doctor Profile";
    Layout = "_DashboardLayout";

    var doctorName = Model.Profile?.FullName ?? "Doctor";
    var avatarUrl = Model.Profile?.AvatarUrl;
    var initial = !string.IsNullOrWhiteSpace(doctorName) ? doctorName.Trim()[0].ToString().ToUpperInvariant() : "D";
    var isVisible = Model.DoctorProfile?.IsVisible == true;
    var fee = Model.DoctorProfile?.ConsultationFee ?? 0;
    var isFeePublic = Model.DoctorProfile?.IsConsultationFeePublic != false;
    var profileChecks = new[]
    {
        !string.IsNullOrWhiteSpace(Model.Profile?.FullName),
        !string.IsNullOrWhiteSpace(Model.Profile?.PhoneNumber),
        !string.IsNullOrWhiteSpace(Model.DoctorProfile?.Specialization),
        (Model.DoctorProfile?.ExperienceYears ?? 0) > 0,
        !string.IsNullOrWhiteSpace(Model.DoctorProfile?.Bio),
        Model.DoctorProfile?.Specializations?.Any() == true,
        !string.IsNullOrWhiteSpace(Model.DoctorProfile?.LicenseNumber),
        !string.IsNullOrWhiteSpace(Model.DoctorProfile?.ConsultationTypes)
    };
    var profileCompleteness = (int)Math.Round(profileChecks.Count(x => x) * 100m / profileChecks.Length);
}

<style>
    :root {
        --dp-primary: #0f766e;
        --dp-primary-strong: #0b5f59;
        --dp-primary-soft: #f0fdfa;
        --dp-primary-border: #ccfbf1;
        --dp-ink: #0f172a;
        --dp-muted: #64748b;
        --dp-line: #e2e8f0;
        --dp-panel: #ffffff;
    }

    .dp-shell { max-width: 1320px; margin: 0 auto; padding: 0.25rem 0.5rem 3.5rem; }

    .dp-hero {
        position: relative;
        overflow: hidden;
        border: 1px solid var(--dp-primary-border);
        border-radius: 18px;
        background: radial-gradient(circle at 12% 0%, rgba(20, 184, 166, 0.16), transparent 34%), linear-gradient(135deg, #ffffff 0%, #f0fdfa 62%, #ecfeff 100%);
        box-shadow: 0 18px 45px -30px rgba(15, 118, 110, 0.55), 0 2px 12px rgba(15, 23, 42, 0.04);
        padding: 1.35rem 1.5rem;
        margin-bottom: 1rem;
    }

    .dp-hero::before {
        content: "";
        position: absolute;
        inset: 0 auto 0 0;
        width: 5px;
        background: linear-gradient(180deg, #0d9488, #14b8a6);
    }

    .dp-avatar {
        width: 86px;
        height: 86px;
        border-radius: 22px;
        background: #ecfdf5;
        color: var(--dp-primary);
        border: 1px solid rgba(13, 148, 136, 0.22);
        box-shadow: 0 14px 26px -22px rgba(15, 118, 110, 0.9);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        font-weight: 850;
        overflow: hidden;
        flex-shrink: 0;
    }

    .dp-avatar img, .dp-edit-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .dp-title { font-size: clamp(1.55rem, 2.2vw, 2.15rem); font-weight: 850; letter-spacing: -0.02em; color: var(--dp-ink); margin: 0; line-height: 1.15; }
    .dp-subtitle { color: var(--dp-primary); font-weight: 700; margin: 0.35rem 0 0; }

    .dp-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        border-radius: 999px;
        padding: 0.32rem 0.65rem;
        font-size: 0.74rem;
        font-weight: 750;
        border: 1px solid transparent;
        white-space: nowrap;
    }

    .dp-chip.good { background: #dcfce7; color: #166534; border-color: #bbf7d0; }
    .dp-chip.muted { background: #f8fafc; color: #475569; border-color: #e2e8f0; }
    .dp-chip.warn { background: #fffbeb; color: #92400e; border-color: #fde68a; }

    .dp-action {
        border-radius: 10px;
        padding: 0.72rem 1rem;
        font-weight: 800;
        border: 1px solid var(--dp-primary);
        background: var(--dp-primary);
        color: #fff;
        box-shadow: 0 12px 26px -18px rgba(15, 118, 110, 0.9);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
    }

    .dp-action:hover { background: var(--dp-primary-strong); color: #fff; }

    .dp-card, .dp-form-card {
        background: var(--dp-panel);
        border: 1px solid var(--dp-line);
        border-radius: 16px;
        box-shadow: 0 12px 34px -30px rgba(15, 23, 42, 0.35), 0 1px 4px rgba(15, 23, 42, 0.04);
        overflow: hidden;
        margin-bottom: 1rem;
    }

    .dp-card-head {
        padding: 1rem 1.15rem;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        background: linear-gradient(180deg, #ffffff 0%, #fbfefd 100%);
    }

    .dp-card-title, .dp-form-title {
        margin: 0;
        color: var(--dp-ink);
        font-size: 0.98rem;
        font-weight: 850;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .dp-card-body { padding: 1.15rem; }
    .dp-stat-grid, .dp-info-grid { display: grid; gap: 0.85rem; }
    .dp-stat-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.7rem; }
    .dp-info-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }

    .dp-stat, .dp-info {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 0.82rem 0.9rem;
    }

    .dp-info { min-height: 76px; }
    .dp-info.full { grid-column: 1 / -1; }
    .dp-stat-label, .dp-info-label { color: var(--dp-muted); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.035em; font-weight: 800; margin-bottom: 0.32rem; }
    .dp-stat-value { color: var(--dp-ink); font-size: 1rem; font-weight: 850; margin-top: 0.2rem; }
    .dp-info-value { color: var(--dp-ink); font-size: 0.91rem; line-height: 1.55; font-weight: 650; word-break: break-word; white-space: pre-line; }
    .dp-specialty-list { display: flex; flex-wrap: wrap; gap: 0.45rem; }
    .dp-specialty { border-radius: 999px; padding: 0.35rem 0.65rem; background: #ecfdf5; color: var(--dp-primary); border: 1px solid #bbf7d0; font-size: 0.74rem; font-weight: 750; }
    .dp-progress-track { width: 100%; height: 8px; border-radius: 999px; background: #e2e8f0; overflow: hidden; }
    .dp-progress-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg, #0d9488, #14b8a6); }

    .dp-alert { border-radius: 12px; border: 1px solid; padding: 0.85rem 1rem; margin-bottom: 1rem; }
    .dp-alert.success { background: #ecfdf5; border-color: #a7f3d0; color: #065f46; }
    .dp-alert.error { background: #fef2f2; border-color: #fecaca; color: #991b1b; }

    .dp-form-section { padding: 1.2rem; border-bottom: 1px solid #f1f5f9; }
    .dp-form-title { margin-bottom: 1rem; }
    .dp-form-card .form-control, .dp-form-card .form-select { border-radius: 10px; border-color: #cbd5e1; min-height: 44px; }
    .dp-form-card textarea.form-control { min-height: auto; }
    .dp-form-card .form-label { color: #334155; font-size: 0.8rem; font-weight: 750; margin-bottom: 0.35rem; }
    .dp-check-panel { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 14px; padding: 1rem; }
    .dp-edit-avatar { width: 92px; height: 92px; border-radius: 22px; background: #f8fafc; border: 1px solid #dbeafe; overflow: hidden; display: flex; align-items: center; justify-content: center; color: var(--dp-muted); flex-shrink: 0; }
    .dp-edit-shell { background: linear-gradient(180deg, #ffffff 0%, #fbfefd 100%); }
    .dp-edit-section-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1rem;
    }
    .dp-edit-section-kicker {
        color: var(--dp-muted);
        font-size: 0.78rem;
        margin: 0.25rem 0 0;
        line-height: 1.45;
    }
    .dp-fee-panel {
        border: 1px solid #ccfbf1;
        border-radius: 16px;
        background: linear-gradient(135deg, #f0fdfa 0%, #ffffff 72%);
        padding: 1rem;
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.9);
    }
    .dp-fee-visibility {
        min-height: 100%;
        border: 1px solid #dbeafe;
        border-radius: 14px;
        background: rgba(255,255,255,0.78);
        padding: 0.95rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }
    .dp-fee-visibility .form-check-input {
        width: 3rem;
        height: 1.55rem;
        cursor: pointer;
    }
    .dp-fee-note {
        color: #64748b;
        font-size: 0.76rem;
        line-height: 1.45;
    }

    @@media (max-width: 991.98px) {
        .dp-info-grid, .dp-stat-grid { grid-template-columns: 1fr; }
        .dp-hero { padding: 1.15rem; }
    }
</style>

<div class="dp-shell">
    @if (Model.Error != null)
    {
        <div class="dp-alert error d-flex align-items-center justify-content-between gap-3">
            <span><i class="bi bi-exclamation-octagon me-2"></i>@Model.Error</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (Model.Success != null)
    {
        <div class="dp-alert success d-flex align-items-center justify-content-between gap-3">
            <span><i class="bi bi-check-circle me-2"></i>@Model.Success</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Profile != null && !Model.IsEditing)
    {
        <section class="dp-hero">
            <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap">
                <div class="d-flex align-items-center gap-3">
                    <div class="dp-avatar">
                        @if (!string.IsNullOrWhiteSpace(avatarUrl))
                        {
                            <img src="@avatarUrl" alt="@doctorName avatar" />
                        }
                        else
                        {
                            @initial
                        }
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
                            <span class="dp-chip @(isVisible ? "good" : "muted")">
                                <i class="bi @(isVisible ? "bi-eye-fill" : "bi-eye-slash")"></i>
                                @(isVisible ? "Public profile visible" : "Public profile hidden")
                            </span>
                            <span class="dp-chip good"><i class="bi bi-shield-check"></i>Doctor account</span>
                        </div>
                        <h1 class="dp-title">@doctorName</h1>
                        <p class="dp-subtitle">@(Model.DoctorProfile?.Specialization ?? "Professional title not updated")</p>
                        <div class="d-flex align-items-center gap-2 flex-wrap mt-2 text-muted" style="font-size:0.84rem;">
                            <span><i class="bi bi-envelope me-1"></i>@Model.Profile.Email</span>
                            <span><i class="bi bi-telephone me-1"></i>@(Model.Profile.PhoneNumber ?? "Phone not updated")</span>
                        </div>
                    </div>
                </div>
                <a asp-page="Profile" asp-route-edit="true" class="dp-action">
                    <i class="bi bi-pencil-square"></i>Edit Profile
                </a>
            </div>
        </section>

        <div class="row g-3">
            <div class="col-xl-4 col-lg-5">
                <div class="dp-card">
                    <div class="dp-card-head">
                        <h2 class="dp-card-title"><i class="bi bi-activity" style="color:var(--dp-primary);"></i>Profile Readiness</h2>
                        <span class="dp-chip @(profileCompleteness >= 75 ? "good" : "warn")">@profileCompleteness%</span>
                    </div>
                    <div class="dp-card-body">
                        <div class="dp-progress-track mb-3">
                            <div class="dp-progress-fill" style="width:@profileCompleteness%;"></div>
                        </div>
                        <div class="dp-stat-grid">
                            <div class="dp-stat">
                                <div class="dp-stat-label">Experience</div>
                                <div class="dp-stat-value">@((Model.DoctorProfile?.ExperienceYears ?? 0)) yrs</div>
                            </div>
                            <div class="dp-stat">
                                <div class="dp-stat-label">Fee</div>
                                <div class="dp-stat-value">@(fee > 0 ? $"{fee:N0} VND" : "Contact")</div>
                                <div class="text-muted" style="font-size:0.7rem;">@(isFeePublic ? "Visible publicly" : "Hidden publicly")</div>
                            </div>
                            <div class="dp-stat">
                                <div class="dp-stat-label">Joined</div>
                                <div class="dp-stat-value">@Model.Profile.CreatedAt.ToString("MMM yyyy")</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="dp-card">
                    <div class="dp-card-head">
                        <h2 class="dp-card-title"><i class="bi bi-person-vcard" style="color:var(--dp-primary);"></i>Account Snapshot</h2>
                    </div>
                    <div class="dp-card-body">
                        <div class="dp-info-grid" style="grid-template-columns:1fr;">
                            <div class="dp-info">
                                <div class="dp-info-label">Member ID</div>
                                <div class="dp-info-value">@Model.Profile.Id</div>
                            </div>
                            <div class="dp-info">
                                <div class="dp-info-label">License Number</div>
                                <div class="dp-info-value">@(Model.DoctorProfile?.LicenseNumber ?? "Not updated")</div>
                            </div>
                            <div class="dp-info">
                                <div class="dp-info-label">License Expiration</div>
                                <div class="dp-info-value">@(Model.DoctorProfile?.LicenseExpiryDate?.ToString("MMM dd, yyyy") ?? "Not updated")</div>
                            </div>
                            <div class="dp-info">
                                <div class="dp-info-label">Languages</div>
                                <div class="dp-info-value">@(Model.DoctorProfile?.Languages ?? "Not updated")</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-8 col-lg-7">
                <div class="dp-card">
                    <div class="dp-card-head">
                        <h2 class="dp-card-title"><i class="bi bi-info-circle" style="color:var(--dp-primary);"></i>Personal Information</h2>
                    </div>
                    <div class="dp-card-body">
                        <div class="dp-info-grid">
                            <div class="dp-info">
                                <div class="dp-info-label">Full Name</div>
                                <div class="dp-info-value">@Model.Profile.FullName</div>
                            </div>
                            <div class="dp-info">
                                <div class="dp-info-label">Phone Number</div>
                                <div class="dp-info-value">@(Model.Profile.PhoneNumber ?? "Not updated")</div>
                            </div>
                            <div class="dp-info">
                                <div class="dp-info-label">Gender</div>
                                <div class="dp-info-value">@(Model.DoctorProfile?.Gender ?? "Not updated")</div>
                            </div>
                            <div class="dp-info">
                                <div class="dp-info-label">Date of Birth</div>
                                <div class="dp-info-value">@(Model.DoctorProfile?.DateOfBirth?.ToString("MMM dd, yyyy") ?? "Not updated")</div>
                            </div>
                            <div class="dp-info full">
                                <div class="dp-info-label">Address</div>
                                <div class="dp-info-value">@(Model.DoctorProfile?.Address ?? "Not updated")</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="dp-card">
                    <div class="dp-card-head">
                        <h2 class="dp-card-title"><i class="bi bi-mortarboard" style="color:var(--dp-primary);"></i>Professional Profile</h2>
                    </div>
                    <div class="dp-card-body">
                        <div class="dp-info-grid">
                            <div class="dp-info">
                                <div class="dp-info-label">Academic Title / Degree</div>
                                <div class="dp-info-value">@(Model.DoctorProfile?.Specialization ?? "Not updated")</div>
                            </div>
                            <div class="dp-info">
                                <div class="dp-info-label">Consultation Formats</div>
                                <div class="dp-info-value">@(Model.DoctorProfile?.ConsultationTypes ?? "Not updated")</div>
                            </div>
                            <div class="dp-info full">
                                <div class="dp-info-label">Specializations</div>
                                @if (Model.DoctorProfile?.Specializations != null && Model.DoctorProfile.Specializations.Any())
                                {
                                    <div class="dp-specialty-list">
                                        @foreach (var specName in Model.DoctorProfile.Specializations)
                                        {
                                            <span class="dp-specialty">@specName</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="dp-info-value">Not updated</div>
                                }
                            </div>
                            <div class="dp-info">
                                <div class="dp-info-label">Education</div>
                                <div class="dp-info-value">@(Model.DoctorProfile?.Education ?? "Not updated")</div>
                            </div>
                            <div class="dp-info">
                                <div class="dp-info-label">Career Background</div>
                                <div class="dp-info-value">@(Model.DoctorProfile?.CareerBackground ?? "Not updated")</div>
                            </div>
                            <div class="dp-info full">
                                <div class="dp-info-label">Treatment & Care Approach</div>
                                <div class="dp-info-value">@(Model.DoctorProfile?.CareApproach ?? "Not updated")</div>
                            </div>
                            <div class="dp-info full">
                                <div class="dp-info-label">About Me</div>
                                <div class="dp-info-value">@(Model.DoctorProfile?.Bio ?? "No biography configured yet.")</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <section class="dp-hero">
            <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap">
                <div>
                    <span class="dp-chip good mb-2"><i class="bi bi-person-gear"></i>Profile editing</span>
                    <h1 class="dp-title">Update Your Doctor Profile</h1>
                    <p class="dp-subtitle">Keep your public profile accurate, credible, and easy for patients to trust.</p>
                </div>
                <a asp-page="Profile" class="dp-action" style="background:#ffffff; color:var(--dp-primary);">
                    <i class="bi bi-arrow-left"></i>Back to Profile
                </a>
            </div>
        </section>

        <div class="dp-form-card dp-edit-shell">
            <form method="post" enctype="multipart/form-data">
                <div class="dp-form-section">
                    <div class="dp-edit-section-head">
                        <div>
                            <h2 class="dp-form-title mb-0"><i class="bi bi-person-circle" style="color:var(--dp-primary);"></i>Personal Information</h2>
                            <p class="dp-edit-section-kicker">Keep your identity and contact details accurate for patients and clinic operations.</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3 mb-4 flex-wrap">
                        <div class="dp-edit-avatar">
                            @if (!string.IsNullOrWhiteSpace(Model.Profile?.AvatarUrl))
                            {
                                <img id="avatar-preview" src="@Model.Profile.AvatarUrl" alt="Avatar preview" />
                            }
                            else
                            {
                                <img id="avatar-preview" src="" alt="Avatar preview" style="display:none;" />
                                <i id="avatar-placeholder" class="bi bi-person-fill" style="font-size:2.8rem;"></i>
                            }
                        </div>
                        <div style="min-width:260px; flex:1;">
                            <label class="form-label">Profile Avatar</label>
                            <input type="file" asp-for="AvatarFile" class="form-control" accept=".jpg,.jpeg,.png,.webp" onchange="previewAvatar(this)" />
                            <div class="form-text">JPG, PNG, WEBP. Maximum 2MB.</div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Full Name <span class="text-danger">*</span></label>
                            <input asp-for="Input.FullName" class="form-control" placeholder="Enter full name" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Phone Number</label>
                            <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Enter phone number" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Gender</label>
                            <select asp-for="DoctorInput.Gender" class="form-select">
                                <option value="">Select Gender</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Date of Birth</label>
                            <input type="date" asp-for="DoctorInput.DateOfBirth" class="form-control" value='@(Model.DoctorInput.DateOfBirth?.ToString("yyyy-MM-dd"))' />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Address</label>
                            <input asp-for="DoctorInput.Address" class="form-control" placeholder="Clinic address or professional contact address" />
                        </div>
                    </div>
                </div>

                <div class="dp-form-section">
                    <div class="dp-edit-section-head">
                        <div>
                            <h2 class="dp-form-title mb-0"><i class="bi bi-mortarboard-fill" style="color:var(--dp-primary);"></i>Professional Profile</h2>
                            <p class="dp-edit-section-kicker">This information shapes your public doctor profile and helps patients decide with confidence.</p>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Academic Title / Degree <span class="text-danger">*</span></label>
                            <input asp-for="DoctorInput.ProfessionalTitle" class="form-control" placeholder="e.g. Clinical Psychology PhD" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Years of Experience <span class="text-danger">*</span></label>
                            <input type="number" asp-for="DoctorInput.ExperienceYears" class="form-control" min="0" required />
                        </div>

                        <div class="col-12">
                            <label class="form-label d-block">Professional Specialization <span class="text-danger">*</span></label>
                            <div class="dp-check-panel">
                                <div class="row g-2">
                                    @foreach (var spec in Model.Specializations)
                                    {
                                        <div class="col-xl-3 col-md-4 col-sm-6">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="SelectedSpecializations" value="@spec.Id" id="spec_@spec.Id" @(Model.SelectedSpecializations.Contains(spec.Id) ? "checked" : "") />
                                                <label class="form-check-label small" for="spec_@spec.Id">@spec.Name</label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Education</label>
                            <input asp-for="DoctorInput.Education" class="form-control" placeholder="e.g. Master of Psychology" />
                        </div>
                        <div class="col-12">
                            <div class="dp-fee-panel">
                                <div class="row g-3 align-items-stretch">
                                    <div class="col-lg-5">
                                        <label class="form-label">Consultation Fee (VND) <span class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <span class="input-group-text" style="border-radius:10px 0 0 10px; background:#ecfdf5; color:#0f766e; font-weight:800;">VND</span>
                                            <input type="number" asp-for="DoctorInput.ConsultationFee" class="form-control" min="0" required style="border-radius:0 10px 10px 0;" />
                                        </div>
                                        <div class="dp-fee-note mt-2">Used internally for appointment and schedule pricing.</div>
                                    </div>
                                    <div class="col-lg-7">
                                        <div class="dp-fee-visibility">
                                            <div>
                                                <div class="fw-bold text-dark"><i class="bi bi-eye me-1" style="color:var(--dp-primary);"></i>Show fee on public doctor profile</div>
                                                <div class="dp-fee-note mt-1">Turn this off if you prefer patients to contact you before seeing pricing.</div>
                                            </div>
                                            <div class="form-check form-switch m-0">
                                                <input class="form-check-input" type="checkbox" role="switch" asp-for="DoctorInput.IsConsultationFeePublic" id="feeVisibilitySwitch" />
                                                <label class="visually-hidden" for="feeVisibilitySwitch">Show consultation fee publicly</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Spoken Languages</label>
                            <input asp-for="DoctorInput.Languages" class="form-control" placeholder="e.g. English, Vietnamese" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Consultation Types</label>
                            <input asp-for="DoctorInput.ConsultationTypes" class="form-control" placeholder="e.g. Online, In-person" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">License Number</label>
                            <input asp-for="DoctorInput.LicenseNumber" class="form-control" placeholder="e.g. LIC-US-2024-001" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">License Expiration Date</label>
                            <input type="date" asp-for="DoctorInput.LicenseExpiryDate" class="form-control" value='@(Model.DoctorInput.LicenseExpiryDate?.ToString("yyyy-MM-dd"))' />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Professional Background / Career History</label>
                            <textarea asp-for="DoctorInput.CareerBackground" class="form-control" rows="3" placeholder="Describe your clinical career, roles, and experience..."></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Care Approach / Strengths</label>
                            <textarea asp-for="DoctorInput.CareApproach" class="form-control" rows="3" placeholder="Describe your therapeutic approach and strengths..."></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label">About Me <span class="text-danger">*</span></label>
                            <textarea asp-for="DoctorInput.Biography" class="form-control" rows="6" placeholder="Write a patient-friendly introduction about your experience and counseling style..." required></textarea>
                        </div>
                        <div class="col-12">
                            <div class="p-3 rounded-3" style="background:#f0fdfa; border:1px solid #ccfbf1;">
                                <div class="form-check form-switch m-0">
                                    <input class="form-check-input" type="checkbox" role="switch" asp-for="DoctorInput.IsVisible" id="isVisibleSwitch" />
                                    <label class="form-check-label fw-semibold text-dark" for="isVisibleSwitch">Display this profile on the doctor search page for patients</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="p-3 d-flex gap-2 justify-content-end flex-wrap">
                    <a asp-page="Profile" class="btn btn-outline-secondary" style="border-radius:10px; font-weight:700;">Cancel</a>
                    <button type="submit" class="dp-action border-0">
                        <i class="bi bi-save2"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    }
</div>

@section Scripts {
<script>
    function previewAvatar(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                var preview = document.getElementById('avatar-preview');
                var placeholder = document.getElementById('avatar-placeholder');
                preview.src = e.target.result;
                preview.style.display = 'block';
                if (placeholder) placeholder.style.display = 'none';
            };
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>
}
