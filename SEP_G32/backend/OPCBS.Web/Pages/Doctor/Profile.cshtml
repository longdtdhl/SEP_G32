@page
@model OPCBS.Web.Pages.Doctor.ProfileModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    ViewData["UseDashboardLayout"] = true;
}

<div class="mb-page-header d-flex justify-content-between align-items-center">
    <h1><i class="bi bi-person-lines-fill me-2 text-primary"></i>Hồ sơ cá nhân</h1>
    @if (Model.Profile != null && !Model.IsEditing)
    {
        <a asp-page="Profile" asp-route-edit="true" class="btn btn-primary"><i class="bi bi-pencil-square me-1"></i>Chỉnh sửa hồ sơ</a>
    }
</div>

@if (Model.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-octagon me-1"></i>@Model.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (Model.Success != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-1"></i>@Model.Success
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Profile != null && !Model.IsEditing)
{
    <div class="row g-4">
        <!-- Sidebar Info Card -->
        <div class="col-lg-4 col-md-5">
            <div class="card border-0 shadow-sm text-center p-4">
                <div class="card-body">
                    <div class="mb-3 position-relative d-inline-block">
                        <div class="rounded-circle border p-1 bg-white shadow-sm" style="width: 120px; height: 120px; overflow: hidden; margin: 0 auto; display: flex; align-items: center; justify-content: center;">
                            @if (!string.IsNullOrEmpty(Model.Profile.AvatarUrl))
                            {
                                <img src="@Model.Profile.AvatarUrl" class="rounded-circle" style="width:100%; height:100%; object-fit:cover;" />
                            }
                            else
                            {
                                <i class="bi bi-person-fill text-muted" style="font-size: 4.5rem;"></i>
                            }
                        </div>
                    </div>
                    <h5 class="fw-bold mb-1">@Model.Profile.FullName</h5>
                    <p class="text-muted small mb-3">@Model.Profile.Email</p>
                    
                    <div class="mb-3">
                        <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill fw-semibold"><i class="bi bi-shield-check me-1"></i>Bác sĩ tâm lý</span>
                    </div>

                    <hr />

                    <div class="text-start">
                        <div class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted small">Mã thành viên:</span>
                            <span class="fw-medium small text-truncate" style="max-width: 150px;">@Model.Profile.Id</span>
                        </div>
                        <div class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted small">Ngày tham gia:</span>
                            <span class="fw-medium small">@Model.Profile.CreatedAt.ToString("dd/MM/yyyy")</span>
                        </div>
                        <div class="d-flex justify-content-between py-2">
                            <span class="text-muted small">Hiển thị tìm kiếm:</span>
                            <span class="badge @(Model.DoctorProfile?.IsVisible == true ? "bg-success" : "bg-secondary")">
                                @(Model.DoctorProfile?.IsVisible == true ? "Đang hiển thị" : "Đang ẩn")
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Detail Profile Card -->
        <div class="col-lg-8 col-md-7">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4 border-bottom pb-2 text-dark"><i class="bi bi-info-circle me-2 text-primary"></i>Thông tin cá nhân</h5>
                    <div class="row g-3 mb-5">
                        <div class="col-md-6">
                            <div class="text-muted small mb-1">Họ và tên</div>
                            <div class="fw-semibold text-dark">@Model.Profile.FullName</div>
                        </div>
                        <div class="col-md-6">
                            <div class="text-muted small mb-1">Số điện thoại</div>
                            <div class="fw-semibold text-dark">@(Model.Profile.PhoneNumber ?? "-")</div>
                        </div>
                        <div class="col-md-6">
                            <div class="text-muted small mb-1">Giới tính</div>
                            <div class="fw-semibold text-dark">@(Model.Profile.Gender == "Male" ? "Nam" : Model.Profile.Gender == "Female" ? "Nữ" : Model.Profile.Gender ?? "-")</div>
                        </div>
                        <div class="col-md-6">
                            <div class="text-muted small mb-1">Ngày sinh</div>
                            <div class="fw-semibold text-dark">@(Model.Profile.DateOfBirth?.ToString("dd/MM/yyyy") ?? "-")</div>
                        </div>
                        <div class="col-12">
                            <div class="text-muted small mb-1">Địa chỉ</div>
                            <div class="fw-semibold text-dark">@(Model.Profile.Address ?? "-")</div>
                        </div>
                    </div>

                    <h5 class="fw-bold mb-4 border-bottom pb-2 text-dark"><i class="bi bi-mortarboard me-2 text-primary"></i>Hồ sơ chuyên môn</h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="text-muted small mb-1">Học hàm / Học vị / Chức danh</div>
                            <div class="fw-semibold text-dark">@(Model.DoctorProfile?.Specialization ?? "-")</div>
                        </div>
                        <div class="col-md-6">
                            <div class="text-muted small mb-1">Số năm kinh nghiệm</div>
                            <div class="fw-semibold text-dark">@(Model.DoctorProfile?.ExperienceYears ?? 0) năm</div>
                        </div>
                        <div class="col-12">
                            <div class="text-muted small mb-1">Chuyên khoa</div>
                            <div class="d-flex flex-wrap gap-2 mt-1">
                                @if (Model.DoctorProfile?.Specializations != null && Model.DoctorProfile.Specializations.Any())
                                {
                                    @foreach (var specName in Model.DoctorProfile.Specializations)
                                    {
                                        <span class="badge bg-light text-primary border border-primary border-opacity-25 px-3 py-2 rounded-3 small">@specName</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="text-muted small mb-1">Giới thiệu bản thân</div>
                            <div class="p-3 bg-light rounded-3 text-dark small" style="white-space: pre-line; line-height: 1.6;">
                                @(Model.DoctorProfile?.Bio ?? "Chưa cấu hình giới thiệu bản thân.")
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- Edit Mode Form -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form method="post">
                <h5 class="fw-bold mb-4 border-bottom pb-2 text-dark"><i class="bi bi-person-gear me-2 text-primary"></i>Thông tin cá nhân</h5>
                <div class="row g-3 mb-5">
                    <div class="col-md-6">
                        <label class="form-label fw-medium small">Họ tên <span class="text-danger">*</span></label>
                        <input asp-for="Input.FullName" class="form-control" placeholder="Nhập họ tên" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-medium small">Số điện thoại</label>
                        <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Nhập số điện thoại" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-medium small">Giới tính</label>
                        <select asp-for="Input.Gender" class="form-select">
                            <option value="">-- Chọn giới tính --</option>
                            <option value="Male">Nam</option>
                            <option value="Female">Nữ</option>
                            <option value="Other">Khác</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-medium small">Ngày sinh</label>
                        <input type="date" asp-for="Input.DateOfBirth" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-medium small">Địa chỉ</label>
                        <input asp-for="Input.Address" class="form-control" placeholder="Nhập địa chỉ" />
                    </div>
                </div>

                <h5 class="fw-bold mb-4 border-bottom pb-2 text-dark"><i class="bi bi-mortarboard-fill me-2 text-primary"></i>Hồ sơ chuyên môn</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-medium small">Học hàm / Học vị / Chức danh <span class="text-danger">*</span></label>
                        <input asp-for="DoctorInput.ProfessionalTitle" class="form-control" placeholder="Ví dụ: Tiến sĩ Tâm lý lâm sàng" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-medium small">Số năm kinh nghiệm <span class="text-danger">*</span></label>
                        <input type="number" asp-for="DoctorInput.ExperienceYears" class="form-control" min="0" required />
                    </div>
                    
                    <div class="col-12">
                        <label class="form-label fw-medium small d-block">Chuyên khoa chuyên môn <span class="text-danger">*</span></label>
                        <div class="row g-2 border rounded-3 p-3 bg-light m-0">
                            @foreach (var spec in Model.Specializations)
                            {
                                <div class="col-md-4 col-sm-6">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="SelectedSpecializations" value="@spec.Id" id="spec_@spec.Id" 
                                            @(Model.SelectedSpecializations.Contains(spec.Id) ? "checked" : "") />
                                        <label class="form-check-label small" for="spec_@spec.Id">@spec.Name</label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-medium small">Giới thiệu bản thân <span class="text-danger">*</span></label>
                        <textarea asp-for="DoctorInput.Biography" class="form-control" rows="6" placeholder="Viết giới thiệu tóm tắt về kinh nghiệm, định hướng làm việc và chuyên môn trị liệu..." required></textarea>
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" role="switch" name="DoctorInput.IsVisible" value="true" id="isVisibleSwitch" @(Model.DoctorInput.IsVisible == true ? "checked" : "") />
                            <input type="hidden" name="DoctorInput.IsVisible" value="false" />
                            <label class="form-check-label fw-medium small text-dark" for="isVisibleSwitch">Đồng ý hiển thị hồ sơ này trên trang tìm kiếm bác sĩ dành cho bệnh nhân</label>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Lưu thay đổi</button>
                    <a asp-page="Profile" class="btn btn-outline-secondary">Hủy bỏ</a>
                </div>
            </form>
        </div>
    </div>
}
