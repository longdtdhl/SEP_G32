@page
@model OPCBS.Web.Pages.Doctor.TreatmentPackages.IndexModel
@{
    ViewData["Title"] = "Treatment Packages";
    Layout = "_DashboardLayout";
    var visiblePackages = Model.Packages.Where(p => p.Status != "Cancelled" && p.Status != "Rejected").ToList();
}

<style>
    .pkg-card {
        background: white; border-radius: 16px; border: 1px solid #f1f5f9;
        overflow: hidden; transition: all 0.2s; box-shadow: 0 1px 4px rgba(0,0,0,0.04);
    }
    .pkg-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.08); transform: translateY(-2px); }
    .pkg-card-header { padding: 1.25rem; border-bottom: 1px solid #f8fafc; }
    .pkg-card-body { padding: 1rem 1.25rem; }
    .pkg-card-footer { padding: 0.75rem 1.25rem; border-top: 1px solid #f8fafc; background: #fafbfc; }
    .pkg-status { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 20px; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.3px; }
    .pkg-status.active { background: #dcfce7; color: #15803d; }
    .pkg-status.draft { background: #fef3c7; color: #b45309; }
    .pkg-status.archived { background: #f1f5f9; color: #64748b; }
    .pkg-meta-row { display: flex; align-items: center; gap: 8px; font-size: 0.82rem; color: #64748b; margin-bottom: 6px; }
    .pkg-meta-row i { color: var(--mb-primary); font-size: 0.85rem; width: 18px; text-align: center; }
    .pkg-empty { text-align: center; padding: 4rem 2rem; background: white; border-radius: 16px; border: 2px dashed #e2e8f0; }
</style>

<!-- Page Header -->
<div class="mb-page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 style="font-size:1.4rem; font-weight:700; margin:0;">
            <i class="bi bi-box-seam-fill me-2" style="color:var(--mb-primary);"></i>Treatment Packages
        </h1>
        <p style="margin:4px 0 0; font-size:0.85rem; color:#64748b;">Manage your standard treatment package templates</p>
    </div>
    <a asp-page="Create" class="btn btn-primary px-3 py-2 d-flex align-items-center gap-2"
       style="border-radius:10px; background:var(--mb-primary); border-color:var(--mb-primary); font-weight:600;">
        <i class="bi bi-plus-lg"></i>Create New Package
    </a>
</div>

@if (Model.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show" style="border-radius:12px; border:none;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" style="border-radius:12px; border:none;">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Package Cards Grid -->
<div class="row g-3">
    @if (visiblePackages.Any())
    {
        @foreach (var pkg in visiblePackages.OrderByDescending(p => p.CreatedAt))
        {
            var statusClass = pkg.Status == "Active" ? "active" : pkg.Status == "Draft" ? "draft" : "archived";
            <div class="col-md-6 col-xl-4">
                <div class="pkg-card h-100 d-flex flex-column justify-content-between">
                    <div>
                        <!-- Header -->
                        <div class="pkg-card-header d-flex justify-content-between align-items-start">
                            <h6 style="font-weight:700; font-size:1rem; color:#1e293b; margin:0;" class="text-truncate" title="@pkg.Title">@pkg.Title</h6>
                            <span class="pkg-status @statusClass">@pkg.Status</span>
                        </div>
                        <!-- Body -->
                        <div class="pkg-card-body">
                            @if (!string.IsNullOrEmpty(pkg.Description))
                            {
                                <p style="font-size:0.83rem; color:#64748b; margin-bottom:12px; line-height:1.5; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">@pkg.Description</p>
                            }
                            <div class="pkg-meta-row"><i class="bi bi-calendar2-check"></i><span>Sessions: <strong>@pkg.TotalSessions sessions</strong></span></div>
                            <div class="pkg-meta-row"><i class="bi bi-hourglass-split"></i><span>Duration: <strong>@pkg.ValidityDays days</strong></span></div>
                            <div class="pkg-meta-row"><i class="bi bi-cash-stack"></i><span>Price: <strong style="color:var(--mb-primary);">@pkg.Price.ToString("N0") ₫</strong></span></div>
                            @if (!string.IsNullOrEmpty(pkg.TargetOutcome))
                            {
                                <div class="pkg-meta-row"><i class="bi bi-trophy"></i><span class="text-truncate">Goal: @pkg.TargetOutcome</span></div>
                            }
                        </div>
                    </div>
                    <!-- Footer -->
                    <div class="pkg-card-footer d-flex gap-2">
                        <a asp-page="Details" asp-route-id="@pkg.Id" class="btn btn-sm btn-outline-primary flex-fill text-center" style="border-radius:8px; font-size:0.8rem; font-weight:600;">
                            <i class="bi bi-eye me-1"></i>Details
                        </a>
                        <a asp-page="Edit" asp-route-id="@pkg.Id" class="btn btn-sm btn-outline-secondary flex-fill text-center" style="border-radius:8px; font-size:0.8rem; font-weight:600;">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <div class="pkg-empty">
                <i class="bi bi-box-seam d-block mb-3" style="font-size:3rem; color:#cbd5e1;"></i>
                <h5 style="font-weight:700; color:#475569; margin-bottom:8px;">No active treatment packages.</h5>
                <p style="font-size:0.85rem; color:#94a3b8; margin-bottom:1.5rem;">Create your first standard treatment package to offer to patients</p>
                <a asp-page="Create" class="btn btn-primary px-4 py-2" style="border-radius:10px; background:var(--mb-primary); border-color:var(--mb-primary);">
                    <i class="bi bi-plus-lg me-1"></i>Create New Package
                </a>
            </div>
        </div>
    }
</div>
