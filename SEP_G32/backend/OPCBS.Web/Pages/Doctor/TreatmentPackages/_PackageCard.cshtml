@model OPCBS.Web.DTOs.TreatmentPackageDto
@{
    var statusClass = Model.Status switch {
        "Active" => "active",
        "Assigned" or "Accepted" => "assigned",
        "Draft" or "Created" => "draft",
        "Completed" => "completed",
        "Cancelled" => "cancelled",
        "Rejected" => "rejected",
        _ => "expired"
    };
}

<div class="col-md-6 col-xl-4">
    <div class="pkg-card h-100 d-flex flex-column justify-content-between">
        <div>
            <div class="pkg-card-header d-flex justify-content-between align-items-start">
                <h6 style="font-weight:700; font-size:0.92rem; color:#1e293b; margin:0; max-width:70%;" class="text-truncate" title="@Model.Title">@Model.Title</h6>
                <span class="pkg-status @statusClass">@Model.Status</span>
            </div>
            <div class="pkg-card-body">
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <p style="font-size:0.8rem; color:#64748b; margin-bottom:8px; line-height:1.45; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">@Model.Description</p>
                }
                <div class="pkg-meta-row"><i class="bi bi-person-fill"></i><span>Patient: <strong style="color:#1e293b;">@Model.DisplayPatientName</strong></span></div>
                <div class="pkg-meta-row"><i class="bi bi-camera-video"></i><span>Sessions: <strong>@Model.TotalSessions</strong> (@Model.RecommendedSessionsPerWeek/week)</span></div>
                <div class="pkg-meta-row"><i class="bi bi-hourglass-split"></i><span>Duration: <strong>@Model.ValidityDays days</strong></span></div>
                <div class="pkg-meta-row"><i class="bi bi-cash-stack"></i><span>Price: <strong style="color:var(--mb-primary);">@Model.Price.ToString("N0") ₫</strong></span></div>
                @if (!string.IsNullOrEmpty(Model.TargetOutcome))
                {
                    <div class="pkg-meta-row"><i class="bi bi-trophy"></i><span class="text-truncate" title="@Model.TargetOutcome">@Model.TargetOutcome</span></div>
                }
            </div>
        </div>
        <div class="pkg-card-footer d-flex gap-2">
            <a asp-page="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary flex-fill text-center" style="border-radius:6px; font-size:0.78rem; font-weight:600;">
                <i class="bi bi-eye me-1"></i>Details
            </a>
            @if (Model.IsTemplate || Model.Status == "Draft" || Model.Status == "Created")
            {
                <a asp-page="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary flex-fill text-center" style="border-radius:6px; font-size:0.78rem; font-weight:600;">
                    <i class="bi bi-pencil me-1"></i>Edit
                </a>
            }
        </div>
    </div>
</div>
