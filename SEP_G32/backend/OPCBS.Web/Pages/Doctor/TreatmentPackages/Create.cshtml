@page
@model OPCBS.Web.Pages.Doctor.TreatmentPackages.CreateModel
@{ ViewData["Title"] = "Tạo gói điều trị"; ViewData["UseDashboardLayout"] = true; }

<div class="mb-page-header d-flex justify-content-between align-items-center">
    <div>
        <h1><i class="bi bi-box-seam me-2" style="color:var(--mb-primary);"></i>Tạo gói điều trị</h1>
        <p class="text-muted mb-0 mt-1" style="font-size:0.875rem;">Thiết lập gói điều trị cho bệnh nhân</p>
    </div>
    <a asp-page="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>
</div>

@if (Model.Error != null) { <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-1"></i>@Model.Error</div> }

<div class="card border-0 shadow-sm" style="border-radius:20px;">
    <div class="card-body p-4">
        <form method="post">
            <!-- Package Name -->
            <div class="p-3 rounded-3 mb-3" style="border:1px solid transparent;transition:all 0.2s;" onmouseover="this.style.background='#f8faf6';this.style.borderColor='#e0e7e3';" onmouseout="this.style.background='';this.style.borderColor='transparent';">
                <label class="form-label fw-semibold d-flex align-items-center gap-2">
                    <i class="bi bi-tag" style="color:var(--mb-primary);"></i>
                    Tên gói <span class="text-danger">*</span>
                </label>
                <input asp-for="Input.Title" class="form-control" placeholder="VD: Stress Management, Anxiety Treatment..." style="border-radius:12px;" />
            </div>

            <!-- Description -->
            <div class="p-3 rounded-3 mb-3" style="border:1px solid transparent;transition:all 0.2s;" onmouseover="this.style.background='#f8faf6';this.style.borderColor='#e0e7e3';" onmouseout="this.style.background='';this.style.borderColor='transparent';">
                <label class="form-label fw-semibold d-flex align-items-center gap-2">
                    <i class="bi bi-card-text" style="color:var(--mb-primary);"></i>
                    Mô tả
                </label>
                <textarea asp-for="Input.Description" class="form-control" rows="3" placeholder="Mô tả chi tiết về gói điều trị..." style="border-radius:12px;resize:vertical;"></textarea>
            </div>

            <!-- Sessions + Price + Validity -->
            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <div class="p-3 rounded-3 h-100" style="background:#f8faf8;border:1px solid #e0e7e3;">
                        <label class="form-label fw-semibold d-flex align-items-center gap-2">
                            <i class="bi bi-calendar2-check" style="color:var(--mb-primary);"></i>
                            Tổng số phiên <span class="text-danger">*</span>
                        </label>
                        <input type="number" asp-for="Input.TotalSessions" class="form-control" min="1" value="8" style="border-radius:12px;font-weight:600;font-size:1.1rem;color:var(--mb-primary);" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 rounded-3 h-100" style="background:#f8faf8;border:1px solid #e0e7e3;">
                        <label class="form-label fw-semibold d-flex align-items-center gap-2">
                            <i class="bi bi-currency-dollar" style="color:var(--mb-primary);"></i>
                            Giá (₫)
                        </label>
                        <input type="number" asp-for="Input.Price" class="form-control" style="border-radius:12px;font-weight:600;font-size:1.1rem;" />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 rounded-3 h-100" style="background:#f8faf8;border:1px solid #e0e7e3;">
                        <label class="form-label fw-semibold d-flex align-items-center gap-2">
                            <i class="bi bi-hourglass-split" style="color:var(--mb-primary);"></i>
                            Hiệu lực (ngày)
                        </label>
                        <input type="number" asp-for="Input.ValidityDays" class="form-control" min="1" style="border-radius:12px;font-weight:600;font-size:1.1rem;" />
                    </div>
                </div>
            </div>

            <!-- Patient ID (pre-filled or manual) -->
            <div class="p-3 rounded-3 mb-3" style="border:1px solid transparent;transition:all 0.2s;" onmouseover="this.style.background='#f8faf6';this.style.borderColor='#e0e7e3';" onmouseout="this.style.background='';this.style.borderColor='transparent';">
                <label class="form-label fw-semibold d-flex align-items-center gap-2">
                    <i class="bi bi-person" style="color:var(--mb-primary);"></i>
                    Patient ID
                    @if (Model.PrefilledPatientId.HasValue)
                    {
                        <span class="badge bg-success">Đã gán từ hồ sơ</span>
                    }
                </label>
                @if (Model.PrefilledPatientId.HasValue)
                {
                    <input asp-for="Input.PatientId" class="form-control" style="border-radius:12px;" readonly />
                }
                else
                {
                    <input asp-for="Input.PatientId" class="form-control" style="border-radius:12px;" />
                }
            </div>

            <!-- Actions -->
            <div class="d-flex justify-content-end gap-3 pt-3 border-top mt-4">
                <a asp-page="Index" class="btn btn-outline-secondary px-4 py-2" style="border-radius:12px;">Hủy</a>
                <button type="submit" class="btn btn-primary px-4 py-2 d-flex align-items-center gap-2" style="border-radius:12px;">
                    <i class="bi bi-check-circle"></i>
                    Tạo gói điều trị
                </button>
            </div>
        </form>
    </div>
</div>
