@page
@model OPCBS.Web.Pages.Doctor.TreatmentPackages.CreateModel
@{ ViewData["Title"] = "Create Treatment Package"; ViewData["UseDashboardLayout"] = true; }

<style>
    .create-form-card { border-radius: 20px; border: none; box-shadow: 0 1px 6px rgba(0,0,0,0.06); }
    .form-field { margin-bottom: 1.25rem; }
    .form-field-label {
        font-size: 0.82rem; font-weight: 700; color: #1e293b; margin-bottom: 0.5rem;
        display: flex; align-items: center; gap: 8px;
    }
    .form-field-label i { color: var(--mb-primary); font-size: 0.9rem; }
    .form-field .form-control, .form-field .form-select { border-radius: 12px; padding: 10px 14px; border-color: #e2e8f0; }
    .form-field .form-control:focus, .form-field .form-select:focus { border-color: var(--mb-primary); box-shadow: 0 0 0 3px rgba(78,139,112,0.1); }
    .metric-input-group {
        background: #f8faf8; border: 1px solid #e0e7e3; border-radius: 14px; padding: 1rem;
        text-align: center;
    }
    .metric-input-group .form-control { font-weight: 700; font-size: 1.15rem; color: var(--mb-primary); text-align: center; }
</style>

<div class="mb-page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 style="font-size:1.4rem; font-weight:700; margin:0;">
            <i class="bi bi-box-seam me-2" style="color:var(--mb-primary);"></i>Create Treatment Package
        </h1>
        <p class="text-muted mb-0 mt-1" style="font-size:0.85rem;">Set up a personalized treatment package for your patient</p>
    </div>
    <a asp-page="Index" class="btn btn-outline-secondary btn-sm" style="border-radius:10px;">
        <i class="bi bi-arrow-left me-1"></i>Back
    </a>
</div>

@if (Model.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show" style="border-radius:12px; border:none;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card create-form-card">
    <div class="card-body p-4">
        <form method="post">
            <!-- Patient Selection -->
            <div class="form-field">
                <label class="form-field-label">
                    <i class="bi bi-person-fill"></i>
                    Patient <span class="text-danger">*</span>
                    @if (Model.PrefilledPatientId.HasValue)
                    {
                        <span class="badge bg-success ms-1" style="font-size:0.65rem;">Assigned from profile</span>
                    }
                </label>
                @if (Model.PrefilledPatientId.HasValue)
                {
                    <input asp-for="Input.PatientId" class="form-control" readonly />
                    var prefilledName = Model.PatientOptions.FirstOrDefault(p => p.PatientId == Model.PrefilledPatientId!.Value)?.Name;
                    if (prefilledName != null)
                    {
                        <small class="text-muted mt-1 d-block"><i class="bi bi-person me-1"></i>@prefilledName</small>
                    }
                }
                else if (Model.PatientOptions.Any())
                {
                    <select asp-for="Input.PatientId" class="form-select">
                        <option value="">-- Select patient --</option>
                        @foreach (var p in Model.PatientOptions)
                        {
                            if (Model.PrefilledPatientId == p.PatientId)
                            {
                                <option value="@p.PatientId" selected>@p.Name</option>
                            }
                            else
                            {
                                <option value="@p.PatientId">@p.Name</option>
                            }
                        }
                    </select>
                    <small class="text-muted mt-1 d-block">
                        <i class="bi bi-info-circle me-1"></i>Only patients who have had consultation notes with you are listed.
                    </small>
                }
                else
                {
                    <input asp-for="Input.PatientId" class="form-control" placeholder="Enter Patient ID (GUID)" />
                    <small class="text-muted mt-1 d-block">
                        <i class="bi bi-info-circle me-1"></i>No patients in the system yet. Enter Patient ID manually.
                    </small>
                }
            </div>

            <!-- Package Name -->
            <div class="form-field">
                <label class="form-field-label">
                    <i class="bi bi-tag"></i>
                    Package Name <span class="text-danger">*</span>
                </label>
                <input asp-for="Input.Title" class="form-control" placeholder="e.g. Stress Management 8 sessions, Anxiety Therapy..." />
            </div>

            <!-- Description -->
            <div class="form-field">
                <label class="form-field-label">
                    <i class="bi bi-card-text"></i>
                    Detailed Description
                </label>
                <textarea asp-for="Input.Description" class="form-control" rows="4" placeholder="Describe treatment methods, goals, special notes for the patient..." style="resize:vertical;"></textarea>
            </div>

            <!-- Sessions + Price + Validity -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="metric-input-group h-100">
                        <label class="form-field-label justify-content-center">
                            <i class="bi bi-calendar2-check"></i>
                            Total Sessions <span class="text-danger">*</span>
                        </label>
                        <input type="number" asp-for="Input.TotalSessions" class="form-control" min="1" value="8" />
                        <small class="text-muted mt-1 d-block" style="font-size:0.72rem;">Number of consultation sessions</small>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="metric-input-group h-100">
                        <label class="form-field-label justify-content-center">
                            <i class="bi bi-currency-dollar"></i>
                            Price (₫)
                        </label>
                        <input type="number" asp-for="Input.Price" class="form-control" />
                        <small class="text-muted mt-1 d-block" style="font-size:0.72rem;">Treatment package fee</small>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="metric-input-group h-100">
                        <label class="form-field-label justify-content-center">
                            <i class="bi bi-hourglass-split"></i>
                            Validity (days)
                        </label>
                        <input type="number" asp-for="Input.ValidityDays" class="form-control" min="1" />
                        <small class="text-muted mt-1 d-block" style="font-size:0.72rem;">Usage period</small>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="d-flex justify-content-end gap-3 pt-3 border-top mt-4">
                <a asp-page="Index" class="btn btn-outline-secondary px-4 py-2" style="border-radius:12px;">Cancel</a>
                <button type="submit" class="btn btn-primary px-4 py-2 d-flex align-items-center gap-2" style="border-radius:12px; background:var(--mb-primary); border-color:var(--mb-primary);">
                    <i class="bi bi-check-circle"></i>
                    Create Treatment Package
                </button>
            </div>
        </form>
    </div>
</div>
