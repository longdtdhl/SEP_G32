@page
@model OPCBS.Web.Pages.Doctor.Appointments.HistoryModel
@{
    ViewData["Title"] = "Appointment History";
    Layout = "_DashboardLayout";
}

<style>
    .stat-card {
        border-radius: 12px;
        border: none;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        cursor: pointer;
        text-decoration: none;
    }
    .stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.08) !important;
    }
    .stat-card .stat-icon {
        width: 48px; height: 48px;
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.25rem;
    }
    .stat-card .stat-value { font-size: 1.75rem; font-weight: 700; line-height: 1; }
    .stat-card .stat-label { font-size: 0.8rem; color: #6c757d; font-weight: 500; }

    .appt-card {
        border: none;
        border-radius: 12px;
        transition: all 0.2s ease;
        border-left: 4px solid transparent;
    }
    .appt-card:hover {
        box-shadow: 0 4px 16px rgba(0,0,0,0.06);
        transform: translateX(2px);
    }
    .appt-card.status-completed { border-left-color: #198754; }
    .appt-card.status-cancelled { border-left-color: #dc3545; }
    .appt-card.status-rejected { border-left-color: #6c757d; }

    .patient-avatar {
        width: 44px; height: 44px;
        border-radius: 50%;
        background: linear-gradient(135deg, #4e8b70, #6db896);
        color: white;
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: 1rem;
        flex-shrink: 0;
    }

    .time-badge {
        background: #f8fafc;
        color: #475569;
        border-radius: 8px;
        padding: 4px 10px;
        font-size: 0.82rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .filter-section {
        border-radius: 12px;
        border: none;
    }

    .date-group-header {
        font-size: 0.85rem;
        font-weight: 700;
        color: #4e8b70;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 8px 0;
        border-bottom: 2px solid #e9ecef;
        margin-bottom: 12px;
    }

    .empty-state {
        padding: 60px 20px;
        text-align: center;
    }
    .empty-state i { font-size: 3.5rem; color: #dee2e6; }
    .empty-state h5 { color: #6c757d; margin-top: 16px; }
    .empty-state p { color: #adb5bd; font-size: 0.9rem; }
</style>

<!-- Page Header -->
<div class="mb-page-header d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div>
        <h1 class="mb-1">Appointment History</h1>
        <p class="text-muted mb-0 small">Read-only history of completed, cancelled, and rejected appointments</p>
    </div>
    <div>
        <a asp-page="Index" class="btn btn-outline-primary btn-sm px-3 py-2" style="border-radius:10px; font-weight:600; font-size:0.85rem;">
            <i class="bi bi-arrow-left me-1"></i>Back to Active Management
        </a>
    </div>
</div>

@if (Model.Error != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>@Model.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filters -->
<div class="card filter-section shadow-sm mb-4">
    <div class="card-body py-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Status</label>
                <select asp-for="Status" class="form-select form-select-sm">
                    <option value="">All History Statuses</option>
                    <option value="Completed">Completed</option>
                    <option value="Cancelled">Cancelled</option>
                    <option value="Rejected">Rejected</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Search Patient</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input asp-for="Search" class="form-control" placeholder="Patient name..." />
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">From Date</label>
                <input asp-for="DateFrom" type="date" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">To Date</label>
                <input asp-for="DateTo" type="date" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="bi bi-funnel me-1"></i>Filter
                </button>
            </div>
            <div class="col-md-1">
                <a asp-page="History" class="btn btn-outline-secondary btn-sm w-100" title="Clear filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Appointment List -->
@if (Model.Appointments.Any())
{
    var grouped = Model.Appointments
        .OrderByDescending(a => a.AppointmentDate)
        .ThenBy(a => a.StartTime)
        .GroupBy(a => a.AppointmentDate ?? "Unknown");

    @foreach (var group in grouped)
    {
        <div class="mb-4">
            <div class="date-group-header">
                <i class="bi bi-calendar3 me-1"></i>
                @{
                    var displayDate = DateTime.TryParse(group.Key, out var gDate)
                        ? gDate.ToString("dddd, MMMM dd, yyyy")
                        : group.Key;
                }
                @displayDate
                <span class="badge bg-secondary bg-opacity-25 text-dark ms-2">@group.Count() history records</span>
            </div>

            <div class="d-flex flex-column gap-2">
                @foreach (var apt in group)
                {
                    var statusClass = apt.Status switch
                    {
                        4 => "status-completed",
                        5 => "status-cancelled",
                        2 => "status-rejected",
                        _ => ""
                    };
                    var badgeClass = apt.Status switch
                    {
                        4 => "bg-success text-white",
                        5 => "bg-danger text-white",
                        2 => "bg-secondary text-white",
                        _ => "bg-secondary text-white"
                    };

                    <div class="card appt-card @statusClass shadow-sm p-3 bg-white">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="patient-avatar">
                                    @(string.IsNullOrEmpty(apt.PatientName) ? "?" : apt.PatientName.Substring(0, 1).ToUpper())
                                </div>
                                <div>
                                    <h6 class="fw-bold text-dark mb-1">
                                        @(apt.PatientName ?? "Guest Patient")
                                        <span class="badge @badgeClass ms-2" style="font-size:0.7rem;">@apt.StatusText</span>
                                    </h6>
                                    <div class="text-muted small">
                                        <span class="time-badge me-2"><i class="bi bi-clock me-1"></i>@apt.StartTime - @apt.EndTime</span>
                                        @if (!string.IsNullOrEmpty(apt.BookingCode))
                                        {
                                            <span class="me-2"><i class="bi bi-hash me-1"></i>@apt.BookingCode</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex align-items-center gap-2">
                                <a asp-page="Details" asp-route-id="@apt.Id" class="btn btn-outline-primary btn-sm px-3 py-1.5" style="border-radius:8px; font-weight:600;">
                                    <i class="bi bi-eye me-1"></i>View Details
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Pagination -->
    @if (Model.Pagination != null && Model.Pagination.TotalPages > 1)
    {
        <nav class="d-flex justify-content-center mt-4">
            <ul class="pagination pagination-sm">
                <li class="page-item @(!Model.Pagination.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-page="History" asp-route-page="@(Model.CurrentPage - 1)" asp-route-status="@Model.Status" asp-route-search="@Model.Search" asp-route-dateFrom="@Model.DateFrom" asp-route-dateTo="@Model.DateTo">Previous</a>
                </li>
                @for (int p = 1; p <= Model.Pagination.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-page="History" asp-route-page="@p" asp-route-status="@Model.Status" asp-route-search="@Model.Search" asp-route-dateFrom="@Model.DateFrom" asp-route-dateTo="@Model.DateTo">@p</a>
                    </li>
                }
                <li class="page-item @(!Model.Pagination.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-page="History" asp-route-page="@(Model.CurrentPage + 1)" asp-route-status="@Model.Status" asp-route-search="@Model.Search" asp-route-dateFrom="@Model.DateFrom" asp-route-dateTo="@Model.DateTo">Next</a>
                </li>
            </ul>
        </nav>
    }
}
else
{
    <div class="card border-0 shadow-sm rounded-3">
        <div class="empty-state">
            <i class="bi bi-clock-history"></i>
            <h5>No appointment history found</h5>
            <p>Completed, cancelled, and rejected appointments will appear here.</p>
        </div>
    </div>
}
