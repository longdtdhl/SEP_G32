@page "{id:guid}"
@model OPCBS.Web.Pages.Doctor.Appointments.RescheduleModel
@{
    ViewData["Title"] = "Change Appointment Slot";
    Layout = "_DashboardLayout";
    var selectedDate = !string.IsNullOrWhiteSpace(Model.Date) ? Model.Date : DateTime.Today.ToString("yyyy-MM-dd");
    var availableSlots = Model.AvailableSlots?.Slots?
        .Where(s => s.Status == 0 && s.CurrentBookings < s.MaxPatients)
        .OrderBy(s => s.StartTime)
        .ToList() ?? new();
}

<div class="mb-page-header d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">
            <i class="bi bi-arrow-repeat me-2" style="color:#0f766e;"></i>Change Appointment Slot
        </h1>
        <p class="text-muted small mb-0">Select a new date and time range for this appointment session.</p>
    </div>
    <a asp-page="/Doctor/Appointments/Details" asp-route-id="@ViewContext.HttpContext.Request.RouteValues["id"]" class="btn btn-outline-secondary btn-sm" style="border-radius:10px;">
        <i class="bi bi-arrow-left me-1"></i>Back to Details
    </a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger alert-dismissible fade show" style="border-radius:12px;">
        <i class="bi bi-exclamation-octagon me-2"></i>@Model.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Appointment != null)
{
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                <h6 class="fw-bold text-muted small text-uppercase mb-3">
                    <i class="bi bi-calendar-check me-1"></i>Current Booking
                </h6>
                <div class="d-flex align-items-center gap-3 mb-3 p-3 bg-light rounded-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:48px;height:48px;background:#e6f4f1;color:#0f766e;font-size:1.25rem;">
                        <i class="bi bi-person"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark mb-0">@(Model.Appointment.PatientName ?? "Patient")</div>
                        <div class="text-muted small">@(Model.Appointment.TreatmentPackageName ?? "Standard appointment")</div>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="small text-muted mb-1">Booking Reference</div>
                    <div class="fw-semibold font-monospace px-2 py-1 rounded d-inline-block small" style="background:#eef6ff;color:#1d4ed8;">
                        @(Model.Appointment.BookingCode ?? "N/A")
                    </div>
                </div>

                <div class="mb-3">
                    <div class="small text-muted mb-1">Current Scheduled Time</div>
                    <div class="fw-semibold text-dark">
                        <i class="bi bi-clock me-1" style="color:#0f766e;"></i>@Model.Appointment.AppointmentDate @Model.Appointment.StartTime - @Model.Appointment.EndTime
                    </div>
                </div>

                <div class="alert alert-info py-2 px-3 small rounded-3 mb-0">
                    <i class="bi bi-info-circle-fill me-1"></i>
                    The appointment will move immediately after you save the selected available slot.
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                <h5 class="fw-bold text-dark mb-3">
                    <i class="bi bi-calendar2-plus me-2" style="color:#0f766e;"></i>Select New Time Range
                </h5>

                <form method="get" class="row g-2 align-items-end mb-4">
                    <div class="col-sm-6 col-md-5">
                        <label class="form-label small fw-semibold text-muted mb-1">Select New Date</label>
                        <input type="date" name="Date" class="form-control" value="@selectedDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" style="border-radius:10px;" />
                    </div>
                    <div class="col-sm-6 col-md-4">
                        <button type="submit" class="btn btn-outline-primary w-100" style="border-radius:10px;border-color:#0f766e;color:#0f766e;">
                            <i class="bi bi-search me-1"></i>View Slots
                        </button>
                    </div>
                </form>

                <form method="post" asp-route-id="@Model.Appointment.Id">
                    <div class="mb-4">
                        <label class="form-label small fw-bold text-dark mb-2">Available Time Ranges for @selectedDate</label>
                        @if (availableSlots.Any())
                        {
                            <div class="row g-2">
                                @foreach (var slot in availableSlots)
                                {
                                    <div class="col-12 col-sm-6 col-xl-4">
                                        <input type="radio" class="btn-check" name="NewSlotId" id="doctor_slot_@slot.Id" value="@slot.Id" required />
                                        <label class="btn w-100 text-start p-3 rounded-3 border slot-choice" for="doctor_slot_@slot.Id">
                                            <div class="fw-bold text-dark">
                                                <i class="bi bi-clock me-1" style="color:#0f766e;"></i>@slot.StartTime - @slot.EndTime
                                            </div>
                                            <div class="small text-muted mt-1">Available (@slot.CurrentBookings/@slot.MaxPatients)</div>
                                        </label>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="p-4 text-center bg-light rounded-4 border">
                                <i class="bi bi-calendar-x text-muted fs-3 mb-2 d-block"></i>
                                <div class="fw-medium text-muted mb-1">No available time slots on this date</div>
                                <p class="text-muted small mb-0">Please select another date using the date filter above.</p>
                            </div>
                        }
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-dark mb-1">Reason for Moving Appointment <span class="text-muted fw-normal">(Optional)</span></label>
                        <textarea asp-for="Reason" class="form-control" rows="3" placeholder="Briefly explain why this appointment is being moved..." style="border-radius:12px;"></textarea>
                    </div>

                    <div class="d-flex align-items-center gap-2 pt-2 border-top">
                        <button type="submit" class="btn btn-primary px-4 py-2" style="border-radius:10px;background:#0f766e;border-color:#0f766e;" @(availableSlots.Any() ? "" : "disabled")>
                            <i class="bi bi-check2-circle me-1"></i>Save New Slot
                        </button>
                        <a asp-page="/Doctor/Appointments/Details" asp-route-id="@Model.Appointment.Id" class="btn btn-outline-secondary px-3 py-2" style="border-radius:10px;">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<style>
    .slot-choice {
        background: #ffffff;
        border-color: #dbe7e4 !important;
        transition: border-color .15s ease, background .15s ease, box-shadow .15s ease;
    }

    .slot-choice:hover {
        background: #f0fdfa;
        border-color: #0f766e !important;
    }

    .btn-check:checked + .slot-choice {
        background: #e6f4f1;
        border-color: #0f766e !important;
        box-shadow: 0 0 0 .15rem rgba(15,118,110,.12);
    }
</style>
