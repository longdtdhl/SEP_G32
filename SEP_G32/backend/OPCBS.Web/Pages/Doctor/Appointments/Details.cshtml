</style>

<div class="dr-apt-wrapper">
    <!-- Top Navigation Row -->
    <div class="dr-nav-header">
        <a asp-page="Index" class="dr-back-btn">
            <i class="bi bi-arrow-left"></i> Back to Appointments
        </a>
        <div class="d-flex align-items-center gap-2">
            @if (Model.Appointment != null && Model.Appointment.PatientId.HasValue)
            {
                <a asp-page="/Doctor/Messages/Index" asp-route-patientId="@Model.Appointment.PatientId" class="dr-btn-secondary" style="color:#0f766e !important; border-color:#99f6e4;">
                    <i class="bi bi-chat-dots-fill text-teal"></i> Chat with Patient
                </a>
            }
        </div>
    </div>

    <!-- Alert Banners -->
    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4" style="border-radius:12px; background:#fff1f2; border:1px solid #fecdd3; color:#9f1239;">
            <i class="bi bi-exclamation-octagon-fill fs-5"></i>
            <div>@Model.Error</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Success))
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" style="border-radius:12px; background:#ecfdf5; border:1px solid #a7f3d0; color:#065f46;">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@Model.Success</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Appointment != null)
    {
        var apt = Model.Appointment;
        var hasScheduledDate = DateTime.TryParse(apt.AppointmentDate, out var scheduledDate);
        var canStartConsultation = hasScheduledDate && scheduledDate.Date <= DateTime.Today;

        var patientDetailUrl = Model.PatientRecord != null 
            ? $"/Doctor/Patients/Details?id={Model.PatientRecord.Id}" 
            : (apt.PatientId.HasValue ? $"/Doctor/Patients/Details?id={apt.PatientId.Value}" : null);

        var statusText = apt.Status switch
        {
            0 => "Pending Approval",
            1 => "Accepted",
            3 => "In Progress",
            4 => "Completed",
            5 => "Cancelled",
            2 => "Rejected",
            6 => "Reschedule Requested",
            _ => apt.StatusText ?? "Unknown"
        };

        var statusPillClass = apt.Status switch
        {
            0 => "dr-pill-pending",
            1 => "dr-pill-accepted",
            3 => "dr-pill-inprogress",
            4 => "dr-pill-completed",
            5 => "dr-pill-cancelled",
            2 => "dr-pill-rejected",
            6 => "dr-pill-pending",
            _ => "dr-pill-rejected"
        };

        var statusBarClass = apt.Status switch
        {
            0 => "dr-bar-pending",
            1 => "dr-bar-accepted",
            3 => "dr-bar-inprogress",
            4 => "dr-bar-completed",
            5 => "dr-bar-cancelled",
            2 => "dr-bar-rejected",
            6 => "dr-bar-pending",
            _ => "dr-bar-rejected"
        };

        <!-- ═══════════════════════════════════════════════════
           1. HERO APPOINTMENT HEADER
           ═══════════════════════════════════════════════════ -->
        <header class="dr-hero-banner">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                <!-- Left: Title, Patient Name, Booking Code, Status -->
                <div>
                    <div class="dr-hero-topline">
                        <span class="dr-booking-chip" title="Booking Reference Code">
                            <i class="bi bi-upc-scan"></i> @apt.BookingCode
                        </span>
                        <span class="dr-status-pill @statusPillClass @(apt.Status == 3 ? "dr-status-live" : "")">
                            <i class="bi bi-record-circle-fill" style="font-size:0.55rem;"></i> @statusText
                        </span>
                    </div>

                    <h1 class="dr-hero-title">
                        @if (!string.IsNullOrEmpty(patientDetailUrl))
                        {
                            <a href="@patientDetailUrl" title="View Patient Profile">
                                Consultation with @(apt.PatientName ?? "Patient")
                                <i class="bi bi-arrow-up-right-square ms-1" style="font-size:1.15rem; color:var(--dr-primary); vertical-align:middle;"></i>
                            </a>
                        }
                        else
                        {
                            <span>Consultation with @(apt.PatientName ?? "Patient")</span>
                        }
                    </h1>

                    <div class="dr-hero-subtitle">
                        <span>Specialization: <strong class="text-dark">@(apt.Specialization ?? "General Mental Health")</strong></span>
                        <span>•</span>
                        <span>Visit History: <strong class="text-dark">@(apt.VisitCount == 0 ? "First Consultation" : $"{apt.VisitCount} past visits")</strong></span>
                    </div>
                </div>

                <!-- Right: Schedule & Quick Mode Switcher -->
                <div class="d-flex align-items-center gap-3">
                    <div class="text-end d-none d-md-block">
                        <div class="fw-bold text-dark fs-6">
                            @apt.StartAt.LocalDateTime.ToString("dddd, MMM dd, yyyy")
                        </div>
                        <div class="text-muted small">
                            <i class="bi bi-clock me-1 text-teal"></i>@apt.StartAt.LocalDateTime.ToString("HH:mm") – @apt.EndAt.LocalDateTime.ToString("HH:mm")
                        </div>
                    </div>
                    @if (apt.Status != 4 && apt.Status != 5 && apt.Status != 2)
                    {
                        <div class="dropdown">
                            <button class="btn btn-sm btn-white border dropdown-toggle d-flex align-items-center gap-1.5 px-3 py-2 shadow-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 0.84rem; border-radius: 10px; font-weight: 650; background:#fff;">
                                <i class="bi @(apt.IsOnline ? "bi-camera-video-fill text-primary" : "bi-geo-alt-fill text-success")"></i>
                                <span>@(apt.IsOnline ? "Online" : "In-Person")</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm p-1.5 border-0" style="min-width: 220px; border-radius: 12px;">
                                <li>
                                    <form method="post" asp-page-handler="UpdateConsultationMode" asp-route-id="@apt.Id" asp-route-mode="0" onsubmit="return confirm('Switch consultation mode to Online Consultation?');">
                                        <button type="submit" class="dropdown-item d-flex align-items-center gap-2 py-2 px-2.5 rounded-2 @(apt.IsOnline ? "active bg-primary text-white" : "text-dark")" style="font-size: 0.82rem;">
                                            <i class="bi bi-camera-video-fill @(apt.IsOnline ? "text-white" : "text-primary")"></i>
                                            <div>
                                                <div class="fw-bold">Online Consultation</div>
                                                <small class="@(apt.IsOnline ? "text-white-50" : "text-muted")" style="font-size:0.7rem;">Video Call / Telehealth</small>
                                            </div>
                                        </button>
                                    </form>
                                </li>
                                <li><hr class="dropdown-divider my-1"></li>
                                <li>
                                    <form method="post" asp-page-handler="UpdateConsultationMode" asp-route-id="@apt.Id" asp-route-mode="1" onsubmit="return confirm('Switch consultation mode to In-Person (Offline)?');">
                                        <button type="submit" class="dropdown-item d-flex align-items-center gap-2 py-2 px-2.5 rounded-2 @(apt.IsOffline ? "active bg-success text-white" : "text-dark")" style="font-size: 0.82rem;">
                                            <i class="bi bi-geo-alt-fill @(apt.IsOffline ? "text-white" : "text-success")"></i>
                                            <div>
                                                <div class="fw-bold">In-Person (Offline)</div>
                                                <small class="@(apt.IsOffline ? "text-white-50" : "text-muted")" style="font-size:0.7rem;">At Clinic / Office</small>
                                            </div>
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </header>

        <!-- Status Notice Bar -->
        <div class="dr-status-banner-bar @statusBarClass @(apt.Status == 3 ? "dr-live-banner" : "")">
            @if (apt.Status == 0)
            {
                <i class="bi bi-hourglass-split fs-5"></i>
                <span><strong>Awaiting Confirmation</strong> — Review the appointment details and approve or reschedule this booking request.</span>
            }
            else if (apt.Status == 1)
            {
                <i class="bi bi-calendar-check fs-5"></i>
                <span><strong>Accepted</strong> — This appointment is confirmed. Click "Start Consultation" when the session begins.</span>
            }
            else if (apt.Status == 3)
            {
                <i class="bi bi-play-circle-fill fs-5 text-indigo"></i>
                <span><strong>In Progress</strong> — The consultation session is currently active. Record session findings and complete the appointment.</span>
            }
            else if (apt.Status == 4)
            {
                <i class="bi bi-patch-check-fill fs-5 text-success"></i>
                <span><strong>Completed</strong> — This clinical session has been successfully concluded and recorded.</span>
            }
            else if (apt.Status == 2)
            {
                <i class="bi bi-x-octagon-fill fs-5"></i>
                <span><strong>Rejected</strong> — You have declined this booking request.</span>
            }
            else if (apt.Status == 6)
            {
                <i class="bi bi-arrow-repeat fs-5 text-warning"></i>
                <div>
                    <strong>Reschedule Requested</strong> — Patient requested to move appointment to <strong>@(apt.ProposedSlotDate ?? "New date") (@(apt.ProposedSlotStartTime ?? "") - @(apt.ProposedSlotEndTime ?? ""))</strong>.
                    @if (!string.IsNullOrEmpty(apt.RescheduleReason))
                    {
                        <div class="small opacity-75 mt-0.5">Reason: "@apt.RescheduleReason"</div>
                    }
                </div>
            }
            else if (apt.Status == 5)
            {
                <i class="bi bi-x-circle-fill fs-5"></i>
                <span><strong>Cancelled</strong> — This appointment was cancelled.</span>
            }
        </div>

        <!-- ═══════════════════════════════════════════════════
           3. CONTEXT SUMMARY STRIP (4 METRIC CARDS)
           ═══════════════════════════════════════════════════ -->
        <div class="dr-metric-strip">
            <!-- 1. Schedule Time -->
            <div class="dr-metric-card">
                <div class="dr-metric-icon dr-micon-teal">
                    <i class="bi bi-calendar-event"></i>
                </div>
                <div>
                    <div class="dr-metric-lbl">Date & Time</div>
                    <div class="dr-metric-val">
                        @apt.StartAt.LocalDateTime.ToString("MMM dd, yyyy")
                        <div class="text-muted fw-normal" style="font-size:0.82rem;">@apt.StartAt.LocalDateTime.ToString("HH:mm") – @apt.EndAt.LocalDateTime.ToString("HH:mm")</div>
                    </div>
                </div>
            </div>

            <!-- 2. Consultation Format -->
            <div class="dr-metric-card">
                <div class="dr-metric-icon dr-micon-blue">
                    <i class="bi @(apt.IsOnline ? "bi-camera-video" : "bi-geo-alt")"></i>
                </div>
                <div>
                    <div class="dr-metric-lbl">Consultation Format</div>
                    <div class="dr-metric-val">
                        @(apt.IsOnline ? "Online Video Call" : "In-Person Visit")
                        <div class="text-muted fw-normal" style="font-size:0.82rem;">@(apt.IsOnline ? "Telehealth / Remote" : "Clinic Location")</div>
                    </div>
                </div>
            </div>

            <!-- 3. Care Program / Package -->
            <div class="dr-metric-card">
                <div class="dr-metric-icon dr-micon-indigo">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div>
                    <div class="dr-metric-lbl">Care Program</div>
                    <div class="dr-metric-val text-truncate" style="max-width: 200px;" title="@(apt.TreatmentPackageName ?? Model.ActiveTreatmentPackage?.Title ?? "Standard Single Session")">
                        @(apt.TreatmentPackageName ?? Model.ActiveTreatmentPackage?.Title ?? "Standard Session")
                        <div class="text-muted fw-normal" style="font-size:0.82rem;">@(Model.ActiveTreatmentPackage != null ? $"{Model.ActiveTreatmentPackage.RemainingSessions} sessions left" : "General care")</div>
                    </div>
                </div>
            </div>

            <!-- 4. Patient Relationship -->
            <div class="dr-metric-card">
                <div class="dr-metric-icon dr-micon-amber">
                    <i class="bi bi-person-check"></i>
                </div>
                <div>
                    <div class="dr-metric-lbl">Patient History</div>
                    <div class="dr-metric-val">
                        @(apt.VisitCount == 0 ? "New Patient" : $"Returning ({apt.VisitCount} visits)")
                        <div class="text-muted fw-normal" style="font-size:0.82rem;">@(apt.VisitCount == 0 ? "First Consultation" : "Active Patient")</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══════════════════════════════════════════════════
           4. MAIN TWO-COLUMN CLINICAL LAYOUT (70% / 30%)
           ═══════════════════════════════════════════════════ -->
        <div class="row g-4">
            <!-- ═══ LEFT: Clinical Context & Records ═══ -->
            <div class="col-lg-8">
                
                <!-- 1. Patient Booking Note -->
                @if (!string.IsNullOrEmpty(apt.Notes))
                {
                    <div class="dr-card">
                        <div class="dr-card-header">
                            <h2 class="dr-card-title"><i class="bi bi-chat-left-text text-teal"></i> Patient Booking Note</h2>
                        </div>
                        <div class="dr-card-body">
                            <div class="dr-panel dr-panel--neutral">
                                <p class="dr-panel-text">@apt.Notes</p>
                            </div>
                        </div>
                    </div>
                }

                <!-- 2. Pre-Appointment Clinical Evaluation -->
                @{
                    var hasCustomEval = apt.CustomFields != null && apt.CustomFields.Any(cf => !string.IsNullOrWhiteSpace(cf.Content));
                    var hasAptEval = !string.IsNullOrEmpty(apt.Symptoms) || !string.IsNullOrEmpty(apt.MedicalHistory) || !string.IsNullOrEmpty(apt.Expectations) || hasCustomEval;
                    var pRec = Model.PatientRecord;
                    var hasProfileEval = pRec != null && (!string.IsNullOrEmpty(pRec.CurrentSymptoms) || !string.IsNullOrEmpty(pRec.PsychologicalHistory) || !string.IsNullOrEmpty(pRec.StressFactors));
                }
                <div class="dr-card">
                    <div class="dr-card-header">
                        <h2 class="dr-card-title">
                            <i class="bi bi-clipboard2-pulse text-teal"></i> Pre-Appointment Clinical Evaluation
                        </h2>
                        @if (!string.IsNullOrWhiteSpace(apt.PreAppointmentNoteTitle))
                        {
                            <span class="badge px-3 py-1.5 rounded-pill" style="background:#ccfbf1; color:#0f766e; font-weight:700; font-size:0.78rem;">
                                <i class="bi bi-patch-question me-1"></i>@apt.PreAppointmentNoteTitle
                            </span>
                        }
                    </div>
                    <div class="dr-card-body">
                        @if (hasAptEval)
                        {
                            @if (!string.IsNullOrEmpty(apt.Symptoms))
                            {
                                <div class="mb-3">
                                    <div class="dr-panel-lbl" style="color:#991b1b;"><i class="bi bi-activity text-danger"></i> Current Symptoms & Chief Concerns</div>
                                    <div class="dr-panel" style="background:#fef2f2; border:1px solid #fee2e2; color:#991b1b;">
                                        <p class="dr-panel-text">@apt.Symptoms</p>
                                    </div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(apt.MedicalHistory))
                            {
                                <div class="mb-3">
                                    <div class="dr-panel-lbl" style="color:#1e40af;"><i class="bi bi-journal-medical text-primary"></i> Medical & Psychiatric History</div>
                                    <div class="dr-panel" style="background:#eff6ff; border:1px solid #dbeafe; color:#1e40af;">
                                        <p class="dr-panel-text">@apt.MedicalHistory</p>
                                    </div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(apt.Expectations))
                            {
                                <div class="mb-3">
                                    <div class="dr-panel-lbl" style="color:#166534;"><i class="bi bi-bullseye text-success"></i> Patient Consultation Expectations</div>
                                    <div class="dr-panel" style="background:#f0fdf4; border:1px solid #dcfce7; color:#166534;">
                                        <p class="dr-panel-text">@apt.Expectations</p>
                                    </div>
                                </div>
                            }
                            @if (apt.CustomFields != null && apt.CustomFields.Any())
                            {
                                <div class="mt-3 pt-3 border-top">
                                    <div class="small fw-bold text-dark mb-2"><i class="bi bi-tags text-teal me-1"></i>Additional Clinical Custom Fields</div>
                                    @foreach (var cf in apt.CustomFields)
                                    {
                                        <div class="mb-2">
                                            <div class="small fw-semibold text-muted mb-0.5">@(string.IsNullOrWhiteSpace(cf.Title) ? (apt.PreAppointmentNoteTitle ?? "Clinical Response") : cf.Title)</div>
                                            <div class="dr-panel dr-panel--teal">
                                                <p class="dr-panel-text">@cf.Content</p>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else if (hasProfileEval)
                        {
                            <div class="alert alert-info py-2 px-3 mb-3 small d-flex align-items-center gap-2" style="border-radius:10px; background:#eff6ff; border-color:#bfdbfe; color:#1e40af;">
                                <i class="bi bi-info-circle-fill"></i>
                                <span>Patient Profile Clinical Records (From previous registration)</span>
                            </div>
                            @if (!string.IsNullOrEmpty(pRec!.CurrentSymptoms))
                            {
                                <div class="mb-3">
                                    <div class="dr-panel-lbl" style="color:#991b1b;"><i class="bi bi-activity text-danger"></i> Recorded Symptoms</div>
                                    <div class="dr-panel" style="background:#fef2f2; border:1px solid #fee2e2; color:#991b1b;">
                                        <p class="dr-panel-text">@pRec.CurrentSymptoms</p>
                                    </div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(pRec.PsychologicalHistory))
                            {
                                <div class="mb-3">
                                    <div class="dr-panel-lbl" style="color:#1e40af;"><i class="bi bi-journal-medical text-primary"></i> Psychological History</div>
                                    <div class="dr-panel" style="background:#eff6ff; border:1px solid #dbeafe; color:#1e40af;">
                                        <p class="dr-panel-text">@pRec.PsychologicalHistory</p>
                                    </div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(pRec.StressFactors))
                            {
                                <div class="mb-3">
                                    <div class="dr-panel-lbl" style="color:#854d0e;"><i class="bi bi-lightning text-warning"></i> Identified Stress Factors</div>
                                    <div class="dr-panel" style="background:#fffdf5; border:1px solid #fef08a; color:#854d0e;">
                                        <p class="dr-panel-text">@pRec.StressFactors</p>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-muted small p-3 bg-light rounded-3 text-center">
                                <i class="bi bi-info-circle me-1"></i>No pre-appointment questionnaire submitted for this slot (skipped during booking or follow-up).
                            </div>
                        }
                    </div>
                </div>

                <!-- 3. Patient Assessment Screening (DASS-21 / PHQ-9) -->
                <div class="dr-card">
                    <div class="dr-card-header">
                        <h2 class="dr-card-title">
                            <i class="bi bi-clipboard-data text-teal"></i> Patient Assessment Screening
                        </h2>
                        @if (Model.PsychometricSubmission != null)
                        {
                            <span class="badge bg-success text-white px-3 py-1.5 rounded-pill" style="font-size:0.75rem;">Completed</span>
                        }
                        else
                        {
                            <span class="badge bg-light text-muted border px-3 py-1.5 rounded-pill" style="font-size:0.75rem;">Not Taken</span>
                        }
                    </div>
                    <div class="dr-card-body">
                        @if (Model.PsychometricSubmission != null)
                        {
                            var sub = Model.PsychometricSubmission;
                            var isDass = sub.TestType == "DASS21";
                            var depSev = sub.GetDepressionSeverity();
                            var anxSev = sub.GetAnxietySeverity();
                            var strSev = sub.GetStressSeverity();
                            var phqSev = sub.GetPhq9Severity();

                            if (Model.IsUsingFallbackPsych)
                            {
                                <div class="alert alert-info py-2 px-3 mb-3 small d-flex align-items-center gap-2" style="border-radius:10px; background:#eff6ff; border-color:#bfdbfe; color:#1e40af;">
                                    <i class="bi bi-info-circle-fill"></i>
                                    <span>Displaying patient's most recent psychometric assessment result.</span>
                                </div>
                            }

                            <div class="p-3 bg-white rounded-3 mb-3 border">
                                <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                                    <div>
                                        <strong class="text-dark fs-6"><i class="bi bi-clipboard2-pulse me-1 text-teal"></i>@sub.TestTitle</strong>
                                        <span class="text-muted small ms-2">· Submitted @sub.SubmittedAt.ToString("MMM dd, yyyy HH:mm")</span>
                                    </div>
                                    <div class="small fw-bold text-dark">
                                        Total Score: <span class="badge" style="background:#0f766e; color:#fff; font-size:0.82rem;">@sub.TotalScore</span>
                                    </div>
                                </div>

                                @if (isDass)
                                {
                                    <div class="row g-2 mt-1">
                                        <div class="col-4">
                                            <div style="background:@depSev.Bg; border:1px solid @depSev.Border; border-radius:10px; padding:0.75rem; text-align:center;">
                                                <div class="small fw-bold text-muted mb-1" style="font-size:0.75rem; text-transform:uppercase;">Depression</div>
                                                <div class="fs-5 fw-bold" style="color:@depSev.Text;">@sub.DepressionScore<span class="text-muted" style="font-size:0.7rem;">/42</span></div>
                                                <div class="mt-1"><span class="badge" style="background:@depSev.Bg; color:@depSev.Text; border:1px solid @depSev.Border; font-size:0.72rem;">@depSev.En</span></div>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div style="background:@anxSev.Bg; border:1px solid @anxSev.Border; border-radius:10px; padding:0.75rem; text-align:center;">
                                                <div class="small fw-bold text-muted mb-1" style="font-size:0.75rem; text-transform:uppercase;">Anxiety</div>
                                                <div class="fs-5 fw-bold" style="color:@anxSev.Text;">@sub.AnxietyScore<span class="text-muted" style="font-size:0.7rem;">/42</span></div>
                                                <div class="mt-1"><span class="badge" style="background:@anxSev.Bg; color:@anxSev.Text; border:1px solid @anxSev.Border; font-size:0.72rem;">@anxSev.En</span></div>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div style="background:@strSev.Bg; border:1px solid @strSev.Border; border-radius:10px; padding:0.75rem; text-align:center;">
                                                <div class="small fw-bold text-muted mb-1" style="font-size:0.75rem; text-transform:uppercase;">Stress</div>
                                                <div class="fs-5 fw-bold" style="color:@strSev.Text;">@sub.StressScore<span class="text-muted" style="font-size:0.7rem;">/42</span></div>
                                                <div class="mt-1"><span class="badge" style="background:@strSev.Bg; color:@strSev.Text; border:1px solid @strSev.Border; font-size:0.72rem;">@strSev.En</span></div>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-between p-2.5 rounded-2 mt-1" style="background:@phqSev.Bg; border:1px solid @phqSev.Border;">
                                        <span class="fw-semibold text-dark" style="font-size:0.875rem;">PHQ-9 Depression Score: <strong>@sub.TotalScore/27</strong></span>
                                        <span class="badge" style="background:@phqSev.Bg; color:@phqSev.Text; border:1px solid @phqSev.Border; font-size:0.75rem;">@phqSev.En</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="p-3 bg-light rounded-3 text-muted small text-center">
                                <i class="bi bi-info-circle me-1"></i>No psychometric screening completed for this consultation slot.
                            </div>
                        }

                        <!-- Assessment History List -->
                        @if (Model.ClinicalContext?.RecentAssessments != null && Model.ClinicalContext.RecentAssessments.Any())
                        {
                            <div class="mt-3 pt-3 border-top">
                                <h3 class="small fw-bold text-dark mb-2"><i class="bi bi-clock-history text-teal me-1"></i>Assessment History Timeline</h3>
                                <div class="d-flex flex-column gap-2">
                                    @foreach (var testRes in Model.ClinicalContext.RecentAssessments)
                                    {
                                        <div class="p-2.5 rounded-3 border bg-white d-flex justify-content-between align-items-center">
                                            <div>
                                                <strong class="text-dark small">@testRes.TestTitle</strong>
                                                <div class="text-muted" style="font-size:0.75rem;">@testRes.SubmittedAt.ToString("MMM dd, yyyy")</div>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="small">Score: <strong>@testRes.TotalScore</strong></span>
                                                @if (!string.IsNullOrEmpty(testRes.Interpretation))
                                                {
                                                    <span class="badge bg-light text-dark border" style="font-size:0.7rem;">@testRes.Interpretation</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- 4. Official Consultation Record (If recorded) -->
                @if (Model.AssociatedRecord != null)
                {
                    <div class="dr-card" style="border-left: 4px solid #0f766e !important;">
                        <div class="dr-card-header">
                            <h2 class="dr-card-title">
                                <i class="bi bi-file-earmark-medical-fill text-teal"></i> Official Consultation Record
                            </h2>
                            <div class="d-flex align-items-center gap-2">
                                @if (Model.AssociatedRecord.IsPatientConfirmed)
                                {
                                    <span class="badge rounded-pill px-3 py-1.5 fw-medium" style="background:#ecfdf5; color:#065f46; border:1px solid #a7f3d0; font-size:0.75rem;">
                                        <i class="bi bi-check-circle-fill me-1" style="color:#10b981;"></i>Patient Confirmed
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill px-3 py-1.5 fw-medium" style="background:#fffbeb; color:#92400e; border:1px solid #fde68a; font-size:0.75rem;">
                                        <i class="bi bi-hourglass-split me-1" style="color:#d97706;"></i>Awaiting Confirmation
                                    </span>
                                    <a asp-page="/Doctor/ConsultationNotes/Edit" asp-route-id="@Model.AssociatedRecord.Id" class="dr-btn-secondary py-1 px-2.5 js-note-drawer-link" style="font-size:0.75rem;">
                                        <i class="bi bi-pencil-square me-1"></i>Edit Note
                                    </a>
                                }
                            </div>
                        </div>
                        <div class="dr-card-body">
                            <div class="d-flex flex-column gap-3">
                                <!-- Diagnosis / Findings (Full Width) -->
                                <div class="dr-panel dr-panel--neutral">
                                    <div class="dr-panel-lbl" style="color:#475569;">
                                        <i class="bi bi-journal-medical text-primary"></i>
                                        <span>Diagnosis & Clinical Findings</span>
                                    </div>
                                    <p class="dr-panel-text">@(string.IsNullOrWhiteSpace(Model.AssociatedRecord.Diagnosis) ? "No diagnosis recorded" : Model.AssociatedRecord.Diagnosis.Trim())</p>
                                </div>

                                <!-- Session Notes (Full Width) -->
                                <div class="dr-panel dr-panel--neutral">
                                    <div class="dr-panel-lbl" style="color:#475569;">
                                        <i class="bi bi-chat-left-text text-secondary"></i>
                                        <span>Chief Complaints & Consultation Summary</span>
                                    </div>
                                    <p class="dr-panel-text">@(string.IsNullOrWhiteSpace(Model.AssociatedRecord.ConsultationSummary) ? "No summary recorded" : Model.AssociatedRecord.ConsultationSummary.Trim())</p>
                                </div>

                                <!-- Recommendations & Therapy Plan (Side-by-Side) -->
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="dr-panel dr-panel--success h-100">
                                            <div class="dr-panel-lbl" style="color:#166534;">
                                                <i class="bi bi-lightbulb text-success"></i>
                                                <span>Recommendations</span>
                                            </div>
                                            <p class="dr-panel-text">@(string.IsNullOrWhiteSpace(Model.AssociatedRecord.Recommendation) ? "No recommendation recorded" : Model.AssociatedRecord.Recommendation.Trim())</p>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="dr-panel dr-panel--teal h-100">
                                            <div class="dr-panel-lbl" style="color:#0f766e;">
                                                <i class="bi bi-compass" style="color:#0d9488;"></i>
                                                <span>Therapy Intervention Plan</span>
                                            </div>
                                            <p class="dr-panel-text">@(string.IsNullOrWhiteSpace(Model.AssociatedRecord.TherapyPlan) ? "No therapy plan recorded" : Model.AssociatedRecord.TherapyPlan.Trim())</p>
                                        </div>
                                    </div>
                                </div>

                                <!-- Follow-up / Next Visit (Soft Amber Note) -->
                                @if (!string.IsNullOrWhiteSpace(Model.AssociatedRecord.FollowUpNotes) || Model.AssociatedRecord.NextAppointmentRecommendedDate.HasValue)
                                {
                                    <div class="dr-panel dr-panel--amber">
                                        <div class="d-flex justify-content-between align-items-center mb-1 flex-wrap gap-2">
                                            <div class="dr-panel-lbl mb-0" style="color:#854d0e;">
                                                <i class="bi bi-calendar-event text-warning"></i>
                                                <span>Follow-up & Next Visit Instructions</span>
                                            </div>
                                            @if (Model.AssociatedRecord.NextAppointmentRecommendedDate.HasValue)
                                            {
                                                <span class="badge rounded-pill px-2.5 py-1 fw-semibold" style="background:#fef3c7; color:#92400e; border:1px solid #fde68a; font-size:0.75rem;">
                                                    <i class="bi bi-calendar-check me-1"></i>Next Visit: @Model.AssociatedRecord.NextAppointmentRecommendedDate.Value.ToString("dd/MM/yyyy")
                                                </span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(Model.AssociatedRecord.FollowUpNotes))
                                        {
                                            <p class="dr-panel-text mt-1">@Model.AssociatedRecord.FollowUpNotes.Trim()</p>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                <!-- 5. Recent Consultation Records Timeline -->
                <div class="dr-card">
                    <div class="dr-card-header">
                        <h2 class="dr-card-title">
                            <i class="bi bi-clock-history text-teal"></i> Patient Consultation History
                        </h2>
                        @if (Model.ClinicalContext?.RecentConsultations != null && Model.ClinicalContext.RecentConsultations.Any())
                        {
                            <span class="badge bg-light text-muted border px-2.5 py-1" style="font-size:0.75rem;">
                                @Model.ClinicalContext.RecentConsultations.Count Past Record(s)
                            </span>
                        }
                    </div>
                    <div class="dr-card-body">
                        @if (Model.ClinicalContext?.RecentConsultations != null && Model.ClinicalContext.RecentConsultations.Any())
                        {
                            <div class="d-flex flex-column gap-3">
                                @foreach (var note in Model.ClinicalContext.RecentConsultations)
                                {
                                    <div class="p-3 rounded-3 border bg-white">
                                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2 pb-2 border-bottom">
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="rounded-circle d-flex align-items-center justify-content-center bg-teal bg-opacity-10 text-teal" style="width:32px; height:32px; background:rgba(13,148,136,0.1); color:#0f766e; flex-shrink:0;">
                                                    <i class="bi bi-person-badge-fill" style="font-size:0.85rem;"></i>
                                                </div>
                                                <strong class="text-dark" style="font-size:0.9rem;">
                                                    @(note.DoctorName ?? "Attending Specialist")
                                                </strong>
                                            </div>
                                            <div class="d-flex align-items-center flex-wrap gap-2">
                                                @if (note.IsPatientConfirmed)
                                                {
                                                    <span class="badge rounded-pill px-2.5 py-1" style="background:#ecfdf5; color:#065f46; border:1px solid #a7f3d0; font-size:0.72rem;">
                                                        <i class="bi bi-check-circle-fill me-1" style="color:#10b981;"></i>Confirmed
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge rounded-pill px-2.5 py-1" style="background:#fffbeb; color:#92400e; border:1px solid #fde68a; font-size:0.72rem;">
                                                        <i class="bi bi-hourglass-split me-1" style="color:#d97706;"></i>Unconfirmed
                                                    </span>
                                                }
                                                <span class="text-muted small" style="font-size:0.78rem;">
                                                    <i class="bi bi-calendar3 me-1"></i>@note.ConsultationDate.ToString("dd/MM/yyyy HH:mm")
                                                </span>
                                                <a asp-page="/Doctor/ConsultationNotes/Details" asp-route-id="@note.Id" class="dr-btn-secondary py-1 px-2.5" style="font-size:0.75rem;">
                                                    <i class="bi bi-eye me-1"></i>View Record
                                                </a>
                                            </div>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(note.Diagnosis))
                                        {
                                            <div class="mb-1.5 small">
                                                <span class="fw-bold text-muted" style="font-size:0.75rem; text-transform:uppercase;">Diagnosis:</span>
                                                <span class="text-dark">@note.Diagnosis.Trim()</span>
                                            </div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(note.ConsultationSummary))
                                        {
                                            <div class="small text-muted" style="line-height:1.45;">
                                                <span class="fw-bold text-muted" style="font-size:0.75rem; text-transform:uppercase;">Summary:</span>
                                                <span>@note.ConsultationSummary.Trim()</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else if (Model.LatestConsultationNote != null)
                        {
                            var note = Model.LatestConsultationNote;
                            <div class="p-3 rounded-3 border bg-white">
                                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                    <strong class="text-dark small">Previous Visit Note (@note.CreatedAt.ToString("MMM dd, yyyy"))</strong>
                                    <a asp-page="/Doctor/ConsultationNotes/Details" asp-route-id="@note.Id" class="dr-btn-secondary py-1 px-2.5" style="font-size:0.75rem;">
                                        <i class="bi bi-eye me-1"></i>View
                                    </a>
                                </div>
                                <p class="small text-dark mb-0">@(note.ConsultationSummary ?? "No summary details recorded.")</p>
                            </div>
                        }
                        else
                        {
                            <div class="p-3 bg-light rounded-3 text-center text-muted small">
                                <i class="bi bi-info-circle me-1"></i>No previous consultation history found for this patient.
                            </div>
                        }
                    </div>
                </div>

                <!-- 6. Treatment Case Roadmap & Progress -->
                @if (Model.ClinicalContext?.TreatmentCaseContext != null)
                {
                    var tc = Model.ClinicalContext.TreatmentCaseContext;
                    <div class="dr-card" style="border-left: 4px solid #0d9488 !important;">
                        <div class="dr-card-header">
                            <h2 class="dr-card-title">
                                <i class="bi bi-heart-pulse-fill text-teal"></i> Treatment Case Progress
                            </h2>
                            <span class="badge px-3 py-1.5 rounded-pill" style="background:#ccfbf1; color:#0f766e; font-weight:700; font-size:0.78rem;">@tc.Status</span>
                        </div>
                        <div class="dr-card-body">
                            <div class="p-3 rounded-3 mb-3" style="background:#f0fdf4; border:1px solid #bbf7d0;">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <strong class="fs-5 text-dark">@tc.CaseName</strong>
                                    <a asp-page="/Doctor/TreatmentCases/Details" asp-route-id="@tc.TreatmentCaseId" class="dr-btn-secondary py-1 px-2.5" style="font-size:0.78rem;">
                                        <i class="bi bi-arrow-right-circle me-1"></i>View Roadmap
                                    </a>
                                </div>
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between text-muted small mb-1">
                                        <span>Case Roadmap Progress</span>
                                        <strong>@tc.CompletedSessions / @tc.TotalSessions Sessions (@tc.OverallProgressPercent%)</strong>
                                    </div>
                                    <div class="progress rounded-pill" style="height: 8px; background-color: #e2e8f0;">
                                        <div class="progress-bar bg-success rounded-pill" style="width: @(tc.OverallProgressPercent)%;"></div>
                                    </div>
                                </div>
                                <div class="row text-center g-2">
                                    <div class="col-4">
                                        <div class="bg-white p-2 rounded-2 border">
                                            <div class="text-muted small" style="font-size:0.72rem;">Current Session</div>
                                            <strong class="text-primary">#@tc.CurrentSessionNumber</strong>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="bg-white p-2 rounded-2 border">
                                            <div class="text-muted small" style="font-size:0.72rem;">Goals Met</div>
                                            <strong class="text-success">@tc.GoalsAchieved/@tc.TotalGoals</strong>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="bg-white p-2 rounded-2 border">
                                            <div class="text-muted small" style="font-size:0.72rem;">Homework</div>
                                            <strong class="text-teal" style="color:#0f766e;">@tc.HomeworkCompleted/@tc.HomeworkAssigned</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Cancellation Reason (If Cancelled) -->
                @if (!string.IsNullOrEmpty(apt.CancellationReason))
                {
                    <div class="p-3.5 mb-4 rounded-3 border" style="background:#fff1f2; border-color:#fecdd3; color:#9f1239;">
                        <h6 class="fw-bold mb-1 d-flex align-items-center gap-1.5"><i class="bi bi-x-circle-fill"></i> Cancellation Reason</h6>
                        <p class="mb-0 fw-medium" style="font-size:0.9rem;">@apt.CancellationReason</p>
                    </div>
                }
            </div>

            <!-- ═══ RIGHT: Sticky Actions & Patient Profile Card ═══ -->
            <div class="col-lg-4">
                <div class="dr-sticky-sidebar">
                    
                    <!-- 1. Patient Profile Card (With Link to Patient Detail Page) -->
                    <div class="dr-patient-profile-card">
                        <div class="dr-card-header">
                            <h2 class="dr-card-title"><i class="bi bi-person-circle text-teal"></i> Patient Profile</h2>
                            @if (!string.IsNullOrEmpty(patientDetailUrl))
                            {
                                <a href="@patientDetailUrl" class="small fw-bold text-decoration-none" style="color:#0f766e; font-size:0.8rem;">
                                    Details <i class="bi bi-arrow-right"></i>
                                </a>
                            }
                        </div>
                        <div class="dr-card-body">
                            @{
                                var rawInitials = string.Join("", (apt.PatientName ?? "PT").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0]));
                                var initials = string.IsNullOrWhiteSpace(rawInitials) ? "PT" : rawInitials.ToUpperInvariant();
                            }

                            @if (!string.IsNullOrEmpty(patientDetailUrl))
                            {
                                <a href="@patientDetailUrl" class="dr-patient-header-link mb-3" title="Open Patient Record">
                                    <div class="dr-patient-avatar-box">
                                        <div class="dr-patient-initials">@initials</div>
                                    </div>
                                    <div class="overflow-hidden">
                                        <h3 class="dr-patient-name text-truncate">@(apt.PatientName ?? "Patient")</h3>
                                        <div class="text-muted small">@(apt.VisitCount == 0 ? "New Patient" : "Returning Patient")</div>
                                    </div>
                                </a>
                            }
                            else
                            {
                                <div class="d-flex align-items-center gap-3 mb-3">
                                    <div class="dr-patient-avatar-box">
                                        <div class="dr-patient-initials">@initials</div>
                                    </div>
                                    <div class="overflow-hidden">
                                        <h3 class="dr-patient-name text-truncate">@(apt.PatientName ?? "Patient")</h3>
                                        <div class="text-muted small">@(apt.VisitCount == 0 ? "New Patient" : "Returning Patient")</div>
                                    </div>
                                </div>
                            }

                            <!-- Contact Rows -->
                            @{
                                var pPhone = Model.PatientRecord?.ResolvedDisplayPhone ?? apt.GuestZaloNumber;
                                var pEmail = apt.PatientEmail ?? apt.GuestEmail ?? Model.PatientRecord?.ResolvedDisplayEmail;
                                var pAddress = apt.PatientAddress ?? Model.PatientRecord?.ResolvedAddress;
                            }
                            <div class="mb-3">
                                @if (!string.IsNullOrWhiteSpace(pPhone))
                                {
                                    <a href="tel:@pPhone" class="dr-patient-contact-row" title="Call patient">
                                        <div class="dr-contact-icon-chip"><i class="bi bi-telephone-fill"></i></div>
                                        <div class="flex-grow-1 text-truncate">@pPhone</div>
                                        <i class="bi bi-chevron-right text-muted small"></i>
                                    </a>
                                }
                                @if (!string.IsNullOrWhiteSpace(pEmail))
                                {
                                    <a href="mailto:@pEmail" class="dr-patient-contact-row" title="Email patient">
                                        <div class="dr-contact-icon-chip"><i class="bi bi-envelope-fill"></i></div>
                                        <div class="flex-grow-1 text-truncate">@pEmail</div>
                                        <i class="bi bi-chevron-right text-muted small"></i>
                                    </a>
                                }
                                @if (!string.IsNullOrWhiteSpace(pAddress))
                                {
                                    <div class="dr-patient-contact-row" style="cursor:default;">
                                        <div class="dr-contact-icon-chip"><i class="bi bi-geo-alt-fill"></i></div>
                                        <div class="flex-grow-1 text-truncate" title="@pAddress">
                                            @pAddress
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- 2. Session Actions Card -->
                    <div class="dr-card">
                        <div class="dr-card-header">
                            <h2 class="dr-card-title"><i class="bi bi-sliders2 text-teal"></i> Session Actions</h2>
                        </div>
                        <div class="dr-card-body d-flex flex-column gap-2.5">
                            
                            <!-- Reschedule Request Action (Status 6) -->
                            @if (apt.Status == 6)
                            {
                                <div class="p-3 bg-warning bg-opacity-10 border border-warning-subtle rounded-3 mb-2">
                                    <div class="small fw-bold text-dark mb-1"><i class="bi bi-arrow-repeat text-warning me-1"></i>Reschedule Requested</div>
                                    <div class="small text-muted mb-1">Proposed Time:</div>
                                    <div class="fw-bold text-dark small mb-2">@(apt.ProposedSlotDate ?? "New date") (@(apt.ProposedSlotStartTime ?? "") - @(apt.ProposedSlotEndTime ?? ""))</div>
                                    <div class="d-flex gap-2">
                                        <form method="post" asp-page-handler="ApproveReschedule" class="flex-grow-1">
                                            <input type="hidden" name="id" value="@apt.Id" />
                                            <button type="submit" class="dr-btn-primary w-100 py-2" style="font-size:0.85rem;">
                                                <i class="bi bi-check-lg"></i> Approve
                                            </button>
                                        </form>
                                        <button type="button" class="dr-btn-soft-danger flex-grow-1 py-2" style="font-size:0.85rem;" data-bs-toggle="modal" data-bs-target="#rejectRescheduleModal">
                                            <i class="bi bi-x-lg"></i> Decline
                                        </button>
                                    </div>
                                </div>
                            }

                            <!-- Confirm/Approve (Status 0) -->
                            @if (apt.Status == 0)
                            {
                                <form method="post" asp-page-handler="Confirm">
                                    <input type="hidden" name="id" value="@apt.Id" />
                                    <button type="submit" class="dr-btn-primary w-100 py-2.5">
                                        <i class="bi bi-check2-circle fs-5"></i> Approve Appointment
                                    </button>
                                </form>
                            }

                            <!-- Start Consultation (Status 1) -->
                            @if (apt.Status == 1)
                            {
                                @if (canStartConsultation)
                                {
                                    <form method="post" asp-page-handler="Start">
                                        <input type="hidden" name="id" value="@apt.Id" />
                                        <button type="submit" class="dr-btn-primary w-100 py-2.5">
                                            <i class="bi bi-play-circle-fill fs-5"></i> Start Consultation Session
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button type="button" class="dr-btn-secondary w-100 py-2.5 opacity-75" disabled>
                                        <i class="bi bi-calendar-x me-1"></i> Available on @(hasScheduledDate ? scheduledDate.ToString("MMM dd, yyyy") : "appointment date")
                                    </button>
                                    <div class="text-muted text-center" style="font-size:0.75rem;">
                                        Consultation session can be started on the scheduled date.
                                    </div>
                                }
                            }

                            <!-- In Progress Flow (Status 3) -->
                            @if (apt.Status == 3)
                            {
                                @if (Model.HasConsultationNote)
                                {
                                    <div class="alert alert-success py-2 px-3 small d-flex align-items-center gap-2 rounded-3 border border-success-subtle mb-2">
                                        <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                        <span class="fw-medium text-dark">Consultation notes recorded.</span>
                                    </div>
                                    <form method="post" asp-page-handler="Complete">
                                        <input type="hidden" name="id" value="@apt.Id" />
                                        <button type="submit" class="dr-btn-primary w-100 py-2.5">
                                            <i class="bi bi-check-all fs-5"></i> Complete Appointment
                                        </button>
                                    </form>
                                    @if (Model.AssociatedRecord != null)
                                    {
                                        <a asp-page="/Doctor/ConsultationNotes/Edit" asp-route-id="@Model.AssociatedRecord.Id" class="dr-btn-secondary w-100 mt-1 js-note-drawer-link">
                                            <i class="bi bi-pencil-square text-teal"></i> Edit Recorded Note
                                        </a>
                                    }
                                }
                                else
                                {
                                    <button type="button" class="dr-btn-primary w-100 py-2.5" onclick="openClinicalNoteDrawer()">
                                        <i class="bi bi-layout-sidebar-inset-reverse fs-5"></i> Open Clinical Note Drawer
                                    </button>
                                    <div class="text-muted text-center" style="font-size:0.75rem;">
                                        Keep patient context visible while documenting this session.
                                    </div>
                                }
                            }

                            <!-- Completed State Actions (Status 4) -->
                            @if (apt.Status == 4)
                            {
                                @if (Model.AssociatedRecord != null)
                                {
                                    <a asp-page="/Doctor/ConsultationNotes/Edit" asp-route-id="@Model.AssociatedRecord.Id" class="dr-btn-secondary w-100 js-note-drawer-link">
                                        <i class="bi bi-file-earmark-medical text-teal"></i> View / Edit Consultation Note
                                    </a>
                                }
                                @if (apt.PatientId.HasValue)
                                {
                                    @if (Model.ActiveTreatmentPackage != null)
                                    {
                                        <a asp-page="/Doctor/TreatmentPackages/Edit" asp-route-id="@Model.ActiveTreatmentPackage.Id" class="dr-btn-secondary w-100">
                                            <i class="bi bi-box-seam text-teal"></i> View Treatment Package
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-page="/Doctor/TreatmentPackages/Create" asp-route-patientId="@apt.PatientId" class="dr-btn-secondary w-100">
                                            <i class="bi bi-box-seam text-teal"></i> Create Treatment Package
                                        </a>
                                    }
                                }
                            }

                            <!-- Reschedule (Only for Pending or Accepted) -->
                            @if (apt.Status is 0 or 1)
                            {
                                <a asp-page="/Doctor/Appointments/Reschedule" asp-route-id="@apt.Id" class="dr-btn-secondary w-100">
                                    <i class="bi bi-calendar2-range text-teal"></i> Reschedule Appointment
                                </a>
                            }

                            <!-- Low-priority actions live under More to keep primary flow clear -->
                            <div class="mt-2 pt-2 border-top dropdown">
                                <button type="button" class="dr-more-actions-toggle dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-three-dots"></i> More Actions
                                </button>
                                <div class="dropdown-menu dr-more-actions-menu">
                                    @if (apt.Status is 0 or 1)
                                    {
                                        <button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#doctorCancelModal">
                                            <i class="bi bi-x-circle"></i> Cancel Appointment
                                        </button>
                                    }
                                    <a asp-page="/Doctor/Appointments/Report" asp-route-id="@apt.Id" class="dropdown-item text-danger">
                                        <i class="bi bi-flag"></i> Report User or Issue
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="clinicalNoteDrawerBackdrop" class="dr-note-drawer-backdrop" onclick="closeClinicalNoteDrawer()" aria-hidden="true"></div>
        <aside id="clinicalNoteDrawer" class="dr-note-drawer" role="dialog" aria-modal="true" aria-labelledby="clinicalNoteDrawerTitle" aria-hidden="true">
            <div class="dr-note-drawer-header d-flex justify-content-between align-items-start gap-3">
                <div>
                    <div class="small fw-bold text-teal text-uppercase mb-1" style="letter-spacing:.04em;">Clinical documentation</div>
                    <h2 id="clinicalNoteDrawerTitle" class="h5 fw-bold text-dark mb-1">Consultation Note</h2>
                    <p class="text-muted small mb-0">Document findings while keeping the appointment context open.</p>
                </div>
                <button type="button" class="dr-btn-secondary px-2 py-1" onclick="closeClinicalNoteDrawer()" aria-label="Close note drawer">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="dr-note-drawer-body">
                @if (apt.Status == 3 && !Model.HasConsultationNote)
                {
                    <div id="clinicalNoteCreatePanel" class="dr-drawer-form-shell">
                        <div class="d-flex align-items-center gap-2 mb-3 pb-3 border-bottom">
                            <i class="bi bi-file-earmark-medical-fill text-teal fs-5"></i>
                            <div>
                                <h3 class="mb-0 fw-bold text-dark fs-6">Record Session & Finalize</h3>
                                <div class="text-muted small">Saving this note will complete the appointment.</div>
                            </div>
                        </div>

                        <form method="post" asp-page-handler="CreateNoteAndComplete">
                            <input type="hidden" name="id" value="@apt.Id" />
                            <input type="hidden" asp-for="NoteInput.PatientRecordId" />

                            <div class="mb-3">
                                <label class="form-label small fw-bold text-dark mb-1">
                                    Session Notes / Complaints <span class="text-danger">*</span>
                                </label>
                                <textarea asp-for="NoteInput.ConsultationSummary" class="form-control form-control-sm" rows="4" required placeholder="Session summary, chief complaints, observations..." style="border-radius:10px; font-size:0.9rem;"></textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-bold text-dark mb-1">Diagnosis / Assessment Findings</label>
                                <textarea asp-for="NoteInput.Diagnosis" class="form-control form-control-sm" rows="3" placeholder="Clinical findings..." style="border-radius:10px; font-size:0.9rem;"></textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-bold text-dark mb-1">Recommendations</label>
                                <textarea asp-for="NoteInput.Recommendation" class="form-control form-control-sm" rows="3" placeholder="Recommendations..." style="border-radius:10px; font-size:0.9rem;"></textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-bold text-dark mb-1">Therapy Plan</label>
                                <textarea asp-for="NoteInput.TherapyPlan" class="form-control form-control-sm" rows="3" placeholder="Therapy intervention plan..." style="border-radius:10px; font-size:0.9rem;"></textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-bold text-dark mb-1">Follow-up Notes</label>
                                <textarea asp-for="NoteInput.FollowUpNotes" class="form-control form-control-sm" rows="3" placeholder="Follow-up instructions..." style="border-radius:10px; font-size:0.9rem;"></textarea>
                            </div>

                            <div class="mb-3 pt-3 border-top">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <label class="form-label small fw-bold text-dark mb-0">
                                        <i class="bi bi-calendar-plus me-1 text-teal"></i>Follow-up Date (Optional)
                                    </label>
                                    <button type="button" class="btn btn-link p-0 text-muted small text-decoration-none" style="font-size:0.75rem;" onclick="clearFollowUpSelection()">
                                        Reset
                                    </button>
                                </div>
                                <input type="date" asp-for="NoteInput.NextAppointmentRecommendedDate" id="followUpDateInput" min="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control form-control-sm mb-2" style="border-radius:10px; font-size:0.9rem;" onchange="loadFollowUpSlots(this.value)" />

                                <input type="hidden" asp-for="NoteInput.NextAppointmentRecommendedSlotId" id="followUpSlotInput" />

                                <div id="followUpSlotsList" class="d-flex flex-column gap-1.5" style="max-height: 220px; overflow-y: auto;"></div>
                                <div id="followUpSlotsPlaceholder" class="p-3 rounded bg-light border text-center text-muted" style="font-size:0.82rem;">
                                    Pick a date to select an available follow-up slot.
                                </div>
                            </div>

                            <button type="submit" class="dr-btn-primary w-100 py-2.5">
                                <i class="bi bi-check-all fs-5"></i> Save Note & Complete
                            </button>
                        </form>
                    </div>
                }

                <iframe id="clinicalNoteDrawerFrame" class="dr-note-drawer-frame d-none" title="Consultation note editor"></iframe>
            </div>
        </aside>

        <!-- ═══════════════════════════════════════════════════
           MODALS (Cancel & Reject Reschedule)
           ═══════════════════════════════════════════════════ -->
        @if (apt.Status is 0 or 1)
        {
            <div class="modal fade" id="doctorCancelModal" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content" style="border-radius:16px; border:none; box-shadow:0 20px 40px rgba(0,0,0,0.12);">
                        <form method="post" asp-page-handler="Cancel">
                            <input type="hidden" name="id" value="@apt.Id" />
                            <div class="modal-header border-0 pb-0">
                                <h3 class="modal-title fs-5 fw-bold text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Cancel Appointment</h3>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <p class="text-secondary small mb-3">Cancel the appointment with <strong>@(apt.PatientName ?? "patient")</strong> on <strong>@apt.AppointmentDate</strong>?</p>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-dark">Cancellation Reason</label>
                                    <select class="form-select form-select-sm mb-2" name="cancelCategory" style="border-radius:8px;">
                                        <option value="" disabled selected>Select a primary reason...</option>
                                        <option value="Schedule Conflict">Schedule Conflict</option>
                                        <option value="Emergency">Emergency</option>
                                        <option value="Patient Request">Patient Request</option>
                                        <option value="Unavailable">Unavailable</option>
                                        <option value="Other">Other</option>
                                    </select>
                                    <textarea name="reason" class="form-control form-control-sm" rows="3" placeholder="Additional details (optional)" style="border-radius:8px;"></textarea>
                                </div>
                                <div class="alert alert-info py-2 px-3 small mb-0 d-flex align-items-center gap-2" style="border-radius:8px;">
                                    <i class="bi bi-info-circle-fill"></i>
                                    <span>Both doctors and patients must cancel at least 24 hours before the scheduled time.</span>
                                </div>
                            </div>
                            <div class="modal-footer border-0 pt-0">
                                <button type="button" class="dr-btn-secondary py-1.5 px-3" data-bs-dismiss="modal">Close</button>
                                <button type="submit" class="btn btn-danger py-1.5 px-3" style="border-radius:10px; font-weight:600;"><i class="bi bi-x-circle me-1"></i>Confirm Cancellation</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }

        @if (apt.Status == 6)
        {
            <div class="modal fade" id="rejectRescheduleModal" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content" style="border-radius:16px; border:none; box-shadow:0 20px 40px rgba(0,0,0,0.12);">
                        <form method="post" asp-page-handler="RejectReschedule" asp-route-id="@apt.Id">
                            <div class="modal-header border-0 pb-0">
                                <h3 class="modal-title fs-5 fw-bold text-danger"><i class="bi bi-x-circle-fill me-2"></i>Decline Reschedule Request</h3>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <p class="text-secondary small mb-3">Declining this request will keep the patient's appointment at the original date and time.</p>
                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-dark">Reason for declining (Optional)</label>
                                    <textarea name="reason" class="form-control form-control-sm" rows="3" placeholder="Explain why you cannot accommodate this new slot..." style="border-radius:8px;"></textarea>
                                </div>
                            </div>
                            <div class="modal-footer border-0 pt-0">
                                <button type="button" class="dr-btn-secondary py-1.5 px-3" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-danger py-1.5 px-3" style="border-radius:10px; font-weight:600;"><i class="bi bi-x-lg me-1"></i>Decline Request</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
</div>

<!-- Back to Top Floating Button -->
<button id="btnBackToTop" type="button" title="Back to top" aria-label="Back to top">
    <i class="bi bi-arrow-up-lg"></i>
</button>

@section Scripts {
<script>
    var currentFollowUpSlots = [];

    function openClinicalNoteDrawer(url) {
        var drawer = document.getElementById('clinicalNoteDrawer');
        var backdrop = document.getElementById('clinicalNoteDrawerBackdrop');
        var frame = document.getElementById('clinicalNoteDrawerFrame');
        var createPanel = document.getElementById('clinicalNoteCreatePanel');

        if (!drawer || !backdrop) return;

        if (url && frame) {
            frame.src = url;
            frame.classList.remove('d-none');
            if (createPanel) createPanel.classList.add('d-none');
        } else {
            if (frame) {
                frame.classList.add('d-none');
                frame.removeAttribute('src');
            }
            if (createPanel) createPanel.classList.remove('d-none');
        }

        backdrop.classList.add('show');
        drawer.classList.add('show');
        drawer.setAttribute('aria-hidden', 'false');
        document.body.classList.add('dr-drawer-open');
    }

    function closeClinicalNoteDrawer() {
        var drawer = document.getElementById('clinicalNoteDrawer');
        var backdrop = document.getElementById('clinicalNoteDrawerBackdrop');
        var frame = document.getElementById('clinicalNoteDrawerFrame');

        if (drawer) {
            drawer.classList.remove('show');
            drawer.setAttribute('aria-hidden', 'true');
        }
        if (backdrop) backdrop.classList.remove('show');
        document.body.classList.remove('dr-drawer-open');

        if (frame && !frame.classList.contains('d-none')) {
            window.setTimeout(function () { frame.removeAttribute('src'); }, 240);
        }
    }

    function renderFollowUpSlotCard(slot, isSelected) {
        var bgStyle = isSelected 
            ? 'background:#f0fdfa; border:1.5px solid #0d9488 !important; box-shadow:0 1px 3px rgba(13,148,136,0.15);' 
            : 'background:#ffffff; border:1px solid #e2e8f0;';
        var iconBg = isSelected ? '#0d9488' : '#f1f5f9';
        var iconColor = isSelected ? '#ffffff' : '#64748b';
        var iconClass = isSelected ? 'bi-check2-circle' : 'bi-clock';
        var textClass = isSelected ? 'fw-bold' : 'fw-semibold';
        var textColor = isSelected ? 'color:#0f766e;' : 'color:#1e293b;';
        var badgeHtml = isSelected
            ? '<span class="badge" style="background:#0d9488; color:#fff; font-size:0.68rem; font-weight:600;"><i class="bi bi-check me-0.5"></i>Selected</span>'
            : '<span class="badge bg-light text-muted border" style="font-size:0.68rem; font-weight:500;">Available</span>';

        return '<div class="p-2 rounded-3 d-flex align-items-center justify-content-between cursor-pointer mb-1.5" ' +
               'style="cursor:pointer; transition:all 0.15s ease; ' + bgStyle + '" ' +
               'onclick="selectFollowUpSlot(\'' + slot.id + '\')">' +
                   '<div class="d-flex align-items-center gap-2">' +
                       '<div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:26px; height:26px; background:' + iconBg + '; color:' + iconColor + '; font-size:0.85rem;">' +
                           '<i class="bi ' + iconClass + '"></i>' +
                       '</div>' +
                       '<div>' +
                           '<div class="' + textClass + '" style="font-size:0.84rem; ' + textColor + '">' + slot.startTime + ' - ' + slot.endTime + '</div>' +
                           (slot.label ? '<div class="text-muted" style="font-size:0.7rem;">' + slot.label + '</div>' : '') +
                       '</div>' +
                   '</div>' +
                   '<div>' + badgeHtml + '</div>' +
               '</div>';
    }

    function renderAllFollowUpSlots(selectedId) {
        var list = document.getElementById('followUpSlotsList');
        if (!list) return;

        if (currentFollowUpSlots.length === 0) {
            list.innerHTML = '';
            return;
        }

        var html = '';
        currentFollowUpSlots.forEach(function (s) {
            html += renderFollowUpSlotCard(s, s.id === selectedId);
        });
        list.innerHTML = html;
    }

    function loadFollowUpSlots(dateStr) {
        var placeholder = document.getElementById('followUpSlotsPlaceholder');
        var list = document.getElementById('followUpSlotsList');
        var slotInput = document.getElementById('followUpSlotInput');

        if (!dateStr) {
            if (placeholder) {
                placeholder.style.display = 'block';
                placeholder.innerHTML = '<i class="bi bi-calendar-event me-1"></i>Pick a date to select an available follow-up slot';
            }
            if (list) list.innerHTML = '';
            if (slotInput) slotInput.value = '';
            currentFollowUpSlots = [];
            return;
        }

        if (placeholder) placeholder.style.display = 'none';
        if (list) list.innerHTML = '<div class="p-2 text-center text-muted small"><span class="spinner-border spinner-border-sm me-2 text-primary"></span>Loading slots...</div>';

        fetch(`?handler=Slots&date=${encodeURIComponent(dateStr)}`)
            .then(function (res) { return res.json(); })
            .then(function (data) {
                if (data && data.success && data.slots && data.slots.length > 0) {
                    currentFollowUpSlots = data.slots;
                    var selectedId = slotInput ? slotInput.value : '';
                    renderAllFollowUpSlots(selectedId);
                } else {
                    currentFollowUpSlots = [];
                    if (slotInput) slotInput.value = '';
                    if (list) {
                        list.innerHTML = '<div class="p-2.5 text-center bg-light rounded-3 border text-muted small"><i class="bi bi-calendar-x d-block fs-5 mb-1 text-warning"></i>No slots available on this date.</div>';
                    }
                }
            })
            .catch(function () {
                currentFollowUpSlots = [];
                if (list) list.innerHTML = '<div class="p-2 text-center text-danger small">Error loading slots.</div>';
            });
    }

    function selectFollowUpSlot(slotId) {
        var slotInput = document.getElementById('followUpSlotInput');
        if (!slotInput) return;

        if (slotInput.value === slotId) {
            slotInput.value = '';
            renderAllFollowUpSlots('');
        } else {
            slotInput.value = slotId;
            renderAllFollowUpSlots(slotId);
        }
    }

    function clearFollowUpSelection() {
        var dateInput = document.getElementById('followUpDateInput');
        var slotInput = document.getElementById('followUpSlotInput');
        if (dateInput) dateInput.value = '';
        if (slotInput) slotInput.value = '';
        loadFollowUpSlots('');
    }

    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.js-note-drawer-link').forEach(function (link) {
            link.addEventListener('click', function (event) {
                event.preventDefault();
                openClinicalNoteDrawer(link.href);
            });
        });

        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape') {
                closeClinicalNoteDrawer();
            }
        });

        var btn = document.getElementById('btnBackToTop');
        if (btn) {
            window.addEventListener('scroll', function () {
                if (window.scrollY > 200) {
                    btn.classList.add('show');
                } else {
                    btn.classList.remove('show');
                }
            });
            btn.addEventListener('click', function () {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        }
    });
</script>
}
