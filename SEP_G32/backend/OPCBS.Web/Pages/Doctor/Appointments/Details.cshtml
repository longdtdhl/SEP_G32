    @@keyframes drLivePulse {
        0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.28); }
        50% { transform: scale(1.08); box-shadow: 0 0 0 8px rgba(37, 99, 235, 0); }
    }
    @@keyframes drLiveSweep {
        0% { transform: translateX(-130%); opacity: 0; }
        22% { opacity: 1; }
        100% { transform: translateX(130%); opacity: 0; }
    }
    @@keyframes drLiveGlow {
        0%, 100% { border-color: rgba(79, 70, 229, 0.28); box-shadow: 0 14px 30px rgba(79, 70, 229, 0.08); }
        50% { border-color: rgba(20, 184, 166, 0.48); box-shadow: 0 18px 38px rgba(20, 184, 166, 0.16); }
    }

    .dr-status-live {
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, #eef2ff 0%, #ecfeff 100%) !important;
        color: #312e81 !important;
        border-color: rgba(79, 70, 229, 0.32) !important;
        animation: drLiveGlow 2.6s ease-in-out infinite;
    }
    .dr-status-live::after {
        content: "";
        position: absolute;
        inset: 0;
        width: 46%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.78), transparent);
        animation: drLiveSweep 2.8s ease-in-out infinite;
        pointer-events: none;
    }
    .dr-status-live .bi-record-circle-fill {
        color: #2563eb !important;
        animation: drLivePulse 1.35s ease-in-out infinite;
        border-radius: 999px;
    }
    .dr-live-banner {
        position: relative;
        overflow: hidden;
        animation: drLiveGlow 3s ease-in-out infinite;
    }
    .dr-live-banner::after {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        left: -34%;
        width: 28%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.72), transparent);
        animation: drLiveSweep 3.2s ease-in-out infinite;
        pointer-events: none;
    }

    .dr-note-drawer-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1070;
        background: rgba(15, 23, 42, 0.32);
        backdrop-filter: blur(5px);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.22s ease;
    }
    .dr-note-drawer-backdrop.show {
        opacity: 1;
        pointer-events: auto;
    }
    .dr-note-drawer {
        position: fixed;
        top: 0;
        right: 0;
        z-index: 1080;
        width: min(620px, 94vw);
        height: 100vh;
        background: linear-gradient(180deg, #ffffff 0%, #f8fffd 100%);
        border-left: 1px solid rgba(13, 148, 136, 0.18);
        box-shadow: -24px 0 70px rgba(15, 23, 42, 0.22);
        transform: translateX(104%);
        transition: transform 0.28s cubic-bezier(.2,.8,.2,1);
        display: flex;
        flex-direction: column;
    }
    .dr-note-drawer.show {
        transform: translateX(0);
    }
    .dr-note-drawer-header {
        padding: 1.15rem 1.25rem;
        border-bottom: 1px solid rgba(148, 163, 184, 0.18);
        background: linear-gradient(135deg, rgba(240,253,250,0.96), rgba(239,246,255,0.78));
    }
    .dr-note-drawer-body {
        padding: 1.25rem;
        overflow-y: auto;
        flex: 1;
    }
    .dr-note-drawer-frame {
        width: 100%;
        height: 100%;
        border: 0;
        background: #ffffff;
    }
    .dr-drawer-form-shell {
        background: #ffffff;
        border: 1px solid rgba(13, 148, 136, 0.14);
        border-radius: 16px;
        box-shadow: 0 14px 34px rgba(15, 23, 42, 0.08);
        padding: 1rem;
    }
    body.dr-drawer-open {
        overflow: hidden;
    }

    /* OPCBS calm clinical tone: smaller titles, greener accents, clearer fields */
    .dr-card-header {
        padding: 0.72rem 1.05rem !important;
        background: linear-gradient(180deg, rgba(255,255,255,0.98), rgba(240,253,250,0.66)) !important;
    }
    .dr-card-title {
        font-size: 0.86rem !important;
