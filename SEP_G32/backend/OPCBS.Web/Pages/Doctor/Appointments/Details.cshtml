@page "{id:guid}"
@model OPCBS.Web.Pages.Doctor.Appointments.DetailsModel
@{
    ViewData["Title"] = "Appointment Details";
    ViewData["UseDashboardLayout"] = true;
}

<style>
    .appointment-status-banner {
        padding: 1rem 1.5rem;
        border-radius: 12px;
        margin-bottom: 1.5rem;
        font-weight: 500;
    }
    .status-pending { background-color: var(--bs-warning-bg-subtle); color: var(--bs-warning-text-emphasis); border: 1px solid var(--bs-warning-border-subtle); }
    .status-approved { background-color: var(--bs-info-bg-subtle); color: var(--bs-info-text-emphasis); border: 1px solid var(--bs-info-border-subtle); }
    .status-inprogress { background-color: var(--bs-warning-bg-subtle); color: var(--bs-warning-text-emphasis); border: 1px solid var(--bs-warning-border-subtle); }
    .status-completed { background-color: var(--bs-success-bg-subtle); color: var(--bs-success-text-emphasis); border: 1px solid var(--bs-success-border-subtle); }
    .status-rejected { background-color: var(--bs-secondary-bg-subtle); color: var(--bs-secondary-text-emphasis); border: 1px solid var(--bs-secondary-border-subtle); }
    .status-cancelled { background-color: var(--bs-danger-bg-subtle); color: var(--bs-danger-text-emphasis); border: 1px solid var(--bs-danger-border-subtle); }
</style>

<div class="mb-page-header d-flex justify-content-between align-items-center">
    <h1>Appointment Details</h1>
    <a asp-page="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back</a>
</div>

@if (Model.Error != null)
{
    <div class="alert alert-warning alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Success != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill me-2"></i>@Model.Success
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Appointment != null)
{
    var apt = Model.Appointment;
    var badgeClass = apt.Status switch
    {
        0 => "bg-warning text-dark",
        1 => "bg-info text-white",
        3 => "bg-warning text-dark",
        4 => "bg-success text-white",
        5 => "bg-danger text-white",
        2 => "bg-secondary text-white",
        _ => "bg-secondary"
    };

    var statusBannerClass = apt.Status switch
    {
        0 => "status-pending",
        1 => "status-approved",
        3 => "status-inprogress",
        4 => "status-completed",
        5 => "status-cancelled",
        2 => "status-rejected",
        _ => "status-rejected"
    };

    @* Issue 6: Treatment Package Banner *@
    @if (apt.TreatmentPackageId.HasValue && !string.IsNullOrEmpty(apt.TreatmentPackageName))
    {
        <div class="alert d-flex align-items-center gap-2 mb-3" style="background: linear-gradient(135deg, #e8f5e9, #f1f8e9); border: 1px solid #a5d6a7; border-radius: 12px; padding: 1rem 1.5rem;">
            <i class="bi bi-box-seam-fill fs-4" style="color:#2e7d32;"></i>
            <div>
                <strong style="color:#2e7d32;">Treatment Package Appointment</strong>
                <div class="small text-muted">This appointment is part of package: <strong class="text-dark">@apt.TreatmentPackageName</strong></div>
            </div>
        </div>
    }

    <!-- Status Banner -->
    <div class="appointment-status-banner @statusBannerClass">
        <div class="d-flex align-items-center gap-2">
            @if (apt.Status == 0)
            {
                <i class="bi bi-hourglass-split"></i>
                <span><strong>Pending Approval</strong> — Review the appointment details and approve or reject this booking request.</span>
            }
            else if (apt.Status == 1)
            {
                <i class="bi bi-calendar-check"></i>
                <span><strong>Approved</strong> — This appointment is confirmed. Click "Start Consultation" when the session begins.</span>
            }
            else if (apt.Status == 3)
            {
                <i class="bi bi-play-circle-fill text-warning"></i>
                <span><strong>In Progress</strong> — The consultation session is currently ongoing. Click "Complete Appointment" to finalize.</span>
            }
            else if (apt.Status == 4)
            {
                <i class="bi bi-patch-check-fill text-success"></i>
                <span><strong>Completed</strong> — This appointment has been successfully concluded.</span>
            }
            else if (apt.Status == 2)
            {
                <i class="bi bi-x-octagon-fill"></i>
                <span><strong>Rejected</strong> — You have declined this booking request.</span>
            }
            else if (apt.Status == 5)
            {
                <i class="bi bi-x-circle-fill"></i>
                <span><strong>Cancelled</strong> — This appointment was cancelled.</span>
            }
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
                    <h5 class="mb-0 fw-bold">Appointment Information</h5>
                    <span class="badge @badgeClass px-3 py-2 rounded-pill">@apt.StatusText</span>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Patient Name</div>
                        <div class="col-sm-8"><strong>@(apt.PatientName ?? "N/A")</strong></div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Start Time</div>
                        <div class="col-sm-8">@apt.StartAt.LocalDateTime.ToString("MM/dd/yyyy HH:mm")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">End Time</div>
                        <div class="col-sm-8">@apt.EndAt.LocalDateTime.ToString("MM/dd/yyyy HH:mm")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Specialization</div>
                        <div class="col-sm-8">@(apt.Specialization ?? "-")</div>
                    </div>
                    @* Issue 2: Consultation Fee removed — OPCBS does not manage pricing *@
                    @if (!string.IsNullOrEmpty(apt.TreatmentPackageName))
                    {
                        <div class="row mb-3">
                            <div class="col-sm-4 text-muted"><i class="bi bi-box-seam me-1"></i>Treatment Package</div>
                            <div class="col-sm-8">
                                <span class="badge bg-success bg-opacity-15 text-success px-2 py-1" style="border-radius:8px; font-size:0.8rem;">
                                    <i class="bi bi-box-seam me-1"></i>@apt.TreatmentPackageName
                                </span>
                            </div>
                        </div>
                    }
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted"><i class="bi bi-arrow-repeat me-1"></i>Visit Count</div>
                        <div class="col-sm-8">
                            @if (apt.VisitCount == 0)
                            {
                                <span class="badge bg-info bg-opacity-15 text-info px-2 py-1" style="border-radius:8px; font-size:0.8rem;">
                                    <i class="bi bi-person-plus me-1"></i>First consultation
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-primary bg-opacity-15 text-primary px-2 py-1" style="border-radius:8px; font-size:0.8rem;">
                                    <i class="bi bi-arrow-repeat me-1"></i>Visit #@apt.VisitCount
                                </span>
                            }
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(apt.Notes))
                    {
                        <div class="row mb-3">
                            <div class="col-sm-4 text-muted">Booking Notes</div>
                            <div class="col-sm-8 text-secondary">@apt.Notes</div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(apt.Symptoms) || !string.IsNullOrEmpty(apt.MedicalHistory) || !string.IsNullOrEmpty(apt.Expectations))
                    {
                        <div class="row mb-3 mt-3 pt-3" style="border-top:1px solid #dee2e6;">
                            <div class="col-12">
                                <h6 class="fw-bold mb-3"><i class="bi bi-clipboard2-pulse me-2" style="color:var(--mb-primary);"></i>Pre-Appointment Evaluation</h6>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(apt.Symptoms))
                        {
                            <div class="row mb-3">
                                <div class="col-sm-4 text-muted"><i class="bi bi-activity me-1"></i>Current Symptoms</div>
                                <div class="col-sm-8">
                                    <div class="p-2 rounded-2" style="background:#fef2f2; border:1px solid #fecaca;">@apt.Symptoms</div>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(apt.MedicalHistory))
                        {
                            <div class="row mb-3">
                                <div class="col-sm-4 text-muted"><i class="bi bi-journal-medical me-1"></i>Medical History</div>
                                <div class="col-sm-8">
                                    <div class="p-2 rounded-2" style="background:#f0f9ff; border:1px solid #bae6fd;">@apt.MedicalHistory</div>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(apt.Expectations))
                        {
                            <div class="row mb-3">
                                <div class="col-sm-4 text-muted"><i class="bi bi-bullseye me-1"></i>Expectations</div>
                                <div class="col-sm-8">
                                    <div class="p-2 rounded-2" style="background:#f0fdf4; border:1px solid #bbf7d0;">@apt.Expectations</div>
                                </div>
                            </div>
                        }
                    }

                    <!-- Psychometric Test Result -->
                    @if (Model.PsychometricSubmission != null)
                    {
                        <div class="row mb-3 mt-3 pt-3" style="border-top:1px solid #dee2e6;">
                            <div class="col-sm-4 text-muted">Patient Assessment Screening</div>
                            <div class="col-sm-8">
                                <div class="p-3 bg-light rounded-3 border">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <i class="bi bi-clipboard2-pulse text-primary fs-5"></i>
                                        <strong class="text-primary">@Model.PsychometricSubmission.TestTitle</strong>
                                        <span class="badge bg-success text-white ms-auto">Completed</span>
                                    </div>
                                    <div class="mb-2">
                                        <strong>Result:</strong> <span class="text-danger fw-bold">@Model.PsychometricSubmission.Interpretation</span>
                                    </div>
                                    <div class="text-muted small">
                                        Total Score: <strong>@Model.PsychometricSubmission.TotalScore</strong>
                                    </div>
                                    
                                    @if (Model.PsychometricSubmission.TestType == "DASS21")
                                    {
                                        int depScore = 0, anxScore = 0, strScore = 0;
                                        try
                                        {
                                            var doc = System.Text.Json.JsonDocument.Parse(Model.PsychometricSubmission.ScoreDataJson);
                                            var root = doc.RootElement;
                                            if (root.TryGetProperty("Depression", out var dep)) depScore = dep.GetInt32();
                                            if (root.TryGetProperty("Anxiety", out var anx)) anxScore = anx.GetInt32();
                                            if (root.TryGetProperty("Stress", out var str)) strScore = str.GetInt32();
                                        }
                                        catch { }
                                        <div class="mt-3">
                                            <div class="row g-2">
                                                <div class="col-4 text-center">
                                                    <div class="border rounded p-2" style="background:#fff;">
                                                        <div class="small text-muted">Depression</div>
                                                        <strong class="text-danger">@depScore</strong>
                                                    </div>
                                                </div>
                                                <div class="col-4 text-center">
                                                    <div class="border rounded p-2" style="background:#fff;">
                                                        <div class="small text-muted">Anxiety</div>
                                                        <strong class="text-warning">@anxScore</strong>
                                                    </div>
                                                </div>
                                                <div class="col-4 text-center">
                                                    <div class="border rounded p-2" style="background:#fff;">
                                                        <div class="small text-muted">Stress</div>
                                                        <strong class="text-info">@strScore</strong>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @* Issue 3: Previous Consultation Summary (from earlier visits) *@
                    @if (Model.LatestConsultationNote != null)
                    {
                        <div class="row mb-3 mt-3 pt-3" style="border-top:1px solid #dee2e6;">
                            <div class="col-12">
                                <h6 class="fw-bold mb-3"><i class="bi bi-clock-history me-2" style="color:#6366f1;"></i>Previous Consultation (Latest)</h6>
                            </div>
                            <div class="col-sm-12">
                                <div class="p-3 rounded-3 border" style="background:#f5f3ff;">
                                    <div class="small text-muted mb-2"><i class="bi bi-calendar3 me-1"></i>@Model.LatestConsultationNote.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                    @if (!string.IsNullOrEmpty(Model.LatestConsultationNote.Diagnosis))
                                    {
                                        <div class="mb-2"><strong>Diagnosis:</strong> @Model.LatestConsultationNote.Diagnosis</div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.LatestConsultationNote.ConsultationSummary))
                                    {
                                        <div class="mb-2"><strong>Session Notes:</strong> @Model.LatestConsultationNote.ConsultationSummary</div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.LatestConsultationNote.Recommendation))
                                    {
                                        <div class="mb-2"><strong>Recommendations:</strong> @Model.LatestConsultationNote.Recommendation</div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.LatestConsultationNote.TherapyPlan))
                                    {
                                        <div class="mb-0"><strong>Therapy Plan:</strong> @Model.LatestConsultationNote.TherapyPlan</div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @* Issue 3: Active Treatment Package *@
                    @if (Model.ActiveTreatmentPackage != null)
                    {
                        <div class="row mb-3 mt-3 pt-3" style="border-top:1px solid #dee2e6;">
                            <div class="col-sm-4 text-muted"><i class="bi bi-box-seam me-1"></i>Active Package</div>
                            <div class="col-sm-8">
                                <div class="p-3 rounded-3 border" style="background:#ecfdf5;">
                                    <div class="fw-bold text-success mb-1">@Model.ActiveTreatmentPackage.Name</div>
                                    <div class="small text-muted">
                                        Sessions: <strong>@Model.ActiveTreatmentPackage.CompletedSessions / @Model.ActiveTreatmentPackage.TotalSessions</strong>
                                        &nbsp;•&nbsp; Remaining: <strong class="text-primary">@Model.ActiveTreatmentPackage.RemainingSessions</strong>
                                    </div>
                                    <div class="small text-muted mt-1">
                                        Expires: @Model.ActiveTreatmentPackage.ExpirationDate.ToString("dd/MM/yyyy")
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(apt.CancellationReason))
                    {
                        <div class="row mb-3 mt-3 pt-3" style="border-top:1px solid #dee2e6;">
                            <div class="col-sm-4 text-muted text-danger fw-bold">Cancellation Reason</div>
                            <div class="col-sm-8 text-danger fw-semibold">@apt.CancellationReason</div>
                        </div>
                    }
                    
                    @if (Model.AssociatedRecord != null)
                    {
                        <div class="row mb-3 mt-3 pt-3" style="border-top:1px solid #dee2e6;">
                            <div class="col-sm-4 text-muted">Consultation Summary</div>
                            <div class="col-sm-8">
                                <div class="p-3 bg-light rounded-3 border">
                                    <h6 class="fw-bold mb-2">Diagnosis / Findings:</h6>
                                    <p class="mb-2 text-dark">@(Model.AssociatedRecord.Diagnosis ?? "No diagnosis recorded")</p>
                                    <h6 class="fw-bold mb-2">Session Notes:</h6>
                                    <p class="mb-2 text-dark">@(Model.AssociatedRecord.ConsultationSummary ?? "No summary recorded")</p>
                                    <h6 class="fw-bold mb-2">Recommendations:</h6>
                                    <p class="mb-0 text-dark">@(Model.AssociatedRecord.Recommendation ?? "No recommendation recorded")</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Sidebar Actions -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3"><h5 class="mb-0 fw-bold">Session Actions</h5></div>
                <div class="card-body d-grid gap-2">
                    <!-- Confirm/Approve -->
                    @if (apt.Status == 0)
                    {
                        <form method="post" asp-page-handler="Confirm">
                            <input type="hidden" name="id" value="@apt.Id" />
                            <button type="submit" class="btn btn-success w-100 py-2.5 rounded-3 fw-semibold"><i class="bi bi-check-lg me-1"></i>Approve Appointment</button>
                        </form>
                    }

                    <!-- Start Consultation -->
                    @if (apt.Status == 1)
                    {
                        <form method="post" asp-page-handler="Start">
                            <input type="hidden" name="id" value="@apt.Id" />
                            <button type="submit" class="btn btn-primary w-100 py-2.5 rounded-3 fw-semibold"><i class="bi bi-play-circle me-1"></i>Start Consultation</button>
                        </form>
                    }

                    <!-- In Progress Flow -->
                    @if (apt.Status == 3)
                    {
                        @if (Model.HasConsultationNote)
                        {
                            <div class="alert alert-success py-2 mb-2 small d-flex align-items-center gap-2">
                                <i class="bi bi-check-circle-fill"></i>
                                <span>Consultation note created!</span>
                            </div>
                            <form method="post" asp-page-handler="Complete">
                                <input type="hidden" name="id" value="@apt.Id" />
                                <button type="submit" class="btn btn-success w-100 py-2.5 rounded-3 fw-semibold mb-2"><i class="bi bi-check-all me-1"></i>Complete Appointment</button>
                            </form>
                        }
                        else
                        {
                            <div class="alert alert-warning py-2 mb-2 small d-flex align-items-center gap-2">
                                <i class="bi bi-exclamation-triangle"></i>
                                <span>Note required before completion.</span>
                            </div>
                            <button class="btn btn-success w-100 py-2.5 rounded-3 fw-semibold mb-2" data-bs-toggle="modal" data-bs-target="#createNoteModal">
                                <i class="bi bi-check-all me-1"></i>Complete Appointment
                            </button>
                        }

                        @if (Model.AssociatedRecord != null)
                        {
                            <a asp-page="/Doctor/ConsultationNotes/Edit" asp-route-id="@Model.AssociatedRecord.Id" class="btn btn-outline-success w-100 rounded-3">
                                <i class="bi bi-file-earmark-medical me-1"></i>View/Edit Note
                            </a>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-primary w-100 rounded-3" data-bs-toggle="modal" data-bs-target="#createNoteModal">
                                <i class="bi bi-file-earmark-medical me-1"></i>Write Consultation Note
                            </button>
                        }
                    }

                    <!-- Completed Flow -->
                    @if (apt.Status == 4)
                    {
                        @if (Model.AssociatedRecord != null)
                        {
                            <a asp-page="/Doctor/ConsultationNotes/Edit" asp-route-id="@Model.AssociatedRecord.Id" class="btn btn-outline-success w-100 rounded-3">
                                <i class="bi bi-file-earmark-medical me-1"></i>View/Edit Consultation Note
                            </a>
                        }
                        @* Issue 5: Toggle Create/View Package button *@
                        @if (apt.PatientId.HasValue)
                        {
                            @if (Model.ActiveTreatmentPackage != null)
                            {
                                <a asp-page="/Doctor/TreatmentPackages/Edit" asp-route-id="@Model.ActiveTreatmentPackage.Id" class="btn btn-outline-success w-100 rounded-3 mt-2">
                                    <i class="bi bi-box-seam me-1"></i>View Package Details
                                    <span class="badge bg-success ms-1">@Model.ActiveTreatmentPackage.RemainingSessions left</span>
                                </a>
                            }
                            else
                            {
                                <a asp-page="/Doctor/TreatmentPackages/Create" asp-route-patientId="@apt.PatientId" class="btn btn-outline-info w-100 rounded-3 mt-2">
                                    <i class="bi bi-box-seam me-1"></i>Create Treatment Package
                                </a>
                            }
                        }
                    }

                    <!-- Cancel Button (only for Pending or Approved) -->
                    @if (apt.Status is 0 or 1)
                    {
                        <hr />
                        <button type="button" class="btn btn-outline-danger w-100 py-2 rounded-3" data-bs-toggle="modal" data-bs-target="#doctorCancelModal">
                            <i class="bi bi-x-lg me-1"></i>Cancel Appointment
                        </button>
                    }
                    @if (apt.Status is 4 or 5 or 2)
                    {
                        <div class="text-center text-muted py-2 small">
                            <i class="bi bi-info-circle me-1"></i> Appointment session has ended.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Create Note & Complete Modal -->
    @if (apt.Status == 3)
    {
        <div class="modal fade" id="createNoteModal" tabindex="-1" aria-labelledby="createNoteModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content" style="border-radius:18px; border:none;">
                    <form method="post" asp-page-handler="CreateNoteAndComplete">
                        <input type="hidden" name="id" value="@apt.Id" />
                        <input type="hidden" asp-for="NoteInput.PatientRecordId" />
                        
                        <div class="modal-header border-0 pb-0 px-4 pt-4">
                            <h5 class="modal-title fw-bold" id="createNoteModalLabel"><i class="bi bi-file-earmark-medical text-primary me-2"></i>Consultation Note & Completion</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        
                        <div class="modal-body px-4">
                            <p class="text-muted small mb-3">Please fill in the consultation note below to complete and finalize the appointment record.</p>
                            
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Consultation Summary (Chief Complaint & Session Notes) <span class="text-danger">*</span></label>
                                <textarea asp-for="NoteInput.ConsultationSummary" class="form-control" rows="4" required placeholder="Write a summary of the patient's complaints and counselling session..." style="border-radius:10px;"></textarea>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">Diagnosis / Assessment findings</label>
                                    <textarea asp-for="NoteInput.Diagnosis" class="form-control" rows="3" placeholder="Enter counselling diagnosis or assessment findings..." style="border-radius:10px;"></textarea>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">Recommendations</label>
                                    <textarea asp-for="NoteInput.Recommendation" class="form-control" rows="3" placeholder="Enter treatment recommendations..." style="border-radius:10px;"></textarea>
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">Therapy Plan</label>
                                    <textarea asp-for="NoteInput.TherapyPlan" class="form-control" rows="3" placeholder="Enter therapy intervention plan..." style="border-radius:10px;"></textarea>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">Follow-up Notes</label>
                                    <textarea asp-for="NoteInput.FollowUpNotes" class="form-control" rows="3" placeholder="Enter follow-up instructions..." style="border-radius:10px;"></textarea>
                                </div>
                            </div>

                            @* Issue 1: Follow-up date field *@
                            <div class="mb-3 mt-3 pt-3" style="border-top:1px solid #dee2e6;">
                                <label class="form-label fw-semibold"><i class="bi bi-calendar-plus me-1 text-primary"></i>Recommended Follow-up Date</label>
                                <input type="date" asp-for="NoteInput.NextAppointmentRecommendedDate" class="form-control" style="border-radius:10px;" />
                                <div class="form-text">Set a recommended date for the patient's next visit. An email reminder will be sent 1 day before.</div>
                            </div>
                        </div>

                        <div class="modal-footer border-0 pt-0 px-4 pb-4">
                            <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold"><i class="bi bi-check-all me-1"></i>Save & Complete</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    @if (apt.Status is 0 or 1)
    {
        <!-- Doctor Cancel Modal -->
        <div class="modal fade" id="doctorCancelModal" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content" style="border-radius:16px;border:none;">
                    <form method="post" asp-page-handler="Cancel">
                        <input type="hidden" name="id" value="@apt.Id" />
                        <div class="modal-header border-0 pb-0">
                            <h5 class="modal-title"><i class="bi bi-exclamation-triangle text-danger me-2"></i>Cancel Appointment</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <p class="text-muted">Cancel the appointment with <strong>@(apt.PatientName ?? "this patient")</strong> on <strong>@apt.AppointmentDate</strong>?</p>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Cancellation Reason</label>
                                <select class="form-select mb-2" name="cancelCategory">
                                    <option value="" disabled selected>Select a reason...</option>
                                    <option value="Schedule Conflict">Schedule Conflict</option>
                                    <option value="Emergency">Emergency</option>
                                    <option value="Patient Request">Patient Request</option>
                                    <option value="Unavailable">Unavailable</option>
                                    <option value="Other">Other</option>
                                </select>
                                <textarea name="reason" class="form-control" rows="3" placeholder="Additional details (optional)" style="border-radius:10px;"></textarea>
                            </div>
                            <div class="alert alert-info py-2 small mb-0">
                                <i class="bi bi-info-circle me-1"></i>Both doctors and patients must cancel at least 24 hours before the scheduled time.
                            </div>
                        </div>
                        <div class="modal-footer border-0 pt-0">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                            <button type="submit" class="btn btn-danger"><i class="bi bi-x-circle me-1"></i>Confirm Cancellation</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}
