@page "{id:guid}"
@model OPCBS.Web.Pages.Doctor.Appointments.DetailsModel
@{
    ViewData["Title"] = "Appointment Details";
    ViewData["UseDashboardLayout"] = true;
}

<div class="mb-page-header d-flex justify-content-between align-items-center">
    <h1>Appointment Details</h1>
    <a asp-page="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back</a>
</div>

@if (Model.Error != null)
{
    <div class="alert alert-warning">@Model.Error</div>
}

@if (Model.Appointment != null)
{
    var apt = Model.Appointment;
    var badgeClass = apt.Status switch
    {
        0 => "bg-warning text-dark",
        1 => "bg-info text-white",
        4 => "bg-success",
        3 => "bg-danger",
        _ => "bg-secondary"
    };

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white d-flex justify-content-between">
                    <h5 class="mb-0">Appointment Information</h5>
                    <span class="badge @badgeClass fs-6">@apt.StatusText</span>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Patient</div>
                        <div class="col-sm-8"><strong>@(apt.PatientName ?? "N/A")</strong></div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Time start</div>
                        <div class="col-sm-8">@apt.StartAt.LocalDateTime.ToString("MM/dd/yyyy HH:mm")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">End Time</div>
                        <div class="col-sm-8">@apt.EndAt.LocalDateTime.ToString("MM/dd/yyyy HH:mm")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Specialization</div>
                        <div class="col-sm-8">@(apt.Specialization ?? "-")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Fee consultation</div>
                        <div class="col-sm-8">@(apt.Fee?.ToString("N0") ?? "-") ₫</div>
                    </div>
                    @if (!string.IsNullOrEmpty(apt.Notes))
                    {
                        <div class="row mb-3">
                            <div class="col-sm-4 text-muted">Notes</div>
                            <div class="col-sm-8">@apt.Notes</div>
                        </div>
                    }

                    <!-- Psychometric Test Result -->
                    @if (Model.PsychometricSubmission != null)
                    {
                        <div class="row mb-3 mt-3 pt-3" style="border-top:1px solid #dee2e6;">
                            <div class="col-sm-4 text-muted">Psychological screening before appointment</div>
                            <div class="col-sm-8">
                                <div class="p-3 bg-light rounded-3">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <i class="bi bi-clipboard2-pulse text-primary fs-5"></i>
                                        <strong class="text-primary">@Model.PsychometricSubmission.TestTitle</strong>
                                        <span class="badge bg-success text-white ms-auto">Test Completed</span>
                                    </div>
                                    <div class="mb-2">
                                        <strong>Result:</strong> <span class="text-danger fw-bold">@Model.PsychometricSubmission.Interpretation</span>
                                    </div>
                                    <div class="text-muted small">
                                        Total Score: <strong>@Model.PsychometricSubmission.TotalScore</strong>
                                    </div>
                                    
                                    @if (Model.PsychometricSubmission.TestType == "DASS21")
                                    {
                                        int depScore = 0, anxScore = 0, strScore = 0;
                                        try
                                        {
                                            var doc = System.Text.Json.JsonDocument.Parse(Model.PsychometricSubmission.ScoreDataJson);
                                            var root = doc.RootElement;
                                            if (root.TryGetProperty("Depression", out var dep)) depScore = dep.GetInt32();
                                            if (root.TryGetProperty("Anxiety", out var anx)) anxScore = anx.GetInt32();
                                            if (root.TryGetProperty("Stress", out var str)) strScore = str.GetInt32();
                                        }
                                        catch { }
                                        <div class="mt-3">
                                            <div class="row g-2">
                                                <div class="col-4 text-center">
                                                    <div class="border rounded p-2" style="background:#fff;">
                                                        <div class="small text-muted">Depression</div>
                                                        <strong class="text-danger">@depScore</strong>
                                                    </div>
                                                </div>
                                                <div class="col-4 text-center">
                                                    <div class="border rounded p-2" style="background:#fff;">
                                                        <div class="small text-muted">Anxiety</div>
                                                        <strong class="text-warning">@anxScore</strong>
                                                    </div>
                                                </div>
                                                <div class="col-4 text-center">
                                                    <div class="border rounded p-2" style="background:#fff;">
                                                        <div class="small text-muted">Stressed</div>
                                                        <strong class="text-info">@strScore</strong>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(apt.CancellationReason))
                    {
                        <div class="row mb-3">
                            <div class="col-sm-4 text-muted">Cancellation Reason</div>
                            <div class="col-sm-8 text-danger">@apt.CancellationReason</div>
                        </div>
                    }
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted">Created Date</div>
                        <div class="col-sm-8">@apt.CreatedAt.ToString("MM/dd/yyyy HH:mm")</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white"><h5 class="mb-0">Actions</h5></div>
                <div class="card-body d-grid gap-2">
                    @if (apt.Status == 0)
                    {
                        <form method="post" asp-page-handler="Confirm">
                            <input type="hidden" name="id" value="@apt.Id" />
                            <button type="submit" class="btn btn-success w-100"><i class="bi bi-check-lg me-1"></i>Approve Appointment</button>
                        </form>
                    }
                    @if (apt.Status == 1)
                    {
                        <form method="post" asp-page-handler="Complete">
                            <input type="hidden" name="id" value="@apt.Id" />
                            <button type="submit" class="btn btn-primary w-100 mb-2"><i class="bi bi-check-all me-1"></i>Completed</button>
                        </form>
                        @if (Model.AssociatedRecord != null)
                        {
                            <a asp-page="/Doctor/ConsultationNotes/Edit" asp-route-id="@Model.AssociatedRecord.Id" class="btn btn-outline-success">
                                <i class="bi bi-file-earmark-medical me-1"></i>Xem/Edit Profile consultation
                            </a>
                        }
                        else if (Model.PatientRecord != null)
                        {
                            <a asp-page="/Doctor/ConsultationNotes/Create" asp-route-appointmentId="@apt.Id" asp-route-patientRecordId="@Model.PatientRecord.Id" class="btn btn-outline-primary">
                                <i class="bi bi-file-earmark-medical me-1"></i>Create profile consultation
                            </a>
                        }
                        else
                        {
                            <a asp-page="/Doctor/Patients/Create" asp-route-appointmentId="@apt.Id" class="btn btn-outline-primary">
                                <i class="bi bi-person-plus me-1"></i>Create profile patient
                            </a>
                        }
                    }
                    @if (apt.Status == 4)
                    {
                        @if (Model.AssociatedRecord != null)
                        {
                            <a asp-page="/Doctor/ConsultationNotes/Edit" asp-route-id="@Model.AssociatedRecord.Id" class="btn btn-outline-success">
                                <i class="bi bi-file-earmark-medical me-1"></i>Xem/Edit Profile consultation
                            </a>
                        }
                        else if (Model.PatientRecord != null)
                        {
                            <a asp-page="/Doctor/ConsultationNotes/Create" asp-route-appointmentId="@apt.Id" asp-route-patientRecordId="@Model.PatientRecord.Id" class="btn btn-outline-primary">
                                <i class="bi bi-file-earmark-medical me-1"></i>Create profile consultation
                            </a>
                        }
                        else
                        {
                            <a asp-page="/Doctor/Patients/Create" asp-route-appointmentId="@apt.Id" class="btn btn-outline-primary">
                                <i class="bi bi-person-plus me-1"></i>Create profile patient
                            </a>
                        }
                        @if (apt.PatientId.HasValue)
                        {
                            <a asp-page="/Doctor/TreatmentPackages/Create" asp-route-patientId="@apt.PatientId" class="btn btn-outline-info mt-2">
                                <i class="bi bi-box-seam me-1"></i>Create Treatment Package
                            </a>
                        }
                    }
                    @if (apt.Status is 0 or 1)
                    {
                        <hr />
                        <form method="post" asp-page-handler="Cancel">
                            <input type="hidden" name="id" value="@apt.Id" />
                            <div class="mb-2">
                                <input name="reason" class="form-control form-control-sm" placeholder="Cancellation Reason (optional)" />
                            </div>
                            <button type="submit" class="btn btn-outline-danger w-100" onclick="return confirm('Are you sure you want to cancel?')">
                                <i class="bi bi-x-lg me-1"></i>Cancel Appointment
                            </button>
                        </form>
                    }
                    @if (apt.Status is 4 or 3)
                    {
                        <div class="text-center text-muted py-2">
                            <i class="bi bi-info-circle"></i> Appointment has ended
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
