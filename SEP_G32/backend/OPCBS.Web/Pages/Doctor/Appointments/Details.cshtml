@page "{id:guid}"
@model OPCBS.Web.Pages.Doctor.Appointments.DetailsModel
@{
    ViewData["Title"] = Model.Appointment != null ? $"Appointment - {Model.Appointment.PatientName ?? Model.Appointment.BookingCode}" : "Appointment Details";
    Layout = "_DashboardLayout";
}

<style>
    :root {
        --dr-primary: #0f766e;
        --dr-primary-hover: #0d5f58;
        --dr-primary-light: #f0fdfa;
        --dr-primary-border: #99f6e4;
        --dr-primary-glow: rgba(13, 148, 136, 0.12);
        
        --dr-bg-page: #f8fafc;
        --dr-card-bg: #ffffff;
        --dr-border-light: #e2e8f0;
        --dr-border-subtle: rgba(226, 232, 240, 0.8);
        
        --dr-text-main: #0f172a;
        --dr-text-body: #334155;
        --dr-text-muted: #64748b;
        --dr-text-subtle: #94a3b8;
    }

    /* ═══════════════════════════════════════════════════
       1. PAGE WRAPPER & BREADCRUMB
       ═══════════════════════════════════════════════════ */
    .dr-apt-wrapper {
        max-width: 1320px;
        margin: 0 auto;
        padding: 0.25rem 0.5rem 4rem;
    }

    .dr-nav-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .dr-back-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #475569;
        background: #ffffff;
        border: 1px solid #cbd5e1;
        padding: 0.45rem 0.85rem;
        border-radius: 9px;
        font-size: 0.82rem;
        font-weight: 650;
        text-decoration: none;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
        transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .dr-back-btn:hover {
        color: #0f172a;
        background: #f8fafc;
        border-color: #94a3b8;
        transform: translateY(-1px);
    }

    /* ═══════════════════════════════════════════════════
       2. HERO APPOINTMENT HEADER CARD
       ═══════════════════════════════════════════════════ */
    .dr-hero-banner {
        background: linear-gradient(135deg, #ffffff 0%, #f0fdfa 100%);
        border: 1px solid #ccfbf1;
        border-radius: 14px;
        padding: 1.25rem 1.65rem;
        margin-bottom: 1.15rem;
        box-shadow: 0 6px 20px -4px rgba(15, 118, 110, 0.05), 0 1px 3px rgba(0, 0, 0, 0.02);
        position: relative;
        overflow: hidden;
    }
    .dr-hero-banner::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        width: 4px;
        height: 100%;
        background: linear-gradient(180deg, #0d9488 0%, #14b8a6 100%);
    }

    .dr-hero-topline {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 0.35rem;
    }

    .dr-booking-chip {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-family: 'JetBrains Mono', SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.76rem;
        font-weight: 700;
        color: #0f766e;
        background: rgba(13, 148, 136, 0.09);
        border: 1px solid rgba(13, 148, 136, 0.22);
        padding: 2.5px 8px;
        border-radius: 6px;
    }

    .dr-hero-title {
        font-size: 1.35rem;
        font-weight: 800;
        color: var(--dr-text-main);
        letter-spacing: -0.02em;
        line-height: 1.3;
        margin: 0;
    }
    .dr-hero-title a {
        color: var(--dr-text-main);
        text-decoration: none;
        transition: color 0.15s ease;
    }
    .dr-hero-title a:hover {
        color: var(--dr-primary);
    }

    .dr-hero-subtitle {
        color: var(--dr-text-muted);
        font-size: 0.82rem;
        font-weight: 500;
        margin-top: 0.25rem;
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    /* ═══════════════════════════════════════════════════
       STATUS PILLS & BANNER
       ═══════════════════════════════════════════════════ */
    .dr-status-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3.5px 11px;
        border-radius: 9999px;
        font-size: 0.76rem;
        font-weight: 700;
        letter-spacing: 0.01em;
    }
    .dr-pill-pending { background: #fffbeb; color: #b45309; border: 1px solid #fde68a; }
    .dr-pill-accepted { background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; }
    .dr-pill-inprogress { background: #eef2ff; color: #4338ca; border: 1px solid #c7d2fe; }
    .dr-pill-completed { background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; }
    .dr-pill-cancelled { background: #fff1f2; color: #be123c; border: 1px solid #fecdd3; }
    .dr-pill-rejected { background: #f8fafc; color: #475569; border: 1px solid #e2e8f0; }

    .dr-status-banner-bar {
        padding: 0.7rem 1.15rem;
        border-radius: 10px;
        margin-bottom: 1.15rem;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.84rem;
        font-weight: 550;
        line-height: 1.45;
    }
    .dr-bar-pending { background: #fffbeb; color: #92400e; border: 1px solid #fde68a; }
    .dr-bar-accepted { background: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; }
    .dr-bar-inprogress { background: #eef2ff; color: #3730a3; border: 1px solid #c7d2fe; }
    .dr-bar-completed { background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; }
    .dr-bar-cancelled { background: #fff1f2; color: #9f1239; border: 1px solid #fecdd3; }
    .dr-bar-rejected { background: #f8fafc; color: #475569; border: 1px solid #e2e8f0; }

    /* ═══════════════════════════════════════════════════
       3. CONTEXT SUMMARY STRIP (4 METRIC CARDS)
       ═══════════════════════════════════════════════════ */
    .dr-metric-strip {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 0.85rem;
        margin-bottom: 1.35rem;
    }
    .dr-metric-card {
        background: #ffffff;
        border: 1px solid var(--dr-border-light);
        border-radius: 12px;
        padding: 0.85rem 1rem;
        display: flex;
        align-items: center;
        gap: 11px;
        box-shadow: 0 1px 4px rgba(15, 23, 42, 0.03);
        transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
    }
    .dr-metric-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 14px rgba(15, 23, 42, 0.05);
        border-color: #cbd5e1;
    }
    .dr-metric-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        flex-shrink: 0;
    }
    .dr-micon-teal { background: rgba(13, 148, 136, 0.1); color: #0f766e; }
    .dr-micon-blue { background: rgba(37, 99, 235, 0.1); color: #2563eb; }
    .dr-micon-indigo { background: rgba(99, 102, 241, 0.1); color: #4f46e5; }
    .dr-micon-amber { background: rgba(217, 119, 6, 0.1); color: #d97706; }

    .dr-metric-lbl {
        font-size: 0.68rem;
        font-weight: 750;
        color: var(--dr-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 0.15rem;
    }
    .dr-metric-val {
        font-size: 0.88rem;
        font-weight: 750;
        color: var(--dr-text-main);
        line-height: 1.3;
    }

    /* ═══════════════════════════════════════════════════
       4. CLINICAL CARD CONTAINERS
       ═══════════════════════════════════════════════════ */
    .dr-card {
        background: #ffffff;
        border: 1px solid var(--dr-border-light);
        border-radius: 14px;
        box-shadow: 0 2px 12px -2px rgba(15, 23, 42, 0.03), 0 1px 2px rgba(0, 0, 0, 0.02);
        margin-bottom: 1.25rem;
        overflow: hidden;
    }
    .dr-card-header {
        padding: 0.85rem 1.25rem;
        border-bottom: 1px solid #f1f5f9;
        background: rgba(255, 255, 255, 0.95);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        flex-wrap: wrap;
    }
    .dr-card-title {
        font-size: 0.94rem;
        font-weight: 750;
        color: var(--dr-text-main);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
        letter-spacing: -0.01em;
    }
    .dr-card-body {
        padding: 1.25rem;
    }

    /* Clinical Note Panels */
    .dr-panel {
        border-radius: 10px;
        padding: 0.85rem 1.05rem;
        text-align: left;
    }
    .dr-panel--neutral {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
    }
    .dr-panel--success {
        background: #f0fdf4;
        border: 1px solid #dcfce7;
    }
    .dr-panel--teal {
        background: #f0fdfa;
        border: 1px solid #ccfbf1;
    }
    .dr-panel--amber {
        background: #fffdf5;
        border: 1px solid #fef08a;
    }

    .dr-panel-lbl {
        font-size: 0.72rem;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 0.3rem;
        display: flex;
        align-items: center;
        gap: 5px;
    }
    .dr-panel-text {
        font-size: 0.86rem;
        color: var(--dr-text-main);
        line-height: 1.55;
        white-space: pre-line;
        word-break: break-word;
        margin: 0;
    }

    /* ═══════════════════════════════════════════════════
       5. PATIENT PROFILE SIDEBAR CARD
       ═══════════════════════════════════════════════════ */
    .dr-sticky-sidebar {
        position: sticky;
        top: 85px;
        z-index: 40;
    }

    .dr-patient-profile-card {
        background: linear-gradient(180deg, #ffffff 0%, #f8fffd 100%);
        border: 1px solid var(--dr-border-light);
        border-radius: 14px;
        box-shadow: 0 2px 12px -2px rgba(15, 23, 42, 0.03);
        margin-bottom: 1.25rem;
        overflow: hidden;
    }
    .dr-patient-header-link {
        display: flex;
        align-items: center;
        gap: 12px;
        text-decoration: none;
        color: inherit;
        padding: 0.15rem 0;
        transition: transform 0.15s ease;
    }
    .dr-patient-header-link:hover {
        transform: translateX(2px);
    }
    .dr-patient-header-link:hover .dr-patient-name {
        color: var(--dr-primary);
    }

    .dr-patient-avatar-box {
        position: relative;
        flex-shrink: 0;
    }
    .dr-patient-initials {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: linear-gradient(135deg, #e6f4f1 0%, #ccfbf1 100%);
        color: #0f766e;
        font-weight: 800;
        font-size: 1.15rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2.5px solid #ffffff;
        box-shadow: 0 3px 10px rgba(15, 118, 110, 0.12);
    }
    .dr-patient-name {
        font-size: 0.96rem;
        font-weight: 750;
        color: var(--dr-text-main);
        margin: 0;
        line-height: 1.25;
        transition: color 0.15s ease;
    }

    .dr-patient-contact-row {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 0.55rem 0.75rem;
        border-radius: 8px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        margin-bottom: 0.45rem;
        font-size: 0.82rem;
        text-decoration: none;
        color: var(--dr-text-main);
        transition: all 0.15s ease;
    }
    .dr-patient-contact-row:hover {
        background: #f8fafc;
        border-color: #cbd5e1;
        transform: translateX(2px);
    }
    .dr-contact-icon-chip {
        width: 26px;
        height: 26px;
        border-radius: 6px;
        background: rgba(13, 148, 136, 0.09);
        color: #0d9488;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        flex-shrink: 0;
    }

    /* ═══════════════════════════════════════════════════
       6. BUTTONS & ACTIONS
       ═══════════════════════════════════════════════════ */
    .dr-btn-primary {
        background: linear-gradient(135deg, #0f766e 0%, #0d9488 100%);
        color: #ffffff !important;
        border: none;
        font-weight: 750;
        font-size: 0.92rem;
        border-radius: 10px;
        padding: 0.8rem 1.35rem;
        box-shadow: 0 4px 14px rgba(13, 148, 136, 0.28);
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }
    .dr-btn-primary:hover {
        background: linear-gradient(135deg, #0d5f58 0%, #0f766e 100%);
        transform: translateY(-2px);
        box-shadow: 0 8px 22px rgba(13, 148, 136, 0.38);
    }

    .dr-btn-secondary {
        background: #ffffff;
        color: #334155 !important;
        border: 1px solid #cbd5e1;
        font-weight: 650;
        font-size: 0.86rem;
        border-radius: 10px;
        padding: 0.65rem 1rem;
        transition: all 0.18s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }
    .dr-btn-secondary:hover {
        background: #f8fafc;
        border-color: #94a3b8;
        color: #0f172a !important;
        transform: translateY(-1px);
    }

    .dr-btn-soft-danger {
        background: #fff1f2;
        color: #be123c !important;
        border: 1px solid #fecdd3;
        font-weight: 650;
        font-size: 0.86rem;
        border-radius: 10px;
        padding: 0.65rem 1rem;
        transition: all 0.18s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }
    .dr-btn-soft-danger:hover {
        background: #ffe4e6;
        border-color: #fda4af;
        color: #9f1239 !important;
        transform: translateY(-1px);
    }

    /* Floating Back to Top */
    #btnBackToTop {
        position: fixed;
        bottom: 30px;
        right: 30px;
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: linear-gradient(135deg, #0f766e, #0d9488);
        color: #ffffff;
        border: none;
        box-shadow: 0 6px 20px rgba(15, 118, 110, 0.35);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        cursor: pointer;
        z-index: 1050;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    #btnBackToTop:hover {
        transform: translateY(-3px) scale(1.05);
        box-shadow: 0 10px 25px rgba(15, 118, 110, 0.45);
        color: #ffffff;
    }
    #btnBackToTop.show {
        opacity: 1;
        visibility: visible;
    }

    /* ═══════════════════════════════════════════════════
       PREMIUM COLOR RETOUCH
       Softer clinical palette, layered cards, calmer status surfaces.
       ═══════════════════════════════════════════════════ */
    :root {
        --dr-bg-page: #f4faf8;
        --dr-card-bg: rgba(255, 255, 255, 0.94);
        --dr-border-light: rgba(120, 144, 156, 0.18);
        --dr-border-subtle: rgba(13, 148, 136, 0.13);
        --dr-shadow-soft: 0 16px 44px rgba(15, 23, 42, 0.07), 0 3px 10px rgba(15, 118, 110, 0.04);
        --dr-shadow-hover: 0 22px 58px rgba(15, 23, 42, 0.10), 0 6px 18px rgba(13, 148, 136, 0.08);
    }

    .dr-apt-wrapper {
        position: relative;
        isolation: isolate;
    }
    .dr-apt-wrapper::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: -1;
        background:
            radial-gradient(circle at 12% 8%, rgba(13, 148, 136, 0.12), transparent 28%),
            radial-gradient(circle at 82% 20%, rgba(37, 99, 235, 0.07), transparent 24%),
            linear-gradient(180deg, #f7fcfb 0%, #f2f8f6 52%, #f8fafc 100%);
    }

    .dr-back-btn,
    .dr-btn-secondary {
        background: rgba(255, 255, 255, 0.82) !important;
        border-color: rgba(100, 116, 139, 0.20) !important;
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.04) !important;
        backdrop-filter: blur(10px);
    }
    .dr-back-btn:hover,
    .dr-btn-secondary:hover {
        background: #ffffff !important;
        border-color: rgba(13, 148, 136, 0.28) !important;
        color: #0f766e !important;
        box-shadow: 0 14px 30px rgba(15, 23, 42, 0.08) !important;
    }

    .dr-hero-banner {
        background:
            linear-gradient(135deg, rgba(255, 255, 255, 0.96) 0%, rgba(240, 253, 250, 0.88) 55%, rgba(239, 246, 255, 0.62) 100%) !important;
        border: 1px solid rgba(13, 148, 136, 0.18) !important;
        box-shadow: var(--dr-shadow-soft) !important;
    }
    .dr-hero-banner::before {
        content: "";
        position: absolute;
        inset: -45% -18% auto auto;
        width: 460px;
        height: 460px;
        border-radius: 999px;
        background: radial-gradient(circle, rgba(13, 148, 136, 0.14), transparent 66%);
        pointer-events: none;
    }
    .dr-hero-banner::after {
        width: 5px !important;
        background: linear-gradient(180deg, #0f766e 0%, #2dd4bf 46%, #93c5fd 100%) !important;
        box-shadow: 0 0 22px rgba(13, 148, 136, 0.38);
    }
    .dr-booking-chip {
        background: rgba(255, 255, 255, 0.78) !important;
        border-color: rgba(13, 148, 136, 0.25) !important;
        color: #0f766e !important;
        box-shadow: 0 8px 18px rgba(13, 148, 136, 0.08);
    }

    .dr-status-pill {
        box-shadow: 0 6px 16px rgba(15, 23, 42, 0.05);
        border-width: 1px !important;
    }
    .dr-pill-pending { background: #fff8e6 !important; color: #9a5b00 !important; border-color: #f6d58b !important; }
    .dr-pill-accepted { background: #edf6ff !important; color: #1d4f91 !important; border-color: #b8d8ff !important; }
    .dr-pill-inprogress { background: #f0f2ff !important; color: #4338ca !important; border-color: #c7d2fe !important; }
    .dr-pill-completed { background: #eefbf5 !important; color: #047857 !important; border-color: #b8ead2 !important; }
    .dr-pill-cancelled { background: #fff0f3 !important; color: #b4234a !important; border-color: #ffc7d2 !important; }
    .dr-pill-rejected { background: #f5f7fa !important; color: #475569 !important; border-color: #d8e0ea !important; }

    .dr-status-banner-bar {
        border: 1px solid rgba(100, 116, 139, 0.14) !important;
        box-shadow: 0 10px 26px rgba(15, 23, 42, 0.045);
    }
    .dr-bar-pending { background: linear-gradient(135deg, #fffaf0, #fffef8) !important; color: #875200 !important; }
    .dr-bar-accepted { background: linear-gradient(135deg, #f0f7ff, #ffffff) !important; color: #1e4f86 !important; }
    .dr-bar-inprogress { background: linear-gradient(135deg, #f3f4ff, #ffffff) !important; color: #3730a3 !important; }
    .dr-bar-completed { background: linear-gradient(135deg, #effcf6, #ffffff) !important; color: #047857 !important; }
    .dr-bar-cancelled,
    .dr-bar-rejected { background: linear-gradient(135deg, #fff5f7, #ffffff) !important; color: #9f1239 !important; }

    .dr-metric-card,
    .dr-card,
    .dr-patient-profile-card {
        background: linear-gradient(180deg, rgba(255,255,255,0.98) 0%, rgba(248,255,253,0.92) 100%) !important;
        border-color: var(--dr-border-subtle) !important;
        box-shadow: var(--dr-shadow-soft) !important;
    }
    .dr-metric-card:hover {
        box-shadow: var(--dr-shadow-hover) !important;
        border-color: rgba(13, 148, 136, 0.24) !important;
    }
    .dr-card-header {
        background: linear-gradient(180deg, rgba(255,255,255,0.98), rgba(248,250,252,0.72)) !important;
        border-bottom-color: rgba(148, 163, 184, 0.18) !important;
    }
    .dr-card-title i {
        color: #0f766e !important;
        filter: drop-shadow(0 4px 9px rgba(13, 148, 136, 0.14));
    }

    .dr-metric-icon,
    .dr-contact-icon-chip {
        box-shadow: inset 0 0 0 1px rgba(255,255,255,0.72), 0 8px 18px rgba(15, 118, 110, 0.08);
    }
    .dr-micon-teal,
    .dr-micon-blue,
    .dr-micon-indigo,
    .dr-micon-amber {
        background: linear-gradient(135deg, rgba(236,253,245,0.95), rgba(239,246,255,0.72)) !important;
        color: #0f766e !important;
    }

    .dr-panel,
    .dr-panel--neutral,
    .dr-panel--success,
    .dr-panel--teal,
    .dr-panel--amber {
        background: linear-gradient(180deg, #ffffff 0%, #f8fbfa 100%) !important;
        border: 1px solid rgba(148, 163, 184, 0.22) !important;
        color: #0f172a !important;
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.82), 0 8px 20px rgba(15, 23, 42, 0.035);
    }
    .dr-panel-lbl,
    .dr-panel-lbl[style] {
        color: #334155 !important;
    }
    .dr-panel-lbl i,
    .dr-panel-lbl i[style] {
        color: #0d9488 !important;
    }
    .dr-panel-text {
        color: #1e293b !important;
    }

    .dr-patient-initials {
        background: linear-gradient(135deg, #dff7f2 0%, #f0f9ff 100%) !important;
        color: #0f766e !important;
        box-shadow: 0 12px 26px rgba(13, 148, 136, 0.16) !important;
