@page
@model OPCBS.Web.Pages.Doctor.Blogs.CreateModel
@{ ViewData["Title"] = "Viết bài mới"; ViewData["UseDashboardLayout"] = true; }

<style>
    .create-header { margin-bottom: 1.5rem; }
    .create-header h1 { font-size: 1.4rem; font-weight: 700; }
    .editor-card { background: white; border-radius: 14px; border: 1px solid rgba(78,139,112,0.08); overflow: hidden; }
    .editor-card .card-section { padding: 1.5rem; }
    .editor-card .card-section + .card-section { border-top: 1px solid #f1f5f9; }
    .editor-card .section-title { font-size: 0.8rem; font-weight: 600; color: var(--mb-primary); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; }
    .editor-card .form-label { font-size: 0.82rem; font-weight: 500; color: #334155; margin-bottom: 0.35rem; }
    .editor-card .form-control, .editor-card .form-select { border-radius: 10px; border: 1.5px solid #e2e8f0; font-size: 0.85rem; transition: border-color 0.2s; }
    .editor-card .form-control:focus { border-color: var(--mb-primary); box-shadow: 0 0 0 3px rgba(78,139,112,0.1); }
    .editor-card textarea.form-control { resize: vertical; }
    .meta-sidebar .meta-card { background: white; border-radius: 14px; border: 1px solid rgba(78,139,112,0.08); padding: 1.25rem; margin-bottom: 1rem; }
    .meta-sidebar .meta-title { font-size: 0.8rem; font-weight: 600; color: var(--mb-primary); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; }
    .img-preview { width: 100%; height: 120px; border-radius: 10px; background: #f1f5f9; display: flex; align-items: center; justify-content: center; overflow: hidden; margin-top: 0.5rem; border: 2px dashed #e2e8f0; }
    .img-preview img { width: 100%; height: 100%; object-fit: cover; }
    .img-preview .placeholder { color: #94a3b8; font-size: 0.8rem; }
    .btn-actions { display: flex; gap: 0.75rem; margin-top: 1rem; }
    .btn-actions .btn { border-radius: 10px; padding: 0.6rem 1.5rem; font-size: 0.85rem; font-weight: 500; }
    .tag-input-hint { font-size: 0.7rem; color: #94a3b8; margin-top: 0.25rem; }
    .char-counter { font-size: 0.7rem; color: #94a3b8; text-align: right; margin-top: 0.2rem; }
</style>

<div class="create-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1><i class="bi bi-pencil-square me-2" style="color:var(--mb-primary);"></i>Viết bài mới</h1>
        <p class="text-muted mb-0" style="font-size:0.82rem;">Soạn thảo bài viết chuyên môn để chia sẻ với bệnh nhân</p>
    </div>
    <a asp-page="Index" class="btn btn-outline-secondary btn-sm" style="border-radius:10px;"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>
</div>

@if (Model.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-triangle me-1"></i>@Model.Error<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<form method="post">
    <div class="row g-4">
        <!-- Main Editor -->
        <div class="col-lg-8">
            <div class="editor-card">
                <div class="card-section">
                    <div class="section-title"><i class="bi bi-type-h1"></i>Nội dung chính</div>
                    <div class="mb-3">
                        <label class="form-label">Tiêu đề bài viết <span class="text-danger">*</span></label>
                        <input asp-for="Input.Title" class="form-control" placeholder="VD: 5 cách quản lý stress hiệu quả cho sinh viên" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tóm tắt nội dung</label>
                        <textarea asp-for="Input.Summary" class="form-control" rows="2" placeholder="Mô tả ngắn gọn về bài viết (hiển thị trong danh sách)..."></textarea>
                    </div>
                </div>
                <div class="card-section">
                    <div class="section-title"><i class="bi bi-text-paragraph"></i>Nội dung bài viết</div>
                    <div class="mb-0">
                        <label class="form-label">Nội dung <span class="text-danger">*</span></label>
                        <textarea asp-for="Input.Content" class="form-control" rows="14" placeholder="Viết nội dung bài viết của bạn tại đây... (Hỗ trợ HTML)"></textarea>
                        <div class="char-counter"><span id="contentCount">0</span> ký tự</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Metadata Sidebar -->
        <div class="col-lg-4 meta-sidebar">
            <div class="meta-card">
                <div class="meta-title"><i class="bi bi-gear"></i>Cài đặt bài viết</div>
                <div class="mb-3">
                    <label class="form-label">Danh mục</label>
                    <select asp-for="Input.Category" class="form-select">
                        <option value="">— Chọn danh mục —</option>
                        <option value="Sức khỏe tâm thần">Sức khỏe tâm thần</option>
                        <option value="Trầm cảm">Trầm cảm</option>
                        <option value="Lo âu">Lo âu</option>
                        <option value="Stress">Stress & Áp lực</option>
                        <option value="Mối quan hệ">Mối quan hệ</option>
                        <option value="Trẻ em & Thanh thiếu niên">Trẻ em & Thanh thiếu niên</option>
                        <option value="Tự chăm sóc">Tự chăm sóc bản thân</option>
                        <option value="Khác">Khác</option>
                    </select>
                </div>
                <div class="mb-0">
                    <label class="form-label">Tags</label>
                    <input asp-for="TagsInput" class="form-control" placeholder="stress, lo âu, chánh niệm" />
                    <div class="tag-input-hint">Phân cách bằng dấu phẩy</div>
                </div>
            </div>

            <div class="meta-card">
                <div class="meta-title"><i class="bi bi-image"></i>Ảnh bìa</div>
                <div class="mb-0">
                    <label class="form-label">URL ảnh bìa</label>
                    <input asp-for="Input.ImageUrl" class="form-control" placeholder="https://example.com/image.jpg" id="imageUrlInput" />
                    <div class="img-preview" id="imgPreview">
                        <span class="placeholder"><i class="bi bi-image me-1"></i>Xem trước ảnh bìa</span>
                    </div>
                </div>
            </div>

            <div class="meta-card" style="background:linear-gradient(135deg, #f0fdf4, #ecfdf5); border-color: rgba(34,197,94,0.15);">
                <div class="meta-title" style="color:#16a34a;"><i class="bi bi-rocket-takeoff"></i>Xuất bản</div>
                <p style="font-size:0.78rem;color:#64748b;margin-bottom:1rem;">Bài viết cần được Customer Support duyệt trước khi xuất bản công khai.</p>
                <div class="btn-actions flex-column">
                    <button type="submit" asp-page-handler="" class="btn btn-outline-primary w-100">
                        <i class="bi bi-save me-1"></i>Lưu bản nháp
                    </button>
                    <button type="submit" asp-page-handler="Submit" class="btn btn-success w-100">
                        <i class="bi bi-send me-1"></i>Lưu & Gửi duyệt
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

<script>
    // Character counter
    const contentEl = document.getElementById('Input_Content');
    const counterEl = document.getElementById('contentCount');
    if (contentEl && counterEl) {
        const update = () => counterEl.textContent = contentEl.value.length;
        contentEl.addEventListener('input', update);
        update();
    }
    // Image preview
    const imgInput = document.getElementById('imageUrlInput');
    const preview = document.getElementById('imgPreview');
    if (imgInput && preview) {
        imgInput.addEventListener('input', () => {
            const url = imgInput.value.trim();
            if (url) {
                preview.innerHTML = `<img src="${url}" alt="Preview" onerror="this.parentElement.innerHTML='<span class=\\'placeholder\\'><i class=\\'bi bi-exclamation-triangle me-1\\'></i>Không tải được ảnh</span>'" />`;
            } else {
                preview.innerHTML = '<span class="placeholder"><i class="bi bi-image me-1"></i>Xem trước ảnh bìa</span>';
            }
        });
    }
</script>
