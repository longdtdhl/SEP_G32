@page "{id:guid}"
@model OPCBS.Web.Pages.Doctor.Blogs.EditModel
@{
    ViewData["Title"] = "Edit Article"; 
    Layout = "_DashboardLayout";
}

<style>
    /* Quill Editor Styling */
    .ql-toolbar.ql-snow {
        border-radius: 6px 6px 0 0 !important;
        border: 1px solid #d1d5db !important;
        border-bottom: none !important;
        background: #f8fafc;
    }
    .ql-container.ql-snow {
        border-radius: 0 0 6px 6px !important;
        border: 1px solid #d1d5db !important;
        font-size: 0.95rem;
        min-height: 320px;
        background: #ffffff;
    }
    .ql-editor {
        min-height: 320px;
        line-height: 1.7;
    }

    .editor-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }
    .editor-header-title {
        font-size: 1.35rem;
        font-weight: 700;
        color: #0f172a;
        margin: 0;
    }

    .editor-card {
        background: #ffffff;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }
    .editor-card-title {
        font-size: 0.85rem;
        font-weight: 700;
        color: #0f172a;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .form-label {
        font-size: 0.85rem;
        font-weight: 600;
        color: #334155;
        margin-bottom: 0.35rem;
    }
    .form-control, .form-select {
        border-radius: 6px;
        border: 1px solid #d1d5db;
        font-size: 0.875rem;
    }
    .form-control:focus, .form-select:focus {
        border-color: var(--mb-primary);
        box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.12);
    }

    .img-preview-box {
        width: 100%;
        height: 140px;
        border-radius: 6px;
        background: #f8fafc;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        margin-top: 0.5rem;
        border: 1px dashed #cbd5e1;
    }
    .img-preview-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .publish-box {
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 1.25rem;
    }

    .status-badge-lg {
        padding: 0.4rem 0.8rem;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        margin-bottom: 1rem;
    }
    .status-draft { background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; }
    .status-pending { background: #fffbeb; color: #92400e; border: 1px solid #fde68a; }
    .status-published { background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; }
    .status-rejected { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }

    .rejection-alert-card {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 6px;
        padding: 1rem;
        margin-bottom: 1.5rem;
    }
</style>

<!-- Header -->
<div class="editor-header">
    <div>
        <h1 class="editor-header-title"><i class="bi bi-pencil-square me-2" style="color:var(--mb-primary);"></i>Edit Article</h1>
        <p class="text-muted small mb-0">Update content and submission details for your article.</p>
    </div>
    <a asp-page="Index" class="btn btn-sm btn-outline-secondary px-3" style="border-radius: 6px;">
        <i class="bi bi-arrow-left me-1"></i>Back to List
    </a>
</div>

@if (Model.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3" style="border-radius: 6px;">
        <i class="bi bi-exclamation-triangle me-1"></i>@Model.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.CurrentStatus == "Rejected" && !string.IsNullOrEmpty(Model.RejectionReason))
{
    <div class="rejection-alert-card">
        <div class="fw-bold text-danger small mb-1"><i class="bi bi-exclamation-triangle-fill me-1"></i>Article Rejected</div>
        <div class="small text-dark">@Model.RejectionReason</div>
    </div>
}

<form method="post" asp-route-id="@Model.BlogId">
    <div class="row g-4">
        <!-- Main Form (8 cols) -->
        <div class="col-lg-8">
            <div class="editor-card">
                <div class="editor-card-title"><i class="bi bi-type-h1 text-primary"></i>Article Content</div>
                <div class="mb-3">
                    <label class="form-label">Article Title <span class="text-danger">*</span></label>
                    <input asp-for="Input.Title" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Summary / Excerpt</label>
                    <textarea asp-for="Input.Summary" class="form-control" rows="2"></textarea>
                </div>
                <div class="mb-0">
                    <label class="form-label">Main Body <span class="text-danger">*</span></label>
                    <div id="quill-editor"></div>
                    <textarea asp-for="Input.Content" id="hiddenContent" style="display:none;"></textarea>
                </div>
            </div>
        </div>

        <!-- Sidebar (4 cols) -->
        <div class="col-lg-4">
            <!-- Status Card -->
            @{
                var statusClass = Model.CurrentStatus switch { "Draft" => "status-draft", "Pending" or "PendingApproval" => "status-pending", "Published" => "status-published", "Rejected" => "status-rejected", _ => "status-draft" };
                var statusText = Model.CurrentStatus switch { "Draft" => "Draft", "Pending" or "PendingApproval" => "Pending Review", "Published" => "Published", "Rejected" => "Rejected", _ => "Draft" };
                var statusIcon = Model.CurrentStatus switch { "Draft" => "bi-file-earmark", "Pending" or "PendingApproval" => "bi-hourglass-split", "Published" => "bi-check-circle", "Rejected" => "bi-x-circle", _ => "bi-file-earmark" };
            }
            <div class="editor-card mb-3">
                <div class="editor-card-title"><i class="bi bi-info-circle text-primary"></i>Status & Metrics</div>
                <div class="status-badge-lg @statusClass">
                    <i class="bi @statusIcon"></i>
                    <span>@statusText</span>
                </div>
                <div class="d-flex justify-content-between py-1 border-bottom small">
                    <span class="text-muted">Views</span>
                    <span class="fw-semibold font-mono">@Model.ViewCount</span>
                </div>
                @if (Model.PublishedAt.HasValue)
                {
                    <div class="d-flex justify-content-between py-1 small">
                        <span class="text-muted">Published Date</span>
                        <span class="fw-medium">@Model.PublishedAt.Value.ToString("MMM dd, yyyy")</span>
                    </div>
                }
            </div>

            <!-- Settings Card -->
            <div class="editor-card mb-3">
                <div class="editor-card-title"><i class="bi bi-gear text-primary"></i>Classification & Tags</div>
                <div class="mb-3">
                    <label class="form-label">Category</label>
                    <select asp-for="Input.Category" class="form-select">
                        <option value="">— Select Category —</option>
                        <option value="Mental Health">Mental Health</option>
                        <option value="Depression">Depression</option>
                        <option value="Anxiety">Anxiety</option>
                        <option value="Stress">Stress & Burnout</option>
                        <option value="Relationships">Relationships</option>
                        <option value="Children & Adolescents">Children & Adolescents</option>
                        <option value="Self-care">Self-Care</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div class="mb-0">
                    <label class="form-label">Tags</label>
                    <input asp-for="TagsInput" class="form-control" placeholder="stress, anxiety" />
                    <div class="text-muted text-xs mt-1">Separate keywords with commas</div>
                </div>
            </div>

            <!-- Cover Image -->
            <div class="editor-card mb-3">
                <div class="editor-card-title"><i class="bi bi-image text-primary"></i>Cover Image</div>
                <div class="mb-0">
                    <label class="form-label">Image URL</label>
                    <input asp-for="Input.ImageUrl" class="form-control" id="imageUrlInput" />
                    <div class="img-preview-box" id="imgPreview">
                        @if (!string.IsNullOrEmpty(Model.Input.ImageUrl))
                        {
                            <img src="@Model.Input.ImageUrl" alt="Preview" />
                        }
                        else
                        {
                            <span class="text-muted small"><i class="bi bi-image me-1"></i>Cover Image Preview</span>
                        }
                    </div>
                </div>
            </div>

            <!-- Actions Card -->
            <div class="publish-box">
                <div class="editor-card-title mb-2"><i class="bi bi-send text-primary"></i>Publishing Actions</div>
                <div class="d-flex flex-column gap-2">
                    <button type="submit" asp-page-handler="" class="btn btn-primary w-100" style="border-radius: 6px; font-weight: 600; font-size: 0.875rem;">
                        <i class="bi bi-save me-1"></i>Save Changes
                    </button>
                    @if (Model.CurrentStatus is "Draft" or "Rejected" or null)
                    {
                        <button type="submit" asp-page-handler="Submit" class="btn btn-success w-100" style="border-radius: 6px; font-weight: 600; font-size: 0.875rem;">
                            <i class="bi bi-send me-1"></i>Submit for Review
                        </button>
                    }
                    <a asp-page="Index" class="btn btn-outline-secondary w-100" style="border-radius: 6px; font-size: 0.875rem;">
                        Cancel
                    </a>
                </div>
            </div>
        </div>
    </div>
</form>

<link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet">
<script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
<script>
    var quill = new Quill('#quill-editor', {
        theme: 'snow',
        placeholder: 'Write article content here...',
        modules: {
            toolbar: [
                [{ 'header': [1, 2, 3, false] }],
                ['bold', 'italic', 'underline', 'strike'],
                [{ 'color': [] }, { 'background': [] }],
                [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                ['blockquote', 'code-block'],
                ['link', 'image'],
                [{ 'align': [] }],
                ['clean']
            ]
        }
    });

    var existingContent = document.getElementById('hiddenContent').value;
    if (existingContent) {
        quill.root.innerHTML = existingContent;
    }

    document.querySelectorAll('form').forEach(function(form) {
        form.addEventListener('submit', function() {
            document.getElementById('hiddenContent').value = quill.root.innerHTML;
        });
    });

    var imgInput = document.getElementById('imageUrlInput');
    var preview = document.getElementById('imgPreview');
    if (imgInput && preview) {
        imgInput.addEventListener('input', function() {
            var url = imgInput.value.trim();
            if (url) {
                preview.innerHTML = '<img src="' + url + '" alt="Preview" onerror="this.parentElement.innerHTML=\'<span class=text-danger small><i class=bi bi-exclamation-triangle me-1></i>Invalid Image URL</span>\'" />';
            } else {
                preview.innerHTML = '<span class="text-muted small"><i class="bi bi-image me-1"></i>Cover Image Preview</span>';
            }
        });
    }
</script>
