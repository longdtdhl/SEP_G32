@model OPCBS.Web.DTOs.TreatmentCaseListWebDto
@{
    var statusClass = Model.Status == 0 ? "active" : Model.Status == 1 ? "paused" : Model.Status == 2 ? "completed" : "cancelled";
    var statusLabel = Model.Status == 0 ? "Active" : Model.Status == 1 ? "On Hold" : Model.Status == 2 ? "Completed" : Model.Status == 3 ? "Terminated" : Model.Status == 5 ? "Cancelled" : "Other";
    var progressColor = Model.OverallProgressPercent >= 100 ? "#10b981" : Model.OverallProgressPercent >= 50 ? "#3b82f6" : "#f59e0b";
}

<div class="col-md-6 col-xl-4">
    <div class="tc-card h-100 d-flex flex-column justify-content-between">
        <div>
            <div class="tc-card-header">
                <div class="d-flex justify-content-between align-items-start mb-1">
                    <h6 style="font-weight:700; font-size:0.92rem; color:#1e293b; margin:0; max-width:70%;" class="text-truncate" title="@Model.CaseName">@Model.CaseName</h6>
                    <span class="tc-status @statusClass">@statusLabel</span>
                </div>
                <span class="text-muted" style="font-size:0.78rem;"><i class="bi bi-person-fill me-1" style="color:var(--mb-primary);"></i>@(Model.PatientName ?? "Unknown")</span>
            </div>
            <div class="tc-card-body">
                @if (!string.IsNullOrEmpty(Model.PackageNameSnapshot))
                {
                    <div class="tc-meta-row"><i class="bi bi-box-seam"></i><span class="text-truncate" title="@Model.PackageNameSnapshot">Package: <strong style="color:#1e293b;">@Model.PackageNameSnapshot</strong></span></div>
                }
                <div class="tc-meta-row"><i class="bi bi-camera-video"></i><span>Sessions: <strong style="color:#1e293b;">@Model.CompletedSessions / @Model.TotalSessions</strong></span></div>
                <div class="tc-meta-row"><i class="bi bi-calendar3"></i><span>Started: <strong style="color:#1e293b;">@Model.StartDate.ToString("dd/MM/yyyy")</strong></span></div>
                <div style="margin-top:8px;">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span style="font-size:0.7rem; color:#94a3b8; font-weight:500;">Progress</span>
                        <span style="font-size:0.7rem; color:@progressColor; font-weight:700;">@(Model.OverallProgressPercent)%</span>
                    </div>
                    <div class="tc-progress-track">
                        <div class="tc-progress-fill" style="width:@(Model.OverallProgressPercent)%; background:@progressColor;"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="tc-card-footer">
            <a href="/Doctor/TreatmentCases/Details?id=@Model.Id" class="btn btn-sm btn-outline-primary w-100 d-flex align-items-center justify-content-center gap-1" style="border-radius:6px; font-size:0.78rem; font-weight:600;">
                <i class="bi bi-eye"></i>View Details
            </a>
        </div>
    </div>
</div>
