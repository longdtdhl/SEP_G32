@page
@model OPCBS.Web.Pages.Doctor.TreatmentCases.DetailsModel
@{ ViewData["Title"] = Model.Case?.CaseName ?? "Treatment Case Details"; }

<div class="container py-4">
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>@Model.ErrorMessage</div>
        return;
    }

    @if (Model.Case == null) { <div class="alert alert-warning">Case not found.</div> return; }

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <a href="/Doctor/TreatmentCases" class="text-decoration-none text-muted mb-2 d-inline-block"><i class="bi bi-arrow-left me-1"></i>Back to Cases</a>
            <h2 class="fw-bold mb-1">@Model.Case.CaseName</h2>
            <p class="text-muted mb-0">
                <i class="bi bi-person me-1"></i>@(Model.Case.PatientName ?? "Unknown") &middot;
                <span class="@Model.Case.StatusBadgeClass">@Model.Case.StatusText</span> &middot;
                Started @Model.Case.StartDate.ToString("MMM dd, yyyy")
            </p>
        </div>
        @if (Model.Case.Status == 0)
        {
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#updateCaseModal">
                    <i class="bi bi-pencil me-1"></i>Edit Case
                </button>
                <button class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#closeCaseModal">
                    <i class="bi bi-x-circle me-1"></i>Close Case
                </button>
            </div>
        }
    </div>

    <!-- Progress Overview Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center p-3" style="border-radius: 12px;">
                <div class="display-6 fw-bold text-success">@(Model.Progress?.OverallProgressPercent ?? 0)%</div>
                <small class="text-muted">Overall Progress</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center p-3" style="border-radius: 12px;">
                <div class="display-6 fw-bold text-primary">@Model.Case.CompletedSessions/@Model.Case.TotalSessions</div>
                <small class="text-muted">Sessions</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center p-3" style="border-radius: 12px;">
                <div class="display-6 fw-bold text-info">@Model.Case.AchievedGoalCount/@Model.Case.GoalCount</div>
                <small class="text-muted">Goals Achieved</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-center p-3" style="border-radius: 12px;">
                <div class="display-6 fw-bold text-warning">@Model.Case.CompletedAssignmentCount/@Model.Case.AssignmentCount</div>
                <small class="text-muted">Homework Done</small>
            </div>
        </div>
    </div>

    <!-- Tabs -->
    <ul class="nav nav-tabs mb-4" role="tablist">
        <li class="nav-item"><a class="nav-link active" data-bs-toggle="tab" href="#tab-sessions"><i class="bi bi-camera-video me-1"></i>Sessions</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-goals"><i class="bi bi-bullseye me-1"></i>Goals</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-timeline"><i class="bi bi-clock-history me-1"></i>Timeline</a></li>
        <li class="nav-item"><a class="nav-link" data-bs-toggle="tab" href="#tab-info"><i class="bi bi-info-circle me-1"></i>Overview</a></li>
    </ul>

    <div class="tab-content">
        <!-- Sessions Tab -->
        <div class="tab-pane fade show active" id="tab-sessions">
            @if (Model.Case.Status == 0 && Model.Case.RemainingSessions > 0)
            {
                <form method="post" asp-page-handler="CreateSession" class="mb-3">
                    <input type="hidden" name="caseId" value="@Model.Case.Id" />
                    <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-plus-circle me-1"></i>Add Session</button>
                </form>
            }
            @if (!Model.Sessions.Any())
            {
                <p class="text-muted">No sessions yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light"><tr><th>#</th><th>Status</th><th>Summary</th><th>Mood</th><th>Date</th><th>Actions</th></tr></thead>
                        <tbody>
                        @foreach (var s in Model.Sessions)
                        {
                            <tr>
                                <td class="fw-bold">Session @s.SessionNumber</td>
                                <td><span class="@s.StatusBadgeClass">@s.StatusText</span></td>
                                <td>@(s.SessionSummary ?? "<em class='text-muted'>Not completed</em>")</td>
                                <td>@(s.MoodBefore.HasValue ? $"{s.MoodBefore}→{s.MoodAfter}" : "-")</td>
                                <td>@s.CreatedAt.ToString("MMM dd")</td>
                                <td>
                                    @if (s.Status == 0)
                                    {
                                        <button class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#completeSession-@s.Id">Complete</button>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- Goals Tab -->
        <div class="tab-pane fade" id="tab-goals">
            @if (Model.Case.Status == 0)
            {
                <button class="btn btn-primary btn-sm mb-3" data-bs-toggle="modal" data-bs-target="#createGoalModal"><i class="bi bi-plus-circle me-1"></i>Add Goal</button>
            }
            @if (!Model.Goals.Any())
            {
                <p class="text-muted">No goals set yet.</p>
            }
            else
            {
                @foreach (var g in Model.Goals)
                {
                    <div class="card mb-3 border-0 shadow-sm" style="border-radius: 10px;">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h6 class="fw-bold mb-1">@g.Title</h6>
                                    <p class="text-muted small mb-2">@g.Description</p>
                                    <span class="@g.PriorityBadgeClass me-2">@g.PriorityText</span>
                                    <span class="@g.StatusBadgeClass">@g.StatusText</span>
                                </div>
                                @if (Model.Case.Status == 0)
                                {
                                    <button class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#updateGoal-@g.Id">Edit</button>
                                }
                            </div>
                            <div class="progress mt-3" style="height: 6px;">
                                <div class="progress-bar bg-success" style="width: @g.ProgressPercent%;"></div>
                            </div>
                            <small class="text-muted">@g.ProgressPercent% complete</small>
                        </div>
                    </div>

                    <!-- Update Goal Modal -->
                    <div class="modal fade" id="updateGoal-@g.Id" tabindex="-1">
                        <div class="modal-dialog"><div class="modal-content">
                            <form method="post" asp-page-handler="UpdateGoal">
                                <input type="hidden" name="caseId" value="@Model.Case.Id" />
                                <input type="hidden" name="goalId" value="@g.Id" />
                                <div class="modal-header"><h5 class="modal-title">Update Goal: @g.Title</h5></div>
                                <div class="modal-body">
                                    <div class="mb-3"><label class="form-label">Status</label>
                                        <select name="status" class="form-select">
                                            <option value="0" selected="@(g.Status == 0)">Not Started</option>
                                            <option value="1" selected="@(g.Status == 1)">In Progress</option>
                                            <option value="2" selected="@(g.Status == 2)">Achieved</option>
                                            <option value="3" selected="@(g.Status == 3)">Deferred</option>
                                        </select></div>
                                    <div class="mb-3"><label class="form-label">Progress %</label>
                                        <input type="number" name="progressPercent" class="form-control" min="0" max="100" value="@g.ProgressPercent" /></div>
                                    <div class="mb-3"><label class="form-label">Notes</label>
                                        <textarea name="doctorNotes" class="form-control" rows="3">@g.DoctorNotes</textarea></div>
                                </div>
                                <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save</button></div>
                            </form>
                        </div></div>
                    </div>
                }
            }
        </div>

        <!-- Timeline Tab -->
        <div class="tab-pane fade" id="tab-timeline">
            @if (!Model.Timeline.Any())
            {
                <p class="text-muted">No activity yet.</p>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var t in Model.Timeline)
                    {
                        <div class="list-group-item border-0 px-0">
                            <div class="d-flex align-items-start">
                                <div class="me-3"><i class="bi @t.IconCss fs-4 text-primary"></i></div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between">
                                        <strong>@t.Title</strong>
                                        <small class="text-muted">@t.EventDate.ToString("MMM dd, yyyy HH:mm")</small>
                                    </div>
                                    <p class="text-muted small mb-0">@t.Description</p>
                                    @if (!string.IsNullOrEmpty(t.Status))
                                    {
                                        <span class="badge bg-secondary mt-1">@t.Status</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Overview Tab -->
        <div class="tab-pane fade" id="tab-info">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm p-4" style="border-radius: 12px;">
                        <h6 class="fw-bold mb-3">Case Information</h6>
                        <p><strong>Description:</strong> @(Model.Case.CaseDescription ?? "N/A")</p>
                        <p><strong>Primary Concern:</strong> @(Model.Case.PrimaryConcern ?? "N/A")</p>
                        <p><strong>Start Date:</strong> @Model.Case.StartDate.ToString("MMMM dd, yyyy")</p>
                        <p><strong>Expected End:</strong> @(Model.Case.ExpectedEndDate?.ToString("MMMM dd, yyyy") ?? "N/A")</p>
                        @if (Model.Case.ActualEndDate.HasValue)
                        {
                            <p><strong>Actual End:</strong> @Model.Case.ActualEndDate.Value.ToString("MMMM dd, yyyy")</p>
                        }
                        @if (!string.IsNullOrEmpty(Model.Case.ClosureNote))
                        {
                            <p><strong>Closure Note:</strong> @Model.Case.ClosureNote</p>
                        }
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm p-4" style="border-radius: 12px;">
                        <h6 class="fw-bold mb-3">Treatment Progress</h6>
                        @if (Model.Progress != null)
                        {
                            <p><strong>Days Elapsed:</strong> @Model.Progress.DaysElapsed</p>
                            <p><strong>Days Remaining:</strong> @(Model.Progress.DaysRemaining?.ToString() ?? "N/A")</p>
                            <div class="mb-2"><small>Sessions (@Model.Progress.SessionProgressPercent%)</small>
                                <div class="progress" style="height:6px;"><div class="progress-bar bg-primary" style="width:@(Model.Progress.SessionProgressPercent)%"></div></div></div>
                            <div class="mb-2"><small>Goals (@Model.Progress.GoalProgressPercent%)</small>
                                <div class="progress" style="height:6px;"><div class="progress-bar bg-info" style="width:@(Model.Progress.GoalProgressPercent)%"></div></div></div>
                            <div class="mb-2"><small>Homework (@Model.Progress.AssignmentProgressPercent%)</small>
                                <div class="progress" style="height:6px;"><div class="progress-bar bg-warning" style="width:@(Model.Progress.AssignmentProgressPercent)%"></div></div></div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Complete Session Modals -->
@foreach (var s in Model.Sessions.Where(s => s.Status == 0))
{
    <div class="modal fade" id="completeSession-@s.Id" tabindex="-1">
        <div class="modal-dialog"><div class="modal-content">
            <form method="post" asp-page-handler="CompleteSession">
                <input type="hidden" name="caseId" value="@Model.Case.Id" />
                <input type="hidden" name="sessionId" value="@s.Id" />
                <div class="modal-header"><h5 class="modal-title">Complete Session #@s.SessionNumber</h5></div>
                <div class="modal-body">
                    <div class="mb-3"><label class="form-label">Session Summary</label><textarea name="sessionSummary" class="form-control" rows="3" required></textarea></div>
                    <div class="mb-3"><label class="form-label">Therapist Notes (Private)</label><textarea name="therapistNotes" class="form-control" rows="2"></textarea></div>
                    <div class="row g-3">
                        <div class="col-6"><label class="form-label">Mood Before (1-10)</label><input type="number" name="moodBefore" class="form-control" min="1" max="10" /></div>
                        <div class="col-6"><label class="form-label">Mood After (1-10)</label><input type="number" name="moodAfter" class="form-control" min="1" max="10" /></div>
                    </div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-success">Complete Session</button></div>
            </form>
        </div></div>
    </div>
}

<!-- Create Goal Modal -->
<div class="modal fade" id="createGoalModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form method="post" asp-page-handler="CreateGoal">
            <input type="hidden" name="caseId" value="@Model.Case?.Id" />
            <div class="modal-header"><h5 class="modal-title">Add Treatment Goal</h5></div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label">Goal Title</label><input type="text" name="title" class="form-control" required /></div>
                <div class="mb-3"><label class="form-label">Description</label><textarea name="description" class="form-control" rows="2"></textarea></div>
                <div class="row g-3">
                    <div class="col-6"><label class="form-label">Priority</label>
                        <select name="priority" class="form-select"><option value="0">Low</option><option value="1" selected>Medium</option><option value="2">High</option></select></div>
                    <div class="col-6"><label class="form-label">Target Date</label><input type="date" name="targetDate" class="form-control" /></div>
                </div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Create Goal</button></div>
        </form>
    </div></div>
</div>

<!-- Update Case Modal -->
<div class="modal fade" id="updateCaseModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form method="post" asp-page-handler="UpdateCase">
            <input type="hidden" name="caseId" value="@Model.Case?.Id" />
            <div class="modal-header"><h5 class="modal-title">Edit Case</h5></div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label">Description</label>
                    <textarea name="caseDescription" class="form-control" rows="2">@Model.Case?.CaseDescription</textarea></div>
                <div class="mb-3"><label class="form-label">Primary Concern</label>
                    <textarea name="primaryConcern" class="form-control" rows="2">@Model.Case?.PrimaryConcern</textarea></div>
                <div class="mb-3"><label class="form-label">Status</label>
                    <select name="status" class="form-select">
                        <option value="0" selected="@(Model.Case?.Status == 0)">Active</option>
                        <option value="1" selected="@(Model.Case?.Status == 1)">On Hold</option>
                    </select></div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save Changes</button></div>
        </form>
    </div></div>
</div>

<!-- Close Case Modal -->
<div class="modal fade" id="closeCaseModal" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <form method="post" asp-page-handler="CloseCase">
            <input type="hidden" name="caseId" value="@Model.Case?.Id" />
            <div class="modal-header"><h5 class="modal-title text-danger">Close Treatment Case</h5></div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label">Close Reason</label>
                    <select name="closeStatus" class="form-select"><option value="2">Completed Successfully</option><option value="3">Terminated Early</option></select></div>
                <div class="mb-3"><label class="form-label">Closure Note</label><textarea name="closureNote" class="form-control" rows="3"></textarea></div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-danger">Close Case</button></div>
        </form>
    </div></div>
</div>
