@page
@model OPCBS.Web.Pages.Doctor.TreatmentCases.Homework.CreateModel
@{
    ViewData["Title"] = "Assign Homework";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-3" style="max-width: 700px;">
    <a href="/Doctor/TreatmentCases/Details?id=@Model.CaseId&tab=homework" class="text-decoration-none text-muted small d-inline-block mb-2">
        <i class="bi bi-arrow-left me-1"></i>Back to Homework
    </a>
    <h4 class="fw-bold mb-1">Assign Homework</h4>
    <p class="text-muted small mb-3">Create a homework assignment for the patient.</p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger rounded-3 mb-3"><i class="bi bi-exclamation-triangle me-2"></i>@Model.ErrorMessage</div>
    }

    <div class="card border-0 shadow-sm rounded-3 p-4">
        <form method="post" asp-page-handler="Create">
            <input type="hidden" name="caseId" value="@Model.CaseId" />

            <div class="mb-3">
                <label class="form-label small fw-bold">Assign to Session</label>
                <select name="sessionId" class="form-select">
                    <option value="">— General (not session-specific) —</option>
                    @foreach (var s in Model.Sessions)
                    {
                        <option value="@s.Id">Session @s.SessionNumber: @(s.Title ?? $"Session {s.SessionNumber}")</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-bold">Homework Title <span class="text-danger">*</span></label>
                <input type="text" name="title" class="form-control" placeholder="e.g. Negative Thoughts Journal 3x/day" required />
            </div>

            <div class="mb-3">
                <label class="form-label small fw-bold">Short Description</label>
                <textarea name="description" class="form-control" rows="2"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-bold">Detailed Instructions</label>
                <textarea name="detailedInstructions" class="form-control" rows="3" placeholder="Specific execution steps..."></textarea>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label small fw-bold">Resource URL</label>
                    <input type="url" name="resourceUrl" class="form-control" placeholder="https://..." />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-bold">Due Date</label>
                    <input type="date" name="dueDate" class="form-control" />
                </div>
            </div>

            <div class="d-flex justify-content-between">
                <a href="/Doctor/TreatmentCases/Details?id=@Model.CaseId&tab=homework" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary px-4"><i class="bi bi-journal-plus me-1"></i>Assign Homework</button>
            </div>
        </form>
    </div>
</div>
