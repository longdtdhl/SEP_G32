@page
@model OPCBS.Web.Pages.Doctor.TreatmentCases.Homework.CreateModel
@{
    ViewData["Title"] = "Assign Therapy Homework";
    Layout = "_DashboardLayout";
}

<style>
    .tc-create-page { max-width: 1120px; margin: 0 auto; }
    .tc-create-page .form-label { font-size: .9rem; margin-bottom: .45rem; }
    .tc-create-page .form-control, .tc-create-page .form-select { min-height: 46px; font-size: .95rem; }
    .tc-create-page textarea.form-control { min-height: 120px; }
</style>
<div class="container-fluid py-3 tc-create-page">
    <a href="/Doctor/TreatmentCases/Details?id=@Model.CaseId&tab=activities&subTab=homework" class="text-decoration-none text-muted fs-7 d-inline-block mb-2">
        <i class="bi bi-arrow-left me-1"></i> Back to Homework & Activities
    </a>
    <h1 class="fs-3 fw-bold text-dark mb-1">
        <i class="bi bi-journal-plus text-teal me-2" style="color:#0d9488;"></i> Assign Therapy Homework
    </h1>
    <p class="text-muted mb-4">Define a session-linked activity, its completion condition, and the evidence the patient should submit.</p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 mb-3">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="bg-white border rounded-3 p-4 p-lg-5 shadow-sm">
        <form method="post" asp-page-handler="Create">
            <input type="hidden" name="caseId" value="@Model.CaseId" />

            <div class="mb-3">
                <label class="form-label fw-bold text-dark">Link to Session <span class="text-danger">*</span></label>
                <select name="sessionId" class="form-select" required>
                    <option value="">— General Case Homework (Not Session Specific) —</option>
                    @foreach (var s in Model.Sessions)
                    {
                        <option value="@s.Id">Session @s.SessionNumber: @(s.Title ?? $"Session {s.SessionNumber}")</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold text-dark">Homework Title <span class="text-danger">*</span></label>
                <input type="text" name="title" class="form-control" placeholder="e.g. Daily CBT Thought Record & Coping Log" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold text-dark">Summary Overview</label>
                <textarea name="description" class="form-control" rows="2" placeholder="Brief summary of what this homework entails..."></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold text-dark">Completion Conditions & Instructions <span class="text-danger">*</span></label>
                <textarea name="detailedInstructions" class="form-control" rows="5" required placeholder="State what the patient needs to do, how often, and what reflection or evidence they must submit..."></textarea>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label fw-bold text-dark">Resource URL (Optional)</label>
                    <input type="url" name="resourceUrl" class="form-control" placeholder="https://..." />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold text-dark">Due Date <span class="text-danger">*</span></label>
                    <input type="date" name="dueDate" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                <a href="/Doctor/TreatmentCases/Details?id=@Model.CaseId&tab=activities&subTab=homework" class="btn btn-outline-secondary px-4" style="border-radius:8px;">Cancel</a>
                <button type="submit" class="btn btn-primary px-4 py-2 d-inline-flex align-items-center gap-2" style="background:#0d9488; border-color:#0d9488; border-radius:8px; font-weight:600;">
                    <i class="bi bi-check-circle-fill"></i> Assign Homework
                </button>
            </div>
        </form>
    </div>
</div>
