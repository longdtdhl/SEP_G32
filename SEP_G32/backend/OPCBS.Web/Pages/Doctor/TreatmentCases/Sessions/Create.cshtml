@page
@model OPCBS.Web.Pages.Doctor.TreatmentCases.Sessions.CreateModel
@{
    ViewData["Title"] = "Add Custom Session";
    Layout = "_DashboardLayout";
    var packageExhausted = Model.IsPackageExhausted;
}

<style>
    .tc-create-page { max-width: 1120px; margin: 0 auto; }
    .tc-create-page .form-label { font-size: .9rem; margin-bottom: .45rem; }
    .tc-create-page .form-control { min-height: 46px; font-size: .95rem; }
    .tc-create-page textarea.form-control { min-height: 140px; }
    .session-summary-card { border: 1px solid #e2e8f0; border-radius: 14px; background: #fff; }
    .session-summary-card .summary-chip { display:inline-flex; align-items:center; gap:.4rem; padding:.4rem .65rem; border-radius:999px; background:#eef6f4; color:#0f766e; font-size:.82rem; font-weight:700; }
    .session-form-card { border: 1px solid #dbe7e4; border-radius: 16px; background:#fff; }
</style>
<div class="container-fluid py-3 tc-create-page">
    <a href="/Doctor/TreatmentCases/Details?id=@Model.CaseId&tab=sessions" class="text-decoration-none text-muted fs-7 d-inline-block mb-2">
        <i class="bi bi-arrow-left me-1"></i> Back to Sessions
    </a>
    <h1 class="fs-3 fw-bold text-dark mb-1">
        <i class="bi bi-calendar-plus text-teal me-2" style="color:#0d9488;"></i> Add Custom Treatment Session
    </h1>
    <p class="text-muted mb-4">Add a planned session. Schedule it from the case calendar to create the linked appointment.</p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 mb-3">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="session-summary-card p-4 shadow-sm">
                <h6 class="fw-bold text-muted small text-uppercase mb-3">
                    <i class="bi bi-heart-pulse me-1"></i>Treatment Case
                </h6>
                <div class="mb-3">
                    <div class="fw-bold text-dark fs-5">@(Model.TreatmentCase?.CaseName ?? "Treatment case")</div>
                    <div class="text-muted small">Patient: @(Model.TreatmentCase?.PatientName ?? "N/A")</div>
                </div>
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <span class="summary-chip"><i class="bi bi-calendar2-check"></i>@(Model.TreatmentCase?.CompletedSessions ?? 0)/@(Model.TreatmentCase?.TotalSessions ?? 0) sessions</span>
                    <span class="summary-chip"><i class="bi bi-graph-up"></i>@(Model.TreatmentCase?.OverallProgressPercent ?? 0)% progress</span>
                </div>
                <div class="alert alert-info small rounded-3 mb-0">
                    <i class="bi bi-info-circle-fill me-1"></i>
                    This creates one planned session only. It does not auto-generate a full schedule.
                </div>
                @if (packageExhausted)
                {
                    <div class="alert alert-warning small rounded-3 mt-3 mb-0">
                        <i class="bi bi-hourglass-split me-1"></i>
                        @Model.PackageExhaustedMessage
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-8">
            <div class="session-form-card p-4 p-lg-5 shadow-sm">
                <form method="post" asp-page-handler="Create">
                    <input type="hidden" name="caseId" value="@Model.CaseId" />

                    <h5 class="fw-bold text-dark mb-3">
                        <i class="bi bi-calendar-plus me-2" style="color:#0d9488;"></i>Session Information
                    </h5>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark">Session Title <span class="text-danger">*</span></label>
                        <input type="text" name="title" class="form-control" placeholder="e.g. Mid-treatment evaluation and goal review" required disabled="@packageExhausted" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark">Description & Agenda</label>
                        <textarea name="description" class="form-control" rows="5" placeholder="Outline key topics, assessments, or interventions planned for this session..." disabled="@packageExhausted"></textarea>
                    </div>

                    <div class="mb-4 p-3 rounded-4 bg-light border">
                        <h6 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                            <i class="bi bi-calendar2-plus text-primary" style="color:#0d9488 !important;"></i> Select Time Slot
                        </h6>

                        <!-- Date Picker Row -->
                        <div class="row g-2 align-items-end mb-3">
                            <div class="col-sm-7 col-md-6">
                                <label class="form-label small fw-semibold text-muted mb-1">Select Date</label>
                                <input type="date" id="sessionDatePicker" class="form-control" value="@(string.IsNullOrWhiteSpace(Model.Date) ? DateTime.Today.ToString("yyyy-MM-dd") : Model.Date)" min="@DateTime.Today.ToString("yyyy-MM-dd")" style="border-radius:10px;" onchange="loadDoctorSlots(this.value)" disabled="@packageExhausted" />
                            </div>
                            <div class="col-sm-5 col-md-4">
                                <button type="button" class="btn btn-outline-primary w-100" style="border-radius:10px; border-color:#0d9488; color:#0d9488;" onclick="loadDoctorSlots(document.getElementById('sessionDatePicker').value)" disabled="@packageExhausted">
                                    <i class="bi bi-search me-1"></i>View Slots
                                </button>
                            </div>
                        </div>

                        <!-- Available Time Slots Grid -->
                        <div class="mb-2">
                            <label class="form-label small fw-bold text-dark mb-2" id="slotHeaderLabel">Available Time Slots for @(string.IsNullOrWhiteSpace(Model.Date) ? DateTime.Today.ToString("yyyy-MM-dd") : Model.Date)</label>
                            <div id="slotsContainer" class="row g-2">
                                @if (Model.AvailableSlots?.Slots != null && Model.AvailableSlots.Slots.Any(s => s.Status == 0))
                                {
                                    @foreach (var slot in Model.AvailableSlots.Slots.Where(s => s.Status == 0))
                                    {
                                        <div class="col-6 col-sm-4 col-md-3">
                                            <input type="radio" class="btn-check" name="slotRadio" id="slot_@slot.Id" value="@slot.Id" data-start="@slot.StartTime" data-end="@slot.EndTime" onchange="onSlotSelected(this)" @(packageExhausted ? "disabled" : "") />
                                            <label class="btn btn-outline-primary w-100 p-2.5 rounded-3 text-center" for="slot_@slot.Id" style="border-radius:10px;">
                                                <div class="fw-bold fs-6">@slot.StartTime</div>
                                                <div class="small opacity-75">until @slot.EndTime</div>
                                            </label>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="col-12 p-3 text-center bg-white rounded-3 border border-dashed text-muted">
                                        <i class="bi bi-calendar-x d-block fs-4 mb-1"></i>
                                        <span class="small">No available time slots on this date. Select another date above or create slots in Schedule Management.</span>
                                    </div>
                                }
                            </div>
                            <input type="hidden" name="sessionDate" id="hiddenSessionDate" value="@(string.IsNullOrWhiteSpace(Model.Date) ? DateTime.Today.ToString("yyyy-MM-dd") : Model.Date)" />
                            <input type="hidden" name="startTime" id="hiddenStartTime" />
                            <input type="hidden" name="endTime" id="hiddenEndTime" />
                            <input type="hidden" name="selectedSlotId" id="hiddenSlotId" />
                        </div>
                    </div>

                    <div class="alert alert-light border small rounded-3 mb-4">
                        <i class="bi bi-calendar-range me-1" style="color:#0d9488;"></i>
                        Selecting a time slot sets the planned schedule for this session.
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a href="/Doctor/TreatmentCases/Details?id=@Model.CaseId&tab=sessions" class="btn btn-outline-secondary px-4" style="border-radius:8px;">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 py-2 d-inline-flex align-items-center gap-2" style="background:#0d9488; border-color:#0d9488; border-radius:8px; font-weight:600;" disabled="@packageExhausted">
                            <i class="bi bi-plus-lg"></i> Add Session to Case
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    async function loadDoctorSlots(dateStr) {
        if (!dateStr) return;
        document.getElementById('slotHeaderLabel').textContent = 'Available Time Slots for ' + dateStr;
        document.getElementById('hiddenSessionDate').value = dateStr;
        document.getElementById('hiddenStartTime').value = '';
        document.getElementById('hiddenEndTime').value = '';
        document.getElementById('hiddenSlotId').value = '';
        const container = document.getElementById('slotsContainer');
        container.innerHTML = '<div class="col-12 py-3 text-center text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Loading time slots...</div>';

        try {
            const resp = await fetch(`?handler=Slots&date=${dateStr}&caseId=@Model.CaseId`);
            const result = await resp.json();
            if (result && result.slots && result.slots.length > 0) {
                const openSlots = result.slots.filter(s => s.status === 0);
                if (openSlots.length === 0) {
                    container.innerHTML = `<div class="col-12 p-3 text-center bg-white rounded-3 border border-dashed text-muted"><i class="bi bi-calendar-x d-block fs-4 mb-1"></i>No available slots on this date</div>`;
                    return;
                }
                container.innerHTML = openSlots.map(s => `
                    <div class="col-6 col-sm-4 col-md-3">
                        <input type="radio" class="btn-check" name="slotRadio" id="slot_${s.id}" value="${s.id}" data-start="${s.startTime}" data-end="${s.endTime}" onchange="onSlotSelected(this)" />
                        <label class="btn btn-outline-primary w-100 p-2.5 rounded-3 text-center" for="slot_${s.id}" style="border-radius:10px;">
                            <div class="fw-bold fs-6">${s.startTime}</div>
                            <div class="small opacity-75">until ${s.endTime}</div>
                        </label>
                    </div>
                `).join('');
            } else {
                container.innerHTML = `<div class="col-12 p-3 text-center bg-white rounded-3 border border-dashed text-muted"><i class="bi bi-calendar-x d-block fs-4 mb-1"></i>No available slots on this date</div>`;
            }
        } catch (e) {
            container.innerHTML = `<div class="col-12 p-3 text-center text-danger">Failed to load slots.</div>`;
        }
    }

    function onSlotSelected(radio) {
        document.getElementById('hiddenSlotId').value = radio.value;
        document.getElementById('hiddenStartTime').value = radio.dataset.start;
        document.getElementById('hiddenEndTime').value = radio.dataset.end;
    }
</script>
}
