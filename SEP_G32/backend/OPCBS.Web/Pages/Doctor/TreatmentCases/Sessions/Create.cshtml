@page
@model OPCBS.Web.Pages.Doctor.TreatmentCases.Sessions.CreateModel
@{
    ViewData["Title"] = "Add Session";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-3" style="max-width: 700px;">
    <a href="/Doctor/TreatmentCases/Details?id=@Model.CaseId&tab=sessions" class="text-decoration-none text-muted small d-inline-block mb-2">
        <i class="bi bi-arrow-left me-1"></i>Back to Sessions
    </a>
    <h4 class="fw-bold mb-1">Add New Session</h4>
    <p class="text-muted small mb-3">Manually add a session to this treatment case.</p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger rounded-3 mb-3"><i class="bi bi-exclamation-triangle me-2"></i>@Model.ErrorMessage</div>
    }

    <div class="card border-0 shadow-sm rounded-3 p-4">
        <form method="post" asp-page-handler="Create">
            <input type="hidden" name="caseId" value="@Model.CaseId" />

            <div class="mb-3">
                <label class="form-label small fw-bold">Session Title</label>
                <input type="text" name="title" class="form-control" placeholder="e.g. Initial Assessment" />
            </div>

            <div class="mb-3">
                <label class="form-label small fw-bold">Description / Agenda</label>
                <textarea name="description" class="form-control" rows="3" placeholder="What will be covered in this session..."></textarea>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label small fw-bold">Planned Start Time</label>
                    <input type="datetime-local" name="plannedStartTime" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-bold">Planned End Time</label>
                    <input type="datetime-local" name="plannedEndTime" class="form-control" />
                </div>
            </div>

            <div class="d-flex justify-content-between">
                <a href="/Doctor/TreatmentCases/Details?id=@Model.CaseId&tab=sessions" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary px-4"><i class="bi bi-plus-lg me-1"></i>Add Session</button>
            </div>
        </form>
    </div>
</div>
