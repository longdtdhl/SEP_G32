@page
@model OPCBS.Web.Pages.Doctor.TreatmentCases.Goals.CreateModel
@{
    ViewData["Title"] = "Add Treatment Goal";
    Layout = "_DashboardLayout";
}

<style>
    .tc-create-page { max-width: 1120px; margin: 0 auto; }
    .tc-create-page .form-label { font-size: .9rem; margin-bottom: .45rem; }
    .tc-create-page .form-control, .tc-create-page .form-select { min-height: 46px; font-size: .95rem; }
    .tc-create-page textarea.form-control { min-height: 140px; }
</style>
<div class="container-fluid py-3 tc-create-page">
    <a href="/Doctor/TreatmentCases/Details?id=@Model.CaseId&tab=goals" class="text-decoration-none text-muted fs-7 d-inline-block mb-2">
        <i class="bi bi-arrow-left me-1"></i> Back to Goals & Outcomes
    </a>
    <h1 class="fs-3 fw-bold text-dark mb-1">
        <i class="bi bi-bullseye text-teal me-2" style="color:#0d9488;"></i> Add Therapeutic Goal
    </h1>
    <p class="text-muted mb-4">Define a measurable outcome that can be reviewed with the patient over several sessions.</p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 mb-3">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="bg-white border rounded-3 p-4 p-lg-5 shadow-sm">
        <form method="post" asp-page-handler="Create">
            <input type="hidden" name="caseId" value="@Model.CaseId" />

            <div class="mb-3">
                <label class="form-label fs-7 fw-bold text-dark">Goal Title <span class="text-danger">*</span></label>
                <input type="text" name="title" class="form-control" placeholder="e.g. Reduce GAD-7 anxiety score by 50%" required />
            </div>

            <div class="mb-3">
                <label class="form-label fs-7 fw-bold text-dark">Description & Clinical Rationale</label>
                <textarea name="description" class="form-control" rows="3" placeholder="Describe the therapeutic objectives and methodology..."></textarea>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label fs-7 fw-bold text-dark">Category</label>
                    <select name="category" class="form-select">
                        <option value="0">Other / General</option>
                        <option value="1">Anxiety Reduction</option>
                        <option value="2">Depression Management</option>
                        <option value="3">Behavioral Change</option>
                        <option value="4">Coping Skills</option>
                        <option value="5">Relationship Improvement</option>
                        <option value="6">Sleep Quality</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label fs-7 fw-bold text-dark">Priority</label>
                    <select name="priority" class="form-select">
                        <option value="0">Low</option>
                        <option value="1" selected>Medium</option>
                        <option value="2">High</option>
                        <option value="3">Critical</option>
                    </select>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label class="form-label fs-7 fw-bold text-dark">Target Measured Value</label>
                    <input type="number" step="0.1" name="targetValue" class="form-control" placeholder="e.g. 5" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fs-7 fw-bold text-dark">Unit of Measurement</label>
                    <input type="text" name="unit" class="form-control" placeholder="e.g. GAD-7 score, points" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fs-7 fw-bold text-dark">Target Completion Date</label>
                    <input type="date" name="targetDate" class="form-control" />
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                <a href="/Doctor/TreatmentCases/Details?id=@Model.CaseId&tab=goals" class="btn btn-outline-secondary px-4" style="border-radius:8px;">Cancel</a>
                <button type="submit" class="btn btn-primary px-4 py-2 d-inline-flex align-items-center gap-2" style="background:#0d9488; border-color:#0d9488; border-radius:8px; font-weight:600;">
                    <i class="bi bi-plus-lg"></i> Create Therapeutic Goal
                </button>
            </div>
        </form>
    </div>
</div>
