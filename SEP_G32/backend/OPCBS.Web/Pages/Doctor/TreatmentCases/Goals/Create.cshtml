@page
@model OPCBS.Web.Pages.Doctor.TreatmentCases.Goals.CreateModel
@{
    ViewData["Title"] = "Add Treatment Goal";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-3" style="max-width: 700px;">
    <a href="/Doctor/TreatmentCases/Details?id=@Model.CaseId&tab=goals" class="text-decoration-none text-muted small d-inline-block mb-2">
        <i class="bi bi-arrow-left me-1"></i>Back to Goals
    </a>
    <h4 class="fw-bold mb-1">Add Treatment Goal</h4>
    <p class="text-muted small mb-3">Define a measurable therapeutic goal for this treatment case.</p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger rounded-3 mb-3"><i class="bi bi-exclamation-triangle me-2"></i>@Model.ErrorMessage</div>
    }

    <div class="card border-0 shadow-sm rounded-3 p-4">
        <form method="post" asp-page-handler="Create">
            <input type="hidden" name="caseId" value="@Model.CaseId" />

            <div class="mb-3">
                <label class="form-label small fw-bold">Goal Title <span class="text-danger">*</span></label>
                <input type="text" name="title" class="form-control" placeholder="e.g. Reduce anxiety by 50%" required />
            </div>

            <div class="mb-3">
                <label class="form-label small fw-bold">Description</label>
                <textarea name="description" class="form-control" rows="2" placeholder="Detailed description of the goal..."></textarea>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label small fw-bold">Category</label>
                    <select name="category" class="form-select">
                        <option value="0">Other</option>
                        <option value="1">Anxiety Reduction</option>
                        <option value="2">Depression Management</option>
                        <option value="3">Behavioral Change</option>
                        <option value="4">Coping Skills</option>
                        <option value="5">Relationship Improvement</option>
                        <option value="6">Sleep Quality</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-bold">Priority</label>
                    <select name="priority" class="form-select">
                        <option value="0">Low</option>
                        <option value="1" selected>Medium</option>
                        <option value="2">High</option>
                        <option value="3">Critical</option>
                    </select>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Target Value</label>
                    <input type="number" step="0.1" name="targetValue" class="form-control" placeholder="e.g. 5" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Unit</label>
                    <input type="text" name="unit" class="form-control" placeholder="e.g. GAD-7 score" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Deadline</label>
                    <input type="date" name="targetDate" class="form-control" />
                </div>
            </div>

            <div class="d-flex justify-content-between">
                <a href="/Doctor/TreatmentCases/Details?id=@Model.CaseId&tab=goals" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary px-4"><i class="bi bi-plus-lg me-1"></i>Create Goal</button>
            </div>
        </form>
    </div>
</div>
