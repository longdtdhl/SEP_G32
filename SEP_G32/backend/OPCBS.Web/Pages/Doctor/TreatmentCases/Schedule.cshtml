@page
@model OPCBS.Web.Pages.Doctor.TreatmentCases.ScheduleModel
@{
    ViewData["Title"] = "Generate Treatment Schedule";
    Layout = "_DashboardLayout";
}
<style>
    .sched-section { background: #fff; border-radius: 8px; border: 1px solid #e2e8f0; padding: 1.5rem; margin-bottom: 1.25rem; }
    .sched-section h6 { font-weight: 700; font-size: 1.125rem; margin-bottom: 1rem; color: #0f172a; }
    .day-check { display: inline-flex; align-items: center; gap: .4rem; padding: 8px 16px; border: 1px solid #e2e8f0; border-radius: 6px; cursor: pointer; font-size: 0.875rem; font-weight: 600; transition: all .15s; min-height: 40px; user-select: none; }
    .day-check:has(input:checked) { background: #0d9488; color: #fff; border-color: #0d9488; }
    .day-check:hover:not(:has(input:checked)) { background: #f0fdfa; border-color: #99f6e4; }
    .day-check input { display: none; }
    .sched-info-label { font-size: 0.8125rem; color: #64748b; margin-bottom: 2px; }
    .sched-info-value { font-size: 0.9375rem; font-weight: 600; color: #0f172a; }
</style>

<div class="container-fluid py-3">
    <a href="/Doctor/TreatmentCases/Details?id=@Model.CaseId&tab=calendar" class="text-decoration-none d-inline-block mb-2" style="color: #64748b; font-size: 0.875rem;">
        <i class="bi bi-arrow-left me-1"></i>Back to Treatment Case
    </a>
    <h1 class="mb-1" style="font-size: 1.625rem; font-weight: 700; color: #0f172a;">Generate Treatment Schedule</h1>
    <p class="mb-3" style="color: #64748b; font-size: 0.9375rem;">Automatically create sessions and appointments based on your availability.</p>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger rounded-2 mb-3" style="font-size: 0.9375rem;">
            <i class="bi bi-exclamation-triangle me-2"></i>@Model.ErrorMessage
        </div>
    }

    @if (Model.Case == null)
    {
        <div class="alert alert-warning rounded-2">Treatment case not found.</div>
        return;
    }

    <div class="row g-4">
        <!-- LEFT: Schedule Form (7/12) -->
        <div class="col-lg-7">
            <form method="post" asp-page-handler="Generate">
                <input type="hidden" name="caseId" value="@Model.CaseId" />

                <div class="sched-section">
                    <h6><i class="bi bi-calendar-range me-2" style="color: #0d9488;"></i>Recurrence Setup</h6>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Days of Week</label>
                        <div class="d-flex flex-wrap gap-2">
                            <label class="day-check"><input type="checkbox" name="daysOfWeek" value="Monday" checked>Mon</label>
                            <label class="day-check"><input type="checkbox" name="daysOfWeek" value="Tuesday">Tue</label>
                            <label class="day-check"><input type="checkbox" name="daysOfWeek" value="Wednesday">Wed</label>
                            <label class="day-check"><input type="checkbox" name="daysOfWeek" value="Thursday">Thu</label>
                            <label class="day-check"><input type="checkbox" name="daysOfWeek" value="Friday">Fri</label>
                            <label class="day-check"><input type="checkbox" name="daysOfWeek" value="Saturday">Sat</label>
                            <label class="day-check"><input type="checkbox" name="daysOfWeek" value="Sunday">Sun</label>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Start Date</label>
                            <input type="date" name="startDate" class="form-control" value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Session Start Time</label>
                            <input type="time" name="startTime" class="form-control" value="09:00" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Duration</label>
                            <select name="durationMinutes" class="form-select" required>
                                <option value="30">30 minutes</option>
                                <option value="45">45 minutes</option>
                                <option value="60" selected>60 minutes</option>
                                <option value="90">90 minutes</option>
                                <option value="120">120 minutes</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Max Weeks <span class="fw-normal" style="color: #94a3b8;">(optional, 0 = auto)</span></label>
                            <input type="number" name="totalWeeks" class="form-control" value="0" min="0" />
                        </div>
                    </div>

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="clearExistingFutureSessions" value="true" id="clearFuture">
                        <label class="form-check-label" for="clearFuture" style="color: #64748b;">
                            <i class="bi bi-exclamation-triangle text-warning me-1"></i>Cancel existing Planned/Scheduled sessions before generating
                        </label>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <a href="/Doctor/TreatmentCases/Details?id=@Model.CaseId&tab=calendar" class="btn btn-outline-secondary px-3" style="border-radius: 6px;">Cancel</a>
                    <button type="submit" class="btn px-4 py-2" style="background: #0d9488; color: #fff; font-weight: 600; border-radius: 6px; min-height: 44px;">
                        <i class="bi bi-calendar-range me-2"></i>Generate Schedule
                    </button>
                </div>
            </form>
        </div>

        <!-- RIGHT: Case Info Sidebar (5/12) -->
        <div class="col-lg-5">
            <div class="sched-section" style="position: sticky; top: 1rem;">
                <h6><i class="bi bi-info-circle me-2" style="color: #0d9488;"></i>Treatment Case</h6>
                <div class="mb-3">
                    <div class="sched-info-label">Case Name</div>
                    <div class="sched-info-value">@Model.Case.CaseName</div>
                </div>
                <div class="mb-3">
                    <div class="sched-info-label">Patient</div>
                    <div class="sched-info-value">@(Model.Case.PatientName ?? "N/A")</div>
                </div>
                <div class="row mb-3">
                    <div class="col-4">
                        <div class="sched-info-label">Total</div>
                        <div class="sched-info-value">@Model.Case.TotalSessions</div>
                    </div>
                    <div class="col-4">
                        <div class="sched-info-label">Completed</div>
                        <div class="sched-info-value text-success">@Model.Case.CompletedSessions</div>
                    </div>
                    <div class="col-4">
                        <div class="sched-info-label">Remaining</div>
                        <div class="sched-info-value" style="color: #0d9488;">@Model.Case.RemainingSessions</div>
                    </div>
                </div>
                @if (Model.Case.StartDate != default)
                {
                    <div class="mb-3">
                        <div class="sched-info-label">Treatment Period</div>
                        <div class="sched-info-value" style="font-size: 0.875rem;">
                            @Model.Case.StartDate.ToString("MMM dd, yyyy")
                            @if (Model.Case.ExpectedEndDate.HasValue)
                            {
                                <span> → @Model.Case.ExpectedEndDate.Value.ToString("MMM dd, yyyy")</span>
                            }
                        </div>
                    </div>
                }
                <div class="p-3 rounded-2" style="background: #f0fdfa; border: 1px solid #ccfbf1;">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-lightbulb" style="color: #0d9488; font-size: 1.25rem;"></i>
                        <span style="font-size: 0.8125rem; color: #475569;">
                            The system will skip dates with existing booked slots and auto-create appointments.
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
