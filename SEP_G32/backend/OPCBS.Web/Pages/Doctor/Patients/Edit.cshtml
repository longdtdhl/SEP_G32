@page "{id:guid}"
@model OPCBS.Web.Pages.Doctor.Patients.EditModel
@{
    ViewData["Title"] = "Update Patient Profile";

    Layout = "_DashboardLayout";}

<style>
    .form-section { margin-bottom: 1.5rem; }
    .form-section-title {
        font-size: 0.85rem; font-weight: 700; color: #1e293b; margin-bottom: 0.75rem;
        padding-bottom: 0.5rem; border-bottom: 2px solid rgba(78,139,112,0.1);
        display: flex; align-items: center; gap: 8px;
    }
    .form-section-title i { color: var(--mb-primary); }

    .patient-info-card {
        background: linear-gradient(135deg, #f0fdf8, #ecfdf5); border-radius: 14px; padding: 1.25rem;
        border: 1px solid rgba(16,185,129,0.15);
    }
    
    .form-control { border-radius: 10px; }
</style>

<div class="mb-page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 style="font-size:1.4rem; font-weight:700; margin:0;">
            <i class="bi bi-pencil-square me-2" style="color:var(--mb-primary);"></i>Update Patient Profile
        </h1>
        <p style="margin:4px 0 0; font-size:0.85rem; color:#64748b;">Edit basic information and clinical history</p>
    </div>
    <a asp-page="./Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary px-3 py-2" style="border-radius:10px;">
        <i class="bi bi-arrow-left me-1"></i> Back
    </a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mt-3" style="border-radius:12px;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form method="post" class="mt-4">
    <input type="hidden" asp-for="Id" />
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm" style="border-radius:16px;">
                <div class="card-body p-4">
                    <div class="form-section-title justify-content-between">
                        <div><i class="bi bi-person-badge"></i>Personal Information</div>
                        @if (Model.PatientRecord?.IsGuest == true)
                        {
                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning ms-auto small" style="font-size:0.7rem;"><i class="bi bi-person me-1"></i>Guest Record</span>
                        }
                        else
                        {
                            <span class="badge bg-light text-secondary border ms-auto small" style="font-size:0.7rem;"><i class="bi bi-lock-fill me-1"></i>Read-Only</span>
                        }
                    </div>

                    @if (Model.PatientRecord?.IsGuest == true)
                    {
                        <div class="alert alert-light border small text-muted mb-3" style="border-radius:10px;">
                            <i class="bi bi-info-circle me-1 text-primary"></i>Guest patient contact details can be modified directly before account creation.
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small">Full Name <span class="text-danger">*</span></label>
                            <input asp-for="Input.GuestName" class="form-control" placeholder="Patient full name" required />
                            <span asp-validation-for="Input.GuestName" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Phone Number</label>
                            <input asp-for="Input.GuestPhone" class="form-control" placeholder="Phone number" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Email Address</label>
                            <input asp-for="Input.GuestEmail" type="email" class="form-control" placeholder="email@example.com" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Date of Birth</label>
                            <input asp-for="Input.GuestDateOfBirth" type="date" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Gender</label>
                            <select asp-for="Input.GuestGender" class="form-select">
                                <option value="">Select Gender</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Address</label>
                            <input asp-for="Input.GuestAddress" class="form-control" placeholder="Address" />
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light border small text-muted mb-3" style="border-radius:10px;">
                            <i class="bi bi-info-circle me-1 text-primary"></i>Personal information is managed by the patient and cannot be modified by doctor.
                        </div>

                        <input type="hidden" asp-for="Input.GuestName" />
                        <input type="hidden" asp-for="Input.GuestPhone" />
                        <input type="hidden" asp-for="Input.GuestEmail" />
                        <input type="hidden" asp-for="Input.GuestDateOfBirth" />
                        <input type="hidden" asp-for="Input.GuestGender" />
                        <input type="hidden" asp-for="Input.GuestAddress" />

                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small">Patient Name</label>
                            <input type="text" value="@(Model.PatientRecord?.ResolvedDisplayName ?? "N/A")" class="form-control bg-light text-dark fw-semibold" readonly disabled />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small">Phone Number</label>
                            <input type="text" value="@(string.IsNullOrEmpty(Model.PatientRecord?.ResolvedDisplayPhone) ? "N/A" : Model.PatientRecord.ResolvedDisplayPhone)" class="form-control bg-light text-dark" readonly disabled />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small">Email</label>
                            <input type="text" value="@(string.IsNullOrEmpty(Model.PatientRecord?.ResolvedDisplayEmail) ? "N/A" : Model.PatientRecord.ResolvedDisplayEmail)" class="form-control bg-light text-dark" readonly disabled />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small">Date of Birth</label>
                            <input type="text" value="@(Model.PatientRecord?.ResolvedDateOfBirth.HasValue == true ? Model.PatientRecord.ResolvedDateOfBirth.Value.ToString("MM/dd/yyyy") : "N/A")" class="form-control bg-light text-dark" readonly disabled />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small">Gender</label>
                            <input type="text" value="@(string.IsNullOrEmpty(Model.PatientRecord?.ResolvedGender) ? "N/A" : Model.PatientRecord.ResolvedGender)" class="form-control bg-light text-dark" readonly disabled />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted small">Address</label>
                            <input type="text" value="@(string.IsNullOrEmpty(Model.PatientRecord?.ResolvedAddress) ? "N/A" : Model.PatientRecord.ResolvedAddress)" class="form-control bg-light text-dark" readonly disabled />
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm" style="border-radius:16px;">
                <div class="card-body p-4">
                    <div class="form-section-title">
                        <i class="bi bi-heart-pulse-fill"></i>Clinical & Psychology Information
                    </div>

                    <div class="form-section">
                        <label class="form-label fw-bold">Psychological History</label>
                        <textarea asp-for="Input.PsychologicalHistory" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="form-section">
                        <label class="form-label fw-bold">Current Symptoms</label>
                        <textarea asp-for="Input.CurrentSymptoms" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="form-section">
                        <label class="form-label fw-bold">Stress Factors</label>
                        <textarea asp-for="Input.StressFactors" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="form-section">
                        <label class="form-label fw-bold">General Notes</label>
                        <textarea asp-for="Input.GeneralNotes" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-3 pt-3 mt-4" style="border-top:2px solid #f1f5f9;">
                        <a asp-page="./Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary px-4 py-2 fw-bold" style="border-radius:10px;">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 py-2 fw-bold d-flex align-items-center gap-2" style="border-radius:10px; background:var(--mb-primary); border-color:var(--mb-primary);">
                            <i class="bi bi-check-circle-fill"></i>Update Profile
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
