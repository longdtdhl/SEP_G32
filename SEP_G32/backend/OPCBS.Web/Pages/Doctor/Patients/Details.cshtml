@page "{id:Guid}"
@model OPCBS.Web.Pages.Doctor.Patients.DetailsModel
@{
    ViewData["Title"] = "Patient Profile Details";

    Layout = "_DashboardLayout";}

<style>
    .patient-banner {
        background: linear-gradient(135deg, #f0fdf8 0%, #ecfdf5 50%, #d1fae5 100%);
        border-radius: 16px; padding: 1.5rem; margin-bottom: 1.5rem;
        border: 1px solid rgba(16,185,129,0.12);
    }
    .patient-banner .avatar {
        width: 64px; height: 64px; border-radius: 16px; display: flex; align-items: center; justify-content: center;
        font-size: 1.8rem; font-weight: 700; flex-shrink: 0;
    }
    .patient-meta { font-size: 0.85rem; color: #64748b; display: flex; gap: 16px; align-items: center; margin-top: 8px; flex-wrap: wrap; }
    
    .info-group { margin-bottom: 1.25rem; }
    .info-group .label { font-size: 0.8rem; color: #64748b; font-weight: 600; margin-bottom: 4px; display: block; text-transform: uppercase; letter-spacing: 0.5px; }
    .info-group .value { font-size: 0.95rem; color: #1e293b; font-weight: 500; }
    
    .timeline-item { position: relative; padding-left: 1.5rem; padding-bottom: 1.5rem; border-left: 2px solid #e2e8f0; }
    .timeline-item:last-child { border-left-color: transparent; padding-bottom: 0; }
    .timeline-item::before {
        content: ''; position: absolute; left: -6px; top: 0; width: 10px; height: 10px;
        border-radius: 50%; background: var(--mb-primary); border: 2px solid white; box-shadow: 0 0 0 2px var(--mb-primary);
    }
    .timeline-date { font-size: 0.8rem; font-weight: 600; color: var(--mb-primary); margin-bottom: 4px; }
</style>

<div class="mb-page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 style="font-size:1.4rem; font-weight:700; margin:0;">
            <i class="bi bi-person-lines-fill me-2" style="color:var(--mb-primary);"></i>Patient Profile
        </h1>
        <p style="margin:4px 0 0; font-size:0.85rem; color:#64748b;">View patient overview and history</p>
    </div>
    <div>
        <a asp-page="./Edit" asp-route-id="@Model.PatientRecord.Id" class="btn btn-warning me-2 fw-semibold" style="border-radius:10px;"><i class="bi bi-pencil-square me-1"></i>Edit Profile</a>
        <a asp-page="./Index" class="btn btn-outline-secondary px-3 py-2 fw-semibold" style="border-radius:10px;"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>

<div class="patient-banner d-flex align-items-center gap-4 shadow-sm mt-3">
    @{
        var initial = Model.PatientRecord.DisplayName.Substring(0, 1).ToUpper();
    }
    <div class="avatar" style="background:rgba(16,185,129,0.15); color:var(--mb-primary);">@initial</div>
    <div class="flex-grow-1">
        <h3 style="margin:0; font-weight:800; color:#0f172a; display:flex; align-items:center; gap:8px;">
            @Model.PatientRecord.DisplayName
            @if (Model.PatientRecord.IsGuest)
            {
                <span style="font-size:0.7rem; background:#fef3c7; color:#92400e; padding:3px 10px; border-radius:8px;">Guest</span>
            }
            else
            {
                <span style="font-size:0.7rem; background:#dcfce7; color:#166534; padding:3px 10px; border-radius:8px;">System User</span>
            }
        </h3>
        <div class="patient-meta">
            <span><i class="bi bi-telephone me-1 text-success"></i> @Model.PatientRecord.DisplayPhone</span>
            <span><i class="bi bi-envelope me-1 text-primary"></i> @Model.PatientRecord.DisplayEmail</span>
            <span><i class="bi bi-calendar-event me-1 text-warning"></i> DOB: @(Model.PatientRecord.GuestDateOfBirth.HasValue ? Model.PatientRecord.GuestDateOfBirth.Value.ToString("MM/dd/yyyy") : "N/A")</span>
            <span><i class="bi bi-gender-ambiguous me-1 text-info"></i> Gender: @(string.IsNullOrEmpty(Model.PatientRecord.GuestGender) ? "N/A" : Model.PatientRecord.GuestGender)</span>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Patient Profile Column -->
    <div class="col-lg-4">
        <!-- Personal Information Card -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius:16px;">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-4 border-bottom pb-2" style="color:#1e293b; font-size:1rem;">
                    <i class="bi bi-person-badge-fill text-primary me-2"></i>Personal Information
                </h5>
                
                <div class="info-group">
                    <span class="label">Full Name</span>
                    <span class="value">@Model.PatientRecord.DisplayName</span>
                </div>

                <div class="info-group">
                    <span class="label">Phone Number</span>
                    <span class="value">@Model.PatientRecord.DisplayPhone</span>
                </div>

                <div class="info-group">
                    <span class="label">Email Address</span>
                    <span class="value">@Model.PatientRecord.DisplayEmail</span>
                </div>

                <div class="info-group">
                    <span class="label">Date of Birth</span>
                    <span class="value">@(Model.PatientRecord.GuestDateOfBirth.HasValue ? Model.PatientRecord.GuestDateOfBirth.Value.ToString("MM/dd/yyyy") : "N/A")</span>
                </div>

                <div class="info-group">
                    <span class="label">Gender</span>
                    <span class="value">@(string.IsNullOrEmpty(Model.PatientRecord.GuestGender) ? "N/A" : Model.PatientRecord.GuestGender)</span>
                </div>

                <div class="info-group mb-0">
                    <span class="label">Address</span>
                    <span class="value">@(string.IsNullOrEmpty(Model.PatientRecord.GuestAddress) ? "N/A" : Model.PatientRecord.GuestAddress)</span>
                </div>
            </div>
        </div>

        <!-- Clinical Information Card -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius:16px;">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-4 border-bottom pb-2" style="color:#1e293b; font-size:1rem;">
                    <i class="bi bi-heart-pulse-fill text-danger me-2"></i>Clinical Information
                </h5>
                
                <div class="info-group">
                    <span class="label">Psychological History</span>
                    <span class="value">@(string.IsNullOrEmpty(Model.PatientRecord.PsychologicalHistory) ? "None recorded" : Model.PatientRecord.PsychologicalHistory)</span>
                </div>
                
                <div class="info-group">
                    <span class="label">Current Symptoms</span>
                    <span class="value">@(string.IsNullOrEmpty(Model.PatientRecord.CurrentSymptoms) ? "None recorded" : Model.PatientRecord.CurrentSymptoms)</span>
                </div>
                
                <div class="info-group">
                    <span class="label">Stress Factors</span>
                    <span class="value">@(string.IsNullOrEmpty(Model.PatientRecord.StressFactors) ? "None recorded" : Model.PatientRecord.StressFactors)</span>
                </div>
                
                <div class="info-group mb-0">
                    <span class="label">Other Notes</span>
                    <span class="value">@(string.IsNullOrEmpty(Model.PatientRecord.GeneralNotes) ? "None" : Model.PatientRecord.GeneralNotes)</span>
                </div>
            </div>
        </div>

        <!-- Patient Treatment Packages -->
        @if (!Model.PatientRecord.IsGuest)
        {
            <div class="card border-0 shadow-sm mb-4" style="border-radius:16px;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                        <h5 class="fw-bold mb-0" style="color:#1e293b; font-size:1rem;">
                            <i class="bi bi-box-seam text-success me-2"></i>Psychotherapy Packages
                        </h5>
                        <a asp-page="/Doctor/TreatmentPackages/Create" asp-route-patientId="@Model.PatientRecord.PatientId" 
                           class="btn btn-sm btn-primary fw-semibold d-flex align-items-center gap-1" 
                           style="border-radius:8px; background:var(--mb-primary); border-color:var(--mb-primary); font-size:0.75rem;">
                            <i class="bi bi-plus-lg"></i>Create New
                        </a>
                    </div>
                    
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success py-2 mb-3" style="border-radius:10px; font-size:0.82rem; border:none;">
                            <i class="bi bi-check-circle-fill me-1"></i>@TempData["SuccessMessage"]
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger py-2 mb-3" style="border-radius:10px; font-size:0.82rem; border:none;">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>@TempData["ErrorMessage"]
                        </div>
                    }

                    <!-- Active Packages List -->
                    @if (Model.TreatmentPackages.Any())
                    {
                        <div class="d-flex flex-column gap-3 mb-3">
                            @foreach (var pkg in Model.TreatmentPackages)
                            {
                                var progress = pkg.TotalSessions > 0 ? (int)(((double)pkg.CompletedSessions / pkg.TotalSessions) * 100) : 0;
                                var progressColor = progress >= 100 ? "#10b981" : progress >= 50 ? "#3b82f6" : "#f59e0b";
                                var statusBg = pkg.Status switch {
                                    "Active" => "bg-success", "Accepted" => "bg-success",
                                    "Completed" => "bg-primary", "Assigned" => "bg-warning",
                                    _ => "bg-secondary"
                                };

                                <div class="p-3 rounded-3" style="background:#f8fafc; border:1px solid #f1f5f9;">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h6 class="fw-bold text-dark mb-0" style="font-size:0.85rem; line-height:1.4;">@pkg.Title</h6>
                                        <span class="badge @statusBg" style="font-size:0.65rem;">@pkg.Status</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-1" style="font-size:0.75rem; color:#64748b;">
                                        <span>Completed: @pkg.CompletedSessions/@pkg.TotalSessions</span>
                                        <span style="color:@progressColor; font-weight:700;">@progress%</span>
                                    </div>
                                    <div class="progress mb-2" style="height:6px; border-radius:4px;">
                                        <div class="progress-bar" style="width:@(progress)%; background:@progressColor; border-radius:4px;"></div>
                                    </div>
                                    <a asp-page="/Doctor/TreatmentPackages/Details" asp-route-id="@pkg.Id" 
                                       class="btn btn-sm btn-outline-success w-100 fw-bold mt-1" style="font-size:0.75rem; border-radius:8px;">
                                        <i class="bi bi-journal-check me-1"></i>Assignments &amp; Feedback
                                    </a>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-3 mb-3 text-muted rounded-3" style="background:#fafbfc; border:1px dashed #e2e8f0;">
                            <i class="bi bi-box-seam d-block mb-1" style="font-size:1.4rem; opacity:0.35;"></i>
                            <span class="small">No active treatment package for this patient.</span>
                        </div>
                    }

                    <!-- Assign Template Package Section -->
                    @if (Model.TemplatePackages.Any())
                    {
                        <div class="mt-2 pt-3 border-top">
                            <h6 class="fw-bold mb-2" style="font-size:0.82rem; color:#334155;">
                                <i class="bi bi-clipboard-plus me-1 text-primary"></i>Assign Existing Template
                            </h6>
                            <form method="post" asp-page-handler="AssignTemplate" asp-route-id="@Model.PatientRecord.Id">
                                <select name="AssignTemplateId" class="form-select form-select-sm mb-2" style="border-radius:8px; font-size:0.82rem;" required>
                                    <option value="">-- Select a template package --</option>
                                    @foreach (var tpl in Model.TemplatePackages)
                                    {
                                        <option value="@tpl.Id">
                                            @tpl.Title (@tpl.TotalSessions sessions, @tpl.ValidityDays days)
                                        </option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-primary w-100 fw-semibold" 
                                        style="border-radius:8px; font-size:0.78rem;">
                                    <i class="bi bi-clipboard-check me-1"></i>Assign Selected Template to Patient
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Consultation Sessions Column -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm" style="border-radius:16px;">
            <div class="card-header bg-white border-bottom p-4 d-flex justify-content-between align-items-center" style="border-radius:16px 16px 0 0;">
                <h5 class="fw-bold mb-0" style="color:#1e293b; font-size:1rem;">
                    <i class="bi bi-journal-medical me-2" style="color:var(--mb-primary);"></i>Consultation History
                </h5>
            </div>
            <div class="card-body p-4">
                @if (Model.ConsultationNotes.Any())
                {
                    <div class="timeline ps-2 pt-2">
                        @foreach (var note in Model.ConsultationNotes.OrderByDescending(n => n.CreatedAt))
                        {
                            <div class="timeline-item">
                                <div class="timeline-date">@note.DisplayConsultationDate.ToLocalTime().ToString("MM/dd/yyyy HH:mm")</div>
                                <div class="card border border-light bg-light" style="border-radius:12px;">
                                    <div class="card-body p-3">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h6 class="fw-bold mb-0" style="color:#334155;">
                                                @(string.IsNullOrEmpty(note.Diagnosis) ? "No Diagnosis" : note.Diagnosis)
                                            </h6>
                                            <div class="d-flex gap-1 align-items-center">
                                                <span class="@note.VisibilityBadgeClass" style="font-size:0.7rem;"><i class="bi @note.VisibilityIcon me-1"></i>@note.VisibilityText</span>
                                                <a asp-page="/Doctor/ConsultationNotes/Details" asp-route-id="@note.Id" class="btn btn-sm btn-outline-primary py-1 px-2" style="font-size:0.75rem; border-radius:6px;">Details</a>
                                            </div>
                                        </div>
                                        <p class="mb-2" style="font-size:0.85rem; color:#475569;">
                                            <strong>Summary:</strong> @(string.IsNullOrEmpty(note.ConsultationSummary) ? "None" : note.ConsultationSummary)
                                        </p>
                                        <div style="font-size:0.8rem; color:#94a3b8;">
                                            <i class="bi bi-person-badge me-1"></i>Doctor: @note.DoctorName
                                            @if (!string.IsNullOrEmpty(note.PackageName))
                                            {
                                                <span class="ms-2"><i class="bi bi-box-seam me-1"></i>Package: <span class="badge bg-info text-dark" style="font-size:0.7rem;">@note.PackageName</span></span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center p-4">
                        <i class="bi bi-inbox d-block mb-3" style="font-size:2.5rem; color:#cbd5e1;"></i>
                        <h6 class="fw-semibold text-muted">No consultations recorded yet</h6>
                        <p style="font-size:0.85rem; color:#94a3b8;">No consultation history records found for this patient.</p>
                        <a asp-page="/Doctor/Appointments/Index" class="btn btn-outline-primary btn-sm mt-2" style="border-radius:8px;">View Doctor Appointments</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
