@page "{id:Guid}"
@model OPCBS.Web.Pages.Doctor.Patients.DetailsModel
@{
    ViewData["Title"] = "Chi tiết hồ sơ bệnh nhân";
    ViewData["UseDashboardLayout"] = true;
}

<style>
    .patient-banner {
        background: linear-gradient(135deg, #f0fdf8 0%, #ecfdf5 50%, #d1fae5 100%);
        border-radius: 16px; padding: 1.5rem; margin-bottom: 1.5rem;
        border: 1px solid rgba(16,185,129,0.12);
    }
    .patient-banner .avatar {
        width: 64px; height: 64px; border-radius: 16px; display: flex; align-items: center; justify-content: center;
        font-size: 1.8rem; font-weight: 700; flex-shrink: 0;
    }
    .patient-meta { font-size: 0.85rem; color: #64748b; display: flex; gap: 16px; align-items: center; margin-top: 8px; flex-wrap: wrap; }
    
    .info-group { margin-bottom: 1.25rem; }
    .info-group .label { font-size: 0.8rem; color: #64748b; font-weight: 600; margin-bottom: 4px; display: block; text-transform: uppercase; letter-spacing: 0.5px; }
    .info-group .value { font-size: 0.95rem; color: #1e293b; font-weight: 500; }
    
    .timeline-item { position: relative; padding-left: 1.5rem; padding-bottom: 1.5rem; border-left: 2px solid #e2e8f0; }
    .timeline-item:last-child { border-left-color: transparent; padding-bottom: 0; }
    .timeline-item::before {
        content: ''; position: absolute; left: -6px; top: 0; width: 10px; height: 10px;
        border-radius: 50%; background: var(--mb-primary); border: 2px solid white; box-shadow: 0 0 0 2px var(--mb-primary);
    }
    .timeline-date { font-size: 0.8rem; font-weight: 600; color: var(--mb-primary); margin-bottom: 4px; }
</style>

<div class="mb-page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 style="font-size:1.4rem; font-weight:700; margin:0;">
            <i class="bi bi-person-lines-fill me-2" style="color:var(--mb-primary);"></i>Hồ sơ bệnh nhân
        </h1>
        <p style="margin:4px 0 0; font-size:0.85rem; color:#64748b;">Xem thông tin tổng quan và lịch sử khám</p>
    </div>
    <div>
        <a asp-page="./Edit" asp-route-id="@Model.PatientRecord.Id" class="btn btn-warning me-2 fw-semibold" style="border-radius:10px;"><i class="bi bi-pencil-square me-1"></i>Sửa hồ sơ</a>
        <a asp-page="./Index" class="btn btn-outline-secondary px-3 py-2 fw-semibold" style="border-radius:10px;"><i class="bi bi-arrow-left me-1"></i>Quay lại</a>
    </div>
</div>

<div class="patient-banner d-flex align-items-center gap-4 shadow-sm mt-3">
    @{
        var initial = Model.PatientRecord.DisplayName.Substring(0, 1).ToUpper();
    }
    <div class="avatar" style="background:rgba(16,185,129,0.15); color:var(--mb-primary);">@initial</div>
    <div>
        <h3 style="margin:0; font-weight:800; color:#0f172a; display:flex; align-items:center; gap:8px;">
            @Model.PatientRecord.DisplayName
            @if (Model.PatientRecord.IsGuest)
            {
                <span style="font-size:0.7rem; background:#fef3c7; color:#92400e; padding:3px 10px; border-radius:8px;">Khách vãng lai</span>
            }
            else
            {
                <span style="font-size:0.7rem; background:#dcfce7; color:#166534; padding:3px 10px; border-radius:8px;">Hệ thống</span>
            }
        </h3>
        <div class="patient-meta">
            <span><i class="bi bi-telephone me-1"></i> @Model.PatientRecord.DisplayPhone</span>
            <span><i class="bi bi-envelope me-1"></i> @Model.PatientRecord.DisplayEmail</span>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Cột trái: Thông tin lâm sàng -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-4" style="border-radius:16px;">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-4 border-bottom pb-2" style="color:#1e293b; font-size:1rem;">
                    <i class="bi bi-heart-pulse-fill text-danger me-2"></i>Thông tin lâm sàng
                </h5>
                
                <div class="info-group">
                    <span class="label">Tiền sử tâm lý</span>
                    <span class="value">@(string.IsNullOrEmpty(Model.PatientRecord.PsychologicalHistory) ? "Không ghi nhận" : Model.PatientRecord.PsychologicalHistory)</span>
                </div>
                
                <div class="info-group">
                    <span class="label">Triệu chứng hiện tại</span>
                    <span class="value">@(string.IsNullOrEmpty(Model.PatientRecord.CurrentSymptoms) ? "Không ghi nhận" : Model.PatientRecord.CurrentSymptoms)</span>
                </div>
                
                <div class="info-group">
                    <span class="label">Yếu tố sang chấn</span>
                    <span class="value">@(string.IsNullOrEmpty(Model.PatientRecord.StressFactors) ? "Không ghi nhận" : Model.PatientRecord.StressFactors)</span>
                </div>
                
                <div class="info-group mb-0">
                    <span class="label">Ghi chú khác</span>
                    <span class="value">@(string.IsNullOrEmpty(Model.PatientRecord.GeneralNotes) ? "Không có" : Model.PatientRecord.GeneralNotes)</span>
                </div>
            </div>
        </div>

        <!-- Gói điều trị của bệnh nhân -->
        @if (!Model.PatientRecord.IsGuest)
        {
            <div class="card border-0 shadow-sm mb-4" style="border-radius:16px;">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3 border-bottom pb-2" style="color:#1e293b; font-size:1rem;">
                        <i class="bi bi-box-seam text-success me-2"></i>Gói điều trị tâm lý
                    </h5>
                    
                    @if (Model.TreatmentPackages.Any())
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var pkg in Model.TreatmentPackages)
                            {
                                var progress = pkg.TotalSessions > 0 ? (int)(((double)pkg.CompletedSessions / pkg.TotalSessions) * 100) : 0;
                                var progressColor = progress >= 100 ? "#10b981" : progress >= 50 ? "#3b82f6" : "#f59e0b";
                                
                                <div class="p-3 rounded-3" style="background:#f8fafc; border:1px solid #f1f5f9;">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h6 class="fw-bold text-dark mb-0" style="font-size:0.85rem; line-height:1.4;">@pkg.Title</h6>
                                        <span class="badge @(pkg.Status == "Active" ? "bg-success" : pkg.Status == "Completed" ? "bg-primary" : "bg-warning")" style="font-size:0.65rem;">@pkg.Status</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-1" style="font-size:0.75rem; color:#64748b;">
                                        <span>Hoàn thành: @pkg.CompletedSessions/@pkg.TotalSessions</span>
                                        <span style="color:@progressColor; font-weight:700;">@progress%</span>
                                    </div>
                                    <div class="progress mb-2" style="height:6px; border-radius:4px;">
                                        <div class="progress-bar" style="width:@(progress)%; background:@progressColor; border-radius:4px;"></div>
                                    </div>
                                    <a asp-page="/Doctor/TreatmentPackages/Details" asp-route-id="@pkg.Id" class="btn btn-sm btn-outline-success w-100 fw-bold mt-1" style="font-size:0.75rem; border-radius:8px;">
                                        <i class="bi bi-journal-check me-1"></i>Bài tập & Nhận xét
                                    </a>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-3 text-muted">
                            <i class="bi bi-box-seam d-block mb-1" style="font-size:1.5rem; opacity:0.4;"></i>
                            <span class="small">Chưa đăng ký gói điều trị nào.</span>
                            <div class="mt-2">
                                <a asp-page="/Doctor/TreatmentPackages/Create" asp-route-patientId="@Model.PatientRecord.PatientId" class="btn btn-sm btn-primary w-100 fw-bold" style="font-size:0.72rem; border-radius:8px; background:var(--mb-primary); border-color:var(--mb-primary);">
                                    <i class="bi bi-plus-lg me-1"></i>Chỉ định gói mới
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Cột phải: Phiên tư vấn -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm" style="border-radius:16px;">
            <div class="card-header bg-white border-bottom p-4 d-flex justify-content-between align-items-center" style="border-radius:16px 16px 0 0;">
                <h5 class="fw-bold mb-0" style="color:#1e293b; font-size:1rem;">
                    <i class="bi bi-journal-medical me-2" style="color:var(--mb-primary);"></i>Lịch sử Phiên tư vấn
                </h5>
                <a asp-page="/Doctor/ConsultationNotes/Create" asp-route-patientRecordId="@Model.PatientRecord.Id" class="btn btn-sm btn-primary fw-semibold" style="border-radius:8px;">
                    <i class="bi bi-plus-lg me-1"></i>Tạo mới
                </a>
            </div>
            <div class="card-body p-4">
                @if (Model.ConsultationNotes.Any())
                {
                    <div class="timeline ps-2 pt-2">
                        @foreach (var note in Model.ConsultationNotes.OrderByDescending(n => n.CreatedAt))
                        {
                            <div class="timeline-item">
                                <div class="timeline-date">@note.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                <div class="card border border-light bg-light" style="border-radius:12px;">
                                    <div class="card-body p-3">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h6 class="fw-bold mb-0" style="color:#334155;">
                                                @(string.IsNullOrEmpty(note.Diagnosis) ? "Chưa có chẩn đoán" : note.Diagnosis)
                                            </h6>
                                            <a asp-page="/Doctor/ConsultationNotes/Details" asp-route-id="@note.Id" class="btn btn-sm btn-outline-primary py-1 px-2" style="font-size:0.75rem; border-radius:6px;">Chi tiết</a>
                                        </div>
                                        <p class="mb-2" style="font-size:0.85rem; color:#475569;">
                                            <strong>Tóm tắt:</strong> @(string.IsNullOrEmpty(note.ConsultationSummary) ? "Không có" : note.ConsultationSummary)
                                        </p>
                                        <div style="font-size:0.8rem; color:#94a3b8;">
                                            <i class="bi bi-person-badge me-1"></i>Bác sĩ: @note.DoctorName
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center p-4">
                        <i class="bi bi-inbox d-block mb-3" style="font-size:2.5rem; color:#cbd5e1;"></i>
                        <h6 class="fw-semibold text-muted">Chưa có phiên tư vấn nào</h6>
                        <p style="font-size:0.85rem; color:#94a3b8;">Bệnh nhân này chưa có ghi chú tư vấn nào được lưu trữ.</p>
                        <a asp-page="/Doctor/ConsultationNotes/Create" asp-route-patientRecordId="@Model.PatientRecord.Id" class="btn btn-outline-primary btn-sm mt-2" style="border-radius:8px;">Bắt đầu tư vấn ngay</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
