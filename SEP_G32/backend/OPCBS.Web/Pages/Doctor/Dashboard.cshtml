@page
@model OPCBS.Web.Pages.Doctor.DashboardModel
@{
    ViewData["Title"] = "Doctor Dashboard";
    ViewData["UseDashboardLayout"] = true;
}

<div class="mb-page-header">
    <h1>Dashboard</h1>
    <p class="text-muted">Tổng quan hoạt động tư vấn của bạn</p>
</div>

@if (Model.Error != null)
{
    <div class="alert alert-warning">@Model.Error</div>
}

<!-- Verification Banner -->
@if (!Model.IsVerified)
{
    var statusLower = Model.VerificationStatus?.ToLower();
    <div class="card border-0 shadow-sm mb-4" style="border-radius:16px;overflow:hidden;">
        <div class="card-body p-4" style="background:linear-gradient(135deg, #fff8e1 0%, #fff3cd 100%);">
            <div class="d-flex align-items-start gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:48px;height:48px;background:#ffc107;">
                    <i class="bi bi-shield-exclamation text-white" style="font-size:1.5rem;"></i>
                </div>
                <div class="flex-grow-1">
                    @if (statusLower == "submitted" || statusLower == "pending")
                    {
                        <h5 class="fw-bold mb-1" style="color:#856404;">Hồ sơ đang chờ duyệt</h5>
                        <p class="mb-2 text-muted">Hồ sơ xác minh của bạn đã được gửi và đang được xem xét. Bạn sẽ được thông báo khi có kết quả.</p>
                        <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Đang chờ duyệt</span>
                    }
                    else if (statusLower == "rejected")
                    {
                        <h5 class="fw-bold mb-1" style="color:#721c24;">Hồ sơ bị từ chối</h5>
                        <p class="mb-2 text-muted">Hồ sơ xác minh của bạn đã bị từ chối. Vui lòng chỉnh sửa và nộp lại.</p>
                        @if (!string.IsNullOrEmpty(Model.RejectionReason))
                        {
                            <div class="alert alert-danger py-2 px-3 mb-2" style="font-size:0.875rem;">
                                <i class="bi bi-x-circle me-1"></i><strong>Lý do:</strong> @Model.RejectionReason
                            </div>
                        }
                        <a asp-page="/Doctor/Verification" class="btn btn-danger btn-sm"><i class="bi bi-arrow-repeat me-1"></i>Nộp lại hồ sơ</a>
                    }
                    else
                    {
                        <h5 class="fw-bold mb-1" style="color:#856404;">Chưa xác minh hồ sơ</h5>
                        <p class="mb-2 text-muted">Bạn cần nộp hồ sơ xác minh để bắt đầu sử dụng các chức năng trên nền tảng (đặt lịch, tư vấn, viết blog...).</p>
                        <a asp-page="/Doctor/Verification" class="btn btn-primary btn-sm"><i class="bi bi-send me-1"></i>Nộp hồ sơ xác minh</a>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <div style="font-size:2rem;color:var(--mb-primary)"><i class="bi bi-calendar-check"></i></div>
                <h3 class="mb-0 mt-1">@Model.TotalAppointments</h3>
                <small class="text-muted">Tổng lịch hẹn</small>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <div style="font-size:2rem;color:#e6a817"><i class="bi bi-clock-history"></i></div>
                <h3 class="mb-0 mt-1">@Model.PendingCount</h3>
                <small class="text-muted">Chờ duyệt</small>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <div style="font-size:2rem;color:#3498db"><i class="bi bi-check-circle"></i></div>
                <h3 class="mb-0 mt-1">@Model.ApprovedCount</h3>
                <small class="text-muted">Đã duyệt</small>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <div style="font-size:2rem;color:#27ae60"><i class="bi bi-check-all"></i></div>
                <h3 class="mb-0 mt-1">@Model.CompletedCount</h3>
                <small class="text-muted">Hoàn thành</small>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Upcoming Appointments -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-calendar-event me-2"></i>Lịch hẹn sắp tới</h5>
                <a asp-page="/Doctor/Appointments/Index" class="btn btn-sm btn-outline-primary">Xem tất cả</a>
            </div>
            <div class="card-body p-0">
                @if (Model.UpcomingAppointments.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Bệnh nhân</th>
                                    <th>Thời gian</th>
                                    <th>Trạng thái</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var apt in Model.UpcomingAppointments)
                                {
                                    <tr>
                                        <td>
                                            <strong>@(apt.PatientName ?? "N/A")</strong>
                                            @if (!string.IsNullOrEmpty(apt.Specialization))
                                            {
                                                <br /><small class="text-muted">@apt.Specialization</small>
                                            }
                                        </td>
                                        <td>
                                            <span>@apt.StartAt.LocalDateTime.ToString("dd/MM/yyyy")</span><br />
                                            <small class="text-muted">@apt.StartAt.LocalDateTime.ToString("HH:mm")</small>
                                        </td>
                                        <td>
                                            @{
                                                var badgeClass = apt.Status switch
                                                {
                                                    0 => "bg-warning text-dark",
                                                    1 => "bg-info text-white",
                                                    4 => "bg-success",
                                                    3 => "bg-danger",
                                                    _ => "bg-secondary"
                                                };
                                            }
                                            <span class="badge @badgeClass">@apt.StatusText</span>
                                        </td>
                                        <td>
                                            <a asp-page="/Doctor/Appointments/Details" asp-route-id="@apt.Id" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-calendar-x d-block" style="font-size:2rem"></i>
                        <p class="mt-2">Không có lịch hẹn sắp tới</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Subscription Info -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="bi bi-credit-card me-2"></i>Gói dịch vụ</h5>
            </div>
            <div class="card-body">
                @if (Model.CurrentSubscription != null)
                {
                    <div class="text-center">
                        <span class="badge bg-success mb-2">@Model.CurrentSubscription.Status</span>
                        <h4 class="text-primary">@(Model.CurrentSubscription.PackageName ?? "N/A")</h4>
                        <p class="text-muted mb-1">
                            <i class="bi bi-calendar3"></i>
                            @Model.CurrentSubscription.StartDate.ToString("dd/MM/yyyy") - @Model.CurrentSubscription.EndDate.ToString("dd/MM/yyyy")
                        </p>
                        <hr />
                        <a asp-page="/Doctor/Subscriptions/Status" class="btn btn-outline-primary btn-sm">Chi tiết</a>
                    </div>
                }
                else
                {
                    <div class="text-center py-3 text-muted">
                        <i class="bi bi-credit-card-2-front d-block" style="font-size:2rem"></i>
                        <p class="mt-2">Chưa đăng ký gói dịch vụ</p>
                        <a asp-page="/Doctor/ServicePackages/Index" class="btn btn-primary btn-sm">Xem gói dịch vụ</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
