@page
@model OPCBS.Web.Pages.Doctor.ConsultationNotes.CreateModel
@{
    ViewData["Title"] = "Tạo hồ sơ tư vấn";
    ViewData["UseDashboardLayout"] = true;
}

<style>
    .mode-tabs { display: flex; gap: 4px; background: #f1f5f9; border-radius: 12px; padding: 4px; margin-bottom: 1.5rem; }
    .mode-tab {
        flex: 1; text-align: center; padding: 10px 16px; border-radius: 10px; font-size: 0.85rem;
        font-weight: 600; color: #64748b; cursor: pointer; transition: all 0.2s; text-decoration: none;
        display: flex; align-items: center; justify-content: center; gap: 6px;
    }
    .mode-tab.active { background: white; color: var(--mb-primary); box-shadow: 0 1px 4px rgba(0,0,0,0.08); }
    .mode-tab:hover:not(.active) { color: #1e293b; }

    .form-section { margin-bottom: 1.5rem; }
    .form-section-title {
        font-size: 0.85rem; font-weight: 700; color: #1e293b; margin-bottom: 0.75rem;
        padding-bottom: 0.5rem; border-bottom: 2px solid rgba(78,139,112,0.1);
        display: flex; align-items: center; gap: 8px;
    }
    .form-section-title i { color: var(--mb-primary); }

    .patient-info-card {
        background: linear-gradient(135deg, #f0fdf8, #ecfdf5); border-radius: 14px; padding: 1.25rem;
        border: 1px solid rgba(16,185,129,0.15);
    }
    .patient-info-card .label { font-size: 0.75rem; color: #64748b; margin-bottom: 2px; }
    .patient-info-card .value { font-size: 0.9rem; font-weight: 600; color: #1e293b; }

    .tip-card {
        background: linear-gradient(135deg, #fefce8, #fef9c3); border-radius: 14px; padding: 1.25rem;
        border: 1px solid rgba(245,158,11,0.15);
    }
</style>

<!-- Page Header -->
<div class="mb-page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 style="font-size:1.4rem; font-weight:700; margin:0;">
            <i class="bi bi-file-earmark-medical-fill me-2" style="color:var(--mb-primary);"></i>Tạo hồ sơ tư vấn
        </h1>
        <p style="margin:4px 0 0; font-size:0.85rem; color:#64748b;">Lập bệnh án, ghi chú tư vấn và khuyến nghị bài tập sau buổi trị liệu</p>
    </div>
    <a asp-page="/Doctor/Patients/Details" asp-route-id="@Model.PatientRecordId" class="btn btn-outline-secondary px-3 py-2" style="border-radius:10px;">
        <i class="bi bi-arrow-left me-1"></i>Quay lại hồ sơ
    </a>
</div>

@if (Model.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show" style="border-radius:12px; border:none;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form method="post">
    <input type="hidden" asp-for="PatientRecordId" />
    <input type="hidden" asp-for="AppointmentId" />
    
    <div class="row g-4">
        <!-- Sidebar -->
        <div class="col-lg-4">
            
            <!-- Patient Record Info -->
            <div class="card border-0 shadow-sm" style="border-radius:16px;">
                <div class="card-body p-4">
                    <div class="form-section-title">
                        <i class="bi bi-person-lines-fill"></i>Thông tin bệnh nhân
                    </div>
                    <div class="patient-info-card mb-3">
                        <div class="label">Họ và tên</div>
                        <div class="value">
                            <i class="bi bi-person-fill me-1" style="color:var(--mb-primary);"></i>@(Model.PatientRecord?.DisplayName ?? "Không xác định")
                            @if (Model.PatientRecord?.IsGuest == true)
                            {
                                <span class="badge bg-secondary ms-2">Khách vãng lai</span>
                            }
                        </div>
                    </div>
                    <div class="patient-info-card mb-3">
                        <div class="label">Số điện thoại / Email</div>
                        <div class="value" style="font-size:0.82rem;"><i class="bi bi-telephone me-1"></i>@(Model.PatientRecord?.DisplayPhone ?? "N/A")</div>
                        <div class="value" style="font-size:0.82rem;"><i class="bi bi-envelope me-1"></i>@(Model.PatientRecord?.DisplayEmail ?? "N/A")</div>
                    </div>
                </div>
            </div>

            @if (Model.SelectedAppointment != null)
            {
                <div class="card border-0 shadow-sm mt-3" style="border-radius:16px;">
                    <div class="card-body p-4">
                        <div class="form-section-title">
                            <i class="bi bi-link-45deg"></i>Thông tin lịch hẹn
                        </div>
                        <div class="patient-info-card mb-3">
                            <div class="label">Mã cuộc hẹn</div>
                            <div class="value">
                                <span class="badge bg-primary bg-opacity-10 text-primary px-2 py-1" style="border-radius:8px;">
                                    @Model.SelectedAppointment.BookingCode
                                </span>
                            </div>
                        </div>
                        <div class="patient-info-card">
                            <div class="label">Thời gian tư vấn</div>
                            <div class="value" style="font-size:0.82rem;"><i class="bi bi-calendar3 me-1"></i>@Model.SelectedAppointment.AppointmentDate • @Model.SelectedAppointment.StartTime - @Model.SelectedAppointment.EndTime</div>
                        </div>
                    </div>
                </div>
            }

            <!-- Tips Card -->
            <div class="tip-card mt-3">
                <h6 style="font-size:0.85rem; font-weight:700; color:#92400e; margin-bottom:8px;">
                    <i class="bi bi-lightbulb-fill text-warning me-1"></i>Lưu ý
                </h6>
                <ul style="font-size:0.8rem; color:#78716c; padding-left:1.2rem; margin:0;">
                    <li class="mb-1">Ghi chẩn đoán lâm sàng rõ ràng để bệnh nhân theo dõi.</li>
                    <li class="mb-1">Khuyến nghị bài tập thực hành giúp tiến trình trị liệu hiệu quả hơn.</li>
                    <li>Hồ sơ sẽ hiển thị ngay sau khi lưu.</li>
                </ul>
            </div>
        </div>

        <!-- Main Form -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm" style="border-radius:16px;">
                <div class="card-body p-4">

                    <!-- Diagnosis -->
                    <div class="form-section">
                        <div class="form-section-title">
                            <i class="bi bi-clipboard2-pulse-fill"></i>Chẩn đoán lâm sàng <span class="text-danger">*</span>
                        </div>
                        <input asp-for="Input.Diagnosis" class="form-control" style="border-radius:10px;"
                               placeholder="Ví dụ: Rối loạn lo âu lan tỏa (GAD), Stress công việc nặng..." required />
                    </div>

                    <!-- Consultation Summary -->
                    <div class="form-section">
                        <div class="form-section-title">
                            <i class="bi bi-journal-text"></i>Nội dung & Ghi chú tư vấn <span class="text-danger">*</span>
                        </div>
                        <textarea asp-for="Input.ConsultationSummary" class="form-control" style="border-radius:10px;" rows="5"
                                  placeholder="Ghi nhận diễn biến buổi tư vấn, các biểu hiện tâm lý, kết quả kiểm tra..." required></textarea>
                    </div>

                    <!-- TherapyPlan -->
                    <div class="form-section">
                        <label asp-for="Input.TherapyPlan" class="form-label fw-semibold" style="font-size:0.9rem;">
                            <i class="bi bi-capsule me-1 text-secondary"></i>Kế hoạch trị liệu
                        </label>
                        <textarea asp-for="Input.TherapyPlan" class="form-control" rows="3" placeholder="Nhập kế hoạch trị liệu (nếu có)..." style="border-radius:10px;"></textarea>
                        <span asp-validation-for="Input.TherapyPlan" class="text-danger small"></span>
                    </div>

                    <!-- Recommendations -->
                    <div class="form-section">
                        <div class="form-section-title">
                            <i class="bi bi-heart-pulse-fill"></i>Lời khuyên / Bài tập tại nhà
                        </div>
                        <textarea asp-for="Input.Recommendation" class="form-control" style="border-radius:10px;" rows="4"
                                  placeholder="Ví dụ:&#10;- Thực hành bài tập thở 4-7-8 trước khi đi ngủ.&#10;- Viết nhật ký biết ơn mỗi tối.&#10;- Hạn chế thiết bị điện tử sau 22h..."></textarea>
                    </div>

                    <!-- Follow-up Notes -->
                    <div class="form-section">
                        <div class="form-section-title">
                            <i class="bi bi-arrow-repeat"></i>Ghi chú theo dõi
                        </div>
                        <textarea asp-for="Input.FollowUpNotes" class="form-control" style="border-radius:10px;" rows="2"
                                  placeholder="Ghi chú cho buổi tái khám tiếp theo (nếu cần)..."></textarea>
                    </div>

                    <div class="form-section">
                        <div class="form-section-title">
                            <i class="bi bi-calendar"></i>Ngày tái khám dự kiến
                        </div>
                        <input asp-for="Input.NextAppointmentRecommendedDate" class="form-control" type="date" style="border-radius:10px;" />
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex justify-content-end gap-3 pt-3 mt-3" style="border-top:2px solid #f1f5f9;">
                        <a asp-page="/Doctor/Patients/Details" asp-route-id="@Model.PatientRecordId" class="btn btn-outline-secondary px-4 py-2 fw-bold" style="border-radius:10px;">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4 py-2 fw-bold d-flex align-items-center gap-2" style="border-radius:10px; background:var(--mb-primary); border-color:var(--mb-primary);">
                            <i class="bi bi-save2-fill"></i>Lưu hồ sơ tư vấn
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
