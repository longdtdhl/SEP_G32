@page "{id:guid}"
@model OPCBS.Web.Pages.Doctor.ConsultationNotes.EditModel
@using System.Text.Encodings.Web
@{
    ViewData["Title"] = "Details profile consultation";
    
    Layout = "_DashboardLayout";var isWalkIn = Model.Record?.IsWalkIn ?? false;
    var displayName = Model.Record?.DisplayPatientName ?? "Patient";
}

<style>
    .detail-banner {
        background: linear-gradient(135deg, #f0fdf8 0%, #ecfdf5 50%, #d1fae5 100%);
        border-radius: 16px; padding: 1.5rem; margin-bottom: 1.5rem;
        border: 1px solid rgba(16,185,129,0.12);
    }
    .detail-banner .avatar {
        width: 56px; height: 56px; border-radius: 14px; display: flex; align-items: center; justify-content: center;
        font-size: 1.4rem; font-weight: 700; flex-shrink: 0;
    }
    .detail-meta { font-size: 0.78rem; color: #64748b; display: flex; gap: 12px; align-items: center; margin-top: 4px; }
    .form-section { margin-bottom: 1.25rem; }
    .form-section-title {
        font-size: 0.85rem; font-weight: 700; color: #1e293b; margin-bottom: 0.75rem;
        padding-bottom: 0.5rem; border-bottom: 2px solid rgba(78,139,112,0.1);
        display: flex; align-items: center; gap: 8px;
    }
    .form-section-title i { color: var(--mb-primary); }
    .sidebar-card { border-radius: 16px; border: 1px solid rgba(78,139,112,0.08); overflow: hidden; }
    .sidebar-card .card-header-custom {
        padding: 1rem 1.25rem; border-bottom: 1px solid #f1f5f9;
        font-weight: 600; font-size: 0.85rem; color: #1e293b;
        display: flex; align-items: center; gap: 8px;
    }
    .sidebar-card .card-header-custom i { color: var(--mb-primary); }
</style>

<!-- Page Header -->
<div class="mb-page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 style="font-size:1.4rem; font-weight:700; margin:0;">
            <i class="bi bi-file-earmark-medical-fill me-2" style="color:var(--mb-primary);"></i>Consultation Records
        </h1>
        <p style="margin:4px 0 0; font-size:0.85rem; color:#64748b;">View details or update diagnosis information</p>
    </div>
    <a asp-page="./Details" asp-route-id="@Model.RecordId" class="btn btn-outline-secondary px-3 py-2" style="border-radius:10px;">
        <i class="bi bi-arrow-left me-2"></i> Back
    </a>
</div>

@if (Model.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show" style="border-radius:12px; border:none;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" style="border-radius:12px; border:none; background:linear-gradient(135deg,#ecfdf5,#d1fae5);">
        <i class="bi bi-check-circle-fill me-2" style="color:#10b981;"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Record != null)
{
    var initial = displayName.Substring(0, 1).ToUpper();
    var colors = new[] { "#6366f1", "#10b981", "#f59e0b", "#ef4444", "#8b5cf6", "#ec4899" };
    var color = colors[Math.Abs(displayName.GetHashCode()) % colors.Length];

    <!-- Patient Banner -->
    <div class="detail-banner">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <div class="avatar" style="background:@(color)18; color:@color;">@initial</div>
            <div style="flex:1; min-width:0;">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <h4 style="margin:0; font-weight:700; font-size:1.2rem; color:#1e293b;">@displayName</h4>
                    @if (isWalkIn)
                    {
                        <span class="badge bg-warning bg-opacity-15 text-warning px-2 py-1" style="border-radius:8px; font-size:0.7rem;">
                            <i class="bi bi-person-plus me-1"></i>Patient Outside System
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-primary bg-opacity-10 text-primary px-2 py-1" style="border-radius:8px; font-size:0.7rem;">
                            <i class="bi bi-person-check me-1"></i>Patient system
                        </span>
                    }
                </div>
                <div class="detail-meta">
                    <span><i class="bi bi-calendar3 me-1"></i>@Model.Record.DisplayConsultationDate.ToString("MM/dd/yyyy • HH:mm")</span>
                    @if (isWalkIn && !string.IsNullOrEmpty(Model.Record.WalkInPatientPhone))
                    {
                        <span>•</span>
                        <span><i class="bi bi-telephone me-1"></i>@Model.Record.WalkInPatientPhone</span>
                    }
                    @if (isWalkIn && !string.IsNullOrEmpty(Model.Record.WalkInPatientEmail))
                    {
                        <span>•</span>
                        <span><i class="bi bi-envelope me-1"></i>@Model.Record.WalkInPatientEmail</span>
                    }
                    @if (!isWalkIn && Model.Record.AppointmentId != null)
                    {
                        <span>•</span>
                        <span><i class="bi bi-bookmark me-1"></i>Appointment: @Model.Record.AppointmentId.Value.ToString()[..8]...</span>
                    }
                </div>
            </div>
            <span class="badge bg-success bg-opacity-10 text-success px-3 py-2" style="border-radius:10px; font-weight:600;">
                <i class="bi bi-shield-check me-1"></i>Recorded
            </span>
        </div>
    </div>

    <div class="row g-4">
        <!-- Sidebar -->
        <div class="col-lg-4" style="position: sticky; top: 100px; align-self: flex-start;">
            <!-- Treatment Packages -->
            @if (!isWalkIn)
            {
                var activePkgs = Model.PatientPackages.Where(p => !string.Equals(p.Status, "Cancelled", StringComparison.OrdinalIgnoreCase)).ToList();
                <div class="sidebar-card bg-white mb-3">
                    <div class="card-header-custom">
                        <i class="bi bi-box-seam"></i>Package
                        <a asp-page="/Doctor/TreatmentPackages/Create" asp-route-patientRecordId="@Model.Record.PatientRecordId" class="btn btn-sm btn-outline-primary w-100" style="border-radius:8px;">
                            <i class="bi bi-plus-circle me-1"></i>Create New Package
                        </a>
                    </div>
                    <div style="padding:1rem;">
                        @if (activePkgs.Any())
                        {
                            @foreach (var pkg in activePkgs)
                            {
                                var progress = pkg.TotalSessions > 0 ? (int)((double)pkg.CompletedSessions / pkg.TotalSessions * 100) : 0;
                                var statusColor = pkg.Status == "Active" ? "#10b981" : "#f59e0b";
                                <div style="background:#f8fafc; border-radius:12px; padding:0.75rem; margin-bottom:0.5rem;">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span style="font-weight:600; font-size:0.82rem; color:#1e293b;">@pkg.Name</span>
                                        <span style="font-size:0.7rem; color:@statusColor; font-weight:600;">@pkg.Status</span>
                                    </div>
                                    <div style="font-size:0.75rem; color:#64748b; margin-bottom:6px;">@pkg.CompletedSessions/@pkg.TotalSessions sessions • Expired @pkg.ExpirationDate.ToString("dd/MM")</div>
                                    <div style="background:#e2e8f0; border-radius:4px; height:4px;">
                                        <div style="background:var(--mb-primary); width:@(progress)%; height:100%; border-radius:4px;"></div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div style="text-align:center; padding:1.5rem; color:#94a3b8; font-size:0.82rem;">
                                <i class="bi bi-box-seam d-block mb-1" style="font-size:1.3rem; opacity:0.4;"></i>
                                No active treatment packages.
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Record Info -->
            <div class="sidebar-card bg-white">
                <div class="card-header-custom">
                    <i class="bi bi-clock-history"></i>Profile Information
                </div>
                <div style="padding:1rem;">
                    <div style="font-size:0.8rem; color:#64748b; margin-bottom:4px;">Created Date</div>
                    <div style="font-size:0.85rem; font-weight:600; color:#1e293b; margin-bottom:12px;">@Model.Record.CreatedAt.ToString("MM/dd/yyyy HH:mm")</div>
                    <div style="font-size:0.8rem; color:#64748b; margin-bottom:4px;">Profile ID</div>
                    <div style="font-size:0.82rem; font-weight:500; color:#475569; font-family:monospace;">@Model.RecordId.ToString()[..12]...</div>
                </div>
            </div>
        </div>

        <!-- Main Form -->
        <div class="col-lg-8">
            <form method="post" asp-route-id="@Model.RecordId">
                <div class="card border-0 shadow-sm" style="border-radius:16px;">
                    <div class="card-body p-4">
                        
                        <div class="form-section">
                            <div class="form-section-title">
                                <i class="bi bi-clipboard2-pulse-fill"></i>Diagnosis clinical <span class="text-danger">*</span>
                            </div>
                            <input asp-for="Input.Diagnosis" class="form-control" style="border-radius:10px;" placeholder="Enter diagnosis..." required />
                        </div>

                        <div class="form-section">
                            <div class="form-section-title">
                                <i class="bi bi-journal-text"></i>Content & Notes <span class="text-danger">*</span>
                            </div>
                            <textarea asp-for="Input.Notes" class="form-control" style="border-radius:10px;" rows="5" placeholder="Detailed notes..." required></textarea>
                        </div>

                        <div class="form-section">
                                <label asp-for="Input.TherapyPlan" class="form-label fw-semibold" style="font-size:0.9rem;">
                                    <i class="bi bi-capsule me-1 text-secondary"></i>Plan therapy
                                </label>
                                <textarea asp-for="Input.TherapyPlan" class="form-control" rows="3" placeholder="Enter therapy pspread (if applicable)..." style="border-radius:10px;"></textarea>
                                <span asp-validation-for="Input.TherapyPlan" class="text-danger small"></span>
                            <div class="form-section-title">
                                <i class="bi bi-heart-pulse-fill"></i>Recommendations / Home Assignment
                            </div>
                            <textarea asp-for="Input.Recommendations" class="form-control" style="border-radius:10px;" rows="3" placeholder="Advice or assignment..."></textarea>
                        </div>

                        <div class="form-section">
                            <div class="form-section-title">
                                <i class="bi bi-arrow-repeat"></i>Notes track / Follow-up Notes
                            </div>
                            <textarea asp-for="Input.FollowUpNotes" class="form-control" style="border-radius:10px;" rows="2" placeholder="Notes for follow-up consultations..."></textarea>
                        </div>

                        <!-- Custom Clinical Fields -->
                        <div class="form-section">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <div class="form-section-title mb-0 border-0 pb-0">
                                    <i class="bi bi-tags-fill"></i>Custom Clinical Fields
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-primary" style="border-radius:8px;" onclick="addEditCustomField()">
                                    <i class="bi bi-plus-circle me-1"></i>Add Field
                                </button>
                            </div>
                            <p class="text-muted small mb-2">Add structured fields like Biomarkers, Behavioral Observations, Screening Scales, etc.</p>
                            <div id="customFieldsContainer">
                                <!-- Dynamically added or pre-populated custom fields -->
                            </div>
                        </div>

                        <!-- Expected Follow-up Date & Slot -->
                        @{
                            bool isPackageEdit = !string.IsNullOrWhiteSpace(Model.Record?.PackageName)
                                              || (Model.PatientPackages != null && Model.PatientPackages.Any(p => p.Status == "Active" || p.Status == "Accepted"));
                        }

                        @if (isPackageEdit)
                        {
                            <div class="form-section">
                                <div class="p-3 rounded-3 border" style="background:#f0fdfa; border-color:#99f6e4 !important;">
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <i class="bi bi-box-seam text-teal" style="font-size:1.1rem; color:#0d9488;"></i>
                                        <span class="fw-bold text-dark" style="font-size:0.88rem;">Treatment Package Active</span>
                                    </div>
                                    <p class="text-muted small mb-0">
                                        This patient is enrolled in a treatment package@(string.IsNullOrWhiteSpace(Model.Record?.PackageName) ? "" : $" ({Model.Record.PackageName})"). Subsequent therapy sessions are scheduled and managed through the Treatment Plan roadmap.
                                    </p>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="form-section">
                                <div class="form-section-title">
                                    <i class="bi bi-calendar"></i>Expected Follow-up Date & Slot
                                </div>
                                <div class="row g-2 align-items-end mb-3">
                                    <div class="col-sm-7 col-md-6">
                                        <label class="form-label small fw-semibold text-muted mb-1">Select Follow-up Date</label>
                                        <input asp-for="Input.NextAppointmentRecommendedDate" id="editRecDateInput" min="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" type="date" style="border-radius:10px;" onchange="loadEditRecommendedSlots(this.value)" />
                                    </div>
                                    <div class="col-sm-5 col-md-4">
                                        <button type="button" class="btn btn-outline-primary w-100" style="border-radius:10px; border-color:#0d9488; color:#0d9488;" onclick="loadEditRecommendedSlots(document.getElementById('editRecDateInput').value)">
                                            <i class="bi bi-search me-1"></i>View Slots
                                        </button>
                                    </div>
                                </div>
                                <div id="editRecSlotContainer" class="mb-2" style="@(Model.Input.NextAppointmentRecommendedDate.HasValue ? "" : "display:none;")">
                                    <label class="form-label small fw-bold text-dark mb-2" id="editRecSlotHeader">Available Time Slots for Follow-up</label>
                                    <div id="editRecSlotsGrid" class="row g-2"></div>
                                    <input type="hidden" asp-for="Input.NextAppointmentRecommendedSlotId" id="editRecSlotInput" />
                                </div>
                                <div id="editRecSlotMsg" class="form-text small text-muted mt-2">
                                    <i class="bi bi-info-circle me-1"></i>This saves a recommended follow-up slot for the patient. It does not automatically create an appointment.
                                </div>
                            </div>
                        }

                        <!-- Consultation Date -->
                        <div class="form-section">
                            <div class="form-section-title">
                                <i class="bi bi-calendar-check"></i>Consultation Date
                            </div>
                            <div class="row g-3">
                                <div class="col-md-12">
                                    <label class="form-label fw-semibold" style="font-size:0.85rem;">
                                        <i class="bi bi-calendar3 me-1"></i>Consultation Date
                                    </label>
                                    @if (Model.Record?.IsFromAppointment == true)
                                    {
                                        <input type="datetime-local" class="form-control" 
                                               value="@Model.Record.DisplayConsultationDate.ToString("yyyy-MM-ddTHH:mm")" 
                                               disabled style="border-radius:10px; background:#f1f5f9;" />
                                        <small class="text-muted"><i class="bi bi-lock me-1"></i>Auto-filled from appointment</small>
                                        <input type="hidden" asp-for="Input.ConsultationDate" value="@Model.Record.DisplayConsultationDate.ToString("yyyy-MM-ddTHH:mm")" />
                                    }
                                    else
                                    {
                                        <input type="datetime-local" asp-for="Input.ConsultationDate" class="form-control" style="border-radius:10px;" />
                                        <small class="text-muted">Enter the actual consultation date</small>
                                    }
                                </div>
                            </div>
                            <input type="hidden" asp-for="Input.Visibility" value="1" />
                        </div>

                        <div class="d-flex justify-content-end gap-3 pt-3 mt-3" style="border-top:2px solid #f1f5f9;">
                            <a asp-page="./Details" asp-route-id="@Model.RecordId" class="btn btn-outline-secondary px-4 py-2 fw-bold" style="border-radius:10px;">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4 py-2 fw-bold d-flex align-items-center gap-2" style="border-radius:10px; background:var(--mb-primary); border-color:var(--mb-primary);">
                                <i class="bi bi-check-circle-fill"></i>Update profile
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
<script>
    let customFieldCount = 0;
    function addEditCustomField(title = '', content = '', fieldType = 'Text') {
        const container = document.getElementById('customFieldsContainer');
        const index = customFieldCount++;
        const div = document.createElement('div');
        div.className = 'p-3 rounded-3 mb-2 border bg-light';
        div.id = `customFieldRow_${index}`;
        div.innerHTML = `
            <div class="row g-2 align-items-center">
                <div class="col-md-4">
                    <input type="text" name="Input.CustomFields[${index}].Title" value="${title.replace(/"/g, '&quot;')}" class="form-control form-control-sm" placeholder="Field Title (e.g. Test Score)" style="border-radius:8px;" required />
                </div>
                <div class="col-md-5">
                    <input type="text" name="Input.CustomFields[${index}].Content" value="${content.replace(/"/g, '&quot;')}" class="form-control form-control-sm" placeholder="Content / Observation" style="border-radius:8px;" required />
                </div>
                <div class="col-md-2">
                    <select name="Input.CustomFields[${index}].FieldType" class="form-select form-select-sm" style="border-radius:8px;">
                        <option value="Text" ${fieldType === 'Text' ? 'selected' : ''}>Text</option>
                        <option value="Number" ${fieldType === 'Number' ? 'selected' : ''}>Number</option>
                        <option value="Date" ${fieldType === 'Date' ? 'selected' : ''}>Date</option>
                    </select>
                </div>
                <div class="col-md-1 text-end">
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="document.getElementById('customFieldRow_${index}').remove()" style="border-radius:8px;">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </div>
        `;
        container.appendChild(div);
    }

    const currentSelectedSlotId = '@(Model.Input.NextAppointmentRecommendedSlotId?.ToString() ?? "")';

    async function loadEditRecommendedSlots(date, preselectId = '') {
        const container = document.getElementById('editRecSlotContainer');
        const grid = document.getElementById('editRecSlotsGrid');
        const msg = document.getElementById('editRecSlotMsg');
        const header = document.getElementById('editRecSlotHeader');
        const slotInput = document.getElementById('editRecSlotInput');

        if (!date) {
            if (container) container.style.display = 'none';
            if (slotInput) slotInput.value = '';
            return;
        }

        if (container) container.style.display = 'block';
        if (header) header.textContent = 'Available Time Slots for ' + date;
        if (grid) grid.innerHTML = '<div class="col-12 py-2 text-center text-muted small"><span class="spinner-border spinner-border-sm me-2"></span>Loading time slots...</div>';

        const targetSelected = preselectId || slotInput.value;

        try {
            const response = await fetch(`?handler=Slots&date=${encodeURIComponent(date)}`);
            const data = await response.json();
            if (data.success && data.slots && data.slots.length > 0) {
                grid.innerHTML = data.slots.map(s => {
                    const isChecked = (targetSelected && s.id.toLowerCase() === targetSelected.toLowerCase()) ? 'checked' : '';
                    return `
                        <div class="col-6 col-sm-4 col-md-3">
                            <input type="radio" class="btn-check" name="editRecSlotRadio" id="rec_slot_${s.id}" value="${s.id}" ${isChecked} onchange="document.getElementById('editRecSlotInput').value = this.value" />
                            <label class="btn btn-outline-primary w-100 p-2.5 rounded-3 text-center" for="rec_slot_${s.id}" style="border-radius:10px;">
                                <div class="fw-bold fs-6">${s.startTime}</div>
                                <div class="small opacity-75">until ${s.endTime}</div>
                            </label>
                        </div>
                    `;
                }).join('');
                if (msg) msg.innerHTML = '<i class="bi bi-info-circle me-1"></i>Select a suggested follow-up slot for the patient.';
            } else {
                grid.innerHTML = `<div class="col-12 p-3 text-center bg-light rounded-3 border border-dashed text-muted"><i class="bi bi-calendar-x d-block fs-5 mb-1"></i>No available slots found for this date.</div>`;
                if (msg) msg.innerHTML = '<span class="text-warning"><i class="bi bi-exclamation-triangle me-1"></i>No available slots on this date.</span>';
            }
        } catch (e) {
            if (grid) grid.innerHTML = `<div class="col-12 p-3 text-center text-danger small">Failed to load slots.</div>`;
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        const dateInput = document.getElementById('editRecDateInput');
        if (dateInput && dateInput.value) {
            loadEditRecommendedSlots(dateInput.value, currentSelectedSlotId);
        }

        @if (Model.Input.CustomFields != null && Model.Input.CustomFields.Any())
        {
            @foreach (var cf in Model.Input.CustomFields)
            {
                <text>addEditCustomField('@Html.Raw(JavaScriptEncoder.Default.Encode(cf.Title ?? ""))', '@Html.Raw(JavaScriptEncoder.Default.Encode(cf.Content ?? ""))', '@Html.Raw(JavaScriptEncoder.Default.Encode(cf.FieldType ?? "Text"))');</text>
            }
        }
    });
</script>
}
