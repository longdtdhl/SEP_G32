@page
@model OPCBS.Web.Pages.Doctor.ConsultationNotes.IndexModel
@{
    ViewData["Title"] = "Consultation Records";
    ViewData["UseDashboardLayout"] = true;
    var groupedByPatient = Model.Records.GroupBy(r => r.DisplayPatientName).ToList();
    int totalRecords = Model.Records.Count;
    int totalPatients = groupedByPatient.Count;
    var latestRecord = Model.Records.OrderByDescending(r => r.ConsultationDate).FirstOrDefault();
}

<style>
    .cr-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 1.5rem; }
    .cr-stat {
        background: white; border-radius: 14px; padding: 1.25rem; border: 1px solid rgba(78,139,112,0.08);
        display: flex; align-items: center; gap: 1rem; transition: all 0.2s;
    }
    .cr-stat:hover { transform: translateY(-2px); box-shadow: 0 4px 15px rgba(0,0,0,0.06); }
    .cr-stat .icon {
        width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center;
        font-size: 1.2rem; flex-shrink: 0;
    }
    .cr-stat .value { font-size: 1.5rem; font-weight: 700; color: #1e293b; line-height: 1; }
    .cr-stat .label { font-size: 0.8rem; color: #64748b; margin-top: 2px; }

    .cr-card { background: white; border-radius: 16px; border: 1px solid rgba(78,139,112,0.08); overflow: hidden; }
    .cr-card-header {
        padding: 1.25rem 1.5rem; border-bottom: 1px solid #f1f5f9;
        display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;
    }
    .cr-card-header h5 { margin: 0; font-size: 1rem; font-weight: 600; color: #1e293b; }

    .search-box { position: relative; }
    .search-box input {
        border-radius: 10px; border: 1.5px solid #e2e8f0; padding: 6px 12px 6px 36px; font-size: 0.85rem;
        width: 260px; transition: all 0.2s;
    }
    .search-box input:focus { border-color: var(--mb-primary); box-shadow: 0 0 0 3px rgba(78,139,112,0.1); outline: none; }
    .search-box .bi { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #94a3b8; }

    .record-row {
        display: flex; align-items: center; padding: 1rem 1.5rem; border-bottom: 1px solid #f8fafc;
        transition: background 0.15s; gap: 1rem; cursor: pointer; text-decoration: none; color: inherit;
    }
    .record-row:last-child { border-bottom: none; }
    .record-row:hover { background: #f8fffe; }
    .record-avatar {
        width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: 1rem; flex-shrink: 0;
    }
    .record-info { flex: 1; min-width: 0; }
    .record-info .name { font-weight: 600; color: #1e293b; font-size: 0.9rem; }
    .record-info .diagnosis {
        font-size: 0.8rem; color: #64748b; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 400px;
    }
    .record-date { font-size: 0.78rem; color: #94a3b8; text-align: right; white-space: nowrap; }
    .record-actions .btn { border-radius: 8px; font-size: 0.78rem; font-weight: 500; }

    /* Sidebar */
    .patient-sidebar { background: white; border-radius: 16px; border: 1px solid rgba(78,139,112,0.08); }
    .patient-sidebar .sidebar-header { padding: 1rem 1.25rem; border-bottom: 1px solid #f1f5f9; }
    .patient-sidebar .sidebar-header h6 { margin: 0; font-size: 0.85rem; font-weight: 600; color: #1e293b; }
    .patient-item {
        padding: 0.6rem 1.25rem; display: flex; align-items: center; gap: 0.75rem;
        transition: background 0.15s; cursor: pointer; border-bottom: 1px solid #fafafa;
    }
    .patient-item:hover { background: #f0fdf8; }
    .patient-item .avatar {
        width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center;
        font-weight: 600; font-size: 0.75rem; flex-shrink: 0;
    }
    .patient-item .name { font-size: 0.82rem; font-weight: 500; color: #1e293b; }
    .patient-item .count {
        margin-left: auto; font-size: 0.7rem; background: #f1f5f9; padding: 1px 8px; border-radius: 10px;
        font-weight: 600; color: #475569;
    }

    .empty-state { text-align: center; padding: 3rem 1rem; color: #94a3b8; }
    .empty-state i { font-size: 3rem; opacity: 0.3; display: block; margin-bottom: 1rem; }

    @@media (max-width: 768px) {
        .cr-stats { grid-template-columns: 1fr; }
        .search-box input { width: 100%; }
    }
</style>

<!-- Page Header -->
<div class="mb-page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 style="font-size:1.4rem; font-weight:700; margin:0;">
            <i class="bi bi-file-earmark-medical me-2" style="color:var(--mb-primary);"></i>Consultation Records
        </h1>
        <p style="margin:4px 0 0; font-size:0.85rem; color:#64748b;">Management medical record, diagnosis and notes therapy of patient</p>
    </div>
    <a asp-page="Create" class="btn btn-primary d-flex align-items-center gap-2 px-4 py-2 fw-semibold shadow-sm" style="border-radius:12px; background:var(--mb-primary); border-color:var(--mb-primary);">
        <i class="bi bi-plus-lg"></i>Create New Record
    </a>
</div>

<!-- Alerts -->
@if (Model.Success != null)
{
    <div class="alert alert-success alert-dismissible fade show" style="border-radius:12px; border:none; background:linear-gradient(135deg,#ecfdf5,#d1fae5);">
        <i class="bi bi-check-circle-fill me-2" style="color:#10b981;"></i>@Model.Success
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (Model.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show" style="border-radius:12px; border:none;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}


<div class="row g-4">
    <!-- Patient Tree Sidebar -->
    <div class="col-lg-3 d-none d-lg-block">
        <div class="patient-sidebar">
            <div class="sidebar-header">
                <h6><i class="bi bi-people-fill me-2" style="color:var(--mb-primary);"></i>Patient</h6>
            </div>
            @if (groupedByPatient.Any())
            {
                @foreach (var group in groupedByPatient)
                {
                    var initial = group.Key.Substring(0, 1).ToUpper();
                    var colors = new[] { "#6366f1", "#10b981", "#f59e0b", "#ef4444", "#8b5cf6", "#ec4899" };
                    var color = colors[Math.Abs(group.Key.GetHashCode()) % colors.Length];
                    <div class="patient-item" onclick="filterByPatient('@group.Key.Replace("'", "\\'")'); return false;">
                        <div class="avatar" style="background:@(color)15; color:@color;">@initial</div>
                        <div class="name">@group.Key</div>
                        <div class="count">@group.Count()</div>
                    </div>
                }
            }
            else
            {
                <div style="padding:2rem; text-align:center; color:#94a3b8; font-size:0.85rem;">
                    <i class="bi bi-inbox d-block mb-2" style="font-size:1.5rem; opacity:0.4;"></i>
                    None yet patient
                </div>
            }
        </div>
    </div>

    <!-- Records List -->
    <div class="col-lg-9">
        <div class="cr-card">
            <div class="cr-card-header">
                <h5><i class="bi bi-journal-medical me-2" style="color:var(--mb-primary);"></i>List profile</h5>
                <form method="get" class="search-box m-0">
                    <i class="bi bi-search"></i>
                    <input type="text" name="Search" value="@Model.Search" placeholder="Find theo tên, diagnosis..." />
                </form>
            </div>

            @if (Model.Records.Any())
            {
                @foreach (var r in Model.Records.OrderByDescending(r => r.ConsultationDate))
                {
                    var initial = r.DisplayPatientName.Substring(0, 1).ToUpper();
                    var colors = new[] { "#6366f1", "#10b981", "#f59e0b", "#ef4444", "#8b5cf6", "#ec4899" };
                    var color = colors[Math.Abs(r.DisplayPatientName.GetHashCode()) % colors.Length];
                    <a asp-page="Edit" asp-route-id="@r.Id" class="record-row">
                        <div class="record-avatar" style="background:@(color)12; color:@color;">@initial</div>
                        <div class="record-info">
                            <div class="name">
                                @r.DisplayPatientName
                                @if (r.IsWalkIn)
                                {
                                    <span style="font-size:0.65rem; background:#fef3c7; color:#92400e; padding:1px 6px; border-radius:6px; margin-left:4px;">Guest</span>
                                }
                                else
                                {
                                    <span style="font-size:0.65rem; background:#dcfce7; color:#166534; padding:1px 6px; border-radius:6px; margin-left:4px;">System</span>
                                }
                            </div>
                            <div class="diagnosis">
                                <i class="bi bi-clipboard2-pulse me-1"></i>@(string.IsNullOrEmpty(r.Diagnosis) ? "No diagnosis recorded" : r.Diagnosis)
                            </div>
                        </div>
                        <div class="record-date">
                            <div><i class="bi bi-calendar3 me-1"></i>@r.DisplayConsultationDate.ToString("MM/dd/yyyy")</div>
                            <div style="font-size:0.7rem;">@r.DisplayConsultationDate.ToString("HH:mm")</div>
                        </div>
                        <div class="record-actions">
                            <span class="btn btn-sm btn-outline-primary px-3">
                                <i class="bi bi-eye me-1"></i>Details
                            </span>
                        </div>
                    </a>
                }
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-file-earmark-medical"></i>
                    <h6 style="font-weight:600; color:#1e293b;">None yet profile consultation nào</h6>
                    <p style="font-size:0.85rem; margin:4px 0 16px;">All profile patient your sẽ xuất hiện ở here</p>
                    <a asp-page="Create" class="btn btn-sm btn-primary px-4" style="border-radius:10px; background:var(--mb-primary); border-color:var(--mb-primary);">
                        <i class="bi bi-plus-lg me-1"></i>Create profile đầu tiên
                    </a>
                </div>
            }
        </div>

        @if (Model.Pagination != null && Model.Pagination.TotalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center gap-1">
                    @for (int i = 1; i <= Model.Pagination.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link border-0 rounded-3 fw-semibold" asp-page="Index" asp-route-currentPage="@i" asp-route-search="@Model.Search"
                               style="@(i == Model.CurrentPage ? "background:var(--mb-primary); color:white;" : "background:#f8faf8; color:#1e293b;")">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>

@section Scripts {
<script>
    function filterByPatient(name) {
        var input = document.querySelector('.search-box input');
        input.value = name;
        input.closest('form').submit();
    }
</script>
}
