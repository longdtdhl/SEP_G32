                }
                else
                {
                    <tr style="border-bottom: 1px solid #f1f5f9;">
                        <td style="padding: 6px 8px; font-family: monospace; font-weight: 600;">OPCBS-20260817-001</td>
                        <td style="padding: 6px 8px; color: #64748b;">17/08/2026 09:00</td>
                        <td style="padding: 6px 8px; font-weight: 600;">Emily Watson</td>
                        <td style="padding: 6px 8px;">Online Video Consultation</td>
                        <td style="padding: 6px 8px; color: #059669; font-weight: 600;">Completed</td>
                        <td style="padding: 6px 8px; text-align: right; font-weight: 600;">500,000 VND</td>
                        <td style="padding: 6px 8px; text-align: right; font-weight: 700; color: #059669;">500,000 VND</td>
                    </tr>
                    <tr style="border-bottom: 1px solid #f1f5f9;">
                        <td style="padding: 6px 8px; font-family: monospace; font-weight: 600;">OPCBS-20260816-002</td>
                        <td style="padding: 6px 8px; color: #64748b;">16/08/2026 14:30</td>
                        <td style="padding: 6px 8px; font-weight: 600;">John Smith</td>
                        <td style="padding: 6px 8px;">Online Video Consultation</td>
                        <td style="padding: 6px 8px; color: #059669; font-weight: 600;">Completed</td>
                        <td style="padding: 6px 8px; text-align: right; font-weight: 600;">400,000 VND</td>
                        <td style="padding: 6px 8px; text-align: right; font-weight: 700; color: #059669;">400,000 VND</td>
                    </tr>
                    <tr style="border-bottom: 1px solid #f1f5f9;">
                        <td style="padding: 6px 8px; font-family: monospace; font-weight: 600;">PKG-20260815-001</td>
                        <td style="padding: 6px 8px; color: #64748b;">15/08/2026 10:00</td>
                        <td style="padding: 6px 8px; font-weight: 600;">Anna Nguyen</td>
                        <td style="padding: 6px 8px;">Treatment Package (Session 2/5)</td>
                        <td style="padding: 6px 8px; color: #059669; font-weight: 600;">Completed</td>
                        <td style="padding: 6px 8px; text-align: right; font-weight: 600;">300,000 VND</td>
                        <td style="padding: 6px 8px; text-align: right; font-weight: 700; color: #059669;">300,000 VND</td>
                    </tr>
                    <tr style="border-bottom: 1px solid #f1f5f9;">
                        <td style="padding: 6px 8px; font-family: monospace; font-weight: 600;">OPCBS-20260820-003</td>
                        <td style="padding: 6px 8px; color: #64748b;">20/08/2026 11:00</td>
                        <td style="padding: 6px 8px; font-weight: 600;">Michael Brown</td>
                        <td style="padding: 6px 8px;">Online Video Consultation</td>
                        <td style="padding: 6px 8px; color: #d97706; font-weight: 600;">Confirmed</td>
                        <td style="padding: 6px 8px; text-align: right; font-weight: 600;">500,000 VND</td>
                        <td style="padding: 6px 8px; text-align: right; font-weight: 700; color: #059669;">500,000 VND</td>
                    </tr>
                    <tr style="border-bottom: 1px solid #f1f5f9;">
                        <td style="padding: 6px 8px; font-family: monospace; font-weight: 600;">PKG-20260822-002</td>
                        <td style="padding: 6px 8px; color: #64748b;">22/08/2026 15:00</td>
                        <td style="padding: 6px 8px; font-weight: 600;">Sarah Wilson</td>
                        <td style="padding: 6px 8px;">Treatment Package (Session 1/5)</td>
                        <td style="padding: 6px 8px; color: #d97706; font-weight: 600;">Confirmed</td>
                        <td style="padding: 6px 8px; text-align: right; font-weight: 600;">300,000 VND</td>
