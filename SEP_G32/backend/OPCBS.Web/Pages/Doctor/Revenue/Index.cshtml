            </tbody>
            <tfoot>
                <tr style="background: #f8fafc; border-top: 1.5px solid #cbd5e1;">
                    <td colspan="5" style="padding: 8px; font-weight: 800; text-align: right; text-transform: uppercase;">Total Period Revenue (@periodLabel):</td>
                    <td style="padding: 8px; text-align: right; font-weight: 800; font-size: 11px;">@totalGross.ToString("N0") VND</td>
                    <td style="padding: 8px; text-align: right; font-weight: 800; font-size: 11px; color: #059669;">@totalGross.ToString("N0") VND</td>
