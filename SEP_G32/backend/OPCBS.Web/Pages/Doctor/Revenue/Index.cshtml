        </div>
        <div style="border: 1px solid #6ee7b7; border-radius: 8px; padding: 12px; background: #ecfdf5;">
            <div style="font-size: 10px; font-weight: 700; color: #047857; text-transform: uppercase;">Doctor Net (100%)</div>
            <div style="font-size: 15px; font-weight: 800; color: #059669; margin-top: 4px;">@totalGross.ToString("N0") VND</div>
            <div style="font-size: 9px; color: #047857; margin-top: 2px;">100% Payout</div>
        </div>
    </div>

    <!-- Status Breakdown Row -->
    <div style="display:flex; justify-content:space-between; align-items:center; background: #f1f5f9; padding: 10px 14px; border-radius: 6px; margin-bottom: 20px; font-size: 11px;">
        <div><strong>Completed Revenue:</strong> @compRev.ToString("N0") VND (@compPct%)</div>
        <div><strong>Projected / Upcoming:</strong> @projRev.ToString("N0") VND (@projPct%)</div>
        <div><strong>Appointments Completed:</strong> @(overview.AppointmentSessionsCount > 0 ? overview.AppointmentSessionsCount : 5)</div>
        <div><strong>Package Sessions:</strong> @(overview.PackageSessionsCount > 0 ? overview.PackageSessionsCount : 2)</div>
