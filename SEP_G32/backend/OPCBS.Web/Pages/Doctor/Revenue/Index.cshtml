                        <td class="text-end fw-bold text-success">500,000 VND <small class="text-muted fw-normal">(Projected)</small></td>
                        <td class="text-end no-print"><i class="bi bi-chevron-right text-muted"></i></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark font-monospace" style="font-size:0.8rem;">PKG-20260822-002</td>
                        <td class="text-muted small">22/08/2026 15:00</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div style="width:28px; height:28px; border-radius:50%; background:#dcfce7; color:#15803d; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:0.75rem;">S</div>
                                <span class="fw-semibold text-dark">Sarah Wilson</span>
                            </div>
                        </td>
                        <td><span class="tag-service-package"><i class="bi bi-gift me-1"></i>Treatment Package - Session 1/5</span></td>
                        <td class="text-muted small">60 mins</td>
                        <td><span class="tag-confirmed"><i class="bi bi-clock me-1"></i>Confirmed</span></td>
                        <td class="text-end fw-bold text-dark">300,000 VND <small class="text-muted fw-normal">(Projected)</small></td>
                        <td class="text-end fw-bold text-success">300,000 VND <small class="text-muted fw-normal">(Projected)</small></td>
                        <td class="text-end no-print"><i class="bi bi-chevron-right text-muted"></i></td>
