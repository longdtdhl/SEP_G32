                        <td class="fw-bold text-dark font-monospace" style="font-size:0.8rem;">OPCBS-20260817-001</td>
                        <td class="text-muted small">17/08/2026 09:00</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
