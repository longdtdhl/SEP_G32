    </div>

    <!-- PDF Footer -->
    <div style="border-top: 1px solid #e2e8f0; padding-top: 12px; margin-top: 24px; display:flex; justify-content:space-between; align-items:center; font-size: 9px; color: #94a3b8;">
        <div>OPCBS System &bull; Confidential Medical & Financial Record</div>
        <div>Page 1 of 1</div>
