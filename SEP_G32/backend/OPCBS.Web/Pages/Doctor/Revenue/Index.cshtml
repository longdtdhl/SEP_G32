                        <td class="text-end fw-bold text-success">500,000 VND</td>
                        <td class="text-end no-print"><i class="bi bi-chevron-right text-muted"></i></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark font-monospace" style="font-size:0.8rem;">OPCBS-20260816-002</td>
                        <td class="text-muted small">16/08/2026 14:30</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
