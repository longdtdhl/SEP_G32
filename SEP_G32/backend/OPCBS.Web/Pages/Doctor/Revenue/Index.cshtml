<!-- ══ 6. PRICING & SERVICES CONFIGURATION MODAL ══ -->
<div class="modal fade" id="pricingModal" tabindex="-1" aria-labelledby="pricingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius:16px;">
            <div class="modal-header border-bottom px-4 py-3 bg-light" style="border-radius:16px 16px 0 0;">
                <div class="d-flex align-items-center gap-2">
                    <span style="background:#f0fdfa; color:#0d9488; width:34px; height:34px; border-radius:8px; display:inline-flex; align-items:center; justify-content:center;">
                        <i class="bi bi-gear-fill"></i>
                    </span>
                    <div>
                        <h5 class="modal-title fw-bold text-dark fs-6" id="pricingModalLabel">Consultation Pricing & Services</h5>
                        <p class="text-muted small mb-0" style="font-size:0.75rem;">Configure your consultation rates and session durations</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page="/Doctor/Revenue/Index" asp-page-handler="UpdatePricing">
                <div class="modal-body p-4">
                    <!-- 1. Consultation Pricing -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label small fw-bold text-dark mb-0">
                                <i class="bi bi-cash-stack me-1 text-primary"></i>Online Consultation Hourly Rate
                            </label>
                            <span class="text-primary fw-bold small" id="liveFeeFormatted">@Model.CurrentConsultationFee.ToString("N0") VND / hr</span>
                        </div>
                        <div class="input-group">
                            <input type="number" name="consultationFee" id="modalFeeInput" class="form-control fw-bold" value="@Model.CurrentConsultationFee.ToString("F0")" min="50000" step="50000" required oninput="updatePricePreview()" />
                            <span class="input-group-text bg-light text-muted small fw-semibold">VND / hr</span>
                        </div>

                        <!-- Quick Rate Selection Chips -->
                        <div class="d-flex align-items-center flex-wrap gap-1.5 mt-2">
                            <span class="text-muted small" style="font-size:0.75rem;">Quick select:</span>
                            <span class="chip-price" onclick="setQuickRate(200000)">200,000 VND</span>
                            <span class="chip-price" onclick="setQuickRate(300000)">300,000 VND</span>
                            <span class="chip-price" onclick="setQuickRate(500000)">500,000 VND</span>
                            <span class="chip-price" onclick="setQuickRate(800000)">800,000 VND</span>
                            <span class="chip-price" onclick="setQuickRate(1000000)">1,000,000 VND</span>
                        </div>
                    </div>

                    <!-- 2. Default Session Duration -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark mb-1">
                            <i class="bi bi-clock-history me-1 text-primary"></i>Default Session Duration
                        </label>
                        <select name="durationMinutes" id="modalDurationInput" class="form-select" onchange="updatePricePreview()">
                            <option value="30">30 minutes</option>
                            <option value="45">45 minutes</option>
                            <option value="60" selected>60 minutes</option>
                            <option value="90">90 minutes</option>
                            <option value="120">120 minutes</option>
                        </select>
                    </div>

                    <!-- 3. Active Consultation Types -->
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark mb-1">
                            <i class="bi bi-check2-square me-1 text-primary"></i>Offered Consultation Channels
                        </label>
                        <input type="text" name="consultationTypes" class="form-control" value="@(Model.DoctorProfile?.ConsultationTypes ?? "Online, In-person")" placeholder="e.g. Online, In-person" />
                    </div>

                    <!-- 4. Real-time Price Preview Block -->
                    <div class="p-3 rounded-3 bg-light border mt-3">
                        <div class="text-uppercase fw-bold text-muted small mb-2" style="font-size:0.72rem; letter-spacing:0.5px;">PRICE PREVIEW</div>
                        
                        <div class="d-flex justify-content-between align-items-center mb-1.5">
                            <span class="small text-muted">Price per session:</span>
                            <div class="text-end">
                                <span class="fw-bold text-dark fs-6" id="previewSessionPrice">@Model.CurrentConsultationFee.ToString("N0") VND</span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center small pt-1 border-top">
                            <span class="text-muted">Formula breakdown:</span>
                            <span class="text-primary fw-bold" id="previewFormula">@Model.CurrentConsultationFee.ToString("N0") VND/hr × 1 hr (60 mins) = @Model.CurrentConsultationFee.ToString("N0") VND</span>
                        </div>
                    </div>

                    <!-- Price Immutability / Snapshot Notice -->
                    <div class="alert alert-warning py-2.5 px-3 mt-3 mb-2 small d-flex align-items-start gap-2.5" style="font-size:0.77rem; border-radius:10px; background:#fffbeb; border-color:#fde68a; color:#92400e;">
                        <i class="bi bi-shield-lock-fill text-warning fs-6 mt-0.5"></i>
                        <div>
                            <strong>Price Snapshot Policy:</strong> Price changes apply to new bookings only. Existing appointments and purchased packages are not affected.
                        </div>
                    </div>

                    <!-- Zero-Fee Notice -->
                    <div class="alert alert-info py-2 px-2.5 mb-0 small d-flex align-items-start gap-2" style="font-size:0.75rem; border-radius:10px;">
                        <i class="bi bi-info-circle-fill text-info mt-0.5"></i>
                        <div>OPCBS charges 0% platform fee. You receive 100% of your consultation and package revenue.</div>
                    </div>
                </div>
                <div class="modal-footer border-top bg-light px-4 py-2.5" style="border-radius:0 0 16px 16px;">
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary rounded-pill px-4 fw-bold shadow-sm">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ══ 7. DEDICATED STYLED PDF REPORT TEMPLATE ══ -->
<div id="pdfExportContainer" style="background:#ffffff; color:#0f172a; font-family:'Segoe UI', Arial, sans-serif; padding: 24px;">
