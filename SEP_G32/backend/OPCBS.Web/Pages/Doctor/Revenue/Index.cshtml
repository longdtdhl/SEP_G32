                        <td><span class="tag-service-online"><i class="bi bi-camera-video me-1"></i>Online Consultation</span></td>
                        <td class="text-muted small">60 mins</td>
                        <td><span class="tag-completed"><i class="bi bi-check-circle-fill me-1"></i>Completed</span></td>
                        <td class="text-end fw-bold text-dark">400,000 VND</td>
                        <td class="text-end fw-bold text-success">400,000 VND</td>
                        <td class="text-end no-print"><i class="bi bi-chevron-right text-muted"></i></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark font-monospace" style="font-size:0.8rem;">PKG-20260815-001</td>
                        <td class="text-muted small">15/08/2026 10:00</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div style="width:28px; height:28px; border-radius:50%; background:#fce7f3; color:#be185d; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:0.75rem;">A</div>
                                <span class="fw-semibold text-dark">Anna Nguyen</span>
                            </div>
                        </td>
                        <td><span class="tag-service-package"><i class="bi bi-gift me-1"></i>Treatment Package - Session 2/5</span></td>
                        <td class="text-muted small">60 mins</td>
                        <td><span class="tag-completed"><i class="bi bi-check-circle-fill me-1"></i>Completed</span></td>
                        <td class="text-end fw-bold text-dark">300,000 VND</td>
                        <td class="text-end fw-bold text-success">300,000 VND</td>
                        <td class="text-end no-print"><i class="bi bi-chevron-right text-muted"></i></td>
                    </tr>
                    <tr>
                        <td class="fw-bold text-dark font-monospace" style="font-size:0.8rem;">OPCBS-20260820-003</td>
                        <td class="text-muted small">20/08/2026 11:00</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
