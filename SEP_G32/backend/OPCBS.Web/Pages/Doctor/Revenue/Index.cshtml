@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<!-- html2pdf.js bundle -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<script>
    // Server-rendered Timeline Data
    const trendLabels = @Html.Raw(JsonSerializer.Serialize(timelineLabels));
    const trendTotal = @Html.Raw(JsonSerializer.Serialize(timelineTotal));
    const trendCompleted = @Html.Raw(JsonSerializer.Serialize(timelineCompleted));
    const trendProjected = @Html.Raw(JsonSerializer.Serialize(timelineProjected));

    const apptRevenueVal = @apptRev;
    const pkgRevenueVal = @pkgRev;

    // Helper: Currency formatter
    function formatCurrency(amount) {
        return Number(Math.round(amount)).toLocaleString() + ' VND';
    }

    // 1. Initialize Multi-Line Revenue Trend Chart
    function initTrendChart() {
        const ctx = document.getElementById('revenueTrendChart');
        if (!ctx) return;

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: trendLabels,
                datasets: [
                    {
                        label: 'Total Revenue',
                        data: trendTotal,
                        borderColor: '#0d9488',
                        backgroundColor: 'rgba(13, 148, 136, 0.08)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.35,
                        pointRadius: 4,
                        pointBackgroundColor: '#0d9488',
                        pointHoverRadius: 6
                    },
                    {
                        label: 'Completed Revenue',
                        data: trendCompleted,
                        borderColor: '#10b981',
                        backgroundColor: 'transparent',
                        borderWidth: 2.5,
                        borderDash: [5, 5],
                        fill: false,
                        tension: 0.35,
                        pointRadius: 3,
                        pointBackgroundColor: '#10b981',
                        pointHoverRadius: 5
                    },
                    {
                        label: 'Projected / Upcoming',
                        data: trendProjected,
                        borderColor: '#f59e0b',
                        backgroundColor: 'transparent',
                        borderWidth: 2,
                        borderDash: [2, 2],
                        fill: false,
                        tension: 0.35,
                        pointRadius: 3,
                        pointBackgroundColor: '#f59e0b',
                        pointHoverRadius: 5
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#0f172a',
                        padding: 10,
                        titleFont: { size: 12, weight: 'bold' },
                        cornerRadius: 8,
                        callbacks: {
                            label: function(context) {
                                return context.dataset.label + ': ' + formatCurrency(context.raw || 0);
                            }
                        }
                    }
                },
                scales: {
                    x: { grid: { display: false }, ticks: { font: { size: 11 }, color: '#64748b' } },
                    y: {
                        beginAtZero: true,
                        grid: { color: '#f1f5f9' },
                        ticks: {
                            font: { size: 11 },
                            color: '#64748b',
                            callback: function(val) {
                                if (val >= 1000000) return (val / 1000000).toFixed(1) + 'M VND';
                                if (val >= 1000) return (val / 1000).toFixed(0) + 'k VND';
                                return val + ' VND';
                            }
                        }
                    }
                }
            }
        });
    }

    // 2. Initialize Service Breakdown Donut Chart
    function initServiceChart() {
        const ctx = document.getElementById('serviceBreakdownChart');
        if (!ctx) return;

        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Online Consultation', 'Treatment Packages'],
                datasets: [{
                    data: [apptRevenueVal, pkgRevenueVal],
                    backgroundColor: ['#0d9488', '#7c3aed'],
                    borderWidth: 0,
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '72%',
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return context.label + ': ' + formatCurrency(context.raw || 0);
                            }
                        }
                    }
                }
            }
        });
    }

    // 3. Live Price Preview Calculation (Hourly Rate × Duration Hours)
    function updatePricePreview() {
        const feeInput = document.getElementById('modalFeeInput');
        const hourlyRate = parseFloat(feeInput?.value) || 0;
        const duration = parseInt(document.getElementById('modalDurationInput')?.value) || 60;
        const hours = duration / 60.0;
        const sessionPrice = Math.round(hourlyRate * hours);

        const liveFormatted = document.getElementById('liveFeeFormatted');
        if (liveFormatted) {
            liveFormatted.innerText = Number(hourlyRate).toLocaleString() + ' VND / hr';
        }

        const previewPrice = document.getElementById('previewSessionPrice');
        if (previewPrice) {
            previewPrice.innerText = Number(sessionPrice).toLocaleString() + ' VND';
        }

        const previewFormula = document.getElementById('previewFormula');
        if (previewFormula) {
            const hoursFormatted = (hours % 1 === 0) ? hours.toFixed(0) : hours.toFixed(2).replace(/\.?0+$/, '');
            const hrUnit = (hours === 1) ? 'hr' : 'hrs';
            previewFormula.innerText = Number(hourlyRate).toLocaleString() + ' VND/hr × ' + hoursFormatted + ' ' + hrUnit + ' (' + duration + ' mins) = ' + Number(sessionPrice).toLocaleString() + ' VND';
        }
    }

    // 4. Quick rate select chips
    function setQuickRate(rate) {
        const feeInput = document.getElementById('modalFeeInput');
        if (feeInput) {
            feeInput.value = rate;
            updatePricePreview();
        }
    }

    // 5. Professional PDF Export with html2pdf
    function exportRevenuePdf() {
        const btn = document.getElementById('btnExportPdf');
        const originalContent = btn ? btn.innerHTML : '';
        if (btn) {
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>Exporting...';
            btn.disabled = true;
        }

        const element = document.getElementById('pdfExportContainer');
        if (!element) {
            window.print();
            if (btn) { btn.innerHTML = originalContent; btn.disabled = false; }
            return;
        }

        // Temporarily reveal container for canvas capture
        element.style.display = 'block';

        const opt = {
            margin: [10, 10, 10, 10],
            filename: 'OPCBS_Revenue_Report_' + new Date().toISOString().slice(0, 10) + '.pdf',
            image: { type: 'jpeg', quality: 0.98 },
            html2canvas: { scale: 2, useCORS: true, letterRendering: true, logging: false },
            jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
        };

        if (typeof html2pdf !== 'undefined') {
            html2pdf().set(opt).from(element).save().then(() => {
                element.style.display = 'none';
                if (btn) {
                    btn.innerHTML = originalContent;
                    btn.disabled = false;
                }
            }).catch(err => {
                console.error("PDF generation error:", err);
                element.style.display = 'none';
                window.print();
                if (btn) {
                    btn.innerHTML = originalContent;
                    btn.disabled = false;
                }
            });
        } else {
            element.style.display = 'none';
            window.print();
            if (btn) {
                btn.innerHTML = originalContent;
                btn.disabled = false;
            }
        }
    }

    // 6. Client-side CSV Export
    function exportLedgerCsv() {
        const table = document.getElementById('ledgerTable');
        if (!table) return;

        let csv = [];
        const rows = table.querySelectorAll('tr');
        for (let i = 0; i < rows.length; i++) {
            const row = [], cols = rows[i].querySelectorAll('td, th');
            for (let j = 0; j < cols.length - 1; j++) {
                let data = cols[j].innerText.replace(/(\r\n|\n|\r)/gm, '').replace(/(\s\s+)/gm, ' ');
                data = data.replace(/"/g, '""');
                row.push('"' + data + '"');
            }
            csv.push(row.join(','));
        }

        const csvString = csv.join('\n');
        const a = document.createElement('a');
        a.href = 'data:text/csv;charset=utf-8,\uFEFF' + encodeURIComponent(csvString);
        a.target = '_blank';
        a.download = 'OPCBS_Revenue_Report_' + new Date().toISOString().slice(0, 10) + '.csv';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
    }

    document.addEventListener('DOMContentLoaded', function() {
        initTrendChart();
        initServiceChart();
        updatePricePreview();
    });
</script>
}
