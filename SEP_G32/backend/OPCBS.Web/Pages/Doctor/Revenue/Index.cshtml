                @if (Model.Transactions.Any())
                {
                    @foreach (var tx in Model.Transactions)
                    {
                        var isPkg = tx.ServiceType.Contains("Treatment Package", StringComparison.OrdinalIgnoreCase);
                        var isCompleted = tx.Status == "Completed" || tx.SettlementStatus == "Completed";
