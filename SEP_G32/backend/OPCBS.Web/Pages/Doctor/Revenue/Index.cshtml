                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div style="width:28px; height:28px; border-radius:50%; background:#e2e8f0; color:#475569; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:0.75rem;">
                                        @(string.IsNullOrEmpty(tx.PatientName) ? "P" : tx.PatientName[0].ToString().ToUpper())
                                    </div>
                                    <span class="fw-semibold text-dark">@(string.IsNullOrEmpty(tx.PatientName) ? "Patient" : tx.PatientName)</span>
                                </div>
                            </td>
                            <td>
                                @if (isPkg)
                                {
                                    <span class="tag-service-package"><i class="bi bi-gift me-1"></i>@tx.ServiceType</span>
                                }
                                else
                                {
                                    <span class="tag-service-online"><i class="bi bi-camera-video me-1"></i>@tx.ServiceType</span>
                                }
                            </td>
                            <td class="text-muted small">
                                60 mins
                            </td>
                            <td>
                                @if (isCompleted)
                                {
                                    <span class="tag-completed"><i class="bi bi-check-circle-fill me-1"></i>Completed</span>
                                }
                                else if (isConfirmed)
                                {
                                    <span class="tag-confirmed"><i class="bi bi-clock me-1"></i>Confirmed</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border">@tx.Status</span>
                                }
                            </td>
                            <td class="text-end fw-bold text-dark">
                                @tx.GrossAmount.ToString("N0") VND
                            </td>
                            <td class="text-end fw-bold text-success">
                                @tx.NetAmount.ToString("N0") VND
                            </td>
                            <td class="text-end no-print">
                                <a asp-page="/Doctor/Appointments/Details" asp-route-id="@tx.Id" class="btn btn-sm btn-link text-muted p-0 text-decoration-none">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </td>
                        </tr>
