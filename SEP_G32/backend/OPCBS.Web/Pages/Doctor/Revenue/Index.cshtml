    <!-- Pagination -->
    @if (Model.Pagination != null && Model.Pagination.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top no-print">
            <span class="text-muted small">Page @Model.Pagination.Page of @Model.Pagination.TotalPages</span>
            <div class="btn-group btn-group-sm">
                @if (Model.Pagination.HasPreviousPage)
                {
                    <a href="?Period=@Model.Period&Search=@Model.Search&Status=@Model.Status&Page=@(Model.Page - 1)" class="btn btn-outline-secondary">Previous</a>
                }
                @if (Model.Pagination.HasNextPage)
                {
                    <a href="?Period=@Model.Period&Search=@Model.Search&Status=@Model.Status&Page=@(Model.Page + 1)" class="btn btn-outline-secondary">Next</a>
