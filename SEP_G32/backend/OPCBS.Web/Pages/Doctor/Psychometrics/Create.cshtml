@page
@model OPCBS.Web.Pages.Doctor.Psychometrics.CreateModel
@{
    ViewData["Title"] = "Create Custom Assessment";
    Layout = "_DashboardLayout";
}

<style>
    .wizard-step-indicator {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2rem;
    }
    .wizard-step-badge {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.85rem;
        background: #e2e8f0;
        color: #64748b;
        transition: all 0.2s;
    }
    .wizard-step-badge.active {
        background: var(--mb-primary, #0d9488);
        color: #ffffff;
        box-shadow: 0 0 0 3px rgba(13, 148, 136, 0.2);
    }
    .wizard-step-badge.completed {
        background: #16a34a;
        color: #ffffff;
    }

    .question-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 1.25rem;
        margin-bottom: 1.25rem;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.02);
        position: relative;
        transition: border-color 0.15s;
    }
    .question-card:hover {
        border-color: #cbd5e1;
    }
</style>

<div class="container-fluid px-0 py-2" style="max-width: 860px;">
    <!-- Back Header -->
    <div class="mb-4">
        <a asp-page="/Doctor/Psychometrics/Index" class="btn btn-link text-decoration-none p-0 text-muted mb-2" style="font-size:0.84rem; font-weight:600;">
            <i class="bi bi-arrow-left me-1"></i>Back to Psychometric Assessments
        </a>
        <h1 class="h4 fw-bold text-dark mb-1">Create Custom Assessment</h1>
        <p class="text-muted mb-0" style="font-size:0.85rem;">Build a simple clinical questionnaire to evaluate patient symptoms and progress.</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert" style="border-radius:10px;">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Step Indicator -->
    <div class="wizard-step-indicator">
        <div class="d-flex align-items-center gap-2">
            <div class="wizard-step-badge active" id="stepBadge1">1</div>
            <span class="fw-bold text-dark" style="font-size:0.88rem;">Basic Information</span>
        </div>
        <div style="flex-grow:1; height:2px; background:#e2e8f0;"></div>
        <div class="d-flex align-items-center gap-2">
            <div class="wizard-step-badge" id="stepBadge2">2</div>
            <span class="text-muted fw-semibold" id="stepText2" style="font-size:0.88rem;">Questions & Scales</span>
        </div>
    </div>

    <form method="post" id="createAssessmentForm">
        <!-- STEP 1: Basic Information -->
        <div id="step1Container" class="card border-0 shadow-sm mb-4" style="border-radius:16px; border:1px solid #e2e8f0; background:#ffffff;">
            <div class="card-body p-4">
                <h5 class="fw-bold text-dark mb-3" style="font-size:1.05rem;">
                    <i class="bi bi-info-circle-fill me-2 text-teal" style="color:var(--mb-primary, #0d9488);"></i>Step 1 — Basic Information
                </h5>

                <div class="mb-3">
                    <label class="form-label fw-semibold text-dark" style="font-size:0.84rem;">Assessment Name <span class="text-danger">*</span></label>
                    <input asp-for="Title" class="form-control" placeholder="e.g. Weekly Anxiety Check-in, Sleep & Rest Tracker" style="border-radius:10px; font-size:0.88rem;" required />
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold text-dark" style="font-size:0.84rem;">Purpose / Focus</label>
                        <input asp-for="Purpose" class="form-control" placeholder="e.g. Monitor somatic anxiety symptoms" style="border-radius:10px; font-size:0.88rem;" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label fw-semibold text-dark" style="font-size:0.84rem;">Category <span class="text-danger">*</span></label>
                        <select asp-for="Category" class="form-select" style="border-radius:10px; font-size:0.88rem;">
                            <option value="Anxiety">Anxiety</option>
                            <option value="Depression">Depression</option>
                            <option value="Stress">Stress & Tension</option>
                            <option value="Sleep">Sleep Quality</option>
                            <option value="General Wellbeing">General Wellbeing</option>
                            <option value="Treatment Review">Weekly Treatment Review</option>
                        </select>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold text-dark" style="font-size:0.84rem;">Description (Optional)</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief clinical context or instructions for patients..." style="border-radius:10px; font-size:0.85rem;"></textarea>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                    <a asp-page="/Doctor/Psychometrics/Index" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold" style="border-radius:8px;">Cancel</a>
                    <button type="button" class="btn btn-sm px-4 py-2 fw-semibold text-white" onclick="goToStep(2)" style="border-radius:8px; background:var(--mb-primary, #0d9488);">
                        Next: Questions →
                    </button>
                </div>
            </div>
        </div>

        <!-- STEP 2: Questions -->
        <div id="step2Container" class="card border-0 shadow-sm mb-4" style="border-radius:16px; border:1px solid #e2e8f0; background:#ffffff; display:none;">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0" style="font-size:1.05rem;">
                        <i class="bi bi-list-check me-2 text-teal" style="color:var(--mb-primary, #0d9488);"></i>Step 2 — Questions
                    </h5>
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3 py-1.5 fw-semibold" onclick="addQuestionCard()" style="border-radius:8px; font-size:0.8rem;">
                        <i class="bi bi-plus-lg me-1"></i>Add Question
                    </button>
                </div>

                <div id="questionsList">
                    <!-- Dynamic Questions rendered here -->
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-3">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3 py-2 fw-semibold" onclick="goToStep(1)" style="border-radius:8px;">
                        ← Back to Basic Info
                    </button>
                    <button type="submit" class="btn btn-sm px-4 py-2 fw-semibold text-white" style="border-radius:8px; background:var(--mb-primary, #0d9488);">
                        <i class="bi bi-check2-circle me-1"></i>Save Assessment
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        let questionCounter = 0;

        function goToStep(step) {
            if (step === 2) {
                const title = document.getElementById('Title').value.trim();
                if (!title) {
                    alert('Please enter an Assessment Name before proceeding.');
                    document.getElementById('Title').focus();
                    return;
                }
                document.getElementById('step1Container').style.display = 'none';
                document.getElementById('step2Container').style.display = 'block';

                document.getElementById('stepBadge1').classList.remove('active');
                document.getElementById('stepBadge1').classList.add('completed');
                document.getElementById('stepBadge1').innerHTML = '✓';

                document.getElementById('stepBadge2').classList.add('active');
                document.getElementById('stepText2').classList.remove('text-muted');
                document.getElementById('stepText2').classList.add('text-dark', 'fw-bold');

                if (questionCounter === 0) {
                    addQuestionCard();
                }
            } else {
                document.getElementById('step2Container').style.display = 'none';
                document.getElementById('step1Container').style.display = 'block';

                document.getElementById('stepBadge1').classList.add('active');
                document.getElementById('stepBadge1').classList.remove('completed');
                document.getElementById('stepBadge1').textContent = '1';

                document.getElementById('stepBadge2').classList.remove('active');
                document.getElementById('stepText2').classList.add('text-muted');
                document.getElementById('stepText2').classList.remove('text-dark', 'fw-bold');
            }
        }

        function addQuestionCard(text = '', type = 'Rating1To5') {
            const index = questionCounter++;
            const container = document.getElementById('questionsList');

            const card = document.createElement('div');
            card.className = 'question-card';
            card.id = `qCard_${index}`;
            card.innerHTML = `
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge bg-light text-dark border fw-bold q-num-badge">Question ${container.children.length + 1}</span>
                    <button type="button" class="btn btn-link text-danger p-0 text-decoration-none small" onclick="removeQuestionCard(${index})">
                        <i class="bi bi-trash3 me-1"></i>Delete
                    </button>
                </div>
                <div class="mb-2.5">
                    <input type="text" name="Questions[${index}].Text" class="form-control" value="${text}" placeholder="Enter question text (e.g. How often do you feel anxious during the day?)" style="border-radius:8px; font-size:0.86rem;" required />
                </div>
                <div class="row g-2 align-items-center">
                    <div class="col-12 col-md-5">
                        <label class="form-label text-muted small mb-1" style="font-size:0.75rem;">Answer Format</label>
                        <select name="Questions[${index}].Type" class="form-select form-select-sm" onchange="updateQuestionPreview(${index})" id="qType_${index}" style="border-radius:8px; font-size:0.82rem;">
                            <option value="Rating1To5" ${type === 'Rating1To5' ? 'selected' : ''}>1–5 Rating Scale</option>
                            <option value="MultipleChoice" ${type === 'MultipleChoice' ? 'selected' : ''}>Multiple Choice (4 Options)</option>
                            <option value="YesNo" ${type === 'YesNo' ? 'selected' : ''}>Yes / No</option>
                            <option value="ShortText" ${type === 'ShortText' ? 'selected' : ''}>Short Text</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-7" id="qPreview_${index}">
                        <!-- Preview injected dynamically -->
                    </div>
                </div>
            `;

            container.appendChild(card);
            updateQuestionPreview(index);
            reindexQuestionBadges();
        }

        function removeQuestionCard(index) {
            const card = document.getElementById(`qCard_${index}`);
            if (card) {
                card.remove();
                reindexQuestionBadges();
            }
        }

        function reindexQuestionBadges() {
            const badges = document.querySelectorAll('.q-num-badge');
            badges.forEach((b, idx) => {
                b.textContent = `Question ${idx + 1}`;
            });
        }

        function updateQuestionPreview(index) {
            const type = document.getElementById(`qType_${index}`)?.value;
            const preview = document.getElementById(`qPreview_${index}`);
            if (!preview) return;

            if (type === 'Rating1To5') {
                preview.innerHTML = `
                    <label class="form-label text-muted small mb-1" style="font-size:0.75rem;">Format Preview</label>
                    <div class="d-flex gap-2 align-items-center text-muted" style="font-size:0.78rem;">
                        <span class="badge bg-light text-dark border px-2 py-1">○ 1</span>
                        <span class="badge bg-light text-dark border px-2 py-1">○ 2</span>
                        <span class="badge bg-light text-dark border px-2 py-1">○ 3</span>
                        <span class="badge bg-light text-dark border px-2 py-1">○ 4</span>
                        <span class="badge bg-light text-dark border px-2 py-1">○ 5</span>
                    </div>
                `;
            } else if (type === 'YesNo') {
                preview.innerHTML = `
                    <label class="form-label text-muted small mb-1" style="font-size:0.75rem;">Format Preview</label>
                    <div class="d-flex gap-2 align-items-center text-muted" style="font-size:0.78rem;">
                        <span class="badge bg-light text-dark border px-2.5 py-1">○ Yes</span>
                        <span class="badge bg-light text-dark border px-2.5 py-1">○ No</span>
                    </div>
                `;
            } else if (type === 'MultipleChoice') {
                preview.innerHTML = `
                    <label class="form-label text-muted small mb-1" style="font-size:0.75rem;">Format Preview</label>
                    <div class="d-flex gap-1.5 align-items-center text-muted" style="font-size:0.75rem;">
                        <span class="badge bg-light text-dark border">A. Not at all</span>
                        <span class="badge bg-light text-dark border">B. Several days</span>
                        <span class="badge bg-light text-dark border">C. Nearly every day</span>
                    </div>
                `;
            } else {
                preview.innerHTML = `
                    <label class="form-label text-muted small mb-1" style="font-size:0.75rem;">Format Preview</label>
                    <div class="text-muted small" style="font-size:0.78rem;">
                        <i class="bi bi-input-cursor-text me-1"></i>Free text input box
                    </div>
                `;
            }
        }
    </script>
}
