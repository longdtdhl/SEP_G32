@page
@model OPCBS.Web.Pages.Account.VerifyOtpModel
@{
    ViewData["Title"] = "Verify OTP";
    Layout = "_AuthLayout";
}

<div class="mb-auth-card">
    <h2>Verify Your Email</h2>
    <p class="auth-subtitle">We sent a verification code to your email. Please enter it below.</p>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:@(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-success"><i class="bi bi-envelope-check me-2"></i>@Model.StatusMessage</div>
    }
    <form method="post">
        <div class="mb-3">
            <label asp-for="Input.Email" class="form-label">Email</label>
            <input asp-for="Input.Email" class="form-control" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.Code" class="form-label">Verification Code (OTP)</label>
            <input asp-for="Input.Code" class="form-control" placeholder="Enter 6-digit code" maxlength="6" style="text-align:center;font-size:1.25rem;letter-spacing:0.5em;" />
            <span asp-validation-for="Input.Code" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100 btn-lg" style="background:var(--mb-primary); border-color:var(--mb-primary);">Verify</button>
    </form>
    <p class="text-center mt-3" style="font-size:0.875rem;">
        <i class="bi bi-envelope-check me-1"></i>An OTP code has been sent to your email. Please check your inbox (or Spam folder).
    </p>
    <form method="post" asp-page-handler="Resend" class="text-center mt-2">
        <input type="hidden" asp-for="Input.Email" />
        <button type="submit" class="btn btn-link p-0">Resend verification code</button>
    </form>
</div>
