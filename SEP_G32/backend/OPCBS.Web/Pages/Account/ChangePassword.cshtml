@page
@model OPCBS.Web.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="mb-auth-container" style="max-width:480px; margin: 2rem auto;">
    <div class="mb-auth-card card border-0 shadow-sm" style="border-radius:16px; padding:2rem;">
        <h2 style="font-size:1.4rem; font-weight:700; color:#1e293b;"><i class="bi bi-key-fill me-2" style="color:var(--mb-primary);"></i>Change Password</h2>
        <p class="auth-subtitle text-muted small">Update your account password.</p>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:@(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>
        <form method="post">
            <div class="mb-3">
                <label class="form-label fw-semibold">Current Password</label>
                <input asp-for="Input.CurrentPassword" type="password" class="form-control" style="border-radius:10px;" required />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">New Password</label>
                <input asp-for="Input.NewPassword" type="password" class="form-control" style="border-radius:10px;" required />
            </div>
            <button type="submit" class="btn btn-primary w-100 btn-lg mt-2" style="border-radius:10px; background:var(--mb-primary); border-color:var(--mb-primary); font-weight:600;">Update Password</button>
        </form>
    </div>
</div>
