@page
@model OPCBS.Web.Pages.Doctors.IndexModel
@inject OPCBS.Web.Helpers.JwtCookieService JwtService
@{
    ViewData["Title"] = "Search specialist";
    var isPatient = JwtService.IsLoggedIn && string.Equals(JwtService.GetRole(), "Patient", StringComparison.OrdinalIgnoreCase);
}

<style>
    .search-section {
        background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 50%, #d1fae5 100%);
        border-radius: 20px;
        padding: 2rem;
        margin-bottom: 2.5rem;
        border: 1px solid rgba(16,185,129,0.12);
        box-shadow: 0 4px 20px rgba(16,185,129,0.04);
    }
    
    .doctor-card-modern {
        background: white;
        border-radius: 18px;
        border: 1px solid #f1f5f9;
        box-shadow: 0 2px 8px rgba(0,0,0,0.02);
        transition: all 0.3s ease;
        padding: 1.75rem 1.25rem;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        height: 100%;
        text-decoration: none;
    }
    .doctor-card-modern:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 30px rgba(0,0,0,0.08);
        border-color: rgba(78,139,112,0.25);
    }
    
    .avatar-wrapper {
        position: relative;
        margin-bottom: 1.25rem;
    }
    .avatar-img-modern {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #f1f5f9;
        transition: border-color 0.3s;
    }
    .doctor-card-modern:hover .avatar-img-modern {
        border-color: var(--mb-primary);
    }
    
    .doctor-avatar-initials {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background: var(--mb-primary-light);
        color: var(--mb-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        font-weight: 700;
        border: 3px solid #f1f5f9;
    }
    
    .doctor-name-modern {
        font-size: 1.05rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 4px;
    }
    .doctor-spec-modern {
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--mb-primary);
        background: rgba(78,139,112,0.1);
        padding: 3px 10px;
        border-radius: 20px;
        margin-bottom: 12px;
    }
    
    .star-filled { color: #f59e0b; }
    .star-empty { color: #cbd5e1; }

    .fav-heart-btn {
        position: absolute; top: 8px; right: 8px; z-index: 10;
        background: rgba(255,255,255,0.9); border: none; border-radius: 50%;
        width: 34px; height: 34px; display: flex; align-items: center; justify-content: center;
        cursor: pointer; transition: all 0.2s; box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        font-size: 1rem; color: #cbd5e1;
    }
    .fav-heart-btn:hover { transform: scale(1.15); background: #fff; }
    .fav-heart-btn.active { color: #ef4444; }
    .fav-heart-btn.active:hover { color: #dc2626; }

    .doctor-bio-snippet {
        font-size: 0.78rem;
        color: #64748b;
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        margin: 6px 0 10px;
        text-align: center;
        padding: 0 0.25rem;
        min-height: 2.34em;
    }
</style>

<div class="mb-page-header mb-4">
    <h1 style="font-size:1.4rem; font-weight:700; margin:0;">
        <i class="bi bi-search-heart me-2" style="color:var(--mb-primary);"></i>Search Specialist Therapy
    </h1>
    <p style="margin:4px 0 0; font-size:0.85rem; color:#64748b;">Select a doctor and psychological specialist that matches your needs</p>
</div>

<!-- Search & Filter Block -->
<div class="search-section shadow-sm">
    <div class="row g-3">
        <div class="col-lg-8">
            <form method="get" class="mb-search-bar" style="position: relative; display: flex; align-items: center;">
                <i class="bi bi-search" style="position: absolute; left: 16px; color: #94a3b8; font-size: 1rem;"></i>
                <input type="text" name="Filter.Search" value="@Model.Filter.Search" class="form-control"
                       placeholder="Search by doctor name or specialization..." 
                       style="padding-left: 44px; border-radius: 12px; height: 46px; border: 1px solid #cbd5e1;" />
                <input type="hidden" name="Filter.SpecializationId" value="@Model.Filter.SpecializationId" />
            </form>
        </div>
        <div class="col-lg-4">
            <form method="get">
                <input type="hidden" name="Filter.Search" value="@Model.Filter.Search" />
                <select name="Filter.SpecializationId" class="form-select" 
                        style="height:46px; border-radius:12px; border: 1px solid #cbd5e1;"
                        onchange="this.form.submit()">
                    <option value="">All Specializations</option>
                    @foreach (var s in Model.Specializations)
                    {
                        <option value="@s.Id" selected="@(Model.Filter.SpecializationId == s.Id)">@s.Name</option>
                    }
                </select>
            </form>
        </div>
    </div>
</div>

<!-- Doctor Grid -->
@if (Model.Doctors.Any())
{
    <div class="row g-4 mb-4">
        @foreach (var doc in Model.Doctors)
        {
            var initials = string.Join("", (doc.FullName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0]));
            
            <div class="col-sm-6 col-lg-4 col-xl-3" style="position:relative;">
                @if (isPatient)
                {
                    <button class="fav-heart-btn" data-doctor-id="@doc.Id" onclick="toggleFavorite(event, this)" title="Add to Favorites">
                        <i class="bi bi-heart"></i>
                    </button>
                }
                <a asp-page="Details" asp-route-id="@doc.Id" class="doctor-card-modern">
                    <!-- Avatar -->
                    <div class="avatar-wrapper">
                        @if (!string.IsNullOrEmpty(doc.AvatarUrl))
                        {
                            <img src="@doc.AvatarUrl" alt="@doc.FullName" class="avatar-img-modern" />
                        }
                        else
                        {
                            <div class="doctor-avatar-initials">
                                @initials
                            </div>
                        }
                        @if (doc.IsVerified)
                        {
                            <div class="mb-verified-badge" 
                                 style="position: absolute; bottom: 2px; right: 2px; width: 24px; height: 24px; background: #00ba7c; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; border: 2px solid white;">
                                <i class="bi bi-patch-check-fill"></i>
                            </div>
                        }
                    </div>

                    <!-- Name & Spec -->
                    <div class="doctor-name-modern">@doc.FullName</div>
                    <div class="d-inline-block">
                        <span class="doctor-spec-modern">@(doc.Specialization ?? "Therapist")</span>
                    </div>

                    @if (doc.Specializations != null && doc.Specializations.Any())
                    {
                        <div class="d-flex flex-wrap gap-1 justify-content-center mb-2" style="max-height: 48px; overflow: hidden;">
                            @foreach (var s in doc.Specializations.Take(2))
                            {
                                <span class="badge bg-light text-secondary border px-2 py-1" style="font-size: 0.65rem; border-radius: 6px; font-weight: 500;">@s</span>
                            }
                            @if (doc.Specializations.Count > 2)
                            {
                                <span class="badge bg-light text-secondary border px-2 py-1" style="font-size: 0.65rem; border-radius: 6px; font-weight: 500;">+@(doc.Specializations.Count - 2)</span>
                            }
                        </div>
                    }

                    <!-- Bio Snippet -->
                    @if (!string.IsNullOrEmpty(doc.Biography))
                    {
                        <div class="doctor-bio-snippet">@doc.Biography</div>
                    }
                    else
                    {
                        <div class="doctor-bio-snippet" style="color:#cbd5e1;font-style:italic;">Professional therapist dedicated to your well-being</div>
                    }

                    <!-- Rating -->
                    <div class="d-flex align-items-center gap-1 justify-content-center mb-3">
                        @{
                            var rating = doc.Rating;
                            var stars = (int)Math.Floor(rating);
                            var half = (rating - stars) >= 0.25;
                        }
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= stars)
                            {
                                <i class="bi bi-star-fill star-filled" style="font-size:0.85rem;"></i>
                            }
                            else if (i == stars + 1 && half)
                            {
                                <i class="bi bi-star-half star-filled" style="font-size:0.85rem;"></i>
                            }
                            else
                            {
                                <i class="bi bi-star star-empty" style="font-size:0.85rem;"></i>
                            }
                        }
                        @if (doc.ReviewCount > 0)
                        {
                            <span style="font-size:0.75rem; color:#64748b; margin-left:4px;">(@doc.ReviewCount reviews)</span>
                        }
                    </div>

                    <!-- Experience & Fee Meta -->
                    <div class="mt-auto d-flex justify-content-between w-100 border-top pt-3" style="font-size:0.8rem; color:#64748b;">
                        <span><i class="bi bi-briefcase me-1 text-primary"></i>@doc.ExperienceYears years experience</span>
                        @if (doc.ConsultationFee > 0)
                        {
                            <span class="fw-bold" style="color:var(--mb-primary);">@doc.ConsultationFee.ToString("N0")₫</span>
                        }
                    </div>
                </a>
            </div>
        }
    </div>

    @if (Model.Pagination != null)
    {
        <partial name="_Pagination" view-data='@(new ViewDataDictionary(ViewData) { { "Pagination", Model.Pagination }, { "PageUrl", "/Doctors" } })' />
    }
}
else
{
    <div class="card border-0 shadow-sm py-5 text-center" style="border-radius: 16px;">
        <div class="card-body">
            <i class="bi bi-search text-muted mb-3" style="font-size: 3rem; opacity: 0.4;"></i>
            <h5 class="fw-bold">No Doctors Found</h5>
            <p class="text-muted small mb-0">Try changing your search keywords or selected specialization.</p>
        </div>
    </div>
}

@if (isPatient)
{
<script>
async function toggleFavorite(e, btn) {
    e.preventDefault();
    e.stopPropagation();
    var doctorId = btn.dataset.doctorId;
    try {
        var res = await fetch('/Patient/Favorites?handler=Toggle&doctorId=' + doctorId, {
            method: 'POST',
            headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' }
        });
        if (res.ok) {
            var data = await res.json();
            btn.classList.toggle('active', data.isFavorite);
            var icon = btn.querySelector('i');
            if (icon) {
                icon.className = data.isFavorite ? 'bi bi-heart-fill' : 'bi bi-heart';
            }
            btn.title = data.isFavorite ? 'Remove from Favorites' : 'Add to Favorites';
        }
    } catch(err) { console.error('Favorite toggle failed', err); }
}

// Load favorite statuses on page load
document.addEventListener('DOMContentLoaded', async () => {
    var btns = document.querySelectorAll('.fav-heart-btn');
    for (var btn of btns) {
        try {
            var res = await fetch('/Patient/Favorites?handler=Check&doctorId=' + btn.dataset.doctorId);
            if (res.ok) {
                var data = await res.json();
                btn.classList.toggle('active', data.isFavorite);
                var icon = btn.querySelector('i');
                if (icon) {
                    icon.className = data.isFavorite ? 'bi bi-heart-fill' : 'bi bi-heart';
                }
                btn.title = data.isFavorite ? 'Remove from Favorites' : 'Add to Favorites';
            }
        } catch(e) {}
    }
});
</script>
}
