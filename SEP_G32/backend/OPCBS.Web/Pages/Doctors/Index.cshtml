@page
@model OPCBS.Web.Pages.Doctors.IndexModel
@{ ViewData["Title"] = "Find a Therapist"; }

<section class="mb-section">
    <div class="mb-page-header">
        <h1>Find a Therapist</h1>
    </div>

    <!-- Search & Filter -->
    <div class="row g-3 mb-4">
        <div class="col-lg-8">
            <form method="get" class="mb-search-bar">
                <i class="bi bi-search"></i>
                <input type="text" name="search" value="@Model.Filter.Search" class="form-control"
                       placeholder="Search by name or specialization..." />
                <input type="hidden" name="specialization" value="@Model.Filter.Specialization" />
            </form>
        </div>
        <div class="col-lg-4">
            <form method="get">
                <input type="hidden" name="search" value="@Model.Filter.Search" />
                <select name="specialization" class="form-select" style="height:44px;border-radius:var(--mb-radius);"
                        onchange="this.form.submit()">
                    <option value="">All Specializations</option>
                    @foreach (var s in Model.Specializations)
                    {
                        <option value="@s" selected="@(Model.Filter.Specialization == s)">@s</option>
                    }
                </select>
            </form>
        </div>
    </div>

    <!-- Doctor Cards Grid -->
    @if (Model.Doctors.Any())
    {
        <div class="row g-4">
            @foreach (var doc in Model.Doctors)
            {
                var initials = string.Join("", (doc.FullName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0]));
                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <a asp-page="Details" asp-route-id="@doc.Id" class="text-decoration-none">
                        <div class="mb-doctor-card h-100 d-flex flex-column align-items-center text-center">
                            <!-- Avatar -->
                            <div class="position-relative mb-3">
                                @if (!string.IsNullOrEmpty(doc.AvatarUrl))
                                {
                                    <img src="@doc.AvatarUrl" alt="@doc.FullName"
                                         style="width:96px;height:96px;border-radius:50%;object-fit:cover;border:2px solid var(--mb-secondary);" />
                                }
                                else
                                {
                                    <div style="width:96px;height:96px;border-radius:50%;background:var(--mb-secondary);display:flex;align-items:center;justify-content:center;font-size:1.75rem;font-weight:700;color:var(--mb-primary);">
                                        @initials
                                    </div>
                                }
                                @if (doc.IsVerified)
                                {
                                    <div class="mb-verified-badge" style="bottom:2px;right:2px;width:24px;height:24px;font-size:0.75rem;">
                                        <i class="bi bi-patch-check-fill"></i>
                                    </div>
                                }
                            </div>

                            <!-- Name & Specialization -->
                            <h5 class="doctor-name mb-1">@doc.FullName</h5>
                            <p class="doctor-specialization mb-2">@(doc.Specialization ?? "Psychologist")</p>

                            <!-- Rating -->
                            <div class="d-flex align-items-center gap-1 mb-2">
                                @{
                                    var rating = doc.Rating;
                                    var stars = (int)Math.Floor(rating);
                                    var half = (rating - stars) >= 0.25;
                                }
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= stars)
                                    {
                                        <i class="bi bi-star-fill star-filled" style="font-size:0.875rem;"></i>
                                    }
                                    else if (i == stars + 1 && half)
                                    {
                                        <i class="bi bi-star-half star-filled" style="font-size:0.875rem;"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-star star-empty" style="font-size:0.875rem;"></i>
                                    }
                                }
                                @if (doc.ReviewCount > 0)
                                {
                                    <span style="font-size:0.75rem;color:var(--mb-text-muted);margin-left:4px;">(@doc.ReviewCount)</span>
                                }
                            </div>

                            <!-- Meta -->
                            <div class="mt-auto d-flex justify-content-between w-100" style="font-size:0.8125rem;color:var(--mb-text-secondary);">
                                <span><i class="bi bi-briefcase me-1"></i>@doc.ExperienceYears yrs</span>
                                @if (doc.ConsultationFee > 0)
                                {
                                    <span class="fw-semibold" style="color:var(--mb-primary);">@doc.ConsultationFee.ToString("N0")₫</span>
                                }
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>

        <partial name="_Pagination" view-data='@(new ViewDataDictionary(ViewData) { { "Pagination", Model.Pagination }, { "PageUrl", "/Doctors" } })' />
    }
    else
    {
        <partial name="_EmptyState" view-data='@(new ViewDataDictionary(ViewData) { { "EmptyIcon", "bi-search" }, { "EmptyTitle", "No therapists found" }, { "EmptyMessage", "Try adjusting your search filters." } })' />
    }
</section>
