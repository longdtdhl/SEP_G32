@page "{id:guid}"
@model OPCBS.Web.Pages.Doctors.DetailsModel
@{
    ViewData["Title"] = Model.Doctor?.FullName ?? "Doctor Details";
}

@if (Model.Doctor == null)
{
    <partial name="_ErrorState" view-data='@(new ViewDataDictionary(ViewData) { { "ErrorMessage", "Doctor not found." } })' />
    return;
}

@{
    var avgRating = Model.Doctor.Rating;
    var fullStars = (int)Math.Floor(avgRating);
    var hasHalf = (avgRating - fullStars) >= 0.25;
    var initials = string.Join("", (Model.Doctor.FullName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0]));
}

<section class="mb-section">
    <!-- Doctor Profile Header -->
    <div class="mb-doctor-profile-header">
        <div class="d-flex flex-column flex-md-row gap-4 align-items-center align-items-md-start">
            <!-- Avatar -->
            <div class="position-relative">
                @if (!string.IsNullOrEmpty(Model.Doctor.AvatarUrl))
                {
                    <img src="@Model.Doctor.AvatarUrl" alt="@Model.Doctor.FullName" class="doctor-avatar-lg" />
                }
                else
                {
                    <div class="avatar-placeholder-lg">
                        <i class="bi bi-person-fill" style="font-size:3rem;color:var(--mb-primary);"></i>
                    </div>
                }
                @if (Model.Doctor.IsVerified)
                {
                    <div class="mb-verified-badge">
                        <i class="bi bi-patch-check-fill"></i>
                    </div>
                }
            </div>

            <!-- Info -->
            <div class="flex-grow-1 text-center text-md-start">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-center align-items-md-start gap-3">
                    <div>
                        <h1 class="h3 mb-1">@Model.Doctor.FullName</h1>
                        <p class="mb-2" style="color:var(--mb-primary);font-weight:600;font-size:1.125rem;">@Model.Doctor.Specialization</p>
                        @if (Model.Doctor.Specializations.Any())
                        {
                            <div class="d-flex flex-wrap justify-content-center justify-content-md-start gap-2 mt-1">
                                @foreach (var s in Model.Doctor.Specializations)
                                {
                                    <span class="mb-chip">@s</span>
                                }
                            </div>
                        }
                    </div>
                    <a asp-page="/Appointment/Book" asp-route-doctorId="@Model.Doctor.Id"
                       class="btn btn-primary btn-lg px-4" style="border-radius:var(--mb-radius);white-space:nowrap;">
                        <i class="bi bi-calendar-plus me-2"></i>Book an Appointment
                    </a>
                </div>

                <!-- Stats -->
                <div class="row g-3 mt-3 pt-3 border-top">
                    <div class="col-4">
                        <div class="mb-stat-item">
                            <div class="stat-value">@(Model.Doctor.ExperienceYears)+</div>
                            <div class="stat-label">Years Exp.</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="mb-stat-item">
                            <div class="stat-value">@Model.Doctor.ReviewCount</div>
                            <div class="stat-label">Reviews</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="mb-stat-item">
                            <div class="stat-value">@avgRating.ToString("0.0")</div>
                            <div class="stat-label">Rating</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tab Navigation -->
    <div class="mb-tab-nav">
        <button class="mb-tab-btn active" onclick="switchTab('about', this)">About me</button>
        <button class="mb-tab-btn" onclick="switchTab('background', this)">Professional Background</button>
        <button class="mb-tab-btn" onclick="switchTab('reviews', this)">Reviews & Ratings</button>
    </div>

    <!-- About Tab -->
    <div class="mb-tab-content active" id="tab-about">
        <div class="card">
            <div class="card-body">
                <h5 class="mb-3">Personal Bio</h5>
                @if (!string.IsNullOrEmpty(Model.Doctor.Bio))
                {
                    <p class="text-muted" style="line-height:1.8;max-width:800px;">@Model.Doctor.Bio</p>
                }
                else
                {
                    <p class="text-muted fst-italic">No bio available.</p>
                }

                <div class="row g-3 mt-3">
                    <div class="col-md-6">
                        <div class="mb-info-card">
                            <i class="bi bi-heart-fill info-icon"></i>
                            <div>
                                <div class="info-title">Compassionate Care</div>
                                <p class="info-desc">A non-judgmental environment focused on your emotional safety.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-info-card">
                            <i class="bi bi-journal-medical info-icon"></i>
                            <div>
                                <div class="info-title">Evidence-Based</div>
                                <p class="info-desc">Techniques backed by modern psyforlogical research.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Background Tab -->
    <div class="mb-tab-content" id="tab-background">
        <div class="row g-4">
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="mb-3">Practitioner License</h5>
                        <div class="mb-cert-display">
                            <i class="bi bi-award cert-icon"></i>
                            <div class="cert-title">Licensed Psychologist</div>
                            <div class="cert-meta">
                                @if (Model.Doctor.IsVerified)
                                {
                                    <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>Verified</span>
                                }
                                else
                                {
                                    <span class="text-muted">Pending verification</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="mb-3">Experience & Specializations</h5>
                        <div class="mb-cert-display">
                            <i class="bi bi-mortarboard cert-icon"></i>
                            <div class="cert-title">@Model.Doctor.ExperienceYears+ Years of Experience</div>
                            @if (Model.Doctor.Specializations.Any())
                            {
                                <div class="d-flex flex-wrap justify-content-center gap-2 mt-3">
                                    @foreach (var s in Model.Doctor.Specializations)
                                    {
                                        <span class="mb-chip">@s</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Reviews Tab -->
    <div class="mb-tab-content" id="tab-reviews">
        <div class="card">
            <div class="card-body">
                <!-- Rating summary -->
                <div class="d-flex flex-column flex-lg-row gap-4 align-items-center border-bottom pb-4 mb-4">
                    <div class="text-center" style="min-width:140px;">
                        <div style="font-size:3.5rem;font-weight:700;line-height:1;">@avgRating.ToString("0.0")</div>
                        <div class="text-muted" style="font-size:1.25rem;">/ 5.0</div>
                        <div class="mb-rating-summary mt-2 justify-content-center">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= fullStars)
                                {
                                    <i class="bi bi-star-fill star-filled"></i>
                                }
                                else if (i == fullStars + 1 && hasHalf)
                                {
                                    <i class="bi bi-star-half star-filled"></i>
                                }
                                else
                                {
                                    <i class="bi bi-star star-empty"></i>
                                }
                            }
                        </div>
                        <div class="text-muted mt-1" style="font-size:0.8125rem;">Based on @Model.Doctor.ReviewCount reviews</div>
                    </div>
                </div>

                <!-- Review cards -->
                <h5 class="mb-3">Patient Feedback</h5>
                @if (Model.Reviews.Any())
                {
                    @foreach (var review in Model.Reviews)
                    {
                        var ri = string.Join("", (review.PatientName ?? "??").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0]));
                        <div class="mb-review-card">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="reviewer-initials">@ri</div>
                                    <div>
                                        <div class="fw-semibold">@review.PatientName</div>
                                        <div style="font-size:0.75rem;color:var(--mb-text-muted);">@review.CreatedAt.ToString("MMMM dd, yyyy")</div>
                                    </div>
                                </div>
                                <div class="mb-rating-summary">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="bi @(i <= review.Rating ? "bi-star-fill star-filled" : "bi-star star-empty")" style="font-size:0.875rem;"></i>
                                    }
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(review.Comment))
                            {
                                <p class="text-muted mb-0 fst-italic" style="font-size:0.9375rem;line-height:1.6;">"@review.Comment"</p>
                            }
                        </div>
                    }
                    <div class="text-center mt-3">
                        <a asp-page="/Doctors/Ratings" asp-route-id="@Model.Doctor.Id" class="btn btn-outline-primary">View All Reviews</a>
                    </div>
                }
                else
                {
                    <p class="text-muted text-center py-4">No reviews yet.</p>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function switchTab(tabId, btn) {
            // Hide all tab content
            document.querySelectorAll('.mb-tab-content').forEach(el => el.classList.remove('active'));
            // Show selected tab
            document.getElementById('tab-' + tabId).classList.add('active');
            // Update button styles
            document.querySelectorAll('.mb-tab-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
        }
    </script>
}
