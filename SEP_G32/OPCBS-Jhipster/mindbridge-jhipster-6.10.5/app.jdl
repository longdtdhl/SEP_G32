/**
 * ============================================================================
 * OPCBS MindBridge Healthcare System - JDL for JHipster 6.10.5
 * ============================================================================
 */

application {
  config {
    baseName opcbs
    applicationType monolith
    packageName com.ocbs
    authenticationType jwt
    buildTool maven
    databaseType sql
    devDatabaseType mysql
    prodDatabaseType mysql
    cacheProvider no
    enableHibernateCache false
    serverPort 8081
    clientFramework angularX
    clientTheme none
    enableTranslation false
    nativeLanguage en
    testFrameworks []
  }
  entities Specialization, DoctorProfile, PatientProfile, AvailabilitySlot, Appointment, TreatmentPackage, EmotionJournal, PsychometricTest, PsychometricQuestion, PsychometricSubmission
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum Gender {
  MALE,
  FEMALE,
  OTHER
}

enum ConsultationMode {
  ONLINE,
  IN_PERSON,
  BOTH
}

enum SlotStatus {
  AVAILABLE,
  BOOKED,
  CANCELLED
}

enum AppointmentStatus {
  PENDING,
  ACCEPTED,
  REJECTED,
  IN_PROGRESS,
  COMPLETED,
  CANCELLED
}

// ----------------------------------------------------------------------------
// ENTITIES
// ----------------------------------------------------------------------------

entity Specialization {
  name String required unique maxlength(160)
  description String maxlength(500)
}

entity DoctorProfile {
  fullName String required maxlength(160)
  title String maxlength(100)
  bio TextBlob
  experienceYears Integer min(0)
  consultationFee BigDecimal min(0)
  phone String maxlength(30)
  gender Gender
  isActive Boolean required
}

entity PatientProfile {
  fullName String required maxlength(160)
  phone String required maxlength(30)
  dateOfBirth LocalDate
  gender Gender
  address String maxlength(255)
  medicalHistory TextBlob
  allergies String maxlength(500)
  emergencyContactPhone String maxlength(30)
  bloodGroup String maxlength(10)
}

entity AvailabilitySlot {
  startTime Instant required
  endTime Instant required
  status SlotStatus required
  consultationMode ConsultationMode required
  notes String maxlength(255)
}

entity Appointment {
  bookingCode String required unique maxlength(30)
  scheduledStart Instant required
  scheduledEnd Instant required
  consultationMode ConsultationMode required
  status AppointmentStatus required
  reason TextBlob
  cancellationReason String maxlength(500)
  createdAt Instant required
  updatedAt Instant
}

entity TreatmentPackage {
  name String required maxlength(160)
  description TextBlob
  targetOutcome TextBlob
  recommendedExercises TextBlob
  instructions TextBlob
  sessionQuantity Integer required min(1)
  remainingSessions Integer min(0)
  validityDays Integer min(1)
  price BigDecimal min(0)
  status String maxlength(30)
  assignedDate Instant
  acceptedDate Instant
}

entity EmotionJournal {
  title String required maxlength(160)
  content TextBlob required
  moodScale Integer required min(1) max(5)
  stressScale Integer min(1) max(5)
  sleepHours Double min(0) max(24)
  depressionScale Integer min(1) max(5)
  isShared Boolean required
  createdAt Instant required
}

entity PsychometricTest {
  code String required unique maxlength(30)
  name String required maxlength(160)
  description TextBlob
  instruction TextBlob
  totalQuestions Integer required min(1)
  estimatedMinutes Integer
  isActive Boolean required
}

entity PsychometricQuestion {
  questionNumber Integer required min(1)
  questionText TextBlob required
  category String maxlength(50)
  weight Double
}

entity PsychometricSubmission {
  totalScore Integer required
  subscoresJson TextBlob
  interpretationResult TextBlob
  severityLevel String maxlength(50)
  doctorNotes TextBlob
  status String maxlength(30)
  completedAt Instant
}

// ----------------------------------------------------------------------------
// RELATIONSHIPS
// ----------------------------------------------------------------------------

relationship OneToOne {
  DoctorProfile{user(login)} to User
  PatientProfile{user(login)} to User
}

relationship ManyToMany {
  DoctorProfile{specializations(name)} to Specialization{doctors}
}

relationship OneToMany {
  DoctorProfile{availabilitySlots} to AvailabilitySlot{doctor(fullName)}
  DoctorProfile{appointments} to Appointment{doctor(fullName)}
  PatientProfile{appointments} to Appointment{patient(fullName)}
  DoctorProfile{treatmentPackages} to TreatmentPackage{doctor(fullName)}
  PatientProfile{treatmentPackages} to TreatmentPackage{patient(fullName)}
  PatientProfile{journals} to EmotionJournal{patient(fullName)}
  PsychometricTest{questions} to PsychometricQuestion{test(name)}
  PsychometricTest{submissions} to PsychometricSubmission{test(name)}
  PatientProfile{psychometricSubmissions} to PsychometricSubmission{patient(fullName)}
  DoctorProfile{assignedSubmissions} to PsychometricSubmission{assignedByDoctor(fullName)}
}

relationship ManyToOne {
  Appointment{slot} to AvailabilitySlot
  PsychometricSubmission{appointment} to Appointment
}

// ----------------------------------------------------------------------------
// DTO, SERVICE & PAGINATION
// ----------------------------------------------------------------------------

dto * with mapstruct
service * with serviceClass
paginate Specialization, DoctorProfile, PatientProfile, AvailabilitySlot, Appointment with pagination
